    Private Sub BomViewerFormShown(ByVal sender As Object, ByVal e As EventArgs)
        ApplyDefaultSplitterDistance()
    End Sub

    Private Sub BomViewerFormResized(ByVal sender As Object, ByVal e As EventArgs)
        If MainSplit Is Nothing Then Exit Sub
        If MainSplit.Panel2Collapsed Then Exit Sub
        SafeSetSplitterDistance(MainSplit, MainSplit.SplitterDistance)
    End Sub

    Private Sub ApplyDefaultSplitterDistance()
        If MainSplit Is Nothing Then Exit Sub
        If MainSplit.IsDisposed Then Exit Sub
        If MainSplit.Panel2Collapsed Then Exit Sub

        Dim desired As Integer = MainSplit.ClientSize.Width - 340
        SafeSetSplitterDistance(MainSplit, desired)
    End Sub

    Private Sub SafeSetSplitterDistance(ByVal target As System.Windows.Forms.SplitContainer, ByVal desired As Integer)
        If target Is Nothing OrElse target.IsDisposed Then Exit Sub
        If target.Orientation <> System.Windows.Forms.Orientation.Vertical Then Exit Sub

        Dim availableWidth As Integer = target.ClientSize.Width
        If availableWidth <= 0 Then Exit Sub

        Dim minimumValue As Integer = Math.Max(0, target.Panel1MinSize)
        Dim maximumValue As Integer = availableWidth - Math.Max(0, target.Panel2MinSize) - target.SplitterWidth

        'Nếu cửa sổ đang quá nhỏ, tạm thời không thay đổi vị trí thanh chia.
        If maximumValue < minimumValue Then Exit Sub

        Dim safeValue As Integer = desired
        If safeValue < minimumValue Then safeValue = minimumValue
        If safeValue > maximumValue Then safeValue = maximumValue

        Try
            target.SplitterDistance = safeValue
        Catch
            'Không để lỗi giao diện làm dừng quá trình xuất BOM.
        End Try
    End Sub

    Private Sub EnableGridDoubleBuffer(ByVal targetGrid As DataGridView)
        If targetGrid Is Nothing Then Exit Sub
        Try
            Dim propertyInfo As System.Reflection.PropertyInfo = GetType(DataGridView).GetProperty(
                "DoubleBuffered", _
                System.Reflection.BindingFlags.Instance Or System.Reflection.BindingFlags.NonPublic)
            If propertyInfo IsNot Nothing Then propertyInfo.SetValue(targetGrid, True, Nothing)
        Catch
        End Try
    End Sub


'####################################################################
' SUBSECTION 15.03 - RIBBON / QUICK ACCESS / TOOLBAR
'####################################################################

    Private Sub BuildRibbonHost()
        RibbonHost = New Panel()
        RibbonHost.Dock = DockStyle.Fill
        RibbonHost.BackColor = Color.FromArgb(242, 247, 250)
        RibbonHost.Padding = New System.Windows.Forms.Padding(0)

        RibbonQuickBar = New System.Windows.Forms.FlowLayoutPanel()
        RibbonQuickBar.Dock = DockStyle.Top
        RibbonQuickBar.Height = 30
        RibbonQuickBar.FlowDirection = System.Windows.Forms.FlowDirection.LeftToRight
        RibbonQuickBar.WrapContents = False
        RibbonQuickBar.Padding = New System.Windows.Forms.Padding(6, 2, 6, 2)
        RibbonQuickBar.BackColor = Color.FromArgb(225, 236, 242)
        RibbonHost.Controls.Add(RibbonQuickBar)

        AddQuickButton("REFRESH", AddressOf RefreshClicked, "Smart Refresh")
        AddQuickButton("REVIEW [0]", AddressOf ReviewPendingClicked, "Pending Changes Review")
        AddQuickButton("COMMIT", AddressOf CommitPendingClicked, "Commit Pending Changes")
        AddQuickButton("SAVE", AddressOf SaveChangedDocumentsClicked, "Save committed documents")
        AddQuickButton("UNDO", AddressOf UndoClicked, "Undo")
        AddQuickButton("REDO", AddressOf RedoClicked, "Redo")
        AddQuickButton("SAFE MODE", AddressOf ToggleSafeModeClicked, "Read Only safety mode")

        RibbonCollapseButton = New Button()
        RibbonCollapseButton.Text = "THU GỌN ▲"
        RibbonCollapseButton.AutoSize = False
        RibbonCollapseButton.Size = New Size(92, 24)
        RibbonCollapseButton.FlatStyle = FlatStyle.Flat
        RibbonCollapseButton.FlatAppearance.BorderSize = 0
        RibbonCollapseButton.BackColor = Color.FromArgb(225, 236, 242)
        RibbonCollapseButton.ForeColor = Color.FromArgb(35, 85, 105)
        RibbonCollapseButton.Font = New Font("Segoe UI", 8.0F, FontStyle.Bold)
        AddHandler RibbonCollapseButton.Click, AddressOf ToggleRibbonCollapsed
        RibbonQuickBar.Controls.Add(RibbonCollapseButton)

        RibbonTabBar = New System.Windows.Forms.FlowLayoutPanel()
        RibbonTabBar.Dock = DockStyle.Top
        RibbonTabBar.Height = 30
        RibbonTabBar.FlowDirection = System.Windows.Forms.FlowDirection.LeftToRight
        RibbonTabBar.WrapContents = False
        RibbonTabBar.Padding = New System.Windows.Forms.Padding(4, 1, 4, 1)
        RibbonTabBar.BackColor = Color.White
        RibbonHost.Controls.Add(RibbonTabBar)
        RibbonTabBar.BringToFront()

        Dim tabs() As String = {"HOME", "BOM", "STRUCTURE", "CHECK", "DRAWINGS", "CHANGES", "MANUFACTURING", "TOOLS"}
        For Each tabName As String In tabs
            AddRibbonTabButton(tabName)
        Next

        RibbonContent = New Panel()
        RibbonContent.Dock = DockStyle.Fill
        RibbonContent.BackColor = Color.FromArgb(248, 250, 252)
        RibbonContent.Padding = New System.Windows.Forms.Padding(0)
        RibbonHost.Controls.Add(RibbonContent)
        RibbonContent.BringToFront()

        BuildToolBar()
        UpdateRibbonTabVisuals()
    End Sub

    Private Sub AddQuickButton(ByVal caption As String, ByVal handler As EventHandler, ByVal tip As String)
        Dim button As New Button()
        button.Text = caption
        button.AutoSize = False
        Dim quickText As Size = System.Windows.Forms.TextRenderer.MeasureText(caption, New Font("Segoe UI", 8.0F, FontStyle.Bold))
        button.Size = New Size(Math.Max(64, Math.Min(118, quickText.Width + 20)), 24)
        button.Margin = New System.Windows.Forms.Padding(2, 0, 2, 0)
        button.FlatStyle = FlatStyle.Flat
        button.FlatAppearance.BorderSize = 0
        button.BackColor = Color.FromArgb(225, 236, 242)
        button.ForeColor = Color.FromArgb(40, 70, 85)
        button.Font = New Font("Segoe UI", 8.0F, FontStyle.Bold)
        Dim tipControl As New System.Windows.Forms.ToolTip()
        tipControl.SetToolTip(button, tip)
        AddHandler button.Click, handler
        RibbonQuickBar.Controls.Add(button)
        _quickButtons(caption.Split("["c)(0).Trim()) = button
    End Sub

    Private Sub AddRibbonTabButton(ByVal tabName As String)
        Dim button As New Button()
        button.Text = tabName
        button.Tag = tabName
        button.AutoSize = False
        Dim tabText As Size = System.Windows.Forms.TextRenderer.MeasureText(tabName, New Font("Segoe UI", 8.5F, FontStyle.Bold))
        button.Size = New Size(Math.Max(82, Math.Min(150, tabText.Width + 30)), 27)
        button.Margin = New System.Windows.Forms.Padding(1, 0, 1, 0)
        button.FlatStyle = FlatStyle.Flat
        button.FlatAppearance.BorderSize = 0
        button.Font = New Font("Segoe UI", 8.5F, FontStyle.Bold)
        AddHandler button.Click, AddressOf RibbonTabClicked
        RibbonTabBar.Controls.Add(button)
        _ribbonTabButtons(tabName) = button
    End Sub

    Private Sub RibbonTabClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim button As Button = TryCast(sender, Button)
        If button Is Nothing Then Exit Sub
        Dim requestedTab As String = Convert.ToString(button.Tag)
        If String.IsNullOrWhiteSpace(requestedTab) Then Exit Sub

        If _ribbonCollapsed AndAlso String.Equals(_activeRibbonTab, requestedTab, StringComparison.OrdinalIgnoreCase) Then
            _ribbonCollapsed = False
        Else
            _activeRibbonTab = requestedTab
            _ribbonCollapsed = False
        End If

        ApplyRibbonCollapsedState()
        BuildToolBar()
        UpdateRibbonTabVisuals()
        UpdatePreviewFromCurrentRow()
    End Sub

    Private Sub ToggleRibbonCollapsed(ByVal sender As Object, ByVal e As EventArgs)
        _ribbonCollapsed = Not _ribbonCollapsed
        ApplyRibbonCollapsedState()
    End Sub

    Private Sub ApplyRibbonCollapsedState()
        If RibbonContent Is Nothing OrElse RibbonHost Is Nothing Then Exit Sub
        RibbonContent.Visible = Not _ribbonCollapsed
        RibbonCollapseButton.Text = If(_ribbonCollapsed, "MỞ RỘNG ▼", "THU GỌN ▲")
        RibbonHost.Height = If(_ribbonCollapsed, 62, 128)
        If MainLayout IsNot Nothing AndAlso MainLayout.RowStyles.Count > 0 Then
            MainLayout.RowStyles(0).Height = If(_ribbonCollapsed, 62.0F, 136.0F)
        End If
    End Sub

    Private Sub UpdateRibbonTabVisuals()
        For Each pair As KeyValuePair(Of String, Button) In _ribbonTabButtons
            Dim active As Boolean = String.Equals(pair.Key, _activeRibbonTab, StringComparison.OrdinalIgnoreCase)
            pair.Value.BackColor = If(active, Color.FromArgb(210, 235, 243), Color.White)
            pair.Value.ForeColor = If(active, Color.FromArgb(20, 95, 120), Color.FromArgb(65, 75, 82))
            pair.Value.FlatAppearance.BorderSize = If(active, 1, 0)
            pair.Value.FlatAppearance.BorderColor = Color.FromArgb(85, 155, 175)
        Next
    End Sub

