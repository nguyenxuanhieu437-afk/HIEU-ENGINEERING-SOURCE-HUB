    Private Sub ChangeReportClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _lastChangeSet Is Nothing Then
            If _activeSnapshot Is Nothing Then
                MessageBox.Show("Chưa có Snapshot/Change Set.", "CHANGE REPORT",
                                MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If
            _lastChangeSet = BomChangeManagementEngine.Compare(_activeSnapshot, _allItems)
        End If

        Using dlg As New SaveFileDialog()
            dlg.Title = "EXPORT CHANGE REPORT"
            dlg.Filter = "CSV (*.csv)|*.csv"
            dlg.FileName = "BOM_CHANGE_" & DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".csv"
            If dlg.ShowDialog(Me) <> DialogResult.OK Then Exit Sub
            Try
                Using sw As New System.IO.StreamWriter(dlg.FileName, False, System.Text.Encoding.UTF8)
                    sw.WriteLine("CHANGE,PART NUMBER,FILE,FIELD,OLD VALUE,NEW VALUE")
                    For Each c As BomChangeRecord In _lastChangeSet.Changes
                        sw.WriteLine(CsvChangeValue(c.Kind.ToString()) & "," &
                                     CsvChangeValue(c.PartNumber) & "," &
                                     CsvChangeValue(c.FileName) & "," &
                                     CsvChangeValue(c.FieldName) & "," &
                                     CsvChangeValue(c.OldValue) & "," &
                                     CsvChangeValue(c.NewValue))
                    Next
                End Using
                MessageBox.Show("Đã xuất Change Report:" & System.Environment.NewLine & dlg.FileName,
                                "CHANGE REPORT", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Catch ex As Exception
                BomLogger.Log("CHANGE", dlg.FileName, "Export Report", "ERROR", ex.Message)
                MessageBox.Show(ex.Message, "CHANGE REPORT", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Using
    End Sub

    Private Function CsvChangeValue(ByVal value As String) As String
        Dim s As String = If(value, "")
        Return """" & s.Replace("""", """""") & """"
    End Function

    Private Sub ShowDependencyImpact(ByVal focusImpact As Boolean)
        Dim item As PartBomItem = GetCurrentItem()
        If item Is Nothing Then
            MessageBox.Show("Hãy chọn một Part.", If(focusImpact, "IMPACT ANALYSIS", "WHERE USED 2.0"),
                            MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If

        Dim root As BomWhereUsedNode = Nothing
        Dim impact As BomImpactResult = Nothing
        If Not BomDependencyCache.TryGet(item, root, impact) Then
            root = BomWhereUsedEngine.BuildTree(item, _assemblyName)
            impact = BomWhereUsedEngine.AnalyzeImpact(item, _drawingIndex)
            BomDependencyCache.Put(item, root, impact)
        End If

        Using f As New BomDependencyForm(item, root, impact,
                                         AddressOf OpenDependencyDrawing,
                                         AddressOf LocateDependencyAssembly,
                                         AddressOf FilterBomByImpact)
            f.ShowDialog(Me)
        End Using
    End Sub

    Private Sub FilterBomByImpact(ByVal impact As BomImpactResult)
        If impact Is Nothing OrElse impact.Part Is Nothing Then Exit Sub
        Dim targetKey As String = BomDependencyCache.MakeKey(impact.Part)
        Grid.ClearSelection()
        Dim firstRow As Integer = -1
        For Each row As DataGridViewRow In Grid.Rows
            If row Is Nothing Then Continue For
            Dim rowItem As PartBomItem = TryCast(row.Tag, PartBomItem)
            If rowItem Is Nothing Then
                row.Visible = False
                Continue For
            End If
            Dim samePart As Boolean = String.Equals(BomDependencyCache.MakeKey(rowItem), targetKey, StringComparison.OrdinalIgnoreCase)
            row.Visible = samePart
            If samePart AndAlso firstRow < 0 Then firstRow = row.Index
        Next
        If firstRow >= 0 Then
            Try
                Grid.FirstDisplayedScrollingRowIndex = firstRow
                Grid.Rows(firstRow).Selected = True
            Catch
            End Try
        End If
    End Sub

    Private Sub OpenDependencyDrawing(ByVal drawingPath As String)
        If String.IsNullOrWhiteSpace(drawingPath) OrElse Not System.IO.File.Exists(drawingPath) Then
            MessageBox.Show("Không tìm thấy Drawing:" & System.Environment.NewLine & drawingPath,
                            "DRAWING DEPENDENCY", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Exit Sub
        End If
        Try
            _inventor.Documents.Open(drawingPath, True)
        Catch ex As Exception
            BomLogger.Log("DEPENDENCY", drawingPath, "Open Drawing", "ERROR", ex.Message)
            MessageBox.Show("Không mở được Drawing:" & System.Environment.NewLine & ex.Message,
                            "DRAWING DEPENDENCY", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub LocateDependencyAssembly(ByVal assemblyName As String)
        If String.IsNullOrWhiteSpace(assemblyName) Then Exit Sub
        For Each row As DataGridViewRow In Grid.Rows
            If row Is Nothing OrElse Not row.Visible Then Continue For
            Dim headerPath As String = TryCast(row.HeaderCell.Tag, String)
            If Not String.IsNullOrWhiteSpace(headerPath) Then
                Dim names() As String = headerPath.Trim().Trim("\"c).Split("\"c)
                If names.Length > 0 AndAlso String.Equals(names(names.Length - 1), assemblyName, StringComparison.OrdinalIgnoreCase) Then
                    Grid.ClearSelection()
                    row.Selected = True
                    If row.Cells.Count > 0 Then Grid.CurrentCell = row.Cells(0)
                    Try
                        Grid.FirstDisplayedScrollingRowIndex = row.Index
                    Catch
                    End Try
                    Exit Sub
                End If
            End If
        Next
        MessageBox.Show("Assembly này không có dòng đang hiển thị trong BOM hiện tại:" &
                        System.Environment.NewLine & assemblyName,
                        "LOCATE ASSEMBLY", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

    Private Sub ShowProjectIntelligenceText(ByVal title As String, ByVal content As String)
        Using f As New Form()
            f.Text = title
            f.StartPosition = FormStartPosition.CenterParent
            f.Width = 760
            f.Height = 620
            f.MinimizeBox = False
            f.MaximizeBox = True
            Dim box As New System.Windows.Forms.TextBox()
            box.Multiline = True
            box.ReadOnly = True
            box.ScrollBars = ScrollBars.Both
            box.WordWrap = False
            box.Dock = DockStyle.Fill
            box.Font = New Font("Consolas", 10.0F)
            box.Text = content
            f.Controls.Add(box)
            f.ShowDialog(Me)
        End Using
    End Sub


'####################################################################
' SUBSECTION 15.20 - OCCURRENCE LOOKUP / ASSEMBLY TRAVERSAL
'####################################################################

    Private Function GetSourceAssemblyDocument() As AssemblyDocument
        Try
            Dim sourceAsm As AssemblyDocument = Nothing
            Try
                sourceAsm = CType(_inventor.Documents.ItemByName(_assemblyPath), AssemblyDocument)
            Catch
            End Try
            If sourceAsm Is Nothing AndAlso System.IO.File.Exists(_assemblyPath) Then
                Try
                    sourceAsm = CType(_inventor.Documents.Open(_assemblyPath, True), AssemblyDocument)
                Catch
                End Try
            End If
            Return sourceAsm
        Catch
            Return Nothing
        End Try
    End Function

    Private Function GetTargetOccurrences() As List(Of ComponentOccurrence)
        Dim result As New List(Of ComponentOccurrence)()
        Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        Dim sourceAsm As AssemblyDocument = GetSourceAssemblyDocument()
        If sourceAsm Is Nothing Then Return result

        If Grid.CurrentRow IsNot Nothing AndAlso IsAssemblyHeaderRow(Grid.CurrentRow) Then
            Dim groupName As String = GetRowGroupName(Grid.CurrentRow)
            If String.Equals(groupName, _assemblyName, StringComparison.OrdinalIgnoreCase) Then
                For Each occ As ComponentOccurrence In sourceAsm.ComponentDefinition.Occurrences
                    AddUniqueOccurrence(result, seen, occ)
                Next
            Else
                CollectAssemblyOccurrences(sourceAsm.ComponentDefinition.Occurrences, groupName, result, seen)
            End If
        Else
            Dim selected As List(Of PartBomItem) = GetSelectedItems()
            For Each item As PartBomItem In selected
                If item Is Nothing OrElse item.Occurrences Is Nothing Then Continue For
                For Each occ As ComponentOccurrence In item.Occurrences
                    AddUniqueOccurrence(result, seen, occ)
                Next
            Next
        End If
        Return result
    End Function

    Private Sub AddUniqueOccurrence(ByVal result As List(Of ComponentOccurrence), ByVal seen As HashSet(Of String), ByVal occ As ComponentOccurrence)
        If occ Is Nothing Then Exit Sub
        Dim key As String = ""
        Try
            key = occ.Name & "|" & occ.GetHashCode().ToString()
        Catch
            key = Guid.NewGuid().ToString()
        End Try
        If seen.Add(key) Then result.Add(occ)
    End Sub

    Private Sub CollectAssemblyOccurrences(ByVal occurrences As ComponentOccurrences, ByVal targetAssemblyName As String, ByVal result As List(Of ComponentOccurrence), ByVal seen As HashSet(Of String))
        If occurrences Is Nothing Then Exit Sub
        For Each occ As ComponentOccurrence In occurrences
            Try
                If occ.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    Dim displayName As String = ""
                    Try
                        displayName = IOPath.GetFileNameWithoutExtension(occ.Definition.Document.FullFileName)
                    Catch
                        displayName = IOPath.GetFileNameWithoutExtension(occ.Name)
                    End Try
                    If String.Equals(displayName, targetAssemblyName, StringComparison.OrdinalIgnoreCase) Then
                        AddUniqueOccurrence(result, seen, occ)
                    ElseIf Not occ.Suppressed Then
                        CollectAssemblyOccurrences(occ.SubOccurrences, targetAssemblyName, result, seen)
                    End If
                End If
            Catch
            End Try
        Next
    End Sub

    Private Sub CollectAllOccurrences(ByVal occurrences As ComponentOccurrences, ByVal result As List(Of ComponentOccurrence))
        If occurrences Is Nothing Then Exit Sub
        For Each occ As ComponentOccurrence In occurrences
            result.Add(occ)
            Try
                If occ.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject AndAlso Not occ.Suppressed Then
                    CollectAllOccurrences(occ.SubOccurrences, result)
                End If
            Catch
            End Try
        Next
    End Sub


'####################################################################
' SUBSECTION 15.21 - INVENTOR UPDATE / SAVE / VISIBILITY / SUPPRESS
'####################################################################

    Private Sub InventorUpdateClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Inventor Update") Then Exit Sub
        Try
            Dim sourceAsm As AssemblyDocument = GetSourceAssemblyDocument()
            If sourceAsm Is Nothing Then Throw New Exception("Không tìm thấy Assembly nguồn đang mở.")
            sourceAsm.Activate()
            sourceAsm.Update2(True)
            StatusLoadTime.Text = "Inventor: Update hoàn tất " & DateTime.Now.ToString("HH:mm:ss")
        Catch ex As Exception
            MessageBox.Show("Không thể Update Assembly." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub InventorRebuildClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Inventor Rebuild") Then Exit Sub
        Try
            Dim sourceAsm As AssemblyDocument = GetSourceAssemblyDocument()
            If sourceAsm Is Nothing Then Throw New Exception("Không tìm thấy Assembly nguồn đang mở.")
            sourceAsm.Activate()
            sourceAsm.Rebuild2(True)
            StatusLoadTime.Text = "Inventor: Rebuild hoàn tất " & DateTime.Now.ToString("HH:mm:ss")
        Catch ex As Exception
            MessageBox.Show("Không thể Rebuild Assembly." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub InventorSaveAllClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Save All") Then Exit Sub
        Try
            Dim saved As Integer = 0
            Dim failed As Integer = 0
            For Each doc As Inventor.Document In _inventor.Documents
                Try
                    If doc.Dirty AndAlso Not String.IsNullOrWhiteSpace(doc.FullFileName) Then
                        doc.Save()
                        saved += 1
                    End If
                Catch
                    failed += 1
                End Try
            Next
            MessageBox.Show("Đã lưu: " & saved.ToString() & " document" & If(failed > 0, vbCrLf & "Không lưu được: " & failed.ToString(), ""), "SAVE ALL", MessageBoxButtons.OK, If(failed > 0, MessageBoxIcon.Warning, MessageBoxIcon.Information))
        Catch ex As Exception
            MessageBox.Show("Không thể Save All." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub ToggleOccurrenceVisibilityClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Visibility Change") Then Exit Sub
        Dim targets As List(Of ComponentOccurrence) = GetTargetOccurrences()
        If targets.Count = 0 Then
            MessageBox.Show("Hãy chọn Part hoặc Assembly cần Ẩn/Hiện.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Dim makeVisible As Boolean = False
        For Each occ As ComponentOccurrence In targets
            Try
                If Not occ.Visible Then makeVisible = True : Exit For
            Catch
            End Try
        Next
        For Each occ As ComponentOccurrence In targets
            Try
                If Not occ.Suppressed Then occ.Visible = makeVisible
            Catch
            End Try
        Next
        Try
            _inventor.ActiveView.Update()
        Catch
        End Try
    End Sub

    Private Sub SuppressOccurrencesClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Suppress") Then Exit Sub
        SetOccurrenceSuppression(True)
    End Sub

    Private Sub UnsuppressOccurrencesClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Unsuppress") Then Exit Sub
        SetOccurrenceSuppression(False)
    End Sub

    Private Sub SetOccurrenceSuppression(ByVal suppressValue As Boolean)
        Dim targets As List(Of ComponentOccurrence) = GetTargetOccurrences()
        If targets.Count = 0 Then
            MessageBox.Show("Hãy chọn Part hoặc Assembly cần xử lý.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Dim success As Integer = 0
        Dim failed As Integer = 0
        For Each occ As ComponentOccurrence In targets
            Try
                If suppressValue Then
                    If Not occ.Suppressed Then occ.Suppress()
                Else
                    If occ.Suppressed Then occ.Unsuppress()
                End If
                success += 1
            Catch
                failed += 1
            End Try
        Next
        StatusLoadTime.Text = If(suppressValue, "Suppress: ", "Unsuppress: ") & success.ToString() & If(failed > 0, " | Lỗi: " & failed.ToString(), "")
    End Sub


'####################################################################
' SUBSECTION 15.22 - ISOLATE / GROUND / HIGHLIGHT / ZOOM
'####################################################################

    Private Sub IsolateOccurrencesClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Isolate") Then Exit Sub
        Try
            Dim sourceAsm As AssemblyDocument = GetSourceAssemblyDocument()
            If sourceAsm Is Nothing Then Throw New Exception("Không tìm thấy Assembly nguồn.")
            Dim targets As List(Of ComponentOccurrence) = GetTargetOccurrences()
            If targets.Count = 0 Then Throw New Exception("Hãy chọn Part hoặc Assembly cần Isolate.")

            RestoreIsolationInternal()
            Dim targetSet As New HashSet(Of ComponentOccurrence)()
            For Each occ As ComponentOccurrence In targets
                targetSet.Add(occ)
            Next

            Dim allOcc As New List(Of ComponentOccurrence)()
            CollectAllOccurrences(sourceAsm.ComponentDefinition.Occurrences, allOcc)
            For Each occ As ComponentOccurrence In allOcc
                Try
                    _isolateOccurrences.Add(occ)
                    _isolateVisibility.Add(occ.Visible)
                    If Not occ.Suppressed Then occ.Visible = targetSet.Contains(occ)
                Catch
                End Try
            Next
            sourceAsm.Activate()
            Try
                _inventor.ActiveView.Fit()
            Catch
            End Try
            StatusLoadTime.Text = "Isolate: " & targets.Count.ToString() & " occurrence"
        Catch ex As Exception
            MessageBox.Show("Không thể Isolate." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub RestoreIsolationClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Restore Visibility") Then Exit Sub
        RestoreIsolationInternal()
        Try
            _inventor.ActiveView.Update()
        Catch
        End Try
    End Sub

    Private Sub RestoreIsolationInternal()
        If _isolateOccurrences.Count = 0 Then Exit Sub
        Dim count As Integer = Math.Min(_isolateOccurrences.Count, _isolateVisibility.Count)
        For i As Integer = 0 To count - 1
            Try
                Dim occ As ComponentOccurrence = _isolateOccurrences(i)
                If occ IsNot Nothing AndAlso Not occ.Suppressed Then occ.Visible = _isolateVisibility(i)
            Catch
            End Try
        Next
        _isolateOccurrences.Clear()
        _isolateVisibility.Clear()
        StatusLoadTime.Text = "Đã khôi phục hiển thị"
    End Sub

    Private Sub ToggleGroundedClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Ground/Unground") Then Exit Sub
        Dim targets As List(Of ComponentOccurrence) = GetTargetOccurrences()
        If targets.Count = 0 Then
            MessageBox.Show("Hãy chọn Part hoặc Assembly cần Ground/Unground.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Dim groundValue As Boolean = False
        For Each occ As ComponentOccurrence In targets
            Try
                If Not occ.Grounded Then groundValue = True : Exit For
            Catch
            End Try
        Next
        Dim success As Integer = 0
        For Each occ As ComponentOccurrence In targets
            Try
                occ.Grounded = groundValue
                success += 1
            Catch
            End Try
        Next
        StatusLoadTime.Text = If(groundValue, "Ground: ", "Unground: ") & success.ToString()
    End Sub

    Private Sub HighlightClicked(ByVal sender As Object, ByVal e As EventArgs)
        HighlightCurrent(False, False)
    End Sub

    Private Sub ZoomClicked(ByVal sender As Object, ByVal e As EventArgs)
        HighlightCurrent(True, False)
    End Sub

    Private Sub HighlightCurrent(ByVal zoomAfter As Boolean, ByVal silent As Boolean)
        If _syncingSelection Then Exit Sub
        Try
            _syncingSelection = True
            Dim sourceAsm As AssemblyDocument = GetSourceAssemblyDocument()
            If sourceAsm Is Nothing Then
                If Not silent Then MessageBox.Show("Assembly nguồn hiện không mở.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If

            Try : sourceAsm.Activate() : Catch : End Try
            ClearBomHighlight(sourceAsm)
            Try : sourceAsm.SelectSet.Clear() : Catch : End Try

            Dim selectedOccurrences As New List(Of ComponentOccurrence)()
            Dim selectedRows As New List(Of DataGridViewRow)()
            For Each row As DataGridViewRow In Grid.SelectedRows
                If row IsNot Nothing AndAlso row.Visible Then selectedRows.Add(row)
            Next
            If selectedRows.Count = 0 AndAlso Grid.CurrentRow IsNot Nothing Then selectedRows.Add(Grid.CurrentRow)

            For Each row As DataGridViewRow In selectedRows
                If IsAssemblyHeaderRow(row) Then
                    Dim groupName As String = GetRowGroupName(row)
                    CollectAssemblyOccurrences(sourceAsm.ComponentDefinition.Occurrences, groupName, selectedOccurrences)
                Else
                    Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                    If item Is Nothing Then Continue For
                    CollectItemOccurrences(sourceAsm, item, selectedOccurrences)
                End If
            Next

            Dim unique As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            For Each occ As ComponentOccurrence In selectedOccurrences
                If occ Is Nothing Then Continue For
                Try
                    If occ.Suppressed Then Continue For
                    Dim key As String = occ.Name
                    Try
                        Dim keyDoc As Inventor.Document = occ.ReferencedDocumentDescriptor.ReferencedDocument
                        If keyDoc IsNot Nothing Then key &= "|" & keyDoc.FullFileName
                    Catch
                    End Try
                    If unique.Contains(key) Then Continue For
                    unique.Add(key)
                    Try : sourceAsm.SelectSet.Select(occ) : Catch : End Try
                    AddOccurrenceToBomHighlight(sourceAsm, occ)
                Catch
                End Try
            Next

            If sourceAsm.SelectSet.Count = 0 Then
                If Not silent Then MessageBox.Show("Không tìm thấy đối tượng tương ứng trong Assembly nguồn.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If

            If zoomAfter Then
                Try : _inventor.CommandManager.ControlDefinitions.Item("AppZoomSelectCmd").Execute() : Catch : End Try
            End If
            StatusSelection.Text = "Đã chọn " & sourceAsm.SelectSet.Count.ToString() & " occurrence trong Inventor"
        Catch ex As Exception
            If Not silent Then MessageBox.Show("Không thể Highlight đối tượng." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            _syncingSelection = False
        End Try
    End Sub

    Private Sub ClearBomHighlight(ByVal sourceAsm As AssemblyDocument)
        Try
            If _bomHighlightSet IsNot Nothing Then _bomHighlightSet.Clear()
        Catch
            _bomHighlightSet = Nothing
        End Try
        If _bomHighlightSet Is Nothing AndAlso sourceAsm IsNot Nothing Then
            Try
                _bomHighlightSet = sourceAsm.CreateHighlightSet()
                Try : _bomHighlightSet.Color = _inventor.TransientObjects.CreateColor(255, 80, 40) : Catch : End Try
            Catch
                _bomHighlightSet = Nothing
            End Try
        End If
    End Sub

    Private Sub AddOccurrenceToBomHighlight(ByVal sourceAsm As AssemblyDocument, ByVal occ As ComponentOccurrence)
        Try
            If _bomHighlightSet Is Nothing Then ClearBomHighlight(sourceAsm)
            If _bomHighlightSet IsNot Nothing Then _bomHighlightSet.AddItem(occ)
        Catch
        End Try
    End Sub

    Private Sub CollectItemOccurrences(ByVal sourceAsm As AssemblyDocument, ByVal item As PartBomItem, ByVal result As List(Of ComponentOccurrence))
        If item Is Nothing Then Exit Sub
        If _highlightAllOccurrences Then
            SelectMatchingOccurrencesToList(sourceAsm.ComponentDefinition.Occurrences, item.FilePath, result)
        ElseIf item.Occurrences IsNot Nothing AndAlso item.Occurrences.Count > 0 Then
            result.Add(item.Occurrences(0))
        Else
            SelectMatchingOccurrencesToList(sourceAsm.ComponentDefinition.Occurrences, item.FilePath, result, 1)
        End If
    End Sub

    Private Sub CollectAssemblyOccurrences(ByVal occurrences As ComponentOccurrences, ByVal targetAssemblyName As String, ByVal result As List(Of ComponentOccurrence))
        For Each occ As ComponentOccurrence In occurrences
            Try
                If occ.Suppressed Then Continue For
                Dim doc As Inventor.Document = Nothing
                Try : doc = occ.ReferencedDocumentDescriptor.ReferencedDocument : Catch : Try : doc = occ.Definition.Document : Catch : End Try : End Try
                If doc Is Nothing Then Continue For
                If String.Equals(targetAssemblyName, _assemblyName, StringComparison.OrdinalIgnoreCase) Then
                    result.Add(occ)
                ElseIf doc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    Dim docName As String = GetDocumentPartNumberOrFileName(doc)
                    Dim fileNameOnly As String = IOPath.GetFileNameWithoutExtension(doc.FullFileName)
                    If String.Equals(docName, targetAssemblyName, StringComparison.OrdinalIgnoreCase) OrElse String.Equals(fileNameOnly, targetAssemblyName, StringComparison.OrdinalIgnoreCase) Then
                        result.Add(occ)
                    Else
                        CollectAssemblyOccurrences(occ.SubOccurrences, targetAssemblyName, result)
                    End If
                End If
            Catch
            End Try
        Next
    End Sub

    Private Sub SelectMatchingOccurrencesToList(ByVal occurrences As ComponentOccurrences, ByVal targetPath As String, ByVal result As List(Of ComponentOccurrence), Optional ByVal maxCount As Integer = 0)
        For Each occ As ComponentOccurrence In occurrences
            If maxCount > 0 AndAlso result.Count >= maxCount Then Exit Sub
            Try
                If occ.Suppressed Then Continue For
                Dim doc As Inventor.Document = Nothing
                Try : doc = occ.ReferencedDocumentDescriptor.ReferencedDocument : Catch : Try : doc = occ.Definition.Document : Catch : End Try : End Try
                If doc Is Nothing Then Continue For
                If String.Equals(doc.FullFileName, targetPath, StringComparison.OrdinalIgnoreCase) Then
                    result.Add(occ)
                    If maxCount > 0 AndAlso result.Count >= maxCount Then Exit Sub
                End If
                If doc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    SelectMatchingOccurrencesToList(occ.SubOccurrences, targetPath, result, maxCount)
                End If
            Catch
            End Try
        Next
    End Sub

    Private Sub SyncFromInventorClicked(ByVal sender As Object, ByVal e As EventArgs)
        SyncBomSelectionFromInventor(True)
    End Sub

    Private Sub InventorSyncTimerTick(ByVal sender As Object, ByVal e As EventArgs)
        If Not _syncInventorToBom OrElse _syncingSelection Then Exit Sub
        SyncBomSelectionFromInventor(False)
    End Sub

    Private Sub SyncBomSelectionFromInventor(ByVal force As Boolean)
        Try
            Dim sourceAsm As AssemblyDocument = GetSourceAssemblyDocument()
            If sourceAsm Is Nothing OrElse sourceAsm.SelectSet.Count = 0 Then Exit Sub
            Dim keys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            For Each selectedObject As Object In sourceAsm.SelectSet
                Dim occ As ComponentOccurrence = TryCast(selectedObject, ComponentOccurrence)
                If occ Is Nothing Then Continue For
                Dim doc As Inventor.Document = Nothing
                Try : doc = occ.ReferencedDocumentDescriptor.ReferencedDocument : Catch : Try : doc = occ.Definition.Document : Catch : End Try : End Try
                If doc IsNot Nothing AndAlso Not String.IsNullOrEmpty(doc.FullFileName) Then keys.Add(doc.FullFileName)
            Next
            If keys.Count = 0 Then Exit Sub
            Dim signatureBuilder As New StringBuilder()
            For Each keyValue As String In keys
                signatureBuilder.Append(keyValue).Append("|")
            Next
            Dim signature As String = signatureBuilder.ToString()
            If Not force AndAlso String.Equals(signature, _lastInventorSelectionKey, StringComparison.OrdinalIgnoreCase) Then Exit Sub
            _lastInventorSelectionKey = signature

            _syncingSelection = True
            Grid.ClearSelection()
            Dim firstRow As DataGridViewRow = Nothing
            For Each row As DataGridViewRow In Grid.Rows
                Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                If item IsNot Nothing AndAlso keys.Contains(item.FilePath) Then
                    row.Selected = True
                    If firstRow Is Nothing Then firstRow = row
                End If
            Next
            If firstRow IsNot Nothing Then
                Grid.CurrentCell = firstRow.Cells(0)
                Try : Grid.FirstDisplayedScrollingRowIndex = Math.Max(0, firstRow.Index - 2) : Catch : End Try
                UpdatePreviewFromCurrentRow()
                StatusSelection.Text = "Inventor → BOM: " & Grid.SelectedRows.Count.ToString() & " dòng"
            End If
        Catch
        Finally
            _syncingSelection = False
        End Try
    End Sub



    Private Function BuildRegistryContextMenu(ByVal target As String) As ContextMenuStrip
        Dim menu As New ContextMenuStrip()
        Dim groups As New Dictionary(Of String, ToolStripMenuItem)(StringComparer.OrdinalIgnoreCase)
        For Each cmd As BomCommandDefinition In BomCommandRegistry.AllCommands()
            If String.IsNullOrWhiteSpace(cmd.ContextTarget) OrElse Not String.Equals(cmd.ContextTarget, target, StringComparison.OrdinalIgnoreCase) Then Continue For
            Dim groupName As String = If(String.IsNullOrWhiteSpace(cmd.ContextGroup), "OTHER", cmd.ContextGroup)
            Dim parent As ToolStripMenuItem = Nothing
            If Not groups.TryGetValue(groupName, parent) Then
                parent = New ToolStripMenuItem(groupName)
                groups(groupName) = parent : menu.Items.Add(parent)
            End If
            Dim child As New ToolStripMenuItem(cmd.Caption)
            child.Tag = cmd : child.Enabled = Not (_safeMode AndAlso cmd.IsWriteOperation)
            If cmd.Handler IsNot Nothing Then AddHandler child.Click, cmd.Handler
            parent.DropDownItems.Add(child)
        Next
        Return menu
    End Function

    Private Function EnsureWriteAllowed(ByVal operationName As String,
                                        Optional ByVal commandType As BomCommandType = BomCommandType.WriteCommand) As Boolean
        If BomWriteGuard.EnsureWriteAllowed(_safeMode, operationName, commandType) Then Return True
        ShowSafeModeNotice(operationName)
        Return False
    End Function

    Private Sub PersistPendingTransaction()
        Try
            BomPendingTransactionStore.Save(_pendingRecoveryFile, _assemblyPath, _pendingTransaction)
        Catch ex As Exception
            BomLogger.Warn("RECOVERY", "Persist pending failed: " & ex.Message)
        End Try
    End Sub

    Private Function ResolvePropertyInfo(ByVal propertyKey As String, ByVal propertyName As String) As PropertyColumnInfo
        For Each p As PropertyColumnInfo In _selectedProperties
            If p Is Nothing Then Continue For
            If String.Equals(p.Key, propertyKey, StringComparison.OrdinalIgnoreCase) Then Return p
            If Not String.IsNullOrWhiteSpace(propertyName) AndAlso String.Equals(p.PropertyName, propertyName, StringComparison.OrdinalIgnoreCase) Then Return p
        Next
        'Recovery cho native/model setting.
        If Not String.IsNullOrWhiteSpace(propertyKey) AndAlso propertyKey.StartsWith(SystemSettingSetInternalName & "||", StringComparison.OrdinalIgnoreCase) Then
            Dim settingId As String = propertyKey.Substring((SystemSettingSetInternalName & "||").Length)
            Dim p As PropertyColumnInfo = MakeSystemSetting(settingId, If(String.IsNullOrWhiteSpace(propertyName), settingId, propertyName))
            Return p
        End If

        'Recovery cho Custom iProperty được tạo trực tiếp trong BOM nhưng chưa Commit trước khi đóng/crash.
        If Not String.IsNullOrWhiteSpace(propertyName) AndAlso Not String.IsNullOrWhiteSpace(propertyKey) Then
            Dim customPrefix As String = "{D5CDD505-2E9C-101B-9397-08002B2CF9AE}||"
            If propertyKey.StartsWith(customPrefix, StringComparison.OrdinalIgnoreCase) Then
                Dim p As New PropertyColumnInfo()
                p.PropertySetInternalName = "{D5CDD505-2E9C-101B-9397-08002B2CF9AE}"
                p.PropertySetDisplayName = "User Defined Properties"
                p.PropertyName = propertyName.Trim()
                p.Key = BuildPropertyKey(p.PropertySetInternalName, p.PropertyName)
                p.DisplayText = BuildPropertyDisplayText(p.PropertySetDisplayName, p.PropertyName)
                p.IsVirtualCustom = True
                Return p
            End If
        End If
        Return Nothing
    End Function

    Private Sub RestorePendingTransactionIfAvailable()
        If String.IsNullOrWhiteSpace(_pendingRecoveryFile) OrElse Not System.IO.File.Exists(_pendingRecoveryFile) Then Exit Sub
        Dim storedAssembly As String = ""
        Dim txName As String = ""
        Dim created As DateTime = DateTime.MinValue
        Dim recovered As List(Of BomPropertyChange) = BomPendingTransactionStore.Load(_pendingRecoveryFile, storedAssembly, txName, created)
        If recovered.Count = 0 Then Exit Sub
        If Not String.Equals(storedAssembly, _assemblyPath, StringComparison.OrdinalIgnoreCase) Then Exit Sub

        Dim valid As New List(Of BomPropertyChange)()
        For Each ch As BomPropertyChange In recovered
            Dim propertyName As String = ch.ErrorMessage
            ch.ErrorMessage = ""
            ch.PropertyInfo = ResolvePropertyInfo(ch.PropertyKey, propertyName)
            Dim item As PartBomItem = FindItemByDocumentKey(ch.DocumentKey)
            If item Is Nothing AndAlso Not String.IsNullOrWhiteSpace(ch.DocumentPath) Then
                For Each candidate As PartBomItem In _allItems
                    If candidate IsNot Nothing AndAlso String.Equals(candidate.FilePath, ch.DocumentPath, StringComparison.OrdinalIgnoreCase) Then
                        item = candidate
                        Exit For
                    End If
                Next
            End If
            If item Is Nothing OrElse ch.PropertyInfo Is Nothing OrElse (Not String.IsNullOrWhiteSpace(ch.DocumentPath) AndAlso Not System.IO.File.Exists(ch.DocumentPath)) Then
                ch.Status = "CONFLICT"
                ch.ErrorMessage = "Document/Property không còn khả dụng."
            Else
                Dim currentValue As String = ""
                Try
                    currentValue = Convert.ToString(ReadSinglePropertyValue(item.Document, ch.PropertyInfo))
                Catch ex As Exception
                    ch.Status = "CONFLICT"
                    ch.ErrorMessage = "Không đọc được Current Value: " & ex.Message
                End Try
                If ch.Status <> "CONFLICT" AndAlso Not String.Equals(currentValue, ch.OldValue, StringComparison.Ordinal) Then
                    ch.Status = "CONFLICT"
                    ch.ErrorMessage = "Current value đã thay đổi: " & currentValue
                ElseIf ch.Status <> "CONFLICT" Then
                    ch.Status = "READY"
                End If
            End If
            valid.Add(ch)
        Next

        Using f As New BomRecoveryForm(valid, created)
            Dim answer As DialogResult = f.ShowDialog(Me)
            If answer = DialogResult.OK AndAlso f.RestoreRequested Then
                _pendingTransaction = New BomTransaction()
                _pendingTransaction.Name = If(String.IsNullOrWhiteSpace(txName), "RECOVERED BOM EDIT", txName)
                _pendingTransaction.CreatedAt = If(created = DateTime.MinValue, DateTime.Now, created)
                For Each ch As BomPropertyChange In valid
                    If ch.Status = "READY" Then
                        ch.Status = "PENDING"
                        _pendingTransaction.Changes.Add(ch)
                    End If
                Next
                ApplyPendingVisualsFromTransaction()
                PersistPendingTransaction()
            ElseIf f.DiscardRequested Then
                BomPendingTransactionStore.Delete(_pendingRecoveryFile)
            End If
        End Using
    End Sub

    Private Function ReadSinglePropertyValue(ByVal doc As Inventor.Document, ByVal propertyInfo As PropertyColumnInfo) As Object
        If doc Is Nothing OrElse propertyInfo Is Nothing Then Return ""
        Try
            Dim setObj As Inventor.PropertySet = Nothing
            Try
                setObj = doc.PropertySets.Item(propertyInfo.PropertySetInternalName)
            Catch
                setObj = doc.PropertySets.Item(propertyInfo.PropertySetDisplayName)
            End Try
            If setObj Is Nothing Then Return ""
            Dim prop As Inventor.Property = Nothing
            Try
                prop = setObj.Item(propertyInfo.PropertyName)
            Catch
                Return ""
            End Try
            If prop Is Nothing OrElse prop.Value Is Nothing Then Return ""
            Return prop.Value
        Catch
            Return ""
        End Try
    End Function

    Private Sub ApplyPendingVisualsFromTransaction()
        For Each ch As BomPropertyChange In _pendingTransaction.Changes
            Dim item As PartBomItem = FindItemByDocumentKey(ch.DocumentKey)
            If item Is Nothing OrElse ch.PropertyInfo Is Nothing Then Continue For
            For Each row As DataGridViewRow In Grid.Rows
                Dim rowItem As PartBomItem = TryCast(row.Tag, PartBomItem)
                If rowItem Is Nothing OrElse Not String.Equals(rowItem.DocumentKey, ch.DocumentKey, StringComparison.OrdinalIgnoreCase) Then Continue For
                For Each col As DataGridViewColumn In Grid.Columns
                    Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                    If pi IsNot Nothing AndAlso String.Equals(pi.Key, ch.PropertyKey, StringComparison.OrdinalIgnoreCase) Then
                        row.Cells(col.Index).Value = ch.NewValue
                        row.Cells(col.Index).Style.BackColor = Color.FromArgb(255, 248, 200)
                        row.Cells(col.Index).ToolTipText = "RECOVERED PENDING | " & ch.OldValue & " -> " & ch.NewValue
                        Exit For
                    End If
                Next
            Next
        Next
        UpdatePendingCaption()
    End Sub

    Private Sub DiscardSpecificPendingChanges(ByVal changes As List(Of BomPropertyChange))
        If changes Is Nothing OrElse changes.Count = 0 Then Exit Sub
        For Each ch As BomPropertyChange In New List(Of BomPropertyChange)(changes)
            _pendingTransaction.Changes.Remove(ch)
        Next
        _pendingTransaction.Status = If(_pendingTransaction.Changes.Count > 0, "PENDING", "EMPTY")
        LoadRows()
        ApplyPendingVisualsFromTransaction()
        PersistPendingTransaction()
        UpdatePendingCaption()
    End Sub

