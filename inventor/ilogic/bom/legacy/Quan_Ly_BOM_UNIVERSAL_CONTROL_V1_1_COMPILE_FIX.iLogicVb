' ============================================================================
' EMBEDDED SOURCE MODULE: balloon-update Beta
' Disabled reference source retained inside MASTER for controlled integration.
' ============================================================================
'SRC> '##########################
'SRC> '###   Balloon Update   ###
'SRC> '##########################
'SRC> 
'SRC> Sub Main()
'SRC> 
'SRC> 	Dim doc As Inventor.Document = ThisDoc.Document
'SRC> 	Guard.OnlyDrawingDocuments(doc, "This tool is not compatible with this type of file.  Please run from a drawing.")
'SRC> 	FixItemNumbers
'SRC> 
'SRC> End Sub 'Main()'
'SRC> 
'SRC> Sub FixItemNumbers()
'SRC> 
'SRC> 	Dim doc As Inventor.DrawingDocument = ThisDoc.Document
'SRC> 	Dim drawingBoms As Inventor.DrawingBOMs = doc.DrawingBOMs
'SRC> 	Dim drawingBom As Inventor.DrawingBOM
'SRC> 	Dim drawingBomRow As DrawingBOMRow
'SRC> 	Dim bomRow As Inventor.BOMRow
'SRC> 	Dim stockNumber As String
'SRC> 	
'SRC> 	For Each drawingBom In drawingBoms
'SRC> 
'SRC> 		For Each drawingBomRow In drawingBom.DrawingBOMRows
'SRC> 			
'SRC> 			bomRow = drawingBomRow.BOMRow
'SRC> 			stockNumber = GetStockNumber(bomRow)
'SRC> 			Try
'SRC> 				If (IsFabricatedPart(stockNumber)) Then
'SRC> 					bomRow.ItemNumber = GetSheetView(bomRow)
'SRC> 				End If
'SRC> 			Catch
'SRC> 			End Try
'SRC> 		Next
'SRC> 	Next
'SRC> 	
'SRC> End Sub
'SRC> 
'SRC> 
'SRC> Public Function GetStockNumber(ByRef bomRow As Inventor.BOMRow)
'SRC> 
'SRC> 	Dim doc As Inventor.Document = bomRow.ComponentDefinitions(1).Document
'SRC> 	Return PropertyShim.GetProperty(doc, "Stock Number")
'SRC> 
'SRC> End Function
'SRC> 
'SRC> Public Function GetSheetView(ByRef BOMRow As Inventor.BOMRow)
'SRC> 
'SRC> 	Dim doc As Inventor.Document = BOMRow.ComponentDefinitions(1).Document
'SRC> 	Return PropertyShim.GetProperty(doc, "Sheet") & PropertyShim.GetProperty(doc, "View")
'SRC> 
'SRC> End Function
'SRC> 
'SRC> 
'SRC> Public Function IsFabricatedPart(ByRef input As String) As Boolean
'SRC>         Return Text.RegularExpressions.Regex.IsMatch(If(input,"error"), "\b\d{3,4}\-[0123456789]\d\d[a-z|A-Z]*\b")
'SRC> End Function
'SRC> 
'SRC> 
'SRC> Public Class Guard
'SRC> 
'SRC>     Shared Sub OnlyDrawingDocuments(doc As Inventor.Document, message As String)
'SRC>         Dim tempDocument As Inventor.DrawingDocument
'SRC>         Try
'SRC>             tempDocument = doc
'SRC>         Catch ex As Exception
'SRC>             Throw New SystemException(message)
'SRC>         End Try
'SRC>     End Sub
'SRC> 
'SRC> End Class
'SRC> 
'SRC> 
'SRC> Public Class PropertyShim
'SRC> 
'SRC>         Shared ReadOnly PropertyLookup As Dictionary(Of String, String) = New Dictionary(Of String,String)(StringComparer.OrdinalIgnoreCase) From 
'SRC>         {{"Title", "Inventor Summary Information"},
'SRC>         {"Subject", "Inventor Summary Information"},
'SRC>         {"Author", "Inventor Summary Information"},
'SRC>         {"Keywords", "Inventor Summary Information"},
'SRC>         {"Comments", "Inventor Summary Information"},
'SRC>         {"Last Saved By", "Inventor Summary Information"},
'SRC>         {"Revision Number", "Inventor Summary Information"},
'SRC>         {"Thumbnail", "Inventor Summary Information"},
'SRC>         {"Category","Inventor Document Summary Information"},
'SRC>         {"Manager","Inventor Document Summary Information"},
'SRC>         {"Company","Inventor Document Summary Information"},
'SRC>         {"Creation Time","Design Tracking Properties"},
'SRC>         {"Part Number","Design Tracking Properties"},
'SRC>         {"Project","Design Tracking Properties"},
'SRC>         {"Cost Center","Design Tracking Properties"},
'SRC>         {"Checked By","Design Tracking Properties"},
'SRC>         {"Date Checked","Design Tracking Properties"},
'SRC>         {"Engr Approved By","Design Tracking Properties"},
'SRC>         {"Engr Date Approved","Design Tracking Properties"},
'SRC>         {"User Status","Design Tracking Properties"},
'SRC>         {"Material","Design Tracking Properties"},
'SRC>         {"Part Property Revision Id","Design Tracking Properties"},
'SRC>         {"Catalog Web Link","Design Tracking Properties"},
'SRC>         {"Part Icon","Design Tracking Properties"},
'SRC>         {"Description","Design Tracking Properties"},
'SRC>         {"Vendor","Design Tracking Properties"},
'SRC>         {"Document SubType","Design Tracking Properties"},
'SRC>         {"Document SubType Name","Design Tracking Properties"},
'SRC>         {"Proxy Refresh Date","Design Tracking Properties"},
'SRC>         {"Mfg Approved By","Design Tracking Properties"},
'SRC>         {"Mfg Date Approved","Design Tracking Properties"},
'SRC>         {"Cost","Design Tracking Properties"},
'SRC>         {"Standard","Design Tracking Properties"},
'SRC>         {"Design Status","Design Tracking Properties"},
'SRC>         {"Designer","Design Tracking Properties"},
'SRC>         {"Engineer","Design Tracking Properties"},
'SRC>         {"Authority","Design Tracking Properties"},
'SRC>         {"Parameterized Template","Design Tracking Properties"},
'SRC>         {"Template Row","Design Tracking Properties"},
'SRC>         {"External Property Revision Id","Design Tracking Properties"},
'SRC>         {"Standard Revision","Design Tracking Properties"},
'SRC>         {"Manufacturer","Design Tracking Properties"},
'SRC>         {"Standards Organization","Design Tracking Properties"},
'SRC>         {"Language","Design Tracking Properties"},
'SRC>         {"Defer Updates","Design Tracking Properties"},
'SRC>         {"Size Designation","Design Tracking Properties"},
'SRC>         {"Categories","Design Tracking Properties"},
'SRC>         {"Stock Number","Design Tracking Properties"},
'SRC>         {"Weld Material","Design Tracking Properties"},
'SRC>         {"Mass","Design Tracking Properties"},
'SRC>         {"SurfaceArea","Design Tracking Properties"},
'SRC>         {"Volume","Design Tracking Properties"},
'SRC>         {"Density","Design Tracking Properties"},
'SRC>         {"Valid MassProps","Design Tracking Properties"},
'SRC>         {"Flat Pattern Width","Design Tracking Properties"},
'SRC>         {"Flat Pattern Length","Design Tracking Properties"},
'SRC>         {"Flat Pattern Area","Design Tracking Properties"},
'SRC>         {"Sheet Metal Rule","Design Tracking Properties"},
'SRC>         {"Last Updated With","Design Tracking Properties"},
'SRC>         {"Sheet Metal Width","Design Tracking Properties"},
'SRC>         {"Sheet Metal Length","Design Tracking Properties"},
'SRC>         {"Sheet Metal Area","Design Tracking Properties"},
'SRC>         {"Material Identifier","Design Tracking Properties"},
'SRC>         {"Appearance","Design Tracking Properties"},
'SRC>         {"Flat Pattern Defer Update","Design Tracking Properties"}}
'SRC> 
'SRC>         Public Shared PropertySetLookup As HashSet(Of String) = New HashSet(Of String) From {
'SRC>             "Inventor Summary Information",
'SRC>             "Inventor Document Summary Information",
'SRC>             "Design Tracking Properties",
'SRC>             "Inventor User Defined Properties"
'SRC>         }
'SRC> 
'SRC>         ''' <summary>
'SRC>         ''' Return the specified document property's value. This is the short form of this function.
'SRC>         ''' Only requires a document and property propertyName. 
'SRC>         ''' </summary>
'SRC>         ''' <param name="doc">Inventor Document</param>
'SRC>         ''' <param name="propertyName">Name of the Property</param>
'SRC>         ''' <returns></returns>
'SRC>         Shared Function GetProperty(ByRef doc As Inventor.Document, ByVal propertyName As String) As Object
'SRC> 
'SRC>             Dim setName As String
'SRC>             Dim documentPropertySets As Inventor.PropertySets = doc.PropertySets
'SRC>             'Get propertySet for provided propertyName (if exists)
'SRC>             If PropertyLookup.TryGetValue(propertyName, setName) Then
'SRC>                 Return documentPropertySets.Item(setName).Item(propertyName).Value
'SRC>             End If
'SRC> 
'SRC>             'Not found in standard properties, search custom properties
'SRC>             Dim currentPropertySet As Inventor.PropertySet = documentPropertySets.Item("Inventor User Defined Properties")
'SRC>             Try
'SRC>                 Return currentPropertySet.Item(propertyName).Value
'SRC>             Catch
'SRC>             End Try
'SRC> 
'SRC>             'Still not found, search other custom property sets!
'SRC>             If documentPropertySets.Count >= PropertySetLookup.Count Then
'SRC>                 For Each currentPropertySet In doc.PropertySets
'SRC>                     If PropertySetLookup.Contains(currentPropertySet.DisplayName)
'SRC>                         Return ""
'SRC>                     End If
'SRC> 
'SRC>                     Try
'SRC>                         Return currentPropertySet.Item(propertyName).Value
'SRC>                     Catch ex As Exception
'SRC>                         Return ""
'SRC>                     End Try
'SRC>                 Next
'SRC>             End If
'SRC> 
'SRC>             'Still not found, return nothing...
'SRC>             Return ""
'SRC> 
'SRC>         End Function
'SRC> 
'SRC>         Shared Function GetProperty(ByRef doc As Inventor.Document, ByVal setName As String, ByVal propertyName As String) As Object
'SRC> 
'SRC>             Dim documentPropertySets As Inventor.PropertySets = doc.PropertySets
'SRC>             Try
'SRC>                 Dim currentPropertySet As Inventor.PropertySet = documentPropertySets.Item(setName)
'SRC>                 Dim currentProperty As Inventor.Property = currentPropertySet.Item(propertyName)
'SRC>                 Return currentProperty.Value
'SRC>             Catch ex As Exception
'SRC>                 Return ""
'SRC>             End Try
'SRC> 
'SRC>         End Function
'SRC>     Shared Sub SetProperty(ByRef doc As Inventor.Document, ByVal propertyName As String, ByVal value As Object)
'SRC>         
'SRC>         Dim setName As String
'SRC>         Dim documentPropertySets As Inventor.PropertySets = doc.PropertySets
'SRC> 
'SRC>         'If the property exists as a built-in property, set the value
'SRC>         If PropertyLookup.TryGetValue(propertyName, setName) Then
'SRC>             Try
'SRC>                 documentPropertySets.Item(setName).Item(propertyName).Value = value
'SRC>                 Exit Sub
'SRC>             Catch
'SRC>             End Try
'SRC>             
'SRC>         End If
'SRC> 
'SRC>         'Not found in standard properties, search custom properties
'SRC>         Dim currentPropertySet As Inventor.PropertySet = documentPropertySets.Item("Inventor User Defined Properties")
'SRC>             Try
'SRC>                 currentPropertySet.Item(propertyName).Value = value
'SRC>                 Exit Sub
'SRC>             Catch
'SRC>                 currentPropertySet.Add(value, propertyname)
'SRC>             End Try
'SRC>     End Sub
'SRC> 
'SRC>     Shared Function CustomPropertyExists(currentPropertySet As Inventor.PropertySet, propertyName As String)
'SRC> 
'SRC>         Dim a As Object
'SRC>         Try
'SRC>             a = currentPropertySet.Name(propertyName)
'SRC>             Return True
'SRC>         Catch
'SRC>             Return False
'SRC>         End Try
'SRC>     End Function
'SRC> 
'SRC>     Shared Function PropertySetExists(ByRef doc As Inventor.Document, ByVal propertySetName As String)
'SRC>         For Each PropertySet In doc.PropertySets
'SRC>             If String.Equals(PropertySet.Name, propertySetName, StringComparison.OrdinalIgnoreCase)
'SRC>                 Return True
'SRC>             End If
'SRC>         Next
'SRC>         Return False
'SRC>     End Function
'SRC> 
'SRC>         Shared Sub SetProperty(ByRef doc As Inventor.Document, ByVal propertySetName As String, ByVal propertyName As String, ByVal value As Object)
'SRC>             
'SRC>             Dim documentPropertySets As Inventor.PropertySets = doc.PropertySets
'SRC>             'If the property set exists, set the value, or add it if needed
'SRC>             If PropertySetExists(doc, propertySetName) Then
'SRC>                 Try
'SRC>                     documentPropertySets.Item(propertySetName).Item(propertyName).Value = value
'SRC>                     Exit Sub
'SRC>                 Catch
'SRC>                     documentPropertySets.Item(propertySetName).Add(value, propertyname)
'SRC>                 End Try
'SRC>             
'SRC>             Else
'SRC> 
'SRC>                 'Create the property set, then the property
'SRC>                 Try
'SRC>                     documentPropertySets.Add(propertySetName)
'SRC>                     documentPropertySets.Item(propertySetName).Add(value, propertyname)
'SRC>                 Catch ex As Exception
'SRC> 
'SRC>                 End Try
'SRC>             
'SRC>             End If
'SRC>         End Sub
'SRC> End Class

