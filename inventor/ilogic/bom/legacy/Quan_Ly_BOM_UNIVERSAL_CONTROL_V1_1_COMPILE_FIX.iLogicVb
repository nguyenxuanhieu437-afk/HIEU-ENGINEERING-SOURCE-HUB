' SUBSECTION 15.11 - PROPERTY COMMANDS / SAVE / DASHBOARD / CHECK
'####################################################################

    Private Sub BeginEditPropertyClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Edit Property") Then Exit Sub
        If Grid.CurrentCell Is Nothing Then Exit Sub
        If Grid.CurrentRow Is Nothing OrElse Grid.CurrentRow.Tag Is Nothing Then Exit Sub
        If Grid.CurrentCell.OwningColumn.ReadOnly Then
            MessageBox.Show("Cột này không phải iProperty có thể chỉnh sửa.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Grid.BeginEdit(True)
    End Sub

    Private Sub AddPropertiesClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim propertyDictionary As New Dictionary(Of String, PropertyColumnInfo)(StringComparer.OrdinalIgnoreCase)
        Me.Cursor = System.Windows.Forms.Cursors.WaitCursor
        Try
            For Each item As PartBomItem In _allItems
                If item.Document IsNot Nothing Then ScanDocumentPropertyNames(item.Document, propertyDictionary)
            Next
        Finally
            Me.Cursor = System.Windows.Forms.Cursors.Default
        End Try

        Dim available As New List(Of PropertyColumnInfo)()
        For Each pair As KeyValuePair(Of String, PropertyColumnInfo) In propertyDictionary
            Dim alreadySelected As Boolean = False
            For Each selected As PropertyColumnInfo In _selectedProperties
                If String.Equals(selected.Key, pair.Key, StringComparison.OrdinalIgnoreCase) Then alreadySelected = True : Exit For
            Next
            If Not alreadySelected Then available.Add(pair.Value)
        Next
        'Bổ sung các setting native của Part/Sheet Metal vào cùng bộ chọn cột.
        Dim systemCandidates As New List(Of PropertyColumnInfo)()
        AddUniversalSystemSettings(systemCandidates)
        For Each sys As PropertyColumnInfo In systemCandidates
            Dim alreadySelectedSystem As Boolean = False
            For Each selected As PropertyColumnInfo In _selectedProperties
                If String.Equals(selected.Key, sys.Key, StringComparison.OrdinalIgnoreCase) Then alreadySelectedSystem = True : Exit For
            Next
            If Not alreadySelectedSystem Then available.Add(sys)
        Next

        available.Sort(AddressOf ComparePropertyColumns)
        'Ngay cả khi không còn iProperty hiện có, vẫn mở form để người dùng tạo Custom iProperty mới.
        Dim picker As New BomAddPropertiesForm(available)
        If picker.ShowDialog(Me) <> DialogResult.OK OrElse picker.SelectedProperties.Count = 0 Then Exit Sub

        Me.Cursor = System.Windows.Forms.Cursors.WaitCursor
        Try
            For Each p As PropertyColumnInfo In picker.SelectedProperties
                Dim duplicate As Boolean = False
                For Each selected As PropertyColumnInfo In _selectedProperties
                    If selected IsNot Nothing AndAlso String.Equals(selected.Key, p.Key, StringComparison.OrdinalIgnoreCase) Then duplicate = True : Exit For
                Next
                If duplicate Then Continue For
                _selectedProperties.Add(p)
                For Each item As PartBomItem In _allItems
                    item.SelectedPropertyValues(p.Key) = ReadSingleSelectedProperty(item.Document, p)
                Next
                AddPropertyColumn(p)
            Next
            LoadRows()
        Finally
            Me.Cursor = System.Windows.Forms.Cursors.Default
        End Try
    End Sub

    Private Sub SaveChangedDocumentsClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Save Changed Documents") Then Exit Sub
        If _pendingTransaction.Changes.Count > 0 Then
            MessageBox.Show("Có " & _pendingTransaction.Changes.Count.ToString() & " Pending Changes chưa COMMIT." & vbCrLf & "SAVE chỉ lưu các thay đổi đã Commit; Pending không được ghi vào Inventor.", "BOM TRANSACTION", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End If
        SaveChangedDocumentsCore()
    End Sub

    Private Sub SaveChangedDocumentsCore()
        Dim saved As Integer = 0
        Dim failed As New List(Of String)()
        Dim processed As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        For Each item As PartBomItem In _allItems
            Try
                If item.Document IsNot Nothing AndAlso _committedDocumentKeys.Contains(item.DocumentKey) AndAlso Not processed.Contains(item.DocumentKey) Then
                    processed.Add(item.DocumentKey)
                    If item.Document.Dirty Then item.Document.Save2(True)
                    item.IsBomDirty = False
                    item.DirtyPropertyKeys.Clear()
                    _committedDocumentKeys.Remove(item.DocumentKey)
                    saved += 1
                End If
            Catch ex As Exception
                failed.Add(item.FileName & ": " & ex.Message)
            End Try
        Next
        Dim msg As String = "Đã lưu " & saved.ToString() & " Document đã Commit."
        If failed.Count > 0 Then msg &= vbCrLf & vbCrLf & "Không lưu được:" & vbCrLf & String.Join(vbCrLf, failed.ToArray())
        MessageBox.Show(msg, "BOM TOOL PRO", MessageBoxButtons.OK, If(failed.Count = 0, MessageBoxIcon.Information, MessageBoxIcon.Warning))
    End Sub

    Private Sub DashboardClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim form As New BomDashboardForm(_allItems)
        form.ShowDialog(Me)
        form.Dispose()
    End Sub

    Public Sub StageValidationFix(ByVal result As BomValidationResult)
        If Not EnsureWriteAllowed("Auto Fix / Stage Validation") Then Exit Sub
        If result Is Nothing OrElse result.Item Is Nothing OrElse Not result.CanAutoFix Then Exit Sub
        Dim p As PropertyColumnInfo = result.FixPropertyInfo
        If p Is Nothing Then Exit Sub
        Dim oldValue As String = result.CurrentValue
        Dim newValue As String = result.SuggestedValue
        StagePropertyChange(result.Item, p, oldValue, newValue, Nothing, -1)
        If result.Item.SelectedPropertyValues IsNot Nothing Then result.Item.SelectedPropertyValues(p.Key) = newValue
        result.Status = "STAGED"
    End Sub

    Private Sub ProjectCheckClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim form As New BomProjectCheckForm(_allItems, AddressOf OpenPart, AddressOf GetDrawingStatus, AddressOf StageValidationFix)
        form.ShowDialog(Me)
        form.Dispose()
    End Sub


'####################################################################
' SUBSECTION 15.12 - DISPLAY MODE / GROUP / MARK / TABLE STATE
'####################################################################

    Private Sub GridLayoutChanged(ByVal sender As Object, ByVal e As EventArgs)
    End Sub

    Private Sub ToggleDisplayModeClicked(ByVal sender As Object, ByVal e As EventArgs)
        Select Case _bomDisplayMode
            Case BomDisplayMode.PartsOnly
                _bomDisplayMode = BomDisplayMode.Structured
            Case BomDisplayMode.Structured
                _bomDisplayMode = BomDisplayMode.Hybrid
            Case Else
                _bomDisplayMode = BomDisplayMode.PartsOnly
        End Select

        _groupedView = (_bomDisplayMode <> BomDisplayMode.PartsOnly)
        _collapsedGroups.Clear()

        If _displayModeButton IsNot Nothing Then
            Select Case _bomDisplayMode
                Case BomDisplayMode.PartsOnly
                    _displayModeButton.Text = "PARTS ONLY"
                    _displayModeButton.ToolTipText = "Danh sách Part phẳng. Nhấn để chuyển sang STRUCTURED."
                Case BomDisplayMode.Structured
                    _displayModeButton.Text = "STRUCTURED"
                    _displayModeButton.ToolTipText = "Cây Assembly cha-con + Local Qty. Nhấn để chuyển sang HYBRID."
                Case Else
                    _displayModeButton.Text = "HYBRID BOM"
                    _displayModeButton.ToolTipText = "Cây Assembly + Local/Total Quantity. Nhấn để chuyển sang PARTS ONLY."
            End Select
        End If
        LoadRows()
    End Sub

    Private Function IsPathCollapsed(ByVal groupPath As String) As Boolean
        If String.IsNullOrWhiteSpace(groupPath) Then Return False
        For Each collapsedPath As String In _collapsedGroups
            If String.Equals(groupPath, collapsedPath, StringComparison.OrdinalIgnoreCase) Then Return True
            If groupPath.StartsWith(collapsedPath & "\", StringComparison.OrdinalIgnoreCase) Then Return True
        Next
        Return False
    End Function

    Private Sub ToggleCurrentGroupClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not _groupedView OrElse Grid.CurrentRow Is Nothing Then Exit Sub
        Dim groupName As String = GetRowGroupName(Grid.CurrentRow)
        If groupName.Length = 0 Then Exit Sub
        ToggleGroup(groupName)
    End Sub

    Private Sub ToggleGroup(ByVal groupName As String)
        If Not _groupedView OrElse String.IsNullOrWhiteSpace(groupName) Then Exit Sub
        If _collapsedGroups.Contains(groupName) Then
            _collapsedGroups.Remove(groupName)
        Else
            _collapsedGroups.Add(groupName)
        End If
        For Each row As DataGridViewRow In Grid.Rows
            If IsAssemblyHeaderRow(row) AndAlso String.Equals(GetRowGroupName(row), groupName, StringComparison.OrdinalIgnoreCase) Then
                row.Cells("ITEM").Value = If(_collapsedGroups.Contains(groupName), "▸", "▾")
            End If
        Next
        ApplySearchFilter()
    End Sub

    Private Sub CollapseAllGroupsClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not _groupedView Then Exit Sub
        For Each row As DataGridViewRow In Grid.Rows
            If IsAssemblyHeaderRow(row) Then _collapsedGroups.Add(GetRowGroupName(row))
        Next
        For Each row As DataGridViewRow In Grid.Rows
            If IsAssemblyHeaderRow(row) Then row.Cells("ITEM").Value = "▸"
        Next
        ApplySearchFilter()
    End Sub

    Private Sub ExpandAllGroupsClicked(ByVal sender As Object, ByVal e As EventArgs)
        _collapsedGroups.Clear()
        For Each row As DataGridViewRow In Grid.Rows
            If IsAssemblyHeaderRow(row) Then row.Cells("ITEM").Value = "▾"
        Next
        ApplySearchFilter()
    End Sub

    Private Sub ToggleMarkClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim rowsToProcess As New List(Of DataGridViewRow)()
        If Grid.SelectedRows.Count > 0 Then
            For Each row As DataGridViewRow In Grid.SelectedRows
                rowsToProcess.Add(row)
            Next
        ElseIf Grid.CurrentRow IsNot Nothing Then
            rowsToProcess.Add(Grid.CurrentRow)
        End If

        For Each row As DataGridViewRow In rowsToProcess
            If IsAssemblyHeaderRow(row) Then
                Dim groupName As String = GetRowGroupName(row)
                Dim shouldMark As Boolean = False
                For Each child As DataGridViewRow In Grid.Rows
                    Dim childItem As PartBomItem = TryCast(child.Tag, PartBomItem)
                    If childItem IsNot Nothing AndAlso String.Equals(GetRowGroupName(child), groupName, StringComparison.OrdinalIgnoreCase) AndAlso Not _markedPartKeys.Contains(childItem.DocumentKey) Then
                        shouldMark = True
                        Exit For
                    End If
                Next
                For Each child As DataGridViewRow In Grid.Rows
                    Dim childItem As PartBomItem = TryCast(child.Tag, PartBomItem)
                    If childItem IsNot Nothing AndAlso String.Equals(GetRowGroupName(child), groupName, StringComparison.OrdinalIgnoreCase) Then
                        If shouldMark Then _markedPartKeys.Add(childItem.DocumentKey) Else _markedPartKeys.Remove(childItem.DocumentKey)
                        ApplyMarkStyle(child, childItem)
                    End If
                Next
            Else
                Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                If item IsNot Nothing Then
                    If _markedPartKeys.Contains(item.DocumentKey) Then _markedPartKeys.Remove(item.DocumentKey) Else _markedPartKeys.Add(item.DocumentKey)
                    For Each relatedRow As DataGridViewRow In Grid.Rows
                        Dim relatedItem As PartBomItem = TryCast(relatedRow.Tag, PartBomItem)
                        If relatedItem IsNot Nothing AndAlso String.Equals(relatedItem.DocumentKey, item.DocumentKey, StringComparison.OrdinalIgnoreCase) Then ApplyMarkStyle(relatedRow, relatedItem)
                    Next
                End If
            End If
        Next
        Grid.Invalidate()
    End Sub

    Private Sub ApplyMarkStyle(ByVal row As DataGridViewRow, ByVal item As PartBomItem)
        If row Is Nothing OrElse item Is Nothing Then Exit Sub
        row.DefaultCellStyle.BackColor = If(_markedPartKeys.Contains(item.DocumentKey), Color.FromArgb(255, 245, 170), Color.White)
    End Sub

    Private Sub ClearAllMarksClicked(ByVal sender As Object, ByVal e As EventArgs)
        _markedPartKeys.Clear()
        For Each row As DataGridViewRow In Grid.Rows
            Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
            If item IsNot Nothing Then ApplyMarkStyle(row, item)
        Next
        Grid.Invalidate()
    End Sub

    Private Sub ClearTableClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.Rows.Count = 0 Then Exit Sub
        Dim result As DialogResult = MessageBox.Show("Xóa dữ liệu đang hiển thị khỏi bảng?" & vbCrLf & "Thao tác này không xóa hoặc sửa file Inventor.", "CLEAR TABLE", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
        If result <> DialogResult.Yes Then Exit Sub
        Grid.Rows.Clear()
        SearchBox.Clear()
        UpdateStatusBar(0, 0, 0)
    End Sub


