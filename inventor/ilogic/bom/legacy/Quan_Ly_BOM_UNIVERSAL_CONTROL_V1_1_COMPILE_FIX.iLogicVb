        AddPaletteCommand(commands, "Refresh", "BOM", "Refresh dữ liệu BOM.", Sub() RefreshClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Highlight", "VIEW", "Highlight Part đang chọn.", Sub() HighlightCurrent(False, False))
        AddPaletteCommand(commands, "Where Used 2.0", "INTELLIGENCE", "Dependency Tree.", Sub() WhereUsedClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Impact Analysis", "INTELLIGENCE", "Phân tích ảnh hưởng.", Sub() ImpactAnalysisClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Snapshot", "CHANGE", "Chụp trạng thái BOM.", Sub() CaptureSnapshotClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Compare Snapshot", "CHANGE", "So sánh với Snapshot.", Sub() CompareSnapshotClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Manufacturing Summary", "MANUFACTURING", "Dashboard sản xuất/mua hàng.", Sub() ManufacturingSummaryClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Report Center", "REPORT", "BOM Report.", Sub() ReportCenterClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Validation", "QUALITY", "Chạy CHECK PROJECT.", Sub() ProjectCheckClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Commit", "TRANSACTION", "Commit staged changes.", Sub() CommitPendingClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Health Check", "SYSTEM", "Kiểm tra cache/structure integrity.", Sub() HealthCheckClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Recover UI", "SYSTEM", "Khôi phục Grid/UI an toàn.", Sub() RecoverUiClicked(Nothing, EventArgs.Empty))
        AddPaletteCommand(commands, "Final Regression Check", "SYSTEM", "Kiểm tra Production Release.", Sub() FinalRegressionClicked(Nothing, EventArgs.Empty))

        Using f As New BomCommandPaletteForm(commands)
            f.ShowDialog(Me)
        End Using
    End Sub

    Private Sub AddPaletteCommand(ByVal list As List(Of BomCommandItem),
                                  ByVal name As String,
                                  ByVal category As String,
                                  ByVal description As String,
                                  ByVal action As Action)
        Dim cmd As New BomCommandItem()
        cmd.Name = name
        cmd.Category = category
        cmd.Description = description
        cmd.ExecuteAction = action
        list.Add(cmd)
    End Sub

    Private Sub QuickFilterClicked(ByVal sender As Object, ByVal e As EventArgs)
        Select Case _quickFilterMode
            Case "ALL" : _quickFilterMode = "ERROR"
            Case "ERROR" : _quickFilterMode = "PURCHASED"
            Case "PURCHASED" : _quickFilterMode = "MANUFACTURE"
            Case "MANUFACTURE" : _quickFilterMode = "REFERENCE"
            Case Else : _quickFilterMode = "ALL"
        End Select
        ApplyQuickFilter()
    End Sub

    Private Sub ApplyQuickFilter()
        For Each row As DataGridViewRow In Grid.Rows
            If row Is Nothing Then Continue For
            Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
            If item Is Nothing Then
                row.Visible = (_quickFilterMode = "ALL")
                Continue For
            End If

            Dim visible As Boolean = True
            Select Case _quickFilterMode
                Case "ERROR"
                    visible = String.Equals(item.DataStatus, "ERROR", StringComparison.OrdinalIgnoreCase) OrElse
                              String.Equals(item.DataStatus, "WARNING", StringComparison.OrdinalIgnoreCase)
                Case "PURCHASED"
                    visible = BomStructurePolicy.IsPurchased(item)
                Case "MANUFACTURE"
                    visible = Not BomStructurePolicy.IsPurchased(item) AndAlso Not BomStructurePolicy.IsReference(item)
                Case "REFERENCE"
                    visible = BomStructurePolicy.IsReference(item)
                Case Else
                    visible = True
            End Select
            row.Visible = visible
        Next
        Text = Text.Split(New String() {"  | FILTER:"}, StringSplitOptions.None)(0) & "  | FILTER: " & _quickFilterMode
    End Sub

