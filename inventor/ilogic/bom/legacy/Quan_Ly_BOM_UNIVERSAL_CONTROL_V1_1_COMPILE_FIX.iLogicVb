    Private Sub CaptureSnapshotClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim defaultName As String = _assemblyName & "_" & DateTime.Now.ToString("yyyyMMdd_HHmmss")
        Dim name As String = Microsoft.VisualBasic.Interaction.InputBox(
            "Tên Snapshot:", "CAPTURE BOM SNAPSHOT", defaultName)
        If String.IsNullOrWhiteSpace(name) Then Exit Sub
        _activeSnapshot = BomChangeManagementEngine.Capture(name.Trim(), _assemblyName, _allItems)
        _lastChangeSet = Nothing
        MessageBox.Show("Đã tạo Snapshot: " & _activeSnapshot.Name &
                        System.Environment.NewLine & "Items: " & _activeSnapshot.Items.Count.ToString(),
                        "SNAPSHOT", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

