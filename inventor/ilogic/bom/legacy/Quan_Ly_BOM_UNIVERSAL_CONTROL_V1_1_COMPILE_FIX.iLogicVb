    Private Sub LoadProperties(ByVal filterText As String)
        AvailableList.Items.Clear()
        Dim normalizedFilter As String = filterText.Trim()

        For Each propertyInfo As PropertyColumnInfo In AllProperties
            If normalizedFilter.Length > 0 Then
                If propertyInfo.DisplayText.IndexOf( _
                    normalizedFilter, _
                    StringComparison.OrdinalIgnoreCase) < 0 Then
                    Continue For
                End If
            End If

            Dim alreadySelected As Boolean = _
                IsPropertyInSelectedList(propertyInfo.Key)

            AvailableList.Items.Add(propertyInfo, alreadySelected)
        Next

        PropertyCountLabel.Text = _
            AvailableList.Items.Count.ToString() & " iProperty"
    End Sub

    Private Sub SelectDefaultProperties()
        SelectedList.Items.Clear()

        For Each propertyInfo As PropertyColumnInfo In AllProperties
            If propertyInfo.DefaultSelected Then
                SelectedList.Items.Add(propertyInfo)
            End If
        Next

        RefreshAvailableChecks()
    End Sub

    Private Sub SearchTextChanged( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        LoadProperties(SearchTextBox.Text)
    End Sub

    Private Sub AddSelectedProperties( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        Dim propertiesToAdd As New List(Of PropertyColumnInfo)

        For index As Integer = 0 To AvailableList.Items.Count - 1
            If AvailableList.GetItemChecked(index) Then
                Dim propertyInfo As PropertyColumnInfo = _
                    CType(AvailableList.Items(index), PropertyColumnInfo)

                If Not IsPropertyInSelectedList(propertyInfo.Key) Then
                    propertiesToAdd.Add(propertyInfo)
                End If
            End If
        Next

        If propertiesToAdd.Count = 0 AndAlso _
           AvailableList.SelectedItem IsNot Nothing Then

            Dim selectedProperty As PropertyColumnInfo = _
                CType(AvailableList.SelectedItem, PropertyColumnInfo)

            If Not IsPropertyInSelectedList(selectedProperty.Key) Then
                propertiesToAdd.Add(selectedProperty)
            End If
        End If

        For Each propertyInfo As PropertyColumnInfo In propertiesToAdd
            SelectedList.Items.Add(propertyInfo)
        Next

        RefreshAvailableChecks()
    End Sub

    Private Sub RemoveSelectedProperties( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        If SelectedList.SelectedIndex < 0 Then Exit Sub

        Dim selectedIndex As Integer = SelectedList.SelectedIndex
        SelectedList.Items.RemoveAt(selectedIndex)

        If SelectedList.Items.Count > 0 Then
            If selectedIndex >= SelectedList.Items.Count Then
                selectedIndex = SelectedList.Items.Count - 1
            End If

            SelectedList.SelectedIndex = selectedIndex
        End If

        RefreshAvailableChecks()
    End Sub

    Private Sub MoveSelectedPropertyUp( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        Dim selectedIndex As Integer = SelectedList.SelectedIndex
        If selectedIndex <= 0 Then Exit Sub

        Dim selectedObject As Object = SelectedList.Items(selectedIndex)
        SelectedList.Items.RemoveAt(selectedIndex)
        SelectedList.Items.Insert(selectedIndex - 1, selectedObject)
        SelectedList.SelectedIndex = selectedIndex - 1
    End Sub

    Private Sub MoveSelectedPropertyDown( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        Dim selectedIndex As Integer = SelectedList.SelectedIndex

        If selectedIndex < 0 OrElse _
           selectedIndex >= SelectedList.Items.Count - 1 Then
            Exit Sub
        End If

        Dim selectedObject As Object = SelectedList.Items(selectedIndex)
        SelectedList.Items.RemoveAt(selectedIndex)
        SelectedList.Items.Insert(selectedIndex + 1, selectedObject)
        SelectedList.SelectedIndex = selectedIndex + 1
    End Sub

    Private Sub SelectDefaultButtonClick( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        SelectDefaultProperties()
    End Sub

    Private Sub SelectAllButtonClick( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        SelectedList.Items.Clear()

        For Each propertyInfo As PropertyColumnInfo In AllProperties
            SelectedList.Items.Add(propertyInfo)
        Next

        RefreshAvailableChecks()
    End Sub

    Private Sub ClearAllButtonClick( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        SelectedList.Items.Clear()
        RefreshAvailableChecks()
    End Sub

    Private Sub RefreshAvailableChecks()
        For index As Integer = 0 To AvailableList.Items.Count - 1
            Dim propertyInfo As PropertyColumnInfo = _
                CType(AvailableList.Items(index), PropertyColumnInfo)

            AvailableList.SetItemChecked( _
                index, _
                IsPropertyInSelectedList(propertyInfo.Key))
        Next
    End Sub

    Private Function IsPropertyInSelectedList( _
        ByVal propertyKey As String) As Boolean

        For Each selectedObject As Object In SelectedList.Items
            Dim propertyInfo As PropertyColumnInfo = _
                CType(selectedObject, PropertyColumnInfo)

            If String.Equals( _
                propertyInfo.Key, _
                propertyKey, _
                StringComparison.OrdinalIgnoreCase) Then
                Return True
            End If
        Next

        Return False
    End Function

    Private Sub ScanModeChanged(ByVal sender As Object, ByVal e As EventArgs)
        If ScanModeInfoLabel Is Nothing OrElse ScanModeBox Is Nothing Then Exit Sub
        Select Case ScanModeBox.SelectedIndex
            Case 0
                ScanModeInfoLabel.Text = "FAST: Core BOM tối thiểu, bỏ Drawing Index/Geometry/Deep Check."
            Case 2
                ScanModeInfoLabel.Text = "DEEP: Core + Drawing Index + preload Geometry toàn bộ Part."
            Case Else
                ScanModeInfoLabel.Text = "NORMAL: Core + Drawing cơ bản, Geometry vẫn Lazy."
        End Select
    End Sub

    Private Sub ExportButtonClick( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        SelectedProperties.Clear()

        For Each selectedObject As Object In SelectedList.Items
            SelectedProperties.Add( _
                CType(selectedObject, PropertyColumnInfo))
        Next

        IncludeFileName = FileNameCheckBox.Checked
        IncludeFilePath = FilePathCheckBox.Checked
        IncludeParentAssembly = ParentAssemblyCheckBox.Checked
        OpenExcelAfterExport = OpenExcelCheckBox.Checked
        Select Case ScanModeBox.SelectedIndex
            Case 0 : SelectedScanMode = BomScanMode.Fast
            Case 2 : SelectedScanMode = BomScanMode.Deep
            Case Else : SelectedScanMode = BomScanMode.Normal
        End Select

        If SelectedProperties.Count = 0 AndAlso _
           Not IncludeFileName AndAlso _
           Not IncludeFilePath AndAlso _
           Not IncludeParentAssembly Then

            MessageBox.Show( _
                "Hãy chọn ít nhất một cột để xuất.", _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Warning)
            Exit Sub
        End If

        Me.DialogResult = DialogResult.OK
        Me.Close()
    End Sub

    Private Sub CancelButtonClick( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        Me.DialogResult = DialogResult.Cancel
        Me.Close()
    End Sub
End Class

