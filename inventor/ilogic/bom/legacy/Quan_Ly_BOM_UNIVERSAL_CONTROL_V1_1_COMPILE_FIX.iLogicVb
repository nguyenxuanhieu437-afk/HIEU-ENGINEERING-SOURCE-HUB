    Private Sub GridExcelCellPainting(ByVal sender As Object, ByVal e As System.Windows.Forms.DataGridViewCellPaintingEventArgs)
        If e.RowIndex = -1 AndAlso e.ColumnIndex = -1 Then
            e.PaintBackground(e.CellBounds, True)
            Using p As New System.Drawing.Pen(Color.FromArgb(150, 150, 150))
                e.Graphics.DrawLine(p, e.CellBounds.Right - 11, e.CellBounds.Bottom - 4, e.CellBounds.Right - 4, e.CellBounds.Bottom - 11)
            End Using
            e.Handled = True
            Exit Sub
        End If

        'Excel-like fill handle: vẽ ô vuông nhỏ ở góc phải-dưới của ô hiện hành có thể sửa.
        If e.RowIndex >= 0 AndAlso e.ColumnIndex >= 0 AndAlso Grid IsNot Nothing AndAlso Grid.CurrentCell IsNot Nothing Then
            If Grid.CurrentCell.RowIndex = e.RowIndex AndAlso Grid.CurrentCell.ColumnIndex = e.ColumnIndex Then
                Dim col As DataGridViewColumn = Grid.Columns(e.ColumnIndex)
                Dim item As PartBomItem = TryCast(Grid.Rows(e.RowIndex).Tag, PartBomItem)
                Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                If item IsNot Nothing AndAlso pi IsNot Nothing AndAlso Not col.ReadOnly Then
                    e.Paint(e.CellBounds, System.Windows.Forms.DataGridViewPaintParts.All)
                    Dim handleRect As New Rectangle(e.CellBounds.Right - FillHandleSize, e.CellBounds.Bottom - FillHandleSize, FillHandleSize - 1, FillHandleSize - 1)
                    Using b As New System.Drawing.SolidBrush(Color.FromArgb(45, 95, 120))
                        e.Graphics.FillRectangle(b, handleRect)
                    End Using
                    e.Handled = True
                End If
            End If
        End If
    End Sub

