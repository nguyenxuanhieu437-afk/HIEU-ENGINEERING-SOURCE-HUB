Public Class BomManufacturingListForm
    Inherits BomDialogBase
    Public Sub New(ByVal title As String, ByVal records As List(Of BomManufacturingRecord))
        Me.Text = title
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(1080, 600)
        Me.MinimumSize = New Size(820, 440)
        Me.Font = New Font("Segoe UI", 9.0F)

        Dim grid As New DataGridView()
        grid.Dock = DockStyle.Fill
        grid.ReadOnly = True
        grid.AllowUserToAddRows = False
        grid.RowHeadersVisible = False
        grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
        grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        grid.Columns.Add("PART", "PART NUMBER")
        grid.Columns.Add("DESC", "DESCRIPTION")
        grid.Columns.Add("MATERIAL", "MATERIAL")
        grid.Columns.Add("TYPE", "TYPE")
        grid.Columns.Add("CONFIDENCE", "CONFIDENCE")
        grid.Columns.Add("THK", "THICKNESS")
        grid.Columns.Add("WIDTH", "WIDTH")
        grid.Columns.Add("LENGTH", "LENGTH")
        grid.Columns.Add("QTY", "QTY")
        grid.Columns.Add("UNITMASS", "UNIT MASS")
        grid.Columns.Add("TOTALMASS", "TOTAL MASS")

        For Each r As BomManufacturingRecord In records
            grid.Rows.Add(r.PartNumber, r.Description, r.Material,
                          r.ManufacturingType.ToString().ToUpperInvariant(),
                          r.Confidence.ToString().ToUpperInvariant(),
                          BomUnitManager.FormatLength(r.Thickness),
                          BomUnitManager.FormatLength(r.Width),
                          BomUnitManager.FormatLength(r.Length),
                          r.Quantity,
                          BomUnitManager.FormatMass(r.UnitMass),
                          BomUnitManager.FormatMass(r.TotalMass))
        Next

        Dim status As New Label()
        status.Dock = DockStyle.Bottom
        status.Height = 30
        status.Padding = New Padding(8, 6, 8, 0)
        status.Text = records.Count.ToString() & " records | UNKNOWN values are intentionally not guessed."

        Me.Controls.Add(grid)
        Me.Controls.Add(status)
    End Sub
End Class



