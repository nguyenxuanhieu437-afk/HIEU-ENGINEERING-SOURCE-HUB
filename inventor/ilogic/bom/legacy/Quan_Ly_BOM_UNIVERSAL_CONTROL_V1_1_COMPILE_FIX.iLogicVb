Public Class BomAddPropertiesForm
    Inherits Form

    Private PropertyList As CheckedListBox
    Private SearchBox As TextBox
    Private CountLabel As Label
    Private CustomNameBox As TextBox
    Private AllProperties As List(Of PropertyColumnInfo)
    Private CheckedKeys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
    Public SelectedProperties As New List(Of PropertyColumnInfo)()

    Public Sub New(ByVal available As List(Of PropertyColumnInfo))
        AllProperties = If(available, New List(Of PropertyColumnInfo)())
        Me.Text = "THÊM iPROPERTY VÀO BOM"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(700, 650)
        Me.MinimumSize = New Size(580, 520)
        Me.Font = New Font("Segoe UI", 9.0F)
        Me.BackColor = Color.FromArgb(244, 250, 252)

        Dim topPanel As New Panel()
        topPanel.Dock = DockStyle.Top
        topPanel.Height = 140
        topPanel.Padding = New System.Windows.Forms.Padding(12)
        topPanel.BackColor = Color.FromArgb(230, 243, 247)
        Me.Controls.Add(topPanel)

        Dim label As New Label()
        label.Text = "Chọn iProperty hiện có hoặc tạo Custom iProperty mới ngay tại BOM."
        label.AutoSize = True
        label.Location = New Point(12, 10)
        label.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        topPanel.Controls.Add(label)

        Dim searchLabel As New Label()
        searchLabel.Text = "Tìm iProperty:"
        searchLabel.AutoSize = True
        searchLabel.Location = New Point(12, 51)
        topPanel.Controls.Add(searchLabel)

        SearchBox = New TextBox()
        SearchBox.Location = New Point(105, 47)
        SearchBox.Size = New Size(430, 27)
        SearchBox.Anchor = AnchorStyles.Top Or AnchorStyles.Left Or AnchorStyles.Right
        AddHandler SearchBox.TextChanged, AddressOf SearchChanged
        topPanel.Controls.Add(SearchBox)

        Dim clearSearch As New Button()
        clearSearch.Text = "XÓA"
        clearSearch.Size = New Size(62, 28)
        clearSearch.Location = New Point(545, 46)
        clearSearch.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        AddHandler clearSearch.Click, Sub(sender As Object, e As EventArgs) SearchBox.Clear()
        topPanel.Controls.Add(clearSearch)

        CountLabel = New Label()
        CountLabel.AutoSize = True
        CountLabel.ForeColor = Color.DimGray
        CountLabel.Location = New Point(617, 52)
        CountLabel.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        topPanel.Controls.Add(CountLabel)

        Dim customLabel As New Label()
        customLabel.Text = "Custom mới:"
        customLabel.AutoSize = True
        customLabel.Location = New Point(12, 94)
        topPanel.Controls.Add(customLabel)

        CustomNameBox = New TextBox()
        CustomNameBox.Location = New Point(105, 89)
        CustomNameBox.Size = New Size(430, 27)
        CustomNameBox.Anchor = AnchorStyles.Top Or AnchorStyles.Left Or AnchorStyles.Right
        CustomNameBox.Text = ""
        AddHandler CustomNameBox.KeyDown, AddressOf CustomNameKeyDown
        topPanel.Controls.Add(CustomNameBox)

        Dim addCustom As New Button()
        addCustom.Text = "TẠO CUSTOM"
        addCustom.Size = New Size(118, 29)
        addCustom.Location = New Point(545, 88)
        addCustom.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        addCustom.Font = New Font("Segoe UI", 8.5F, FontStyle.Bold)
        AddHandler addCustom.Click, AddressOf AddCustomPropertyClicked
        topPanel.Controls.Add(addCustom)

        PropertyList = New CheckedListBox()
        PropertyList.Dock = DockStyle.Fill
        PropertyList.CheckOnClick = True
        PropertyList.IntegralHeight = False
        PropertyList.BackColor = Color.White
        PropertyList.HorizontalScrollbar = True
        AddHandler PropertyList.ItemCheck, AddressOf PropertyItemCheck
        AddHandler PropertyList.DoubleClick, AddressOf PropertyDoubleClick
        Me.Controls.Add(PropertyList)
        PropertyList.BringToFront()

        Dim bottom As New Panel()
        bottom.Dock = DockStyle.Bottom
        bottom.Height = 60
        bottom.BackColor = Color.FromArgb(230, 243, 247)
        Me.Controls.Add(bottom)

        Dim selectAll As New Button()
        selectAll.Text = "CHỌN ĐANG LỌC"
        selectAll.Size = New Size(132, 34)
        selectAll.Location = New Point(12, 12)
        AddHandler selectAll.Click, AddressOf SelectVisibleClicked
        bottom.Controls.Add(selectAll)

        Dim clearAll As New Button()
        clearAll.Text = "BỎ CHỌN"
        clearAll.Size = New Size(100, 34)
        clearAll.Location = New Point(152, 12)
        AddHandler clearAll.Click, AddressOf ClearCheckedClicked
        bottom.Controls.Add(clearAll)

        Dim okButton As New Button()
        okButton.Text = "THÊM CỘT"
        okButton.Size = New Size(115, 34)
        okButton.Location = New Point(bottom.Width - 250, 12)
        okButton.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        okButton.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        AddHandler okButton.Click, AddressOf OkClicked
        bottom.Controls.Add(okButton)

        Dim cancelButton As New Button()
        cancelButton.Text = "HỦY"
        cancelButton.Size = New Size(90, 34)
        cancelButton.Location = New Point(bottom.Width - 125, 12)
        cancelButton.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        AddHandler cancelButton.Click, AddressOf CancelClicked
        bottom.Controls.Add(cancelButton)

        LoadFilteredProperties("")
    End Sub

    Private Sub LoadFilteredProperties(ByVal filterText As String)
        Dim term As String = If(filterText, "").Trim()
        PropertyList.Items.Clear()
        For Each p As PropertyColumnInfo In AllProperties
            If term.Length > 0 AndAlso p.DisplayText.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0 Then Continue For
            Dim index As Integer = PropertyList.Items.Add(p, CheckedKeys.Contains(p.Key))
        Next
        CountLabel.Text = PropertyList.Items.Count.ToString() & " mục"
    End Sub

    Private Sub SearchChanged(ByVal sender As Object, ByVal e As EventArgs)
        CaptureChecks()
        LoadFilteredProperties(SearchBox.Text)
    End Sub

    Private Sub PropertyItemCheck(ByVal sender As Object, ByVal e As System.Windows.Forms.ItemCheckEventArgs)
        Dim p As PropertyColumnInfo = TryCast(PropertyList.Items(e.Index), PropertyColumnInfo)
        If p Is Nothing Then Exit Sub
        If e.NewValue = CheckState.Checked Then CheckedKeys.Add(p.Key) Else CheckedKeys.Remove(p.Key)
    End Sub

    Private Sub PropertyDoubleClick(ByVal sender As Object, ByVal e As EventArgs)
        If PropertyList.SelectedIndex < 0 Then Exit Sub
        Dim i As Integer = PropertyList.SelectedIndex
        PropertyList.SetItemChecked(i, Not PropertyList.GetItemChecked(i))
    End Sub

    Private Sub CaptureChecks()
        For i As Integer = 0 To PropertyList.Items.Count - 1
            Dim p As PropertyColumnInfo = TryCast(PropertyList.Items(i), PropertyColumnInfo)
            If p Is Nothing Then Continue For
            If PropertyList.GetItemChecked(i) Then CheckedKeys.Add(p.Key) Else CheckedKeys.Remove(p.Key)
        Next
    End Sub

    Private Sub SelectVisibleClicked(ByVal sender As Object, ByVal e As EventArgs)
        For i As Integer = 0 To PropertyList.Items.Count - 1
            PropertyList.SetItemChecked(i, True)
        Next
    End Sub

    Private Sub ClearCheckedClicked(ByVal sender As Object, ByVal e As EventArgs)
        CheckedKeys.Clear()
        For i As Integer = 0 To PropertyList.Items.Count - 1
            PropertyList.SetItemChecked(i, False)
        Next
    End Sub

    Private Sub CustomNameKeyDown(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyEventArgs)
        If e.KeyCode = Keys.Enter Then
            AddCustomPropertyClicked(sender, EventArgs.Empty)
            e.Handled = True
            e.SuppressKeyPress = True
        End If
    End Sub

    Private Function IsValidCustomPropertyName(ByVal propertyName As String) As Boolean
        If String.IsNullOrWhiteSpace(propertyName) Then Return False
        If propertyName.IndexOf("|"c) >= 0 Then Return False
        If propertyName.IndexOf(ControlChars.Cr) >= 0 OrElse propertyName.IndexOf(ControlChars.Lf) >= 0 OrElse propertyName.IndexOf(ControlChars.Tab) >= 0 Then Return False
        Return True
    End Function

    Private Function BuildVirtualCustomProperty(ByVal propertyName As String) As PropertyColumnInfo
        Dim p As New PropertyColumnInfo()
        p.PropertySetInternalName = "{D5CDD505-2E9C-101B-9397-08002B2CF9AE}"
        p.PropertySetDisplayName = "User Defined Properties"
        p.PropertyName = propertyName.Trim()
        p.Key = BuildPropertyKey(p.PropertySetInternalName, p.PropertyName)
        p.DisplayText = BuildPropertyDisplayText(p.PropertySetDisplayName, p.PropertyName) & "  [NEW CUSTOM]"
        p.DefaultSelected = False
        p.IsVirtualCustom = True
        Return p
    End Function

    Private Sub AddCustomPropertyClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim raw As String = If(CustomNameBox.Text, "").Trim()
        If raw.Length = 0 Then
            MessageBox.Show("Nhập tên Custom iProperty, ví dụ: POS hoặc PROFILE.", "CUSTOM iPROPERTY", MessageBoxButtons.OK, MessageBoxIcon.Information)
            CustomNameBox.Focus()
            Exit Sub
        End If

        'Cho phép tạo nhiều tên một lần: POS; PROFILE hoặc POS, PROFILE.
        Dim normalized As String = raw.Replace(vbCrLf, ";").Replace(vbCr, ";").Replace(vbLf, ";").Replace(",", ";")
        Dim names() As String = normalized.Split(";"c)
        Dim added As Integer = 0
        Dim duplicateNames As New List(Of String)()
        Dim invalidNames As New List(Of String)()
        CaptureChecks()

        For Each token As String In names
            Dim propertyName As String = If(token, "").Trim()
            If propertyName.Length = 0 Then Continue For
            If Not IsValidCustomPropertyName(propertyName) Then
                invalidNames.Add(propertyName)
                Continue For
            End If
            Dim candidate As PropertyColumnInfo = BuildVirtualCustomProperty(propertyName)
            Dim exists As Boolean = False
            For Each p As PropertyColumnInfo In AllProperties
                If p IsNot Nothing AndAlso String.Equals(p.Key, candidate.Key, StringComparison.OrdinalIgnoreCase) Then
                    exists = True
                    CheckedKeys.Add(p.Key)
                    Exit For
                End If
            Next
            If exists Then
                duplicateNames.Add(propertyName)
            Else
                AllProperties.Add(candidate)
                CheckedKeys.Add(candidate.Key)
                added += 1
            End If
        Next

        AllProperties.Sort(AddressOf ComparePropertyColumns)
        LoadFilteredProperties(SearchBox.Text)
        CustomNameBox.Clear()
        If added > 0 Then
            CountLabel.Text = PropertyList.Items.Count.ToString() & " mục | +" & added.ToString() & " Custom"
        ElseIf invalidNames.Count > 0 Then
            MessageBox.Show("Tên Custom không hợp lệ: " & String.Join(", ", invalidNames.ToArray()) & vbCrLf & "Không dùng ký tự | hoặc xuống dòng/tab trong tên.", "CUSTOM iPROPERTY", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End If
    End Sub

    Private Sub CancelClicked(ByVal sender As Object, ByVal e As EventArgs)
        Me.DialogResult = DialogResult.Cancel
        Me.Close()
    End Sub

    Private Sub OkClicked(ByVal sender As Object, ByVal e As EventArgs)
        CaptureChecks()
        SelectedProperties.Clear()
        For Each p As PropertyColumnInfo In AllProperties
            If CheckedKeys.Contains(p.Key) Then SelectedProperties.Add(p)
        Next
        If SelectedProperties.Count = 0 Then
            MessageBox.Show("Hãy chọn iProperty hiện có hoặc tạo ít nhất một Custom iProperty mới.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Me.DialogResult = DialogResult.OK
        Me.Close()
    End Sub
End Class

'====================================================================
' QUẢN LÝ ẨN/HIỆN VÀ THỨ TỰ CỘT - HỖ TRỢ KÉO THẢ
'====================================================================

'####################################################################
' SECTION 17 - COLUMN MANAGER FORM
' Ẩn/hiện, kéo thả, sắp xếp và áp dụng bố cục cột.
'####################################################################

Public Class BomColumnListItem
    Public Column As DataGridViewColumn
    Public Position As Integer

    Public Sub New(ByVal column As DataGridViewColumn, ByVal position As Integer)
        Me.Column = column
        Me.Position = position
    End Sub

    Public Overrides Function ToString() As String
        Dim excelLetter As String = BomColumnManagerForm.ColumnNumberToExcelLetter(Position + 1)
        Return "[" & excelLetter & "]  " & BomColumnManagerForm.GetCleanColumnHeader(Column)
    End Function
End Class

Public Class BomColumnManagerForm
    Inherits Form

    Private _grid As DataGridView
    Private ColumnList As CheckedListBox
    Private DragIndex As Integer = -1
    Private PositionLabel As Label

    Public Sub New(ByVal grid As DataGridView)
        _grid = grid
        BuildInterface()
        LoadColumns()
    End Sub

    Private Sub BuildInterface()
        Me.Text = "QUẢN LÝ CỘT - HIỂN THỊ KÝ TỰ EXCEL"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(640, 600)
        Me.MinimumSize = New Size(560, 520)
        Me.Font = New Font("Segoe UI", 9.0F)
        Me.BackColor = Color.FromArgb(247, 250, 252)

        Dim label As New Label()
        label.Text = "Ký tự [A], [B], [C]... tương ứng trực tiếp với vị trí cột trên BOM. Tích để hiện cột; kéo thả hoặc dùng LÊN/XUỐNG để đổi thứ tự."
        label.Location = New Point(15, 12)
        label.Size = New Size(595, 42)
        Me.Controls.Add(label)

        PositionLabel = New Label()
        PositionLabel.Text = "CỘT ĐANG CHỌN: -"
        PositionLabel.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        PositionLabel.Location = New Point(15, 55)
        PositionLabel.Size = New Size(595, 24)
        PositionLabel.ForeColor = Color.FromArgb(30, 70, 110)
        Me.Controls.Add(PositionLabel)

        ColumnList = New CheckedListBox()
        ColumnList.Location = New Point(15, 82)
        ColumnList.Size = New Size(470, 420)
        ColumnList.CheckOnClick = True
        ColumnList.IntegralHeight = False
        ColumnList.AllowDrop = True
        ColumnList.BackColor = Color.White
        AddHandler ColumnList.MouseDown, AddressOf ColumnListMouseDown
        AddHandler ColumnList.MouseMove, AddressOf ColumnListMouseMove
        AddHandler ColumnList.DragOver, AddressOf ColumnListDragOver
        AddHandler ColumnList.DragDrop, AddressOf ColumnListDragDrop
        AddHandler ColumnList.SelectedIndexChanged, AddressOf ColumnListSelectedIndexChanged
        Me.Controls.Add(ColumnList)

        Dim upButton As New Button()
        upButton.Text = "LÊN"
        upButton.Location = New Point(500, 105)
        upButton.Size = New Size(110, 36)
        AddHandler upButton.Click, AddressOf MoveUpClicked
        Me.Controls.Add(upButton)

        Dim downButton As New Button()
        downButton.Text = "XUỐNG"
        downButton.Location = New Point(500, 149)
        downButton.Size = New Size(110, 36)
        AddHandler downButton.Click, AddressOf MoveDownClicked
        Me.Controls.Add(downButton)

        Dim topButton As New Button()
        topButton.Text = "LÊN ĐẦU"
        topButton.Location = New Point(500, 205)
        topButton.Size = New Size(110, 36)
        AddHandler topButton.Click, AddressOf MoveTopClicked
        Me.Controls.Add(topButton)

        Dim bottomButton As New Button()
        bottomButton.Text = "XUỐNG CUỐI"
        bottomButton.Location = New Point(500, 249)
        bottomButton.Size = New Size(110, 36)
        AddHandler bottomButton.Click, AddressOf MoveBottomClicked
        Me.Controls.Add(bottomButton)

        Dim allButton As New Button()
        allButton.Text = "HIỆN TẤT CẢ"
        allButton.Location = New Point(500, 315)
        allButton.Size = New Size(110, 40)
        AddHandler allButton.Click, AddressOf ShowAllClicked
        Me.Controls.Add(allButton)

        Dim applyButton As New Button()
        applyButton.Text = "ÁP DỤNG"
        applyButton.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        applyButton.Location = New Point(395, 520)
        applyButton.Size = New Size(105, 38)
        AddHandler applyButton.Click, AddressOf ApplyClicked
        Me.Controls.Add(applyButton)

        Dim closeButton As New Button()
        closeButton.Text = "ĐÓNG"
        closeButton.Location = New Point(510, 520)
        closeButton.Size = New Size(100, 38)
        AddHandler closeButton.Click, AddressOf CloseClicked
        Me.Controls.Add(closeButton)
    End Sub

    Private Sub LoadColumns()
        ColumnList.Items.Clear()
        Dim ordered As New List(Of DataGridViewColumn)()
        For Each col As DataGridViewColumn In _grid.Columns
            ordered.Add(col)
        Next
        ordered.Sort(Function(a As DataGridViewColumn, b As DataGridViewColumn) a.DisplayIndex.CompareTo(b.DisplayIndex))

        For i As Integer = 0 To ordered.Count - 1
            Dim item As New BomColumnListItem(ordered(i), i)
            ColumnList.Items.Add(item, ordered(i).Visible)
        Next

        If ColumnList.Items.Count > 0 Then ColumnList.SelectedIndex = 0
        UpdatePositionLabel()
    End Sub

    Public Shared Function ColumnNumberToExcelLetter(ByVal number As Integer) As String
        If number <= 0 Then Return "?"
        Dim result As String = ""
        Dim value As Integer = number
        While value > 0
            value -= 1
            result = ChrW(65 + (value Mod 26)) & result
            value \= 26
        End While
        Return result
    End Function

    Public Shared Function GetCleanColumnHeader(ByVal column As DataGridViewColumn) As String
        If column Is Nothing Then Return ""
        Dim header As String = Convert.ToString(column.HeaderText)
        If String.IsNullOrWhiteSpace(header) Then header = column.Name
        Dim lines() As String = header.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries)
        If lines.Length >= 2 AndAlso IsExcelLetter(lines(0).Trim()) Then
            Return String.Join(" ", lines, 1, lines.Length - 1).Trim()
        End If
        Return header.Replace(vbCrLf, " ").Replace(vbLf, " ").Replace(vbCr, " ").Trim()
    End Function

    Private Shared Function IsExcelLetter(ByVal value As String) As Boolean
        If String.IsNullOrWhiteSpace(value) Then Return False
        For Each ch As Char In value.ToUpperInvariant()
            If ch < "A"c OrElse ch > "Z"c Then Return False
        Next
        Return value.Length <= 4
    End Function

    Private Sub RefreshItemPositions(ByVal selectedIndex As Integer)
        For i As Integer = 0 To ColumnList.Items.Count - 1
            Dim item As BomColumnListItem = TryCast(ColumnList.Items(i), BomColumnListItem)
            If item IsNot Nothing Then item.Position = i
        Next
        ColumnList.Refresh()
        If selectedIndex >= 0 AndAlso selectedIndex < ColumnList.Items.Count Then ColumnList.SelectedIndex = selectedIndex
        UpdatePositionLabel()
    End Sub

    Private Sub UpdatePositionLabel()
        Dim item As BomColumnListItem = TryCast(ColumnList.SelectedItem, BomColumnListItem)
        If item Is Nothing Then
            PositionLabel.Text = "CỘT ĐANG CHỌN: -"
            Exit Sub
        End If
        Dim letter As String = ColumnNumberToExcelLetter(item.Position + 1)
        PositionLabel.Text = "CỘT ĐANG CHỌN: " & letter & "  |  VỊ TRÍ: " & (item.Position + 1).ToString() & "  |  " & GetCleanColumnHeader(item.Column)
    End Sub

    Private Sub ColumnListSelectedIndexChanged(ByVal sender As Object, ByVal e As EventArgs)
        UpdatePositionLabel()
    End Sub

    Private Sub ColumnListMouseDown(ByVal sender As Object, ByVal e As MouseEventArgs)
        DragIndex = ColumnList.IndexFromPoint(e.Location)
        If DragIndex >= 0 Then ColumnList.SelectedIndex = DragIndex
    End Sub

    Private Sub ColumnListMouseMove(ByVal sender As Object, ByVal e As MouseEventArgs)
        If e.Button <> MouseButtons.Left OrElse DragIndex < 0 Then Exit Sub
        ColumnList.DoDragDrop(DragIndex, DragDropEffects.Move)
    End Sub

    Private Sub ColumnListDragOver(ByVal sender As Object, ByVal e As DragEventArgs)
        If e.Data.GetDataPresent(GetType(Integer)) Then e.Effect = DragDropEffects.Move Else e.Effect = DragDropEffects.None
    End Sub

    Private Sub ColumnListDragDrop(ByVal sender As Object, ByVal e As DragEventArgs)
        If Not e.Data.GetDataPresent(GetType(Integer)) Then Exit Sub
        Dim sourceIndex As Integer = CInt(e.Data.GetData(GetType(Integer)))
        Dim clientPoint As Point = ColumnList.PointToClient(New Point(e.X, e.Y))
        Dim targetIndex As Integer = ColumnList.IndexFromPoint(clientPoint)
        If targetIndex < 0 Then targetIndex = ColumnList.Items.Count - 1
        MoveListItem(sourceIndex, targetIndex)
        DragIndex = -1
    End Sub

    Private Sub MoveListItem(ByVal sourceIndex As Integer, ByVal targetIndex As Integer)
        If sourceIndex < 0 OrElse targetIndex < 0 OrElse sourceIndex = targetIndex Then Exit Sub
        Dim value As Object = ColumnList.Items(sourceIndex)
        Dim isChecked As Boolean = ColumnList.GetItemChecked(sourceIndex)
        ColumnList.Items.RemoveAt(sourceIndex)
        If targetIndex > ColumnList.Items.Count Then targetIndex = ColumnList.Items.Count
        ColumnList.Items.Insert(targetIndex, value)
        ColumnList.SetItemChecked(targetIndex, isChecked)
        RefreshItemPositions(targetIndex)
    End Sub

    Private Sub MoveUpClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim i As Integer = ColumnList.SelectedIndex
        If i <= 0 Then Exit Sub
        MoveListItem(i, i - 1)
    End Sub

    Private Sub MoveDownClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim i As Integer = ColumnList.SelectedIndex
        If i < 0 OrElse i >= ColumnList.Items.Count - 1 Then Exit Sub
        MoveListItem(i, i + 1)
    End Sub

    Private Sub MoveTopClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim i As Integer = ColumnList.SelectedIndex
        If i <= 0 Then Exit Sub
        MoveListItem(i, 0)
    End Sub

    Private Sub MoveBottomClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim i As Integer = ColumnList.SelectedIndex
        If i < 0 OrElse i >= ColumnList.Items.Count - 1 Then Exit Sub
        MoveListItem(i, ColumnList.Items.Count - 1)
    End Sub

    Private Sub ShowAllClicked(ByVal sender As Object, ByVal e As EventArgs)
        For i As Integer = 0 To ColumnList.Items.Count - 1
            ColumnList.SetItemChecked(i, True)
        Next
    End Sub

    Private Sub ApplyClicked(ByVal sender As Object, ByVal e As EventArgs)
        Try
            'Gán DisplayIndex theo đúng thứ tự danh sách. Dùng 2 bước để tránh xung đột DisplayIndex.
            For i As Integer = 0 To ColumnList.Items.Count - 1
                Dim item As BomColumnListItem = TryCast(ColumnList.Items(i), BomColumnListItem)
                If item IsNot Nothing Then item.Column.Visible = ColumnList.GetItemChecked(i)
            Next

            For i As Integer = 0 To ColumnList.Items.Count - 1
                Dim item As BomColumnListItem = TryCast(ColumnList.Items(i), BomColumnListItem)
                If item IsNot Nothing Then item.Column.DisplayIndex = i
            Next

            UpdateGridExcelHeaders()
            Me.DialogResult = DialogResult.OK
            Me.Close()
        Catch ex As Exception
            MessageBox.Show("Không thể áp dụng bố cục cột." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub UpdateGridExcelHeaders()
        Dim ordered As New List(Of DataGridViewColumn)()
        For Each col As DataGridViewColumn In _grid.Columns
            ordered.Add(col)
        Next
        ordered.Sort(Function(a As DataGridViewColumn, b As DataGridViewColumn) a.DisplayIndex.CompareTo(b.DisplayIndex))
        For i As Integer = 0 To ordered.Count - 1
            Dim cleanHeader As String = GetCleanColumnHeader(ordered(i))
            ordered(i).HeaderText = ColumnNumberToExcelLetter(i + 1) & vbCrLf & cleanHeader
        Next
        _grid.Invalidate()
    End Sub

    Private Sub CloseClicked(ByVal sender As Object, ByVal e As EventArgs)
        Me.Close()
    End Sub
End Class

'====================================================================
' MÁY TÍNH / THỐNG KÊ IPROPERTY
'====================================================================

'====================================================================
' DASHBOARD - CHỈ DÙNG CACHE RAM
'====================================================================

'####################################################################
' SECTION 18 - DASHBOARD FORM
' Thống kê và tổng quan BOM.
'####################################################################

Public Class BomDashboardForm
    Inherits Form
    Public Sub New(ByVal items As List(Of PartBomItem))
        Me.Text = "BOM DASHBOARD"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(760, 560)
        Me.Font = New Font("Segoe UI", 9.0F)
        Dim grid As New DataGridView()
        grid.Dock = DockStyle.Fill
        grid.ReadOnly = True
        grid.AllowUserToAddRows = False
        grid.RowHeadersVisible = False
        grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        grid.Columns.Add("METRIC", "CHỈ SỐ")
        grid.Columns.Add("VALUE", "GIÁ TRỊ")
        Dim totalQty As Integer = 0, purchased As Integer = 0, sheetMetal As Integer = 0
        Dim missingMaterial As Integer = 0, missingDescription As Integer = 0
        Dim totalMass As Double = 0, totalVolume As Double = 0, totalArea As Double = 0
        For Each item As PartBomItem In items
            totalQty += item.Quantity
            If item.IsPurchased Then purchased += 1
            If item.IsSheetMetal Then sheetMetal += 1
            If String.IsNullOrWhiteSpace(item.Material) Then missingMaterial += 1
            If String.IsNullOrWhiteSpace(item.Description) Then missingDescription += 1
            totalMass += item.Mass * item.Quantity
            totalVolume += item.Volume * item.Quantity
            totalArea += item.SurfaceArea * item.Quantity
        Next
        grid.Rows.Add("Unique Part", items.Count)
        grid.Rows.Add("Total Quantity", totalQty)
        grid.Rows.Add("Purchased", purchased)
        grid.Rows.Add("Manufactured", Math.Max(0, items.Count - purchased))
        grid.Rows.Add("Sheet Metal", sheetMetal)
        grid.Rows.Add("Missing Material", missingMaterial)
        grid.Rows.Add("Missing Description", missingDescription)
        grid.Rows.Add("Total Mass (" & BomUnitManager.MassUnit & ")", BomUnitManager.FormatValue(BomUnitManager.ConvertMass(totalMass)))
        grid.Rows.Add("Total Volume (" & BomUnitManager.VolumeUnit & ")", BomUnitManager.FormatValue(BomUnitManager.ConvertVolumeFromCm3(totalVolume)))
        grid.Rows.Add("Total Surface Area (" & BomUnitManager.AreaUnit & ")", BomUnitManager.FormatValue(BomUnitManager.ConvertAreaFromCm2(totalArea)))
        Me.Controls.Add(grid)
    End Sub
End Class

'====================================================================
' PROJECT CHECK - KHÔNG ĐỌC LẠI INVENTOR
'====================================================================

'####################################################################
' SECTION 19 - PROJECT CHECK FORM
' Kiểm tra dữ liệu, duplicate và mở Part từ danh sách lỗi.
'####################################################################

Public Enum BomValidationSeverity
    Critical = 0
    [Error] = 1
    Warning = 2
    Info = 3
End Enum

Public Class BomValidationRule
    Public Id As String = ""
    Public Name As String = ""
    Public Enabled As Boolean = True
    Public Severity As BomValidationSeverity = BomValidationSeverity.Warning
    Public Description As String = ""
    Public CanAutoFix As Boolean = False
End Class

Public Class BomValidationResult
    Public Item As PartBomItem = Nothing
    Public RuleId As String = ""
    Public RuleName As String = ""
    Public Severity As BomValidationSeverity = BomValidationSeverity.Warning
    Public Issue As String = ""
    Public CurrentValue As String = ""
    Public ExpectedValue As String = ""
    Public SuggestedValue As String = ""
    Public CanAutoFix As Boolean = False
    Public FixSafety As String = "REVIEW REQUIRED"
    Public FixPropertyInfo As PropertyColumnInfo = Nothing
    Public Status As String = "OPEN"
End Class

Public Class BomValidationEngine
    Private Const DesignTrackingId As String = "{32853F0F-3444-11D1-9E93-0060B03C1CA6}"

    Public Shared Function Run(ByVal items As List(Of PartBomItem), ByVal drawingStatus As System.Func(Of String, String)) As List(Of BomValidationResult)
        Dim results As New List(Of BomValidationResult)()
        If items Is Nothing Then Return results
        Dim pnMap As New Dictionary(Of String, List(Of PartBomItem))(StringComparer.OrdinalIgnoreCase)
        Dim stockMap As New Dictionary(Of String, List(Of PartBomItem))(StringComparer.OrdinalIgnoreCase)
        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            If String.IsNullOrWhiteSpace(item.PartNumber) Then
                Dim expected As String = ""
                Try : expected = IOPath.GetFileNameWithoutExtension(item.FileName) : Catch : End Try
                AddResult(results, item, "CORE.PN.MISSING", "Missing Part Number", BomValidationSeverity.Critical, "Part Number trống", item.PartNumber, expected, expected, expected.Length > 0, "SAFE", MakeProperty("Part Number"))
            Else
                Dim fileBase As String = ""
                Try : fileBase = IOPath.GetFileNameWithoutExtension(item.FileName) : Catch : End Try
                If fileBase.Length > 0 AndAlso Not String.Equals(item.PartNumber.Trim(), fileBase.Trim(), StringComparison.OrdinalIgnoreCase) Then AddResult(results, item, "CONSISTENCY.PN.FILE", "Filename ≠ Part Number", BomValidationSeverity.Warning, "Filename không trùng Part Number", item.PartNumber, fileBase, "", False, "REVIEW REQUIRED", Nothing)
            End If
            If String.IsNullOrWhiteSpace(item.Description) Then AddResult(results, item, "CORE.DESCRIPTION.MISSING", "Missing Description", BomValidationSeverity.Warning, "Description trống", "", "Có Description", "", False, "REVIEW REQUIRED", MakeProperty("Description"))
            If String.IsNullOrWhiteSpace(item.Material) AndAlso Not item.IsPurchased Then AddResult(results, item, "CORE.MATERIAL.MISSING", "Missing Material", BomValidationSeverity.Error, "Material trống", "", "Có Material", "", False, "REVIEW REQUIRED", MakeProperty("Material"))
            If String.IsNullOrWhiteSpace(item.StockNumber) Then AddResult(results, item, "CORE.STOCK.MISSING", "Missing Stock Number", BomValidationSeverity.Info, "Stock Number trống", "", "Có Stock Number", "", False, "REVIEW REQUIRED", MakeProperty("Stock Number"))
            If String.IsNullOrWhiteSpace(item.Revision) Then AddResult(results, item, "CORE.REVISION.MISSING", "Missing Revision", BomValidationSeverity.Info, "Revision trống", "", "Có Revision", "", False, "REVIEW REQUIRED", Nothing)
            If item.IsPurchased AndAlso String.IsNullOrWhiteSpace(item.Vendor) Then AddResult(results, item, "PURCHASED.VENDOR.MISSING", "Missing Vendor", BomValidationSeverity.Warning, "Purchased Part thiếu Vendor", "", "Có Vendor", "", False, "REVIEW REQUIRED", Nothing)
            If item.IsUnsaved Then AddResult(results, item, "FILE.UNSAVED", "Unsaved Document", BomValidationSeverity.Critical, "Document chưa được Save", item.FileName, "Saved file", "", False, "DESTRUCTIVE", Nothing)
            If item.IsReadOnly Then AddResult(results, item, "FILE.READONLY", "Read Only Document", BomValidationSeverity.Info, "Document Read Only", item.FileName, "Writable nếu cần chỉnh sửa", "", False, "REVIEW REQUIRED", Nothing)
            If drawingStatus IsNot Nothing AndAlso Not item.IsUnsaved Then
                Dim ds As String = "UNKNOWN"
                Try : ds = drawingStatus.Invoke(item.FilePath) : Catch : End Try
                If String.Equals(ds, "MISSING", StringComparison.OrdinalIgnoreCase) Then AddResult(results, item, "DRAWING.MISSING", "Missing Drawing", BomValidationSeverity.Warning, "Không tìm thấy Drawing", ds, "OK", "", False, "REVIEW REQUIRED", Nothing)
            End If
            AddIndex(pnMap, item.PartNumber, item)
            AddIndex(stockMap, item.StockNumber, item)
        Next
        AddDuplicateIntelligence(results, pnMap, True)
        AddDuplicateIntelligence(results, stockMap, False)
        AddFormatValidation(results, items)
        AddModelValidation(results, items)
        AddDrawingValidation(results, items, drawingStatus)
        AddGeometryDuplicateIntelligence(results, items)
        Return results
    End Function

    Private Shared Sub AddFormatValidation(ByVal results As List(Of BomValidationResult), ByVal items As List(Of PartBomItem))
        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            Dim pn As String = If(item.PartNumber, "").Trim()
            If pn.Length > 0 Then
                If pn.IndexOfAny(New Char() {"/"c, ChrW(92), ":"c, "*"c, "?"c, ChrW(34), "<"c, ">"c, "|"c}) >= 0 Then
                    AddResult(results,item,"FORMAT.PN.INVALID","Invalid Part Number format",BomValidationSeverity.Error,"Part Number chứa ký tự không hợp lệ",pn,"Không chứa ký tự cấm của tên file","",False,"REVIEW REQUIRED",MakeProperty("Part Number"))
                End If
                If Not String.Equals(pn, pn.Trim(), StringComparison.Ordinal) Then
                    AddResult(results,item,"FORMAT.PN.WHITESPACE","Part Number whitespace",BomValidationSeverity.Warning,"Part Number có khoảng trắng thừa",item.PartNumber,pn,pn,True,"SAFE",MakeProperty("Part Number"))
                End If
            End If
            Dim rev As String = If(item.Revision, "").Trim()
            If rev.Length > 0 AndAlso rev.Length > 12 Then
                AddResult(results,item,"FORMAT.REVISION.INVALID","Invalid Revision format",BomValidationSeverity.Warning,"Revision dài bất thường",rev,"<= 12 ký tự","",False,"REVIEW REQUIRED",Nothing)
            End If
            Dim desc As String = If(item.Description, "")
            If desc.Length > 0 AndAlso Not String.Equals(desc, desc.Trim(), StringComparison.Ordinal) Then
                AddResult(results,item,"FORMAT.DESCRIPTION.WHITESPACE","Description whitespace",BomValidationSeverity.Info,"Description có khoảng trắng đầu/cuối",desc,desc.Trim(),desc.Trim(),True,"SAFE",MakeProperty("Description"))
            End If
        Next
    End Sub

    Private Shared Sub AddModelValidation(ByVal results As List(Of BomValidationResult), ByVal items As List(Of PartBomItem))
        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            If Not item.IsUnsaved AndAlso Not String.IsNullOrWhiteSpace(item.FilePath) Then
                Try
                    If Not System.IO.File.Exists(item.FilePath) Then AddResult(results,item,"MODEL.FILE.MISSING","Missing model file",BomValidationSeverity.Critical,"File model không tồn tại",item.FilePath,"Existing file","",False,"DESTRUCTIVE",Nothing)
                Catch
                End Try
            End If
            If String.Equals(item.GeometryLoadState,"FAILED",StringComparison.OrdinalIgnoreCase) Then
                AddResult(results,item,"MODEL.GEOMETRY.FAILED","Geometry load failed",BomValidationSeverity.Error,"Không đọc được Geometry",item.GeometryLoadError,"Geometry readable","",False,"REVIEW REQUIRED",Nothing)
            ElseIf String.Equals(item.GeometryLoadState,"LOADED",StringComparison.OrdinalIgnoreCase) Then
                If item.Volume <= 0 Then AddResult(results,item,"MODEL.VOLUME.ZERO","Volume = 0",BomValidationSeverity.Error,"Model có Volume bằng 0",item.Volume.ToString(),"> 0","",False,"REVIEW REQUIRED",Nothing)
                If item.Mass <= 0 AndAlso Not item.IsVirtual Then AddResult(results,item,"MODEL.MASS.ZERO","Mass = 0",BomValidationSeverity.Warning,"Model có Mass bằng 0",item.Mass.ToString(),"> 0","",False,"REVIEW REQUIRED",Nothing)
            End If
            If item.IsReference Then AddResult(results,item,"MODEL.REFERENCE","Reference component",BomValidationSeverity.Info,"Component đang ở BOM Structure Reference",item.BomStructureText,"Intentional Reference","",False,"REVIEW REQUIRED",Nothing)
        Next
    End Sub

    Private Shared Sub AddDrawingValidation(ByVal results As List(Of BomValidationResult), ByVal items As List(Of PartBomItem), ByVal drawingStatus As System.Func(Of String, String))
        If drawingStatus Is Nothing Then Exit Sub
        For Each item As PartBomItem In items
            If item Is Nothing OrElse item.IsUnsaved Then Continue For
            Dim ds As String = "UNKNOWN"
            Try : ds = If(drawingStatus.Invoke(item.FilePath), "UNKNOWN").Trim().ToUpperInvariant() : Catch : ds="UNKNOWN" : End Try
            If ds="SKIPPED" Then Continue For
            If ds="UNKNOWN" Then AddResult(results,item,"DRAWING.UNKNOWN","Drawing status unknown",BomValidationSeverity.Info,"Không xác định được trạng thái Drawing",ds,"OK","",False,"REVIEW REQUIRED",Nothing)
            ' OUTDATED: kiểm tra drawing cùng tên cạnh model, không quét project lần nữa.
            Try
                Dim dir As String=System.IO.Path.GetDirectoryName(item.FilePath)
                Dim baseName As String=System.IO.Path.GetFileNameWithoutExtension(item.FilePath)
                Dim dp As String=""
                Dim idw As String=System.IO.Path.Combine(dir,baseName & ".idw")
                Dim dwg As String=System.IO.Path.Combine(dir,baseName & ".dwg")
                If System.IO.File.Exists(idw) Then
                    dp = idw
                ElseIf System.IO.File.Exists(dwg) Then
                    dp = dwg
                End If
                If dp.Length>0 AndAlso System.IO.File.GetLastWriteTimeUtc(item.FilePath)>System.IO.File.GetLastWriteTimeUtc(dp) Then
                    AddResult(results,item,"DRAWING.OUTDATED","Drawing Outdated",BomValidationSeverity.Warning,"Model mới hơn Drawing",System.IO.File.GetLastWriteTime(item.FilePath).ToString(),"Drawing >= Model","",False,"REVIEW REQUIRED",Nothing)
                End If
            Catch
            End Try
        Next
    End Sub

    Private Shared Sub AddGeometryDuplicateIntelligence(ByVal results As List(Of BomValidationResult), ByVal items As List(Of PartBomItem))
        Dim groups As New Dictionary(Of String,List(Of PartBomItem))(StringComparer.OrdinalIgnoreCase)
        For Each item As PartBomItem In items
            If item Is Nothing OrElse Not String.Equals(item.GeometryLoadState,"LOADED",StringComparison.OrdinalIgnoreCase) OrElse item.Volume<=0 Then Continue For
            Dim key As String=Math.Round(item.Volume,4).ToString("0.####",Globalization.CultureInfo.InvariantCulture) & "|" & Math.Round(item.SurfaceArea,4).ToString("0.####",Globalization.CultureInfo.InvariantCulture) & "|" & Math.Round(item.BoundingMinMm,2).ToString("0.##",Globalization.CultureInfo.InvariantCulture) & "|" & Math.Round(item.BoundingMidMm,2).ToString("0.##",Globalization.CultureInfo.InvariantCulture) & "|" & Math.Round(item.BoundingMaxMm,2).ToString("0.##",Globalization.CultureInfo.InvariantCulture) & "|" & If(item.Material,"").Trim()
            If Not groups.ContainsKey(key) Then groups(key)=New List(Of PartBomItem)()
            groups(key).Add(item)
        Next
        For Each pair As KeyValuePair(Of String,List(Of PartBomItem)) In groups
            If pair.Value.Count<2 Then Continue For
            Dim pn As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            Dim files As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            For Each item As PartBomItem In pair.Value
                pn.Add(If(item.PartNumber, ""))
                files.Add(If(item.FilePath, ""))
            Next
            If files.Count>1 AndAlso pn.Count>1 Then
                For Each item As PartBomItem In pair.Value
                    AddResult(results,item,"DUP.GEOMETRY.CANDIDATE","Possible Geometry Duplicate",BomValidationSeverity.Warning,"Geometry signature giống Part khác",item.PartNumber,"Review duplicate candidate","",False,"REVIEW REQUIRED",Nothing)
                Next
            End If
        Next
    End Sub

    Private Shared Sub AddIndex(ByVal map As Dictionary(Of String, List(Of PartBomItem)), ByVal key As String, ByVal item As PartBomItem)
        If String.IsNullOrWhiteSpace(key) Then Exit Sub
        If Not map.ContainsKey(key.Trim()) Then map(key.Trim()) = New List(Of PartBomItem)()
        map(key.Trim()).Add(item)
    End Sub

    Private Shared Sub AddDuplicateIntelligence(ByVal results As List(Of BomValidationResult), ByVal map As Dictionary(Of String, List(Of PartBomItem)), ByVal isPn As Boolean)
        For Each pair As KeyValuePair(Of String, List(Of PartBomItem)) In map
            If pair.Value.Count < 2 Then Continue For
            Dim files As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            For Each i As PartBomItem In pair.Value
                If i IsNot Nothing Then files.Add(If(i.FilePath, ""))
            Next
            Dim sev As BomValidationSeverity = If(files.Count > 1, BomValidationSeverity.Critical, BomValidationSeverity.Info)
            Dim label As String = If(isPn, If(files.Count > 1, "SAME PN + DIFFERENT FILE", "SAME PN + SAME FILE"), If(files.Count > 1, "SAME STOCK + DIFFERENT FILE", "SAME STOCK + SAME FILE"))
            For Each item As PartBomItem In pair.Value
                AddResult(results, item, If(isPn, "DUP.PN", "DUP.STOCK"), label, sev, label & ": " & pair.Key, pair.Key, "Unique/intentional", "", False, "REVIEW REQUIRED", Nothing)
            Next
        Next
    End Sub

    Private Shared Function MakeProperty(ByVal name As String) As PropertyColumnInfo
        Dim p As New PropertyColumnInfo()
        p.PropertyName = name : p.PropertySetInternalName = DesignTrackingId : p.PropertySetDisplayName = "Design Tracking Properties"
        p.Key = DesignTrackingId & "|" & name : p.DisplayText = name
        Return p
    End Function

    Private Shared Sub AddResult(ByVal list As List(Of BomValidationResult), ByVal item As PartBomItem, ByVal id As String, ByVal ruleName As String, ByVal severity As BomValidationSeverity, ByVal issue As String, ByVal currentValue As String, ByVal expected As String, ByVal suggested As String, ByVal canFix As Boolean, ByVal safety As String, ByVal p As PropertyColumnInfo)
        Dim r As New BomValidationResult()
        r.Item=item : r.RuleId=id : r.RuleName=ruleName : r.Severity=severity : r.Issue=issue : r.CurrentValue=If(currentValue,"") : r.ExpectedValue=If(expected,"") : r.SuggestedValue=If(suggested,"") : r.CanAutoFix=canFix : r.FixSafety=safety : r.FixPropertyInfo=p
        list.Add(r)
    End Sub
End Class

Public Class BomProjectCheckForm
    Inherits Form
    Private _items As List(Of PartBomItem)
    Private _openPartCallback As System.Action(Of PartBomItem)
    Private _drawingStatus As System.Func(Of String, String)
    Private _stageFix As System.Action(Of BomValidationResult)
    Private _grid As DataGridView
    Private _results As New List(Of BomValidationResult)()
    Private _filter As ComboBox
    Private _summary As Label

    Public Sub New(ByVal items As List(Of PartBomItem), ByVal openPartCallback As System.Action(Of PartBomItem), ByVal drawingStatus As System.Func(Of String, String), ByVal stageFix As System.Action(Of BomValidationResult))
        _items=If(items, New List(Of PartBomItem)()) : _openPartCallback=openPartCallback : _drawingStatus=drawingStatus : _stageFix=stageFix
        Me.Text="VALIDATION ENGINE 2.0" : Me.StartPosition=FormStartPosition.CenterParent : Me.Size=New Size(1320,720) : Me.Font=New Font("Segoe UI",9.0F)
        Dim top As New FlowLayoutPanel() : top.Dock=DockStyle.Top : top.Height=48 : top.Padding=New Padding(8)
        Dim runBtn As New Button() : runBtn.Text="RUN VALIDATION" : runBtn.Width=130 : AddHandler runBtn.Click, AddressOf RunClicked : top.Controls.Add(runBtn)
        _filter=New ComboBox() : _filter.DropDownStyle=ComboBoxStyle.DropDownList : _filter.Width=130 : _filter.Items.AddRange(New Object(){"ALL","CRITICAL","ERROR","WARNING","INFO"}) : _filter.SelectedIndex=0 : AddHandler _filter.SelectedIndexChanged, AddressOf FilterChanged : top.Controls.Add(_filter)
        Dim fixBtn As New Button() : fixBtn.Text="FIX ALL SAFE" : fixBtn.Width=120 : AddHandler fixBtn.Click, AddressOf FixAllSafeClicked : top.Controls.Add(fixBtn)
        Dim fixSelectedBtn As New Button() : fixSelectedBtn.Text="FIX SELECTED SAFE" : fixSelectedBtn.Width=140 : AddHandler fixSelectedBtn.Click, AddressOf FixSelectedSafeClicked : top.Controls.Add(fixSelectedBtn)
        _summary=New Label() : _summary.AutoSize=True : _summary.Padding=New Padding(12,7,0,0) : top.Controls.Add(_summary)
        _grid=New DataGridView() : _grid.Dock=DockStyle.Fill : _grid.ReadOnly=True : _grid.AllowUserToAddRows=False : _grid.RowHeadersVisible=False : _grid.SelectionMode=DataGridViewSelectionMode.FullRowSelect : _grid.AutoSizeColumnsMode=DataGridViewAutoSizeColumnsMode.None
        AddCol("SEVERITY","STATUS",85) : AddCol("PART","PART NUMBER",130) : AddCol("FILE","FILE",180) : AddCol("RULE","RULE",190) : AddCol("ISSUE","ISSUE",260) : AddCol("CURRENT","CURRENT",140) : AddCol("EXPECTED","EXPECTED",140) : AddCol("FIX","FIX",150) : AddCol("STATE","STATE",85)
        AddHandler _grid.CellDoubleClick, AddressOf GridDoubleClicked
        Me.Controls.Add(_grid) : Me.Controls.Add(top)
        RunValidation()
    End Sub
    Private Sub AddCol(ByVal n As String, ByVal h As String, ByVal w As Integer)
        Dim c As New DataGridViewTextBoxColumn() : c.Name=n : c.HeaderText=h : c.Width=w : _grid.Columns.Add(c)
    End Sub
    Private Sub RunClicked(ByVal s As Object, ByVal e As EventArgs)
        RunValidation()
    End Sub
    Private Sub RunValidation()
        Me.Cursor=Cursors.WaitCursor
        Try
            _results = BomValidationEngine.Run(_items, _drawingStatus)
            LoadRows()
        Finally
            Me.Cursor = Cursors.Default
        End Try
    End Sub
    Private Sub FilterChanged(ByVal s As Object, ByVal e As EventArgs)
        LoadRows()
    End Sub
    Private Sub LoadRows()
        _grid.Rows.Clear()
        Dim f As String=If(_filter Is Nothing OrElse _filter.SelectedItem Is Nothing,"ALL",Convert.ToString(_filter.SelectedItem))
        Dim c0 As Integer=0,c1 As Integer=0,c2 As Integer=0,c3 As Integer=0
        For Each r As BomValidationResult In _results
            Select Case r.Severity
                Case BomValidationSeverity.Critical
                    c0 += 1
                Case BomValidationSeverity.Error
                    c1 += 1
                Case BomValidationSeverity.Warning
                    c2 += 1
                Case Else
                    c3 += 1
            End Select
            Dim sev As String=r.Severity.ToString().ToUpperInvariant()
            If f<>"ALL" AndAlso f<>sev Then Continue For
            Dim fixText As String=If(r.CanAutoFix, r.FixSafety & ": " & r.SuggestedValue, "-")
            Dim idx As Integer=_grid.Rows.Add(sev,r.Item.PartNumber,r.Item.FileName,r.RuleName,r.Issue,r.CurrentValue,r.ExpectedValue,fixText,r.Status) : _grid.Rows(idx).Tag=r
        Next
        _summary.Text = "CRITICAL " & c0.ToString() &
                        "   ERROR " & c1.ToString() &
                        "   WARNING " & c2.ToString() &
                        "   INFO " & c3.ToString() &
                        "   | TOTAL " & _results.Count.ToString()
    End Sub
    Private Sub FixAllSafeClicked(ByVal s As Object, ByVal e As EventArgs)
        Dim staged As Integer=0
        For Each r As BomValidationResult In _results
            If r.CanAutoFix AndAlso String.Equals(r.FixSafety,"SAFE",StringComparison.OrdinalIgnoreCase) AndAlso r.Status="OPEN" Then
                If _stageFix IsNot Nothing Then _stageFix.Invoke(r) : staged+=1
            End If
        Next
        LoadRows()
        MessageBox.Show(staged.ToString() & " SAFE fix đã được STAGE. Inventor CHƯA bị ghi. Dùng REVIEW / COMMIT ở cửa sổ BOM chính.","VALIDATION ENGINE",MessageBoxButtons.OK,MessageBoxIcon.Information)
    End Sub
    Private Sub FixSelectedSafeClicked(ByVal s As Object, ByVal e As EventArgs)
        Dim staged As Integer=0
        For Each row As DataGridViewRow In _grid.SelectedRows
            Dim r As BomValidationResult=TryCast(row.Tag,BomValidationResult)
            If r Is Nothing Then Continue For
            If r.CanAutoFix AndAlso String.Equals(r.FixSafety,"SAFE",StringComparison.OrdinalIgnoreCase) AndAlso r.Status="OPEN" Then
                If _stageFix IsNot Nothing Then _stageFix.Invoke(r) : staged+=1
            End If
        Next
        LoadRows()
        MessageBox.Show(staged.ToString() & " SAFE fix đã được STAGE từ các dòng chọn. Dùng REVIEW / COMMIT ở BOM chính.","VALIDATION ENGINE",MessageBoxButtons.OK,MessageBoxIcon.Information)
    End Sub
    Private Sub GridDoubleClicked(ByVal s As Object, ByVal e As DataGridViewCellEventArgs)
        If e.RowIndex<0 Then Exit Sub
        Dim r As BomValidationResult=TryCast(_grid.Rows(e.RowIndex).Tag,BomValidationResult)
        If r IsNot Nothing AndAlso r.Item IsNot Nothing AndAlso _openPartCallback IsNot Nothing Then _openPartCallback.Invoke(r.Item)
    End Sub
End Class


'####################################################################
' SECTION 20 - CALCULATOR / ANALYTICS FORM
' Tính tổng, trung bình, min/max và phân tích theo phạm vi dữ liệu.
'####################################################################

Public Class BomCalculatorForm
    Inherits Form

    Private AllItems As List(Of PartBomItem)
    Private FilteredItems As List(Of PartBomItem)
    Private SelectedItems As List(Of PartBomItem)
    Private AssemblyItems As List(Of PartBomItem)
    Private Properties As List(Of PropertyColumnInfo)
    Private ScopeCombo As ComboBox
    Private PropertyCombo As ComboBox
    Private OperationCombo As ComboBox
    Private SearchBox As TextBox
    Private ResultBox As TextBox
    Private PropertyOptions As New List(Of Object)()

    Public Sub New(ByVal allRows As List(Of PartBomItem), ByVal filteredRows As List(Of PartBomItem), ByVal selectedRows As List(Of PartBomItem), ByVal assemblyRows As List(Of PartBomItem), ByVal properties As List(Of PropertyColumnInfo))
        AllItems = If(allRows, New List(Of PartBomItem)())
        FilteredItems = If(filteredRows, New List(Of PartBomItem)())
        SelectedItems = If(selectedRows, New List(Of PartBomItem)())
        AssemblyItems = If(assemblyRows, New List(Of PartBomItem)())
        Properties = If(properties, New List(Of PropertyColumnInfo)())
        BuildInterface()
        LoadPropertyOptions("")
    End Sub

    Private Sub BuildInterface()
        Me.Text = "MÁY TÍNH & THỐNG KÊ BOM"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(760, 650)
        Me.MinimumSize = New Size(680, 560)
        Me.Font = New Font("Segoe UI", 9.0F)
        Me.BackColor = Color.FromArgb(246, 250, 252)

        Dim title As New Label()
        title.Text = "TÍNH TOÁN / THỐNG KÊ iPROPERTY"
        title.Font = New Font("Segoe UI", 14.0F, FontStyle.Bold)
        title.ForeColor = Color.FromArgb(35, 110, 130)
        title.Location = New Point(20, 16)
        title.AutoSize = True
        Me.Controls.Add(title)

        AddLabel("Phạm vi:", 22, 68)
        ScopeCombo = New ComboBox()
        ScopeCombo.DropDownStyle = ComboBoxStyle.DropDownList
        ScopeCombo.Location = New Point(145, 64)
        ScopeCombo.Size = New Size(280, 28)
        ScopeCombo.Items.AddRange(New Object() {"Toàn bộ BOM", "Các dòng đang lọc", "Các dòng đang chọn", "Assembly đang chọn"})
        ScopeCombo.SelectedIndex = 0
        Me.Controls.Add(ScopeCombo)

        AddLabel("Tìm iProperty:", 22, 108)
        SearchBox = New TextBox()
        SearchBox.Location = New Point(145, 104)
        SearchBox.Size = New Size(280, 27)
        AddHandler SearchBox.TextChanged, AddressOf SearchChanged
        Me.Controls.Add(SearchBox)

        AddLabel("iProperty:", 22, 148)
        PropertyCombo = New ComboBox()
        PropertyCombo.DropDownStyle = ComboBoxStyle.DropDownList
        PropertyCombo.Location = New Point(145, 144)
        PropertyCombo.Size = New Size(480, 28)
        Me.Controls.Add(PropertyCombo)

        AddLabel("Phép tính:", 22, 188)
        OperationCombo = New ComboBox()
        OperationCombo.DropDownStyle = ComboBoxStyle.DropDownList
        OperationCombo.Location = New Point(145, 184)
        OperationCombo.Size = New Size(280, 28)
        OperationCombo.Items.AddRange(New Object() {"Tổng", "Tổng × QTY", "Trung bình", "Nhỏ nhất", "Lớn nhất", "Đếm dòng có dữ liệu", "Thống kê theo giá trị"})
        OperationCombo.SelectedIndex = 0
        Me.Controls.Add(OperationCombo)

        Dim calcButton As New Button()
        calcButton.Text = "TÍNH"
        calcButton.Font = New Font("Segoe UI", 9.5F, FontStyle.Bold)
        calcButton.BackColor = Color.FromArgb(211, 240, 245)
        calcButton.Location = New Point(445, 182)
        calcButton.Size = New Size(90, 34)
        AddHandler calcButton.Click, AddressOf CalculateClicked
        Me.Controls.Add(calcButton)

        Dim copyButton As New Button()
        copyButton.Text = "COPY"
        copyButton.Location = New Point(545, 182)
        copyButton.Size = New Size(80, 34)
        AddHandler copyButton.Click, AddressOf CopyClicked
        Me.Controls.Add(copyButton)

        ResultBox = New TextBox()
        ResultBox.Location = New Point(22, 235)
        ResultBox.Size = New Size(700, 340)
        ResultBox.Multiline = True
        ResultBox.ScrollBars = ScrollBars.Both
        ResultBox.ReadOnly = True
        ResultBox.Font = New Font("Consolas", 10.0F)
        ResultBox.BackColor = Color.White
        ResultBox.Anchor = AnchorStyles.Top Or AnchorStyles.Bottom Or AnchorStyles.Left Or AnchorStyles.Right
        Me.Controls.Add(ResultBox)

        Dim closeButton As New Button()
        closeButton.Text = "ĐÓNG"
        closeButton.Location = New Point(632, 587)
        closeButton.Size = New Size(90, 34)
        closeButton.Anchor = AnchorStyles.Bottom Or AnchorStyles.Right
        AddHandler closeButton.Click, Sub(sender As Object, e As EventArgs) Me.Close()
        Me.Controls.Add(closeButton)
    End Sub

    Private Sub AddLabel(ByVal text As String, ByVal x As Integer, ByVal y As Integer)
        Dim l As New Label()
        l.Text = text
        l.Location = New Point(x, y)
        l.AutoSize = True
        Me.Controls.Add(l)
    End Sub

    Private Sub SearchChanged(ByVal sender As Object, ByVal e As EventArgs)
        LoadPropertyOptions(SearchBox.Text)
    End Sub

    Private Sub LoadPropertyOptions(ByVal filter As String)
        PropertyCombo.Items.Clear()
        PropertyOptions.Clear()
        AddOption("QTY", Nothing, filter)
        For Each p As PropertyColumnInfo In Properties
            AddOption(p.PropertyName & " [" & p.PropertySetDisplayName & "]", p, filter)
        Next
        If PropertyCombo.Items.Count > 0 Then PropertyCombo.SelectedIndex = 0
    End Sub

    Private Sub AddOption(ByVal caption As String, ByVal value As Object, ByVal filter As String)
        If filter IsNot Nothing AndAlso filter.Trim().Length > 0 AndAlso caption.IndexOf(filter.Trim(), StringComparison.OrdinalIgnoreCase) < 0 Then Exit Sub
        PropertyCombo.Items.Add(caption)
        PropertyOptions.Add(value)
    End Sub

    Private Function GetScopeItems() As List(Of PartBomItem)
        Select Case ScopeCombo.SelectedIndex
            Case 1 : Return FilteredItems
            Case 2 : Return SelectedItems
            Case 3 : Return AssemblyItems
            Case Else : Return AllItems
        End Select
    End Function

    Private Function GetValue(ByVal item As PartBomItem, ByVal propertyOption As Object) As String
        If item Is Nothing Then Return ""
        If propertyOption Is Nothing Then Return item.Quantity.ToString()
        Dim p As PropertyColumnInfo = TryCast(propertyOption, PropertyColumnInfo)
        If p Is Nothing Then Return ""
        If item.SelectedPropertyValues.ContainsKey(p.Key) Then Return Convert.ToString(item.SelectedPropertyValues(p.Key))
        Return ""
    End Function

    Private Function TryNumber(ByVal text As String, ByRef value As Double) As Boolean
        Dim cleaned As String = If(text, "").Trim().Replace(" ", "")
        If Double.TryParse(cleaned, Globalization.NumberStyles.Any, Globalization.CultureInfo.CurrentCulture, value) Then Return True
        If Double.TryParse(cleaned.Replace(",", "."), Globalization.NumberStyles.Any, Globalization.CultureInfo.InvariantCulture, value) Then Return True
        Return False
    End Function

    Private Function SumNumbers(ByVal values As List(Of Double)) As Double
        Dim result As Double = 0
        For Each value As Double In values
            result += value
        Next
        Return result
    End Function

    Private Function AverageNumbers(ByVal values As List(Of Double)) As Double
        If values Is Nothing OrElse values.Count = 0 Then Return 0
        Return SumNumbers(values) / CDbl(values.Count)
    End Function

    Private Function MinimumNumber(ByVal values As List(Of Double)) As Double
        If values Is Nothing OrElse values.Count = 0 Then Return 0
        Dim result As Double = values(0)
        For Each value As Double In values
            If value < result Then result = value
        Next
        Return result
    End Function

    Private Function MaximumNumber(ByVal values As List(Of Double)) As Double
        If values Is Nothing OrElse values.Count = 0 Then Return 0
        Dim result As Double = values(0)
        For Each value As Double In values
            If value > result Then result = value
        Next
        Return result
    End Function

    Private Function SumIntegerValues(ByVal values As SortedDictionary(Of String, Integer)) As Integer
        Dim result As Integer = 0
        For Each pair As KeyValuePair(Of String, Integer) In values
            result += pair.Value
        Next
        Return result
    End Function

    Private Sub CalculateClicked(ByVal sender As Object, ByVal e As EventArgs)
        If PropertyCombo.SelectedIndex < 0 Then Exit Sub
        Dim rows As List(Of PartBomItem) = GetScopeItems()
        Dim propertyOption As Object = PropertyOptions(PropertyCombo.SelectedIndex)
        Dim propertyCaption As String = Convert.ToString(PropertyCombo.SelectedItem)
        Dim operation As String = Convert.ToString(OperationCombo.SelectedItem)
        Dim numbers As New List(Of Double)()
        Dim weightedSum As Double = 0
        Dim groups As New SortedDictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)

        For Each item As PartBomItem In rows
            Dim raw As String = GetValue(item, propertyOption)
            If raw.Trim().Length > 0 Then
                If Not groups.ContainsKey(raw) Then groups(raw) = 0
                groups(raw) += Math.Max(1, item.Quantity)
            End If
            Dim number As Double = 0
            If TryNumber(raw, number) Then
                numbers.Add(number)
                weightedSum += number * Math.Max(1, item.Quantity)
            End If
        Next

        Dim sb As New System.Text.StringBuilder()
        sb.AppendLine("BOM TOOL PRO V9 - CALCULATION")
        sb.AppendLine("Phạm vi: " & Convert.ToString(ScopeCombo.SelectedItem))
        sb.AppendLine("iProperty: " & propertyCaption)
        sb.AppendLine("Phép tính: " & operation)
        sb.AppendLine(New String("-"c, 56))

        If operation = "Thống kê theo giá trị" Then
            For Each pair As KeyValuePair(Of String, Integer) In groups
                sb.AppendLine(pair.Key.PadRight(38) & pair.Value.ToString().PadLeft(10))
            Next
            sb.AppendLine(New String("-"c, 56))
            sb.AppendLine("Số nhóm: " & groups.Count.ToString())
        ElseIf operation = "Đếm dòng có dữ liệu" Then
            sb.AppendLine("Kết quả: " & SumIntegerValues(groups).ToString())
        ElseIf numbers.Count = 0 Then
            sb.AppendLine("Không có dữ liệu số hợp lệ trong phạm vi đã chọn.")
        Else
            Dim result As Double = 0
            Select Case operation
                Case "Tổng × QTY" : result = weightedSum
                Case "Trung bình" : result = AverageNumbers(numbers)
                Case "Nhỏ nhất" : result = MinimumNumber(numbers)
                Case "Lớn nhất" : result = MaximumNumber(numbers)
                Case Else : result = SumNumbers(numbers)
            End Select
            sb.AppendLine("Kết quả: " & result.ToString("0.####"))
            sb.AppendLine("Số dòng số hợp lệ: " & numbers.Count.ToString())
            sb.AppendLine("Tổng có nhân QTY: " & weightedSum.ToString("0.####"))
        End If
        ResultBox.Text = sb.ToString()
    End Sub

    Private Sub CopyClicked(ByVal sender As Object, ByVal e As EventArgs)
        If ResultBox.Text.Length > 0 Then Clipboard.SetText(ResultBox.Text)
    End Sub
End Class

