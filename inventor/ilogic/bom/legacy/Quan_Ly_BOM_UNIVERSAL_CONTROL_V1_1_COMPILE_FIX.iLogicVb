Public Class BomUiTheme
    Public Shared ReadOnly Background As Color = Color.FromArgb(246, 249, 251)
    Public Shared ReadOnly Surface As Color = Color.White
    Public Shared ReadOnly Border As Color = Color.FromArgb(210, 220, 226)
    Public Shared ReadOnly Accent As Color = Color.FromArgb(36, 112, 140)
    Public Shared ReadOnly TextPrimary As Color = Color.FromArgb(38, 52, 60)
    Public Shared ReadOnly TextSecondary As Color = Color.FromArgb(92, 108, 116)
    Public Shared ReadOnly UiFont As New Font("Segoe UI", 9.0F)
End Class

Public Class BomUiFactory
    Public Shared Function ActionButton(ByVal caption As String, ByVal handler As EventHandler) As Button
        Return ActionButton(caption, handler, False)
    End Function

    Public Shared Function ActionButton(ByVal caption As String, ByVal handler As EventHandler, ByVal isPrimary As Boolean) As Button
        Dim b As New Button()
        b.Text = caption
        b.AutoSize = True
        b.Height = 30
        b.Padding = New Padding(10, 0, 10, 0)
        b.FlatStyle = FlatStyle.Flat
        b.Font = BomUiTheme.UiFont
        b.FlatAppearance.BorderColor = BomUiTheme.Border
        If isPrimary Then
            b.BackColor = BomUiTheme.Accent
            b.ForeColor = Color.White
            b.FlatAppearance.BorderColor = BomUiTheme.Accent
        Else
            b.BackColor = BomUiTheme.Surface
            b.ForeColor = BomUiTheme.TextPrimary
        End If
        If handler IsNot Nothing Then AddHandler b.Click, handler
        Return b
    End Function
End Class

Public Class BomDialogBase
    Inherits Form

    Protected HeaderTitle As Label
    Protected HeaderSubtitle As Label
    Protected ContentHost As Panel
    Protected ActionBar As FlowLayoutPanel

    Public Sub New()
        Me.Font = BomUiTheme.UiFont
        Me.BackColor = BomUiTheme.Background
        Me.StartPosition = FormStartPosition.CenterParent
        Me.MinimizeBox = False
        Me.MaximizeBox = False
        Me.ShowInTaskbar = False

        Dim root As New TableLayoutPanel()
        root.Dock = DockStyle.Fill
        root.ColumnCount = 1
        root.RowCount = 3
        root.RowStyles.Add(New RowStyle(SizeType.Absolute, 82.0F))
        root.RowStyles.Add(New RowStyle(SizeType.Percent, 100.0F))
        root.RowStyles.Add(New RowStyle(SizeType.Absolute, 54.0F))
        Me.Controls.Add(root)

        Dim header As New Panel()
        header.Dock = DockStyle.Fill
        header.BackColor = BomUiTheme.Surface
        header.Padding = New Padding(16, 12, 16, 8)

        HeaderTitle = New Label()
        HeaderTitle.Dock = DockStyle.Top
        HeaderTitle.Height = 28
        HeaderTitle.Font = New Font("Segoe UI", 12.0F, FontStyle.Bold)
        HeaderTitle.ForeColor = BomUiTheme.TextPrimary

        HeaderSubtitle = New Label()
        HeaderSubtitle.Dock = DockStyle.Fill
        HeaderSubtitle.Font = BomUiTheme.UiFont
        HeaderSubtitle.ForeColor = BomUiTheme.TextSecondary
        HeaderSubtitle.Padding = New Padding(0, 3, 0, 0)

        header.Controls.Add(HeaderSubtitle)
        header.Controls.Add(HeaderTitle)
        root.Controls.Add(header, 0, 0)

        ContentHost = New Panel()
        ContentHost.Dock = DockStyle.Fill
        ContentHost.BackColor = BomUiTheme.Background
        ContentHost.Padding = New Padding(12)
        root.Controls.Add(ContentHost, 0, 1)

        ActionBar = New FlowLayoutPanel()
        ActionBar.Dock = DockStyle.Fill
        ActionBar.FlowDirection = FlowDirection.RightToLeft
        ActionBar.WrapContents = False
        ActionBar.Padding = New Padding(10, 10, 10, 8)
        ActionBar.BackColor = BomUiTheme.Surface
        root.Controls.Add(ActionBar, 0, 2)
    End Sub

    Protected Sub SetHeader(ByVal title As String, ByVal subtitle As String)
        HeaderTitle.Text = If(title, "")
        HeaderSubtitle.Text = If(subtitle, "")
    End Sub
End Class

