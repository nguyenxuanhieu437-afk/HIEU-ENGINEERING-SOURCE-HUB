    Private Sub ManageColumnsClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim form As New BomColumnManagerForm(Grid)
        form.ShowDialog(Me)
        ApplySearchFilter()
    End Sub

    Private Sub SaveLayoutClicked(ByVal sender As Object, ByVal e As EventArgs)
        SaveLayout(True)
    End Sub

    Private Sub SaveLayout(ByVal showMessage As Boolean)
        Try
            Dim lines As New List(Of String)()
            For Each column As DataGridViewColumn In Grid.Columns
                lines.Add(column.Name & "|" & column.DisplayIndex.ToString() & "|" & column.Width.ToString() & "|" & column.Visible.ToString())
            Next
            System.IO.File.WriteAllLines(_layoutFile, lines.ToArray(), System.Text.Encoding.UTF8)
            If showMessage Then MessageBox.Show("Đã lưu bố cục cột.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
        Catch ex As Exception
            MessageBox.Show("Không lưu được bố cục." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub LoadLayoutClicked(ByVal sender As Object, ByVal e As EventArgs)
        TryLoadLayout(True)
    End Sub

    Private Sub TryLoadLayout(ByVal showMessage As Boolean)
        Try
            If Not System.IO.File.Exists(_layoutFile) Then
                If showMessage Then MessageBox.Show("Chưa có bố cục đã lưu.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If
            Dim records As New List(Of String())()
            For Each line As String In System.IO.File.ReadAllLines(_layoutFile, System.Text.Encoding.UTF8)
                Dim parts() As String = line.Split("|"c)
                If parts.Length >= 4 Then records.Add(parts)
            Next
            records.Sort(Function(a As String(), b As String()) Convert.ToInt32(a(1)).CompareTo(Convert.ToInt32(b(1))))
            Dim displayIndex As Integer = 0
            For Each parts() As String In records
                If Grid.Columns.Contains(parts(0)) Then
                    Dim col As DataGridViewColumn = Grid.Columns(parts(0))
                    col.Width = Math.Max(45, Convert.ToInt32(parts(2)))
                    col.Visible = Convert.ToBoolean(parts(3))
                    col.DisplayIndex = Math.Min(displayIndex, Grid.Columns.Count - 1)
                    displayIndex += 1
                End If
            Next
            If showMessage Then MessageBox.Show("Đã nạp bố cục cột.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
        Catch ex As Exception
            If showMessage Then MessageBox.Show("Không nạp được bố cục." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub ResetLayoutClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim displayIndex As Integer = 0
        For Each column As DataGridViewColumn In Grid.Columns
            column.Visible = True
            column.DisplayIndex = displayIndex
            displayIndex += 1
        Next
        Grid.AutoResizeColumns(System.Windows.Forms.DataGridViewAutoSizeColumnsMode.DisplayedCells)
    End Sub


'####################################################################
' SUBSECTION 15.14 - OPEN PART / DRAWING / DRAWING INDEX
'####################################################################

    Private Sub OpenPartClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.CurrentRow IsNot Nothing AndAlso IsAssemblyHeaderRow(Grid.CurrentRow) Then
            OpenAssemblySelected()
        Else
            OpenPart(GetCurrentItem())
        End If
    End Sub

    Private Sub OpenPart(ByVal item As PartBomItem)
        If item Is Nothing OrElse String.IsNullOrWhiteSpace(item.FilePath) Then Exit Sub
        Try
            _inventor.Documents.Open(item.FilePath, True)
        Catch ex As Exception
            MessageBox.Show("Không mở được Part." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub OpenDrawingClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.CurrentRow IsNot Nothing AndAlso IsAssemblyHeaderRow(Grid.CurrentRow) Then
            Dim assemblyPath As String = GetCurrentAssemblyPath()
            If assemblyPath.Length = 0 Then Exit Sub
            Dim drawingPath As String = FindDrawingPath(assemblyPath)
            If drawingPath.Length = 0 Then
                MessageBox.Show("Không tìm thấy Drawing của Assembly đang chọn.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If
            Try : _inventor.Documents.Open(drawingPath, True) : Catch ex As Exception : MessageBox.Show("Không mở được Drawing Assembly." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error) : End Try
        Else
            OpenDrawing(GetCurrentItem())
        End If
    End Sub

    'Mở Drawing của Part được truyền vào.
    'Được dùng chung cho nút trên thanh công cụ, menu chuột phải
    'và thao tác nhấn chuột trái một lần tại cột DRAWING.
    Private Sub OpenDrawing(ByVal item As PartBomItem)
        If item Is Nothing Then Exit Sub

        Dim drawingPath As String = FindDrawingPath(item.FilePath)

        If String.IsNullOrWhiteSpace(drawingPath) Then
            MessageBox.Show( _
                "Không tìm thấy bản vẽ IDW hoặc DWG của Part:" & vbCrLf & _
                item.FileName & vbCrLf & vbCrLf & _
                "Bạn có thể dùng chức năng CHỈ ĐỊNH DRAWING để chọn file thủ công.", _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Information)
            Exit Sub
        End If

        Try
            _inventor.Documents.Open(drawingPath, True)
        Catch ex As Exception
            MessageBox.Show( _
                "Không mở được Drawing." & vbCrLf & ex.Message, _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Error)
        End Try
    End Sub

    Private Function FindDrawingPath(ByVal partPath As String) As String
        BomPerformanceCounters.DrawingSearch += 1
        If String.IsNullOrWhiteSpace(partPath) Then Return ""

        '1. Đường dẫn do người dùng chỉ định trước đó
        If _manualDrawingMap.ContainsKey(partPath) Then
            Dim mappedPath As String = _manualDrawingMap(partPath)
            If System.IO.File.Exists(mappedPath) Then Return mappedPath
        End If

        Dim folder As String = IOPath.GetDirectoryName(partPath)
        Dim baseName As String = IOPath.GetFileNameWithoutExtension(partPath)

        '2. Drawing nằm cùng thư mục với Part
        Dim idw As String = IOPath.Combine(folder, baseName & ".idw")
        If System.IO.File.Exists(idw) Then Return idw
        Dim dwg As String = IOPath.Combine(folder, baseName & ".dwg")
        If System.IO.File.Exists(dwg) Then Return dwg

        '3. Tra trong chỉ mục Drawing đã quét một lần khi mở BOM
        If _drawingIndex.ContainsKey(baseName) Then
            Dim indexedPath As String = _drawingIndex(baseName)
            If System.IO.File.Exists(indexedPath) Then Return indexedPath
        End If

        Return ""
    End Function

    '================================================================
    ' TẠO CHỈ MỤC DRAWING MỘT LẦN, KHÔNG TÌM LẠI CHO TỪNG DÒNG
    '================================================================
    Private Sub BuildDrawingIndex()
        Dim drawingWatch As Stopwatch = Stopwatch.StartNew()
        _drawingIndex.Clear()

        Dim folders As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        AddFolderIfValid(folders, IOPath.GetDirectoryName(_assemblyPath))

        For Each item As PartBomItem In _allItems
            If item Is Nothing OrElse String.IsNullOrWhiteSpace(item.FilePath) Then Continue For
            Dim partFolder As String = IOPath.GetDirectoryName(item.FilePath)
            AddFolderIfValid(folders, partFolder)

            Dim parentFolder As String = IOPath.GetDirectoryName(partFolder)
            If Not String.IsNullOrWhiteSpace(parentFolder) Then
                AddKnownDrawingFolders(folders, parentFolder)
                Dim grandParent As String = IOPath.GetDirectoryName(parentFolder)
                If Not String.IsNullOrWhiteSpace(grandParent) Then AddKnownDrawingFolders(folders, grandParent)
            End If
        Next

        Dim assemblyFolder As String = IOPath.GetDirectoryName(_assemblyPath)
        If Not String.IsNullOrWhiteSpace(assemblyFolder) Then
            AddKnownDrawingFolders(folders, assemblyFolder)
            Dim assemblyParent As String = IOPath.GetDirectoryName(assemblyFolder)
            If Not String.IsNullOrWhiteSpace(assemblyParent) Then AddKnownDrawingFolders(folders, assemblyParent)
        End If

        For Each folder As String In folders
            IndexDrawingFilesInFolder(folder)
        Next
        drawingWatch.Stop()
        BomPerformanceCounters.DrawingIndexMs += drawingWatch.ElapsedMilliseconds
    End Sub

    Private Sub AddFolderIfValid(ByVal folders As HashSet(Of String), ByVal folder As String)
        If String.IsNullOrWhiteSpace(folder) Then Exit Sub
        Try
            If System.IO.Directory.Exists(folder) Then folders.Add(folder)
        Catch
        End Try
    End Sub

    Private Sub AddKnownDrawingFolders(ByVal folders As HashSet(Of String), ByVal rootFolder As String)
        If String.IsNullOrWhiteSpace(rootFolder) OrElse Not System.IO.Directory.Exists(rootFolder) Then Exit Sub

        Dim knownNames() As String = {
            "DRAWING", "DRAWINGS", "IDW", "DWG", "2D",
            "BAN VE", "BẢN VẼ", "BANVE", "DRAWING FILE", "DRAWING_FILES"}

        For Each folderName As String In knownNames
            AddFolderIfValid(folders, IOPath.Combine(rootFolder, folderName))
        Next

        'Nhận cả thư mục có tên gần giống Drawing ở cấp con trực tiếp
        Try
            For Each childFolder As String In System.IO.Directory.GetDirectories(rootFolder)
                Dim childName As String = IOPath.GetFileName(childFolder).ToUpperInvariant()
                If childName.Contains("DRAW") OrElse childName.Contains("IDW") OrElse _
                   childName.Contains("DWG") OrElse childName.Contains("BAN VE") OrElse _
                   childName.Contains("BẢN VẼ") Then
                    AddFolderIfValid(folders, childFolder)
                End If
            Next
        Catch
        End Try
    End Sub

    Private Sub IndexDrawingFilesInFolder(ByVal folder As String)
        If String.IsNullOrWhiteSpace(folder) Then Exit Sub
        Try
            For Each filePath As String In System.IO.Directory.GetFiles(folder, "*.idw", System.IO.SearchOption.TopDirectoryOnly)
                AddDrawingToIndex(filePath)
            Next
            For Each filePath As String In System.IO.Directory.GetFiles(folder, "*.dwg", System.IO.SearchOption.TopDirectoryOnly)
                AddDrawingToIndex(filePath)
            Next
        Catch
            'Không có quyền đọc thư mục hoặc đường dẫn mạng tạm mất
        End Try
    End Sub

    Private Sub AddDrawingToIndex(ByVal drawingPath As String)
        If String.IsNullOrWhiteSpace(drawingPath) Then Exit Sub
        Dim baseName As String = IOPath.GetFileNameWithoutExtension(drawingPath)
        If String.IsNullOrWhiteSpace(baseName) Then Exit Sub

        'Ưu tiên IDW nếu cùng tên tồn tại cả IDW và DWG
        If Not _drawingIndex.ContainsKey(baseName) Then
            _drawingIndex.Add(baseName, drawingPath)
        ElseIf IOPath.GetExtension(drawingPath).Equals(".idw", StringComparison.OrdinalIgnoreCase) Then
            _drawingIndex(baseName) = drawingPath
        End If
    End Sub

    '================================================================
    ' CHỈ ĐỊNH DRAWING THỦ CÔNG KHI DRAWING KHÔNG CÙNG TÊN/THƯ MỤC
    '================================================================
    Private Sub LocateDrawingClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim item As PartBomItem = GetCurrentItem()
        If item Is Nothing Then Exit Sub

        Dim dialog As New OpenFileDialog()
        dialog.Title = "Chọn Drawing cho Part: " & item.PartNumber
        dialog.Filter = "Inventor Drawing (*.idw;*.dwg)|*.idw;*.dwg|Inventor IDW (*.idw)|*.idw|Drawing DWG (*.dwg)|*.dwg"
        dialog.CheckFileExists = True
        dialog.Multiselect = False

        Try
            Dim currentDrawing As String = FindDrawingPath(item.FilePath)
            If Not String.IsNullOrWhiteSpace(currentDrawing) Then
                dialog.InitialDirectory = IOPath.GetDirectoryName(currentDrawing)
                dialog.FileName = IOPath.GetFileName(currentDrawing)
            ElseIf Not String.IsNullOrWhiteSpace(item.FilePath) Then
                dialog.InitialDirectory = IOPath.GetDirectoryName(item.FilePath)
            End If
        Catch
        End Try

        If dialog.ShowDialog() <> DialogResult.OK Then Exit Sub

        _manualDrawingMap(item.FilePath) = dialog.FileName
        AddDrawingToIndex(dialog.FileName)
        SaveManualDrawingMap()
        RefreshDrawingStatusForItem(item)
    End Sub

    Private Sub RefreshDrawingStatusForItem(ByVal item As PartBomItem)
        For Each row As DataGridViewRow In Grid.Rows
            If row.Tag Is item Then
                Dim status As String = GetDrawingStatus(item.FilePath)
                row.Cells("DRAWING_STATUS").Value = status
                If status = "MISSING" Then
                    row.Cells("DRAWING_STATUS").Style.BackColor = Color.White
                    row.Cells("DRAWING_STATUS").Style.ForeColor = Color.FromArgb(165, 70, 70)
                Else
                    row.Cells("DRAWING_STATUS").Style.BackColor = Color.White
                    row.Cells("DRAWING_STATUS").Style.ForeColor = Color.FromArgb(45, 105, 78)
                End If
            End If
        Next
        'Tính lại số dòng hiển thị, tổng QTY và số Drawing còn thiếu
        ApplySearchFilter()
    End Sub

    Private Sub LoadManualDrawingMap()
        _manualDrawingMap.Clear()
        If String.IsNullOrWhiteSpace(_drawingMapFile) OrElse Not System.IO.File.Exists(_drawingMapFile) Then Exit Sub
        Try
            For Each line As String In System.IO.File.ReadAllLines(_drawingMapFile)
                Dim separatorIndex As Integer = line.IndexOf("|"c)
                If separatorIndex <= 0 Then Continue For
                Dim partPath As String = line.Substring(0, separatorIndex)
                Dim drawingPath As String = line.Substring(separatorIndex + 1)
                If partPath.Length > 0 AndAlso drawingPath.Length > 0 Then
                    _manualDrawingMap(partPath) = drawingPath
                End If
            Next
        Catch
        End Try
    End Sub

    Private Sub SaveManualDrawingMap()
        If String.IsNullOrWhiteSpace(_drawingMapFile) Then Exit Sub
        Try
            Dim lines As New List(Of String)()
            For Each pair As KeyValuePair(Of String, String) In _manualDrawingMap
                lines.Add(pair.Key & "|" & pair.Value)
            Next
            System.IO.File.WriteAllLines(_drawingMapFile, lines.ToArray())
        Catch
        End Try
    End Sub

    Private Sub BuildExcelFormulaBar(ByVal root As System.Windows.Forms.TableLayoutPanel)
        Dim panel As New Panel()
        panel.Dock = DockStyle.Fill
        panel.BackColor = Color.FromArgb(247, 249, 250)
        panel.Padding = New System.Windows.Forms.Padding(4, 3, 4, 3)

        ExcelNameBox = New TextBox()
        ExcelNameBox.Left = 4
        ExcelNameBox.Top = 4
        ExcelNameBox.Width = 86
        ExcelNameBox.Height = 25
        ExcelNameBox.TextAlign = HorizontalAlignment.Center
        ExcelNameBox.Text = "A1"
        AddHandler ExcelNameBox.KeyDown, AddressOf ExcelNameBoxKeyDown
        panel.Controls.Add(ExcelNameBox)

        Dim fxLabel As New Label()
        fxLabel.Text = "fx"
        fxLabel.Font = New Font("Segoe UI Semibold", 10.0F, FontStyle.Italic)
        fxLabel.TextAlign = ContentAlignment.MiddleCenter
        fxLabel.Left = 94

'####################################################################
' SUBSECTION 15.15 - EXCEL-LIKE FORMULA BAR / CELL ADDRESS / SELECTION
'####################################################################

        fxLabel.Top = 4
        fxLabel.Width = 34
        fxLabel.Height = 25
        panel.Controls.Add(fxLabel)

        ExcelFormulaApply = New Button()
        ExcelFormulaApply.Text = "✓"
        ExcelFormulaApply.Left = 130
        ExcelFormulaApply.Top = 3
        ExcelFormulaApply.Width = 34
        ExcelFormulaApply.Height = 27
        AddHandler ExcelFormulaApply.Click, AddressOf ExcelFormulaApplyClicked
        panel.Controls.Add(ExcelFormulaApply)

        ExcelFormulaBox = New TextBox()
        ExcelFormulaBox.Left = 168
        ExcelFormulaBox.Top = 4
        ExcelFormulaBox.Height = 25
        ExcelFormulaBox.Anchor = AnchorStyles.Left Or AnchorStyles.Top Or AnchorStyles.Right
        ExcelFormulaBox.Width = Math.Max(200, panel.ClientSize.Width - 172)
        AddHandler panel.Resize, Sub(sender As Object, e As EventArgs)
            ExcelFormulaBox.Width = Math.Max(200, panel.ClientSize.Width - 172)
        End Sub
        AddHandler ExcelFormulaBox.KeyDown, AddressOf ExcelFormulaBoxKeyDown
        panel.Controls.Add(ExcelFormulaBox)
        root.Controls.Add(panel, 0, 2)
    End Sub

    Private Function ColumnIndexToExcelName(ByVal columnIndex As Integer) As String
        Dim value As Integer = columnIndex + 1
        Dim result As String = ""
        While value > 0
            value -= 1
            result = ChrW(65 + (value Mod 26)) & result
            value \= 26
        End While
        Return result
    End Function

    Private Function ExcelColumnNameToIndex(ByVal text As String) As Integer
        Dim value As Integer = 0
        For Each ch As Char In text.ToUpperInvariant()
            If ch < "A"c OrElse ch > "Z"c Then Return -1
            value = value * 26 + (AscW(ch) - AscW("A"c) + 1)
        Next
        Return value - 1
    End Function

    Private Sub ExcelNameBoxKeyDown(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyEventArgs)
        If e.KeyCode <> System.Windows.Forms.Keys.Enter Then Exit Sub
        Dim address As String = ExcelNameBox.Text.Trim().ToUpperInvariant()
        Dim letters As String = ""
        Dim digits As String = ""
        For Each ch As Char In address
            If Char.IsLetter(ch) AndAlso digits.Length = 0 Then
                letters &= ch
            ElseIf Char.IsDigit(ch) Then
                digits &= ch
            End If
        Next
        Dim colIndex As Integer = ExcelColumnNameToIndex(letters)
        Dim rowNumber As Integer = 0
        If Not Integer.TryParse(digits, rowNumber) Then rowNumber = 0
        Dim rowIndex As Integer = rowNumber - 1
        If colIndex >= 0 AndAlso colIndex < Grid.Columns.Count AndAlso rowIndex >= 0 AndAlso rowIndex < Grid.Rows.Count Then
            Grid.CurrentCell = Grid.Rows(rowIndex).Cells(colIndex)
            Grid.FirstDisplayedScrollingRowIndex = Math.Max(0, rowIndex)
            If Grid.Columns(colIndex).Visible Then Grid.FirstDisplayedScrollingColumnIndex = colIndex
        End If
        e.Handled = True
        e.SuppressKeyPress = True
    End Sub

    Private Sub ExcelFormulaBoxKeyDown(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyEventArgs)
        If e.KeyCode = System.Windows.Forms.Keys.Enter Then
            ExcelFormulaApplyClicked(sender, EventArgs.Empty)
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.KeyCode = System.Windows.Forms.Keys.Escape Then
            UpdateExcelFormulaBar()
            Grid.Focus()
            e.Handled = True
            e.SuppressKeyPress = True
        End If
    End Sub

    Private Sub ExcelFormulaApplyClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.CurrentCell Is Nothing Then Exit Sub
        ApplyGridPropertyValue(Grid.CurrentCell.RowIndex, Grid.CurrentCell.ColumnIndex, ExcelFormulaBox.Text)
        Grid.Focus()
        UpdateExcelFormulaBar()
    End Sub

    Private Sub UpdateExcelFormulaBar()
        If ExcelNameBox Is Nothing OrElse ExcelFormulaBox Is Nothing Then Exit Sub
        If Grid Is Nothing OrElse Grid.CurrentCell Is Nothing Then
            ExcelNameBox.Text = ""
            ExcelFormulaBox.Text = ""
            Exit Sub
        End If
        ExcelNameBox.Text = ColumnIndexToExcelName(Grid.CurrentCell.ColumnIndex) & (Grid.CurrentCell.RowIndex + 1).ToString()
        If Not ExcelFormulaBox.Focused Then ExcelFormulaBox.Text = Convert.ToString(Grid.CurrentCell.Value)
    End Sub

    Private Sub GridCellValueChangedForFormula(ByVal sender As Object, ByVal e As DataGridViewCellEventArgs)
        If Grid.CurrentCell IsNot Nothing AndAlso e.RowIndex = Grid.CurrentCell.RowIndex AndAlso e.ColumnIndex = Grid.CurrentCell.ColumnIndex Then UpdateExcelFormulaBar()
    End Sub

    Private Sub GridRowPostPaint(ByVal sender As Object, ByVal e As System.Windows.Forms.DataGridViewRowPostPaintEventArgs)
        Dim text As String = (e.RowIndex + 1).ToString()
        Dim bounds As New Rectangle(e.RowBounds.Left, e.RowBounds.Top, Grid.RowHeadersWidth - 5, e.RowBounds.Height)
        System.Windows.Forms.TextRenderer.DrawText(e.Graphics, text, Grid.Font, bounds, Color.FromArgb(55, 75, 85), TextFormatFlags.Right Or TextFormatFlags.VerticalCenter)
    End Sub


'####################################################################
' SUBSECTION 15.16 - ROW/COLUMN HEADER SELECTION / SORT / FREEZE
'####################################################################

    Private Sub GridColumnHeaderMouseClick(ByVal sender As Object, ByVal e As DataGridViewCellMouseEventArgs)
        If e.ColumnIndex < 0 OrElse e.Button <> MouseButtons.Left Then Exit Sub
        If e.ColumnIndex >= Grid.Columns.Count Then Exit Sub

        Dim clickedColumn As DataGridViewColumn = Grid.Columns(e.ColumnIndex)
        If clickedColumn Is Nothing OrElse clickedColumn.SortMode = DataGridViewColumnSortMode.NotSortable Then Exit Sub

        'Excel-like: click header = sort. Ctrl/Shift vẫn dùng để chọn cả cột/range,
        'nhưng sort luôn được xử lý bởi engine riêng để không phá Assembly Group.
        ApplyColumnSort(clickedColumn.Name, Nothing)

        Dim controlDown As Boolean = (Control.ModifierKeys And Keys.Control) = Keys.Control
        Dim shiftDown As Boolean = (Control.ModifierKeys And Keys.Shift) = Keys.Shift
        Dim startIndex As Integer = e.ColumnIndex
        Dim endIndex As Integer = e.ColumnIndex
        If shiftDown AndAlso _lastSelectedColumn >= 0 Then
            startIndex = Math.Min(_lastSelectedColumn, e.ColumnIndex)
            endIndex = Math.Max(_lastSelectedColumn, e.ColumnIndex)
        End If
        SelectColumnRange(startIndex, endIndex, controlDown)
        _lastSelectedColumn = e.ColumnIndex
        Dim target As DataGridViewCell = FirstVisibleCellInColumn(e.ColumnIndex)
        If target IsNot Nothing Then Grid.CurrentCell = target
        UpdateExcelSelectionStatus()
    End Sub

    Private Sub SelectColumnRange(ByVal startIndex As Integer, ByVal endIndex As Integer, ByVal preserveSelection As Boolean)
        If Not preserveSelection Then Grid.ClearSelection()
        For c As Integer = Math.Max(0, startIndex) To Math.Min(Grid.Columns.Count - 1, endIndex)
            If Grid.Columns(c).Visible Then
                For Each row As DataGridViewRow In Grid.Rows
                    If row.Visible Then row.Cells(c).Selected = True
                Next
            End If
        Next
    End Sub

    Private Function FirstVisibleCellInColumn(ByVal columnIndex As Integer) As DataGridViewCell
        If columnIndex < 0 OrElse columnIndex >= Grid.Columns.Count Then Return Nothing
        For Each row As DataGridViewRow In Grid.Rows
            If row.Visible Then Return row.Cells(columnIndex)
        Next
        Return Nothing
    End Function

    Private Function FirstVisibleCellInRow(ByVal rowIndex As Integer) As DataGridViewCell
        If rowIndex < 0 OrElse rowIndex >= Grid.Rows.Count Then Return Nothing
        For Each col As DataGridViewColumn In Grid.Columns
            If col.Visible Then Return Grid.Rows(rowIndex).Cells(col.Index)
        Next
        Return Nothing
    End Function

    Private Sub GridRowHeaderMouseClick(ByVal sender As Object, ByVal e As DataGridViewCellMouseEventArgs)
        If e.RowIndex < 0 OrElse e.Button <> MouseButtons.Left Then Exit Sub
        If Grid.SelectionMode <> DataGridViewSelectionMode.FullRowSelect Then
            Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
            Grid.MultiSelect = True
        End If
        Dim controlDown As Boolean = (Control.ModifierKeys And Keys.Control) = Keys.Control
        Dim shiftDown As Boolean = (Control.ModifierKeys And Keys.Shift) = Keys.Shift
        If Not controlDown AndAlso Not shiftDown Then Grid.ClearSelection()
        Dim startIndex As Integer = e.RowIndex
        Dim endIndex As Integer = e.RowIndex
        If shiftDown AndAlso _lastSelectedRow >= 0 Then
            startIndex = Math.Min(_lastSelectedRow, e.RowIndex)
            endIndex = Math.Max(_lastSelectedRow, e.RowIndex)
        End If
        For r As Integer = startIndex To endIndex
            If Grid.Rows(r).Visible Then Grid.Rows(r).Selected = True
        Next
        _lastSelectedRow = e.RowIndex
        Grid.CurrentCell = Grid.Rows(e.RowIndex).Cells(0)
        UpdateExcelSelectionStatus()
    End Sub

    Private Sub UpdateExcelSelectionStatus()
        If StatusSelection Is Nothing OrElse Grid Is Nothing Then Exit Sub
        Dim count As Integer = Grid.SelectedCells.Count
        If count = 0 Then
            StatusSelection.Text = "Chọn ô để xem thống kê"
            Exit Sub
        End If
        Dim numericCount As Integer = 0
        Dim sum As Double = 0
        Dim minValue As Double = Double.MaxValue
        Dim maxValue As Double = Double.MinValue
        For Each cell As DataGridViewCell In Grid.SelectedCells
            Dim number As Double
            Dim text As String = Convert.ToString(cell.Value).Trim().Replace(",", ".")
            If Double.TryParse(text, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, number) Then
                numericCount += 1
                sum += number
                minValue = Math.Min(minValue, number)
                maxValue = Math.Max(maxValue, number)
            End If
        Next
        If numericCount > 0 Then
            Dim address As String = If(Grid.CurrentCell Is Nothing, "", ColumnIndexToExcelName(Grid.CurrentCell.ColumnIndex) & (Grid.CurrentCell.RowIndex + 1).ToString() & "   ")
            StatusSelection.Text = address & "Count: " & count.ToString() & "   Sum: " & sum.ToString("0.###") & "   Average: " & (sum / numericCount).ToString("0.###") & "   Min: " & minValue.ToString("0.###") & "   Max: " & maxValue.ToString("0.###")
        Else
            Dim address As String = If(Grid.CurrentCell Is Nothing, "", ColumnIndexToExcelName(Grid.CurrentCell.ColumnIndex) & (Grid.CurrentCell.RowIndex + 1).ToString() & "   ")
            StatusSelection.Text = address & "Count: " & count.ToString()
        End If
    End Sub

    Private Sub SelectCurrentColumnClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim index As Integer = If(_contextColumnIndex >= 0, _contextColumnIndex, If(Grid.CurrentCell Is Nothing, -1, Grid.CurrentCell.ColumnIndex))
        If index < 0 Then Exit Sub
        SelectColumnRange(index, index, False)
        Dim target As DataGridViewCell = FirstVisibleCellInColumn(index)
        If target IsNot Nothing Then Grid.CurrentCell = target
        UpdateExcelSelectionStatus()
    End Sub

    Private Sub SelectCurrentRowClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim index As Integer = If(_contextRowIndex >= 0, _contextRowIndex, If(Grid.CurrentCell Is Nothing, -1, Grid.CurrentCell.RowIndex))
        If index < 0 OrElse index >= Grid.Rows.Count Then Exit Sub
        If Grid.SelectionMode <> DataGridViewSelectionMode.FullRowSelect Then
            Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
            Grid.MultiSelect = True
        End If
        Grid.ClearSelection()
        Grid.Rows(index).Selected = True
        Dim target As DataGridViewCell = FirstVisibleCellInRow(index)
        If target IsNot Nothing Then Grid.CurrentCell = target
        UpdateExcelSelectionStatus()
    End Sub

    Private Sub SortAscendingClicked(ByVal sender As Object, ByVal e As EventArgs)
        SortCurrentColumn(System.ComponentModel.ListSortDirection.Ascending)
    End Sub

    Private Sub SortDescendingClicked(ByVal sender As Object, ByVal e As EventArgs)
        SortCurrentColumn(System.ComponentModel.ListSortDirection.Descending)
    End Sub

    '================================================================
    ' SMART STOCK NUMBER SORT
    ' Integrated from the useful core idea of sort-part-lists-by-stock-number.vb.
    ' Unlike the original drawing-only rule, this works directly on BOM Tool's
    ' cached data model, remains group-safe, and does not require the Stock Number
    ' column to be visible.
    '================================================================
    Private Sub SortByStockNumberClicked(ByVal sender As Object, ByVal e As EventArgs)
        _activeSortColumn = "__STOCK_NUMBER__"
        _activeSortDirection = System.ComponentModel.ListSortDirection.Ascending
        LoadRows()
        Try
            If StatusSelection IsNot Nothing Then
                StatusSelection.Text = "Đã sắp xếp BOM theo Stock Number (A → Z)"
            End If
        Catch
        End Try
    End Sub

    Private Sub SortCurrentColumn(ByVal direction As System.ComponentModel.ListSortDirection)
        Dim index As Integer = If(_contextColumnIndex >= 0, _contextColumnIndex, If(Grid.CurrentCell Is Nothing, -1, Grid.CurrentCell.ColumnIndex))
        If index < 0 OrElse index >= Grid.Columns.Count Then Exit Sub
        ApplyColumnSort(Grid.Columns(index).Name, direction)
    End Sub

    '================================================================
    ' V13.2 - GROUP SAFE SORT ENGINE
    '================================================================
    Private Sub ApplyColumnSort(ByVal columnName As String, ByVal forcedDirection As Nullable(Of System.ComponentModel.ListSortDirection))
        If String.IsNullOrWhiteSpace(columnName) OrElse Not Grid.Columns.Contains(columnName) Then Exit Sub

        If forcedDirection.HasValue Then
            _activeSortDirection = forcedDirection.Value
        ElseIf String.Equals(_activeSortColumn, columnName, StringComparison.OrdinalIgnoreCase) Then
            If _activeSortDirection = System.ComponentModel.ListSortDirection.Ascending Then
                _activeSortDirection = System.ComponentModel.ListSortDirection.Descending
            Else
                _activeSortDirection = System.ComponentModel.ListSortDirection.Ascending
            End If
        Else
            _activeSortDirection = System.ComponentModel.ListSortDirection.Ascending
        End If

        _activeSortColumn = columnName

        'Re-render từ Data Model. Như vậy Assembly header không bao giờ là phần tử sort.
        LoadRows()
    End Sub

    Private Sub SortItemsForCurrentView(ByVal items As List(Of PartBomItem), ByVal groupName As String)
        If items Is Nothing OrElse items.Count <= 1 Then Exit Sub

        If String.IsNullOrWhiteSpace(_activeSortColumn) Then
            items.Sort(AddressOf CompareBomItems)
            Exit Sub
        End If

        Dim sortKeys As New Dictionary(Of String, Object)(StringComparer.OrdinalIgnoreCase)
        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            sortKeys(GetSortCacheKey(item, groupName)) = GetItemSortValue(item, _activeSortColumn, groupName)
        Next

        items.Sort(Function(a As PartBomItem, b As PartBomItem) As Integer
            If a Is Nothing AndAlso b Is Nothing Then Return 0
            If a Is Nothing Then Return 1
            If b Is Nothing Then Return -1

            Dim keyA As String = GetSortCacheKey(a, groupName)
            Dim keyB As String = GetSortCacheKey(b, groupName)
            Dim valueA As Object = If(sortKeys.ContainsKey(keyA), sortKeys(keyA), Nothing)
            Dim valueB As Object = If(sortKeys.ContainsKey(keyB), sortKeys(keyB), Nothing)
            Dim result As Integer = CompareSortValues(valueA, valueB)

            'Tie-breaker ổn định để cùng giá trị không nhảy lung tung giữa các lần click.
            If result = 0 Then result = CompareBomItems(a, b)
            If _activeSortDirection = System.ComponentModel.ListSortDirection.Descending Then result = -result
            Return result
        End Function)
    End Sub

    Private Function GetSortCacheKey(ByVal item As PartBomItem, ByVal groupName As String) As String
        If item Is Nothing Then Return Guid.NewGuid().ToString()
        Dim key As String = If(String.IsNullOrWhiteSpace(item.DocumentKey), item.FilePath, item.DocumentKey)
        Return If(key, "") & "|" & If(groupName, "")
    End Function

    Private Function GetItemSortValue(ByVal item As PartBomItem, ByVal columnName As String, ByVal groupName As String) As Object
        If item Is Nothing Then Return Nothing
        Dim name As String = If(columnName, "").Trim().ToUpperInvariant()

        Select Case name
            Case "ITEM"
                'ITEM là số hiển thị được sinh lại sau sort, không dùng mũi tên header làm số 0.
                'Dùng thứ tự BOM gốc làm khóa ổn định.
                Return item.PartNumber & "|" & item.FileName
            Case "QTY"
                If _groupedView AndAlso Not String.IsNullOrWhiteSpace(groupName) Then
                    Return item.GetQuantityForParent(groupName)
                End If
                Return item.Quantity
            Case "__STOCK_NUMBER__"
                Return item.StockNumber
            Case "FILE_NAME"
                Return item.FileName
            Case "FILE_PATH"
                Return item.FilePath
            Case "PARENT_ASSEMBLY"
                If _groupedView AndAlso Not String.IsNullOrWhiteSpace(groupName) Then Return groupName
                Return item.GetParentAssemblyText()
            Case "DRAWING_STATUS"
                Return GetDrawingStatus(item.FilePath)
            Case "DATA_STATUS"
                Return GetDataStatus(item)
        End Select

        'Dynamic Feature columns
        For Each featureKey As String In _enabledFeatures
            If _featureRegistry.ContainsKey(featureKey) Then
                Dim featureDef As BomFeatureDefinition = _featureRegistry(featureKey)
                If featureDef IsNot Nothing AndAlso String.Equals(featureDef.ColumnName, columnName, StringComparison.OrdinalIgnoreCase) Then
                    Return GetFeatureDisplayValue(item, featureKey)
                End If
            End If
        Next

        'Selected iProperty columns
        For Each p As PropertyColumnInfo In _selectedProperties
            If p IsNot Nothing AndAlso String.Equals(p.Key, columnName, StringComparison.OrdinalIgnoreCase) Then
                Return BomUnitManager.GetPropertyDisplayValue(item, p)
            End If
        Next

        Return ""
    End Function

    Private Function CompareSortValues(ByVal leftValue As Object, ByVal rightValue As Object) As Integer
        Dim leftEmpty As Boolean = leftValue Is Nothing OrElse String.IsNullOrWhiteSpace(Convert.ToString(leftValue))
        Dim rightEmpty As Boolean = rightValue Is Nothing OrElse String.IsNullOrWhiteSpace(Convert.ToString(rightValue))

        'Ô trống luôn xuống cuối, bất kể Asc/Desc.
        If leftEmpty AndAlso rightEmpty Then Return 0
        If leftEmpty Then Return 1
        If rightEmpty Then Return -1

        Dim leftNumber As Double
        Dim rightNumber As Double
        Dim leftText As String = Convert.ToString(leftValue).Trim().Replace(",", ".")
        Dim rightText As String = Convert.ToString(rightValue).Trim().Replace(",", ".")
        Dim leftIsNumber As Boolean = Double.TryParse(leftText, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, leftNumber)
        Dim rightIsNumber As Boolean = Double.TryParse(rightText, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, rightNumber)
        If leftIsNumber AndAlso rightIsNumber Then Return leftNumber.CompareTo(rightNumber)

        Dim leftDate As DateTime
        Dim rightDate As DateTime
        If DateTime.TryParse(Convert.ToString(leftValue), leftDate) AndAlso DateTime.TryParse(Convert.ToString(rightValue), rightDate) Then
            Return leftDate.CompareTo(rightDate)
        End If

        Return StringComparer.OrdinalIgnoreCase.Compare(Convert.ToString(leftValue), Convert.ToString(rightValue))
    End Function

    Private Sub UpdateSortGlyph()
        If Grid Is Nothing Then Exit Sub
        For Each col As DataGridViewColumn In Grid.Columns
            If col.HeaderCell Is Nothing Then Continue For
            col.HeaderCell.SortGlyphDirection = System.Windows.Forms.SortOrder.None
        Next
        If String.IsNullOrWhiteSpace(_activeSortColumn) OrElse Not Grid.Columns.Contains(_activeSortColumn) Then Exit Sub
        If _activeSortDirection = System.ComponentModel.ListSortDirection.Ascending Then
            Grid.Columns(_activeSortColumn).HeaderCell.SortGlyphDirection = System.Windows.Forms.SortOrder.Ascending
        Else
            Grid.Columns(_activeSortColumn).HeaderCell.SortGlyphDirection = System.Windows.Forms.SortOrder.Descending
        End If
    End Sub


'####################################################################
' SUBSECTION 15.17 - CUT / FILL / AUTOFIT / HIDE / SHOW
'####################################################################

    Private Sub CutSelectedCellsClicked(ByVal sender As Object, ByVal e As EventArgs)
        CopySelectedCellsClicked(sender, e)
        _cutMode = True
        ClearSelectedCellsClicked(sender, e)
    End Sub

    Private Sub FillRightClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.CurrentCell Is Nothing Then Exit Sub
        Dim sourceRow As Integer = Grid.CurrentCell.RowIndex
        Dim sourceValue As String = Convert.ToString(Grid.CurrentCell.Value)
        Dim targetColumns As New SortedSet(Of Integer)()
        For Each cell As DataGridViewCell In Grid.SelectedCells
            If cell.RowIndex = sourceRow Then targetColumns.Add(cell.ColumnIndex)
        Next
        Dim changed As Integer = 0
        For Each columnIndex As Integer In targetColumns
            If columnIndex <> Grid.CurrentCell.ColumnIndex AndAlso ApplyGridPropertyValue(sourceRow, columnIndex, sourceValue) Then changed += 1
        Next
        MessageBox.Show("Đã Fill Right " & changed.ToString() & " ô.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

    Private Sub AutoFitSelectedColumnsClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim indexes As New HashSet(Of Integer)()
        For Each cell As DataGridViewCell In Grid.SelectedCells
            indexes.Add(cell.ColumnIndex)
        Next
        If indexes.Count = 0 AndAlso Grid.CurrentCell IsNot Nothing Then indexes.Add(Grid.CurrentCell.ColumnIndex)
        For Each index As Integer In indexes
            Try
                Grid.AutoResizeColumn(index, DataGridViewAutoSizeColumnMode.DisplayedCells)
            Catch
            End Try
        Next
    End Sub

    Private Sub HideSelectedColumnsClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim indexes As New List(Of Integer)()
        For Each cell As DataGridViewCell In Grid.SelectedCells
            If Not indexes.Contains(cell.ColumnIndex) Then indexes.Add(cell.ColumnIndex)
        Next
        If indexes.Count = 0 AndAlso Grid.CurrentCell IsNot Nothing Then indexes.Add(Grid.CurrentCell.ColumnIndex)
        If Grid.Columns.Count - indexes.Count < 1 Then Exit Sub
        For Each index As Integer In indexes
            Grid.Columns(index).Visible = False
        Next
    End Sub

    Private Sub ShowAllColumnsClicked(ByVal sender As Object, ByVal e As EventArgs)
        For Each column As DataGridViewColumn In Grid.Columns
            column.Visible = True
        Next
    End Sub

    Private Sub FreezeToCurrentColumnClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.CurrentCell Is Nothing Then Exit Sub
        Dim stopIndex As Integer = Grid.CurrentCell.ColumnIndex
        For Each column As DataGridViewColumn In Grid.Columns
            column.Frozen = column.Index <= stopIndex
        Next
    End Sub

    Private Sub UnfreezeColumnsClicked(ByVal sender As Object, ByVal e As EventArgs)
        For Each column As DataGridViewColumn In Grid.Columns
            column.Frozen = False
        Next
    End Sub

    Private Sub ToggleCellSelectionModeClicked(ByVal sender As Object, ByVal e As EventArgs)
        'Toggle thật sự giữa FullRowSelect và Excel CellSelect.
        If Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect AndAlso _forceFullRowSelection Then
            _forceFullRowSelection = False
            Grid.SelectionMode = DataGridViewSelectionMode.CellSelect
            Grid.MultiSelect = True
            StatusLoadTime.Text = "Chế độ Excel: chọn ô/vùng | click số hàng = chọn cả hàng"
        Else
            _forceFullRowSelection = True
            Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
            Grid.MultiSelect = True
            StatusLoadTime.Text = "Chế độ chọn hàng: Ctrl/Shift chọn nhiều hàng | bấm lại để về Excel"
        End If
    End Sub


'####################################################################
' SUBSECTION 15.18 - COPY / PASTE / CLEAR / KEYBOARD SHORTCUTS
'####################################################################

    Private Sub CopyCurrentCellClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.CurrentCell Is Nothing Then Exit Sub
        Try
            Clipboard.SetText(Convert.ToString(Grid.CurrentCell.FormattedValue))
        Catch ex As Exception
            MessageBox.Show("Không copy được ô hiện tại." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub CopySelectedCellsClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Grid.SelectedCells.Count = 0 Then
            CopyCurrentCellClicked(sender, e)
            Exit Sub
        End If
        Try
            Dim minRow As Integer = Integer.MaxValue
            Dim maxRow As Integer = -1
            Dim minCol As Integer = Integer.MaxValue
            Dim maxCol As Integer = -1
            For Each cell As System.Windows.Forms.DataGridViewCell In Grid.SelectedCells
                If cell.OwningRow.Visible AndAlso cell.OwningColumn.Visible Then
                    minRow = Math.Min(minRow, cell.RowIndex)
                    maxRow = Math.Max(maxRow, cell.RowIndex)
                    minCol = Math.Min(minCol, cell.ColumnIndex)
                    maxCol = Math.Max(maxCol, cell.ColumnIndex)
                End If
            Next
            If maxRow < 0 OrElse maxCol < 0 Then Exit Sub

            Dim selectedKeys As New HashSet(Of String)()
            For Each cell As System.Windows.Forms.DataGridViewCell In Grid.SelectedCells
                selectedKeys.Add(cell.RowIndex.ToString() & "|" & cell.ColumnIndex.ToString())
            Next

            Dim sb As New StringBuilder()
            For r As Integer = minRow To maxRow
                If Not Grid.Rows(r).Visible Then Continue For
                Dim firstValue As Boolean = True
                For c As Integer = minCol To maxCol
                    If Not Grid.Columns(c).Visible Then Continue For
                    If Not firstValue Then sb.Append(vbTab)
                    firstValue = False
                    If selectedKeys.Contains(r.ToString() & "|" & c.ToString()) Then
                        Dim textValue As String = Convert.ToString(Grid.Rows(r).Cells(c).FormattedValue)
                        textValue = textValue.Replace(vbCr, " ").Replace(vbLf, " ").Replace(vbTab, " ")
                        sb.Append(textValue)
                    End If
                Next
                sb.AppendLine()
            Next
            Clipboard.SetText(sb.ToString().TrimEnd(ControlChars.Cr, ControlChars.Lf))
        Catch ex As Exception
            MessageBox.Show("Không copy được vùng dữ liệu." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Function ApplyGridPropertyValue(ByVal rowIndex As Integer, ByVal columnIndex As Integer, ByVal newValue As String) As Boolean
        If rowIndex < 0 OrElse columnIndex < 0 OrElse rowIndex >= Grid.Rows.Count OrElse columnIndex >= Grid.Columns.Count Then Return False
        Dim row As DataGridViewRow = Grid.Rows(rowIndex)
        Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
        Dim col As DataGridViewColumn = Grid.Columns(columnIndex)
        Dim propertyInfo As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
        If item Is Nothing OrElse propertyInfo Is Nothing OrElse col.ReadOnly Then Return False
        Dim oldValue As String = Convert.ToString(row.Cells(columnIndex).Value)
        If String.Equals(oldValue, newValue, StringComparison.Ordinal) Then Return True
        _suppressCellWrite = True
        row.Cells(columnIndex).Value = newValue
        _suppressCellWrite = False
        StagePropertyChange(item, propertyInfo, oldValue, newValue, row, columnIndex)
        Return True
    End Function

    Private Sub PasteCellsClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Paste Property") Then Exit Sub
        If Grid.CurrentCell Is Nothing OrElse Not Clipboard.ContainsText() Then Exit Sub
        Dim clipboardText As String = Clipboard.GetText()
        If String.IsNullOrEmpty(clipboardText) Then Exit Sub
        Dim rowsText() As String = clipboardText.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).Split(New String() {vbLf}, StringSplitOptions.None)
        Dim startRow As Integer = Grid.CurrentCell.RowIndex
        Dim startCol As Integer = Grid.CurrentCell.ColumnIndex
        Dim changed As Integer = 0
        Dim skipped As Integer = 0

        Dim effectiveRows As New List(Of String)()
        For i As Integer = 0 To rowsText.Length - 1
            If i = rowsText.Length - 1 AndAlso rowsText(i).Length = 0 Then Continue For
            effectiveRows.Add(rowsText(i))
        Next

        'Excel behavior: clipboard chỉ có 1 ô + đang chọn nhiều ô => điền cùng giá trị vào toàn vùng chọn.
        If effectiveRows.Count = 1 AndAlso effectiveRows(0).IndexOf(ControlChars.Tab) < 0 AndAlso Grid.SelectedCells.Count > 1 Then
            Dim oneValue As String = effectiveRows(0)
            Dim selected As New List(Of DataGridViewCell)()
            For Each cell As DataGridViewCell In Grid.SelectedCells : selected.Add(cell) : Next
            selected.Sort(Function(a As DataGridViewCell, b As DataGridViewCell)
                              Dim cr As Integer = a.RowIndex.CompareTo(b.RowIndex)
                              If cr <> 0 Then Return cr
                              Return a.ColumnIndex.CompareTo(b.ColumnIndex)
                          End Function)
            For Each cell As DataGridViewCell In selected
                If ApplyGridPropertyValue(cell.RowIndex, cell.ColumnIndex, oneValue) Then changed += 1 Else skipped += 1
            Next
        Else
            For r As Integer = 0 To effectiveRows.Count - 1
                Dim values() As String = effectiveRows(r).Split(ControlChars.Tab)
                For c As Integer = 0 To values.Length - 1
                    Dim targetRow As Integer = startRow + r
                    Dim targetCol As Integer = startCol + c
                    If targetRow >= Grid.Rows.Count OrElse targetCol >= Grid.Columns.Count Then
                        skipped += 1
                    ElseIf ApplyGridPropertyValue(targetRow, targetCol, values(c)) Then
                        changed += 1
                    Else
                        skipped += 1
                    End If
                Next
            Next
        End If
        If _cutMode AndAlso changed > 0 Then _cutMode = False
        StatusLoadTime.Text = "Paste: " & changed.ToString() & " ô" & If(skipped > 0, " | bỏ qua " & skipped.ToString(), "")
    End Sub

    Private Sub FillDownClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Fill Down") Then Exit Sub
        If Grid.CurrentCell Is Nothing Then Exit Sub
        Dim sourceColumn As Integer = Grid.CurrentCell.ColumnIndex
        Dim sourceValue As String = Convert.ToString(Grid.CurrentCell.Value)
        Dim targetRows As New SortedSet(Of Integer)()
        For Each cell As System.Windows.Forms.DataGridViewCell In Grid.SelectedCells
            If cell.ColumnIndex = sourceColumn Then targetRows.Add(cell.RowIndex)
        Next
        If targetRows.Count = 0 Then
            For Each row As DataGridViewRow In Grid.SelectedRows
                targetRows.Add(row.Index)
            Next
        End If
        Dim changed As Integer = 0
        For Each rowIndex As Integer In targetRows
            If rowIndex <> Grid.CurrentCell.RowIndex AndAlso ApplyGridPropertyValue(rowIndex, sourceColumn, sourceValue) Then changed += 1
        Next
        StatusLoadTime.Text = "Fill Down: " & changed.ToString() & " ô"
    End Sub

    Private Sub GridFillHandleMouseMove(ByVal sender As Object, ByVal e As MouseEventArgs)
        If Not _fillDragging Then
            Dim overHandle As Boolean = False
            If Grid.CurrentCell IsNot Nothing Then
                Dim col As DataGridViewColumn = Grid.Columns(Grid.CurrentCell.ColumnIndex)
                Dim item As PartBomItem = TryCast(Grid.Rows(Grid.CurrentCell.RowIndex).Tag, PartBomItem)
                Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                If item IsNot Nothing AndAlso pi IsNot Nothing AndAlso Not col.ReadOnly Then
                    Dim cellRect As Rectangle = Grid.GetCellDisplayRectangle(Grid.CurrentCell.ColumnIndex, Grid.CurrentCell.RowIndex, False)
                    Dim handleRect As New Rectangle(cellRect.Right - FillHandleSize - 2, cellRect.Bottom - FillHandleSize - 2, FillHandleSize + 4, FillHandleSize + 4)
                    overHandle = handleRect.Contains(New Point(e.X, e.Y))
                End If
            End If
            Grid.Cursor = If(overHandle, System.Windows.Forms.Cursors.Cross, System.Windows.Forms.Cursors.Default)
            Exit Sub
        End If
        If _fillSourceRow < 0 OrElse _fillSourceColumn < 0 Then Exit Sub

        'Auto-scroll nhẹ khi kéo sát mép trên/dưới.
        Try
            If e.Y >= Grid.ClientSize.Height - 18 AndAlso Grid.FirstDisplayedScrollingRowIndex >= 0 Then
                Dim nextRow As Integer = Math.Min(Grid.Rows.Count - 1, Grid.FirstDisplayedScrollingRowIndex + 1)
                If nextRow >= 0 AndAlso Grid.Rows(nextRow).Visible Then Grid.FirstDisplayedScrollingRowIndex = nextRow
            ElseIf e.Y <= Grid.ColumnHeadersHeight + 18 AndAlso Grid.FirstDisplayedScrollingRowIndex > 0 Then
                Dim previousRow As Integer = Math.Max(0, Grid.FirstDisplayedScrollingRowIndex - 1)
                If Grid.Rows(previousRow).Visible Then Grid.FirstDisplayedScrollingRowIndex = previousRow
            End If
        Catch
        End Try

        Dim hit As System.Windows.Forms.DataGridView.HitTestInfo = Grid.HitTest(e.X, e.Y)
        If hit.RowIndex < 0 Then Exit Sub
        _fillTargetRow = hit.RowIndex

        Grid.ClearSelection()
        Dim firstRow As Integer = Math.Min(_fillSourceRow, _fillTargetRow)
        Dim lastRow As Integer = Math.Max(_fillSourceRow, _fillTargetRow)
        For r As Integer = firstRow To lastRow
            If r >= 0 AndAlso r < Grid.Rows.Count AndAlso Grid.Rows(r).Visible Then
                Grid.Rows(r).Cells(_fillSourceColumn).Selected = True
            End If
        Next
        Grid.Invalidate()
    End Sub

    Private Sub GridFillHandleMouseUp(ByVal sender As Object, ByVal e As MouseEventArgs)
        If Not _fillDragging Then Exit Sub
        Dim sourceRow As Integer = _fillSourceRow
        Dim sourceColumn As Integer = _fillSourceColumn
        Dim targetRow As Integer = _fillTargetRow
        _fillDragging = False
        _fillSourceRow = -1
        _fillSourceColumn = -1
        _fillTargetRow = -1
        Grid.Capture = False
        Grid.Cursor = System.Windows.Forms.Cursors.Default

        If sourceRow < 0 OrElse sourceColumn < 0 OrElse targetRow < 0 OrElse targetRow = sourceRow Then
            Grid.Invalidate()
            Exit Sub
        End If
        If Not EnsureWriteAllowed("Fill Handle") Then Exit Sub

        Dim sourceValue As String = Convert.ToString(Grid.Rows(sourceRow).Cells(sourceColumn).Value)
        Dim firstRow As Integer = Math.Min(sourceRow, targetRow)
        Dim lastRow As Integer = Math.Max(sourceRow, targetRow)
        Dim changed As Integer = 0
        Dim skipped As Integer = 0
        For r As Integer = firstRow To lastRow
            If r = sourceRow OrElse Not Grid.Rows(r).Visible Then Continue For
            If ApplyGridPropertyValue(r, sourceColumn, sourceValue) Then changed += 1 Else skipped += 1
        Next
        StatusLoadTime.Text = "Auto Fill: " & changed.ToString() & " ô" & If(skipped > 0, " | bỏ qua " & skipped.ToString(), "")
        Grid.Invalidate()
    End Sub

    Private Sub ClearSelectedCellsClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Clear Property") Then Exit Sub
        Dim cells As New List(Of System.Windows.Forms.DataGridViewCell)()
        For Each cell As System.Windows.Forms.DataGridViewCell In Grid.SelectedCells
            cells.Add(cell)
        Next
        If cells.Count = 0 AndAlso Grid.CurrentCell IsNot Nothing Then cells.Add(Grid.CurrentCell)
        Dim changed As Integer = 0
        For Each cell As System.Windows.Forms.DataGridViewCell In cells
            If ApplyGridPropertyValue(cell.RowIndex, cell.ColumnIndex, "") Then changed += 1
        Next
        If changed > 0 Then MessageBox.Show("Đã xóa nội dung " & changed.ToString() & " ô iProperty.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

    Private Sub SelectAllCellsClicked(ByVal sender As Object, ByVal e As EventArgs)
        Grid.SelectAll()
    End Sub

    Private Sub GridKeyDown(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyEventArgs)
        'SMART REFRESH V20: F5 = Incremental | Ctrl+F5 = all selected iProperty | Shift+F5 = Full Reload.
        If e.KeyCode = Keys.F5 Then
            RefreshClicked(sender, EventArgs.Empty)
            e.Handled = True
            e.SuppressKeyPress = True
            Exit Sub
        End If

        'Interaction shortcuts ưu tiên khi đang ở chế độ chọn dòng.
        If e.KeyCode = Keys.Enter Then
            If e.Control Then
                OpenDrawingClicked(sender, EventArgs.Empty)
            Else
                OpenPartClicked(sender, EventArgs.Empty)
            End If
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.KeyCode = Keys.Space AndAlso Not e.Control AndAlso Not e.Shift Then
            HighlightCurrent(False, False)
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.KeyCode = Keys.Delete AndAlso Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect Then
            HideSelectedRowsInteractive()
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.C Then
            CopySelectedCellsClicked(sender, EventArgs.Empty)
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.X Then
            CutSelectedCellsClicked(sender, EventArgs.Empty)
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.V Then
            PasteCellsClicked(sender, EventArgs.Empty)
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.A Then
            Grid.SelectAll()
            e.Handled = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.D Then
            FillDownClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.R Then
            FillRightClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.F Then
            SearchBox.Focus()
            SearchBox.SelectAll()
            e.Handled = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.Space Then
            SelectCurrentColumnClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.Shift AndAlso e.KeyCode = Keys.Space Then
            SelectCurrentRowClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.Home Then
            MoveToExcelEdge(False)
            e.Handled = True
        ElseIf e.Control AndAlso e.KeyCode = Keys.End Then
            MoveToExcelEdge(True)
            e.Handled = True
        ElseIf e.Control AndAlso Not e.Shift AndAlso e.KeyCode = Keys.D0 Then
            HideSelectedColumnsClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.Control AndAlso e.Shift AndAlso e.KeyCode = Keys.D0 Then
            ShowAllColumnsClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.KeyCode = Keys.Delete Then
            ClearSelectedCellsClicked(sender, EventArgs.Empty)
            e.Handled = True
        ElseIf e.KeyCode = Keys.F2 AndAlso Grid.CurrentCell IsNot Nothing Then
            Grid.BeginEdit(True)
            e.Handled = True
        End If
    End Sub

    Private Sub HideSelectedRowsInteractive()
        Dim rowsToHide As New List(Of DataGridViewRow)()
        For Each row As DataGridViewRow In Grid.SelectedRows
            If row IsNot Nothing AndAlso row.Visible AndAlso Not IsAssemblyHeaderRow(row) Then rowsToHide.Add(row)
        Next
        If rowsToHide.Count = 0 AndAlso Grid.CurrentRow IsNot Nothing AndAlso Not IsAssemblyHeaderRow(Grid.CurrentRow) Then
            rowsToHide.Add(Grid.CurrentRow)
        End If
        For Each row As DataGridViewRow In rowsToHide
            Try
                row.Visible = False
            Catch
            End Try
        Next
        StatusLoadTime.Text = "Đã ẩn " & rowsToHide.Count.ToString() & " dòng (Refresh để hiện lại)"
    End Sub

    Private Sub MoveToExcelEdge(ByVal moveToEnd As Boolean)
        If Grid.Rows.Count = 0 OrElse Grid.Columns.Count = 0 Then Exit Sub
        Dim rowIndex As Integer = If(moveToEnd, Grid.Rows.Count - 1, 0)
        Dim columnIndex As Integer = If(moveToEnd, Grid.Columns.Count - 1, 0)
        While rowIndex >= 0 AndAlso rowIndex < Grid.Rows.Count AndAlso Not Grid.Rows(rowIndex).Visible
            rowIndex += If(moveToEnd, -1, 1)
        End While
        While columnIndex >= 0 AndAlso columnIndex < Grid.Columns.Count AndAlso Not Grid.Columns(columnIndex).Visible
            columnIndex += If(moveToEnd, -1, 1)
        End While
        If rowIndex >= 0 AndAlso rowIndex < Grid.Rows.Count AndAlso columnIndex >= 0 AndAlso columnIndex < Grid.Columns.Count Then
            Grid.CurrentCell = Grid.Rows(rowIndex).Cells(columnIndex)
            Grid.FirstDisplayedScrollingRowIndex = rowIndex
            Grid.FirstDisplayedScrollingColumnIndex = columnIndex
        End If
    End Sub


