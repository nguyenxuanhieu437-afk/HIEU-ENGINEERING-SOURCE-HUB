Public Class BomPendingChangesForm
    Inherits BomDialogBase
    Private Grid As DataGridView
    Public ActionName As String = ""
    Public SelectedChanges As New List(Of BomPropertyChange)()

    Public Sub New(ByVal changes As List(Of BomPropertyChange))
        Me.Text = "PENDING CHANGES"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(940, 560)
        Me.MinimumSize = New Size(760, 420)
        Me.Font = New Font("Segoe UI", 9.0F)

        Dim FilterBar As New FlowLayoutPanel()
        FilterBar.Dock = DockStyle.Top : FilterBar.Height = 38 : FilterBar.WrapContents = False
        Dim PartFilter As New TextBox() : PartFilter.Width = 150
        Dim PropertyFilter As New TextBox() : PropertyFilter.Width = 150
        Dim StatusFilter As New ComboBox() : StatusFilter.Width = 120 : StatusFilter.DropDownStyle = ComboBoxStyle.DropDownList
        StatusFilter.Items.AddRange(New Object() {"ALL", "PENDING", "CONFLICT", "FAILED", "COMMITTED", "ROLLED BACK"}) : StatusFilter.SelectedIndex = 0
        FilterBar.Controls.Add(New Label() With {.Text = "Part", .AutoSize = True, .Padding = New Padding(0, 7, 0, 0)}) : FilterBar.Controls.Add(PartFilter)
        FilterBar.Controls.Add(New Label() With {.Text = "Property", .AutoSize = True, .Padding = New Padding(8, 7, 0, 0)}) : FilterBar.Controls.Add(PropertyFilter)
        FilterBar.Controls.Add(New Label() With {.Text = "Status", .AutoSize = True, .Padding = New Padding(8, 7, 0, 0)}) : FilterBar.Controls.Add(StatusFilter)

        Grid = New DataGridView()
        Grid.Dock = DockStyle.Fill
        Grid.AllowUserToAddRows = False
        Grid.AllowUserToDeleteRows = False
        Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
        Grid.MultiSelect = True
        Grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        Grid.RowHeadersVisible = False
        Grid.Columns.Add("PART", "PART")
        Grid.Columns.Add("PROPERTY", "PROPERTY")
        Grid.Columns.Add("OLD", "OLD")
        Grid.Columns.Add("NEW", "NEW")
        Grid.Columns.Add("STATUS", "STATUS")
        Grid.Columns.Add("DOCUMENT", "DOCUMENT")

        For Each ch As BomPropertyChange In changes
            Dim propName As String = If(ch.PropertyInfo Is Nothing, ch.PropertyKey, ch.PropertyInfo.PropertyName)
            Dim idx As Integer = Grid.Rows.Add(If(String.IsNullOrWhiteSpace(ch.PartNumber), ch.FileName, ch.PartNumber),
                                               propName, ch.OldValue, ch.NewValue, ch.Status, ch.FileName)
            Grid.Rows(idx).Tag = ch
        Next

        Dim buttons As New FlowLayoutPanel()
        buttons.Dock = DockStyle.Bottom
        buttons.Height = 48
        buttons.FlowDirection = FlowDirection.RightToLeft
        AddActionButton(buttons, "COMMIT ALL", "COMMIT_ALL")
        AddActionButton(buttons, "COMMIT SELECTED", "COMMIT_SELECTED")
        AddActionButton(buttons, "DISCARD ALL", "DISCARD_ALL")
        AddActionButton(buttons, "DISCARD SELECTED", "DISCARD_SELECTED")
        Dim closeButton As New Button()
        closeButton.Text = "CLOSE"
        closeButton.Size = New Size(95, 30)
        AddHandler closeButton.Click, Sub() Me.Close()
        buttons.Controls.Add(closeButton)

        AddHandler PartFilter.TextChanged, Sub() ApplyPendingFilter(PartFilter.Text, PropertyFilter.Text, Convert.ToString(StatusFilter.SelectedItem))
        AddHandler PropertyFilter.TextChanged, Sub() ApplyPendingFilter(PartFilter.Text, PropertyFilter.Text, Convert.ToString(StatusFilter.SelectedItem))
        AddHandler StatusFilter.SelectedIndexChanged, Sub() ApplyPendingFilter(PartFilter.Text, PropertyFilter.Text, Convert.ToString(StatusFilter.SelectedItem))
        Me.Controls.Add(Grid)
        Me.Controls.Add(FilterBar)
        Me.Controls.Add(buttons)
    End Sub

    Private Sub ApplyPendingFilter(ByVal partText As String, ByVal propertyText As String, ByVal statusText As String)
        Dim p As String = If(partText, "").Trim().ToUpperInvariant()
        Dim prop As String = If(propertyText, "").Trim().ToUpperInvariant()
        Dim st As String = If(statusText, "ALL").Trim().ToUpperInvariant()
        For Each row As DataGridViewRow In Grid.Rows
            Dim ok1 As Boolean = p = "" OrElse Convert.ToString(row.Cells("PART").Value).ToUpperInvariant().Contains(p)
            Dim ok2 As Boolean = prop = "" OrElse Convert.ToString(row.Cells("PROPERTY").Value).ToUpperInvariant().Contains(prop)
            Dim ok3 As Boolean = st = "ALL" OrElse Convert.ToString(row.Cells("STATUS").Value).ToUpperInvariant() = st
            row.Visible = ok1 AndAlso ok2 AndAlso ok3
        Next
    End Sub

    Private Sub AddActionButton(ByVal host As FlowLayoutPanel, ByVal caption As String, ByVal action As String)
        Dim b As New Button()
        b.Text = caption
        b.Tag = action
        b.AutoSize = True
        b.Height = 30
        AddHandler b.Click, AddressOf ActionClicked
        host.Controls.Add(b)
    End Sub

    Private Sub ActionClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim b As Button = TryCast(sender, Button)
        If b Is Nothing Then Exit Sub
        ActionName = Convert.ToString(b.Tag)
        SelectedChanges.Clear()
        For Each row As DataGridViewRow In Grid.SelectedRows
            Dim ch As BomPropertyChange = TryCast(row.Tag, BomPropertyChange)
            If ch IsNot Nothing Then SelectedChanges.Add(ch)
        Next
        If (ActionName = "COMMIT_SELECTED" OrElse ActionName = "DISCARD_SELECTED") AndAlso SelectedChanges.Count = 0 Then
            MessageBox.Show("Hãy chọn ít nhất một thay đổi.", "PENDING CHANGES", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Me.DialogResult = DialogResult.OK
        Me.Close()
    End Sub
End Class

Public Class BomRecoveryForm
    Inherits BomDialogBase
    Private Grid As DataGridView
    Public RestoreRequested As Boolean = False
    Public DiscardRequested As Boolean = False

    Public Sub New(ByVal changes As List(Of BomPropertyChange), ByVal savedAt As DateTime)
        Me.Text = "SESSION RECOVERY"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(900, 520)
        Me.MinimumSize = New Size(720, 400)
        Me.Font = New Font("Segoe UI", 9.0F)

        Dim header As New Label()
        header.Dock = DockStyle.Top
        header.Height = 52
        header.Padding = New Padding(10)
        header.Text = "Previous session contains " & changes.Count.ToString() & " uncommitted changes." &
                      If(savedAt = DateTime.MinValue, "", "  Last saved: " & savedAt.ToString("yyyy-MM-dd HH:mm:ss"))

        Grid = New DataGridView()
        Grid.Dock = DockStyle.Fill
        Grid.ReadOnly = True
        Grid.AllowUserToAddRows = False
        Grid.RowHeadersVisible = False
        Grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        Grid.Columns.Add("PART", "PART")
        Grid.Columns.Add("PROPERTY", "PROPERTY")
        Grid.Columns.Add("OLD", "STORED OLD")
        Grid.Columns.Add("PENDING", "RECOVERED")
        Grid.Columns.Add("STATUS", "STATUS")
        Grid.Columns.Add("DETAIL", "DETAIL")
        For Each ch As BomPropertyChange In changes
            Dim propName As String = If(ch.PropertyInfo Is Nothing, ch.PropertyKey, ch.PropertyInfo.PropertyName)
            Grid.Rows.Add(If(String.IsNullOrWhiteSpace(ch.PartNumber), ch.FileName, ch.PartNumber),
                          propName, ch.OldValue, ch.NewValue, ch.Status, ch.ErrorMessage)
        Next

        Dim buttons As New FlowLayoutPanel()
        buttons.Dock = DockStyle.Bottom
        buttons.Height = 48
        buttons.FlowDirection = FlowDirection.RightToLeft

        Dim restore As New Button()
        restore.Text = "RESTORE CHANGES"
        restore.AutoSize = True
        AddHandler restore.Click, Sub()
                                      RestoreRequested = True
                                      Me.DialogResult = DialogResult.OK
                                      Me.Close()
                                  End Sub
        buttons.Controls.Add(restore)

        Dim discard As New Button()
        discard.Text = "DISCARD"
        discard.AutoSize = True
        AddHandler discard.Click, Sub()
                                      DiscardRequested = True
                                      Me.DialogResult = DialogResult.Cancel
                                      Me.Close()
                                  End Sub
        buttons.Controls.Add(discard)

        Dim viewOnly As New Button()
        viewOnly.Text = "KEEP FOR LATER"
        viewOnly.AutoSize = True
        AddHandler viewOnly.Click, Sub() Me.Close()
        buttons.Controls.Add(viewOnly)

        Me.Controls.Add(Grid)
        Me.Controls.Add(header)
        Me.Controls.Add(buttons)
    End Sub
End Class

