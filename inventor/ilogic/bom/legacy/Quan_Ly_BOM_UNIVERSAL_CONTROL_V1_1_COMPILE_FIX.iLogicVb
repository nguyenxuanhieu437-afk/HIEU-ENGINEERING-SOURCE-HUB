    Private Sub ConfigureCommandUiMetadata()
        Dim quickIds() As String = {"SmartRefresh", "ReviewPending", "CommitAll", "Save", "Undo", "Redo"}
        For Each id As String In quickIds
            Dim c As BomCommandDefinition = BomCommandRegistry.GetCommand(id)
            If c IsNot Nothing Then c.IsQuickAccess = True
        Next
        SetContext("OpenPart", "PART", "OPEN")
        SetContext("OpenDrawing", "PART", "OPEN")
        SetContext("Highlight", "PART", "VIEW")
        SetContext("Zoom", "PART", "VIEW")
        SetContext("Isolate", "PART", "VIEW")
        SetContext("Restore", "PART", "VIEW")
        SetContext("WhereUsed", "PART", "ANALYZE")
        SetContext("Impact", "PART", "ANALYZE")
        SetContext("EditProperty", "PART", "EDIT")
        SetContext("CopyCell", "PART", "GRID")
        SetContext("Paste", "PART", "GRID")
        SetContext("FillDown", "PART", "GRID")
        SetContext("ClearProperty", "PART", "GRID")
        SetContext("Visibility", "PART", "INVENTOR")
        SetContext("Suppress", "PART", "INVENTOR")
        SetContext("Unsuppress", "PART", "INVENTOR")
        SetContext("Ground", "PART", "INVENTOR")
    End Sub

    Private Sub SetContext(ByVal id As String, ByVal target As String, ByVal groupName As String)
        Dim c As BomCommandDefinition = BomCommandRegistry.GetCommand(id)
        If c Is Nothing Then Exit Sub
        c.ContextTarget = target : c.ContextGroup = groupName
        ConfigureCommandUiMetadata()
    End Sub

    Private Sub RegisterCommand(ByVal id As String, ByVal caption As String, ByVal shortCaption As String,
                                ByVal workspace As String, ByVal groupName As String, ByVal iconKey As String,
                                ByVal tooltip As String, ByVal shortcut As String, ByVal isWrite As Boolean,
                                ByVal destructive As Boolean, ByVal requiresSelection As Boolean,
                                ByVal orderValue As Integer, ByVal primary As Boolean, ByVal handler As EventHandler)
        Dim c As New BomCommandDefinition()
        c.Id = id : c.Caption = caption : c.ShortCaption = shortCaption
        c.Workspace = workspace : c.GroupName = groupName : c.IconKey = iconKey
        c.Tooltip = tooltip : c.Description = tooltip : c.Shortcut = shortcut
        c.IsWriteOperation = isWrite : c.IsDestructive = destructive
        c.RequiresSelection = requiresSelection : c.Order = orderValue
        c.IsPrimary = primary : c.Handler = handler
        c.CommandType = If(destructive, BomCommandType.DestructiveCommand, If(isWrite, BomCommandType.WriteCommand, BomCommandType.ReadOnlyCommand))
        BomCommandRegistry.Register(c)
    End Sub

    Private Sub BuildToolBar()
        If RibbonContent Is Nothing Then Exit Sub
        RibbonContent.SuspendLayout()
        Try
            If ToolBar IsNot Nothing Then
                RibbonContent.Controls.Remove(ToolBar)
                ToolBar.Dispose()
            End If
            ToolBar = New System.Windows.Forms.ToolStrip()
            ToolBar.Dock = DockStyle.Fill
            ToolBar.GripStyle = System.Windows.Forms.ToolStripGripStyle.Hidden
            ToolBar.RenderMode = System.Windows.Forms.ToolStripRenderMode.Professional
            ToolBar.BackColor = Color.FromArgb(248, 250, 252)
            ToolBar.ForeColor = Color.FromArgb(40, 55, 65)
            ToolBar.Padding = New System.Windows.Forms.Padding(8, 2, 8, 2)
            ToolBar.AutoSize = False
            ToolBar.Height = 68
            ToolBar.CanOverflow = True
            ToolBar.ShowItemToolTips = True
            ToolBar.ImageScalingSize = New Size(28, 28)
            RibbonContent.Controls.Add(ToolBar)

            Dim commands As List(Of BomCommandDefinition) = BomCommandRegistry.ForWorkspace(_activeRibbonTab)
            Dim lastGroup As String = ""
            For Each cmd As BomCommandDefinition In commands
                If Not String.Equals(lastGroup, cmd.GroupName, StringComparison.OrdinalIgnoreCase) Then
                    If lastGroup <> "" Then AddRibbonSeparator()
                    AddToolGroup(cmd.GroupName)
                    lastGroup = cmd.GroupName
                End If
                If cmd.Id = "DisplayMode" Then
                    AddDisplayModeButton()
                ElseIf cmd.Handler IsNot Nothing Then
                    AddRegisteredToolButton(cmd)
                End If
            Next
            ApplyCommandAvailability()
        Finally
            RibbonContent.ResumeLayout(True)
        End Try
    End Sub

    Private Sub AddRegisteredToolButton(ByVal cmd As BomCommandDefinition)
        Dim button As New System.Windows.Forms.ToolStripButton(cmd.ShortCaption)
        button.Name = "CMD_" & cmd.Id
        button.Tag = cmd
        button.DisplayStyle = System.Windows.Forms.ToolStripItemDisplayStyle.ImageAndText
        button.TextImageRelation = System.Windows.Forms.TextImageRelation.ImageAboveText
        button.Image = BomIconCache.GetOrCreate(cmd.IconKey, Function() CreateToolbarIcon(cmd.IconKey))
        button.ImageScaling = System.Windows.Forms.ToolStripItemImageScaling.None
        button.AutoSize = False
        button.Size = GetToolbarButtonSize(cmd.ShortCaption)
        button.Margin = New System.Windows.Forms.Padding(3, 1, 3, 1)
        button.Padding = New System.Windows.Forms.Padding(3, 2, 3, 2)
        button.Font = New Font("Segoe UI", 8.0F, If(cmd.IsPrimary, FontStyle.Bold, FontStyle.Regular))
        button.ToolTipText = cmd.Tooltip & If(String.IsNullOrWhiteSpace(cmd.Shortcut), "", "  [" & cmd.Shortcut & "]")
        button.AutoToolTip = True
        button.BackColor = If(cmd.IsPrimary, Color.FromArgb(225, 239, 248), Color.FromArgb(248, 250, 252))
        button.ForeColor = If(cmd.IsDestructive, Color.FromArgb(170, 55, 55), Color.FromArgb(45, 65, 78))
        AddHandler button.MouseEnter, AddressOf RibbonButtonMouseEnter
        AddHandler button.MouseLeave, AddressOf RibbonButtonMouseLeave
        AddHandler button.Click, cmd.Handler
        ToolBar.Items.Add(button)
    End Sub

    Private Sub ApplyCommandAvailability()
        If ToolBar Is Nothing Then Exit Sub
        For Each item As System.Windows.Forms.ToolStripItem In ToolBar.Items
            Dim cmd As BomCommandDefinition = TryCast(item.Tag, BomCommandDefinition)
            If cmd Is Nothing Then Continue For
            Dim enabled As Boolean = True
            If _safeMode AndAlso cmd.IsWriteOperation Then enabled = False
            If cmd.RequiresSelection AndAlso (Grid Is Nothing OrElse Grid.SelectedRows.Count = 0) Then enabled = False
            item.Enabled = enabled
        Next
    End Sub

    Private Sub AddRibbonSeparator()
        Dim separator As New System.Windows.Forms.ToolStripSeparator()
        separator.Margin = New System.Windows.Forms.Padding(6, 4, 6, 4)
        ToolBar.Items.Add(separator)
    End Sub

    Private Sub AddDisplayModeButton()
        _displayModeButton = New System.Windows.Forms.ToolStripButton("HYBRID BOM")
        _displayModeButton.DisplayStyle = System.Windows.Forms.ToolStripItemDisplayStyle.ImageAndText
        _displayModeButton.TextImageRelation = System.Windows.Forms.TextImageRelation.ImageAboveText
        _displayModeButton.Image = CreateToolbarIcon("THEO ASSEMBLY")
        _displayModeButton.ImageScaling = System.Windows.Forms.ToolStripItemImageScaling.None
        _displayModeButton.AutoSize = False
        _displayModeButton.Size = New Size(92, 58)
        _displayModeButton.Margin = New System.Windows.Forms.Padding(3, 1, 3, 1)
        _displayModeButton.Padding = New System.Windows.Forms.Padding(3, 2, 3, 2)
        _displayModeButton.Font = New Font("Segoe UI", 8.0F, FontStyle.Bold)
        _displayModeButton.BackColor = Color.FromArgb(220, 244, 247)
        _displayModeButton.ForeColor = Color.FromArgb(25, 100, 112)
        _displayModeButton.ToolTipText = "3 chế độ BOM: PARTS ONLY → STRUCTURED → HYBRID. Nhấn để chuyển chế độ."
        _displayModeButton.AutoToolTip = True
        AddHandler _displayModeButton.Click, AddressOf ToggleDisplayModeClicked
        ToolBar.Items.Add(_displayModeButton)
    End Sub

    Private Sub AddToolGroup(ByVal caption As String)
        Dim groupLabel As New System.Windows.Forms.ToolStripLabel(caption)
        groupLabel.Font = New Font("Segoe UI", 7.5F, FontStyle.Bold)
        groupLabel.ForeColor = Color.FromArgb(105, 115, 125)
        groupLabel.Margin = New System.Windows.Forms.Padding(5, 1, 1, 1)
        groupLabel.Alignment = System.Windows.Forms.ToolStripItemAlignment.Left
        groupLabel.ToolTipText = "Nhóm chức năng " & caption
        groupLabel.DisplayStyle = System.Windows.Forms.ToolStripItemDisplayStyle.Text
        ToolBar.Items.Add(groupLabel)
    End Sub

    Private Sub AddToolButton(ByVal caption As String, ByVal handler As EventHandler, ByVal description As String, ByVal isPrimary As Boolean)
        Dim button As New System.Windows.Forms.ToolStripButton(caption)
        button.DisplayStyle = System.Windows.Forms.ToolStripItemDisplayStyle.ImageAndText
        button.TextImageRelation = System.Windows.Forms.TextImageRelation.ImageAboveText
        button.Image = BomIconCache.GetOrCreate(caption, Function() CreateToolbarIcon(caption))
        button.ImageScaling = System.Windows.Forms.ToolStripItemImageScaling.None
        button.AutoSize = False
        button.Size = GetToolbarButtonSize(caption)
        button.Margin = New System.Windows.Forms.Padding(3, 1, 3, 1)
        button.Padding = New System.Windows.Forms.Padding(3, 2, 3, 2)
        button.Font = New Font("Segoe UI", 8.0F, FontStyle.Bold)
        button.ToolTipText = description
        button.AutoToolTip = True
        If isPrimary Then
            button.BackColor = Color.FromArgb(225, 239, 248)
            button.ForeColor = Color.FromArgb(25, 86, 125)
        Else
            button.BackColor = Color.FromArgb(248, 250, 252)
            button.ForeColor = Color.FromArgb(45, 65, 78)
        End If
        AddHandler button.MouseEnter, AddressOf RibbonButtonMouseEnter
        AddHandler button.MouseLeave, AddressOf RibbonButtonMouseLeave
        AddHandler button.Click, handler
        ToolBar.Items.Add(button)
    End Sub

    Private Function GetToolbarButtonSize(ByVal caption As String) As Size
        Dim measured As Size = System.Windows.Forms.TextRenderer.MeasureText(If(caption, ""), New Font("Segoe UI", 8.0F, FontStyle.Bold))
        Dim width As Integer = measured.Width + 24
        width = Math.Max(82, Math.Min(138, width))
        Return New Size(width, 58)
    End Function

    Private Sub RibbonButtonMouseEnter(ByVal sender As Object, ByVal e As EventArgs)
        Dim item As System.Windows.Forms.ToolStripItem = TryCast(sender, System.Windows.Forms.ToolStripItem)
        If item Is Nothing Then Exit Sub
        item.BackColor = Color.FromArgb(215, 240, 246)
    End Sub

    Private Sub RibbonButtonMouseLeave(ByVal sender As Object, ByVal e As EventArgs)
        Dim item As System.Windows.Forms.ToolStripItem = TryCast(sender, System.Windows.Forms.ToolStripItem)
        If item Is Nothing Then Exit Sub
        If item Is _displayModeButton Then
            item.BackColor = Color.FromArgb(220, 244, 247)
        Else
            item.BackColor = Color.FromArgb(248, 250, 252)
        End If
    End Sub

    Private Function CreateToolbarIcon(ByVal caption As String) As System.Drawing.Image
        Dim bmp As New System.Drawing.Bitmap(34, 34)
        Using g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)
            g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias
            g.Clear(Color.Transparent)

            Dim key As String = If(caption, "").ToUpperInvariant()
            Dim navy As Color = Color.FromArgb(38, 105, 145)
            Dim cyan As Color = Color.FromArgb(40, 165, 185)
            Dim green As Color = Color.FromArgb(45, 155, 95)
            Dim orange As Color = Color.FromArgb(235, 150, 45)
            Dim red As Color = Color.FromArgb(215, 70, 70)
            Dim gray As Color = Color.FromArgb(100, 115, 125)
            Dim purple As Color = Color.FromArgb(145, 85, 175)

            If key.Contains("LOAD") Then
                Using b As New System.Drawing.SolidBrush(Color.FromArgb(250, 190, 55))
                    g.FillRectangle(b, 3, 10, 25, 17)
                    g.FillRectangle(b, 6, 7, 10, 5)
                End Using
                Using p As New System.Drawing.Pen(green, 3)
                    g.DrawLine(p, 25, 29, 25, 18)
                    g.DrawLine(p, 20, 23, 25, 18)
                    g.DrawLine(p, 30, 23, 25, 18)
                End Using

            ElseIf key.Contains("LÀM MỚI") Then
                Using p As New System.Drawing.Pen(navy, 3)
                    g.DrawArc(p, 5, 5, 24, 24, 35, 280)
                    g.DrawLine(p, 26, 5, 29, 12)
                    g.DrawLine(p, 26, 5, 20, 8)
                End Using

            ElseIf key.Contains("XÓA") OrElse key.Contains("BỎ TẤT") Then
                Using p As New System.Drawing.Pen(red, 4)
                    g.DrawLine(p, 7, 7, 27, 27)
                    g.DrawLine(p, 27, 7, 7, 27)
                End Using

            ElseIf key.Contains("IPROPERTY") Then
                Using b As New System.Drawing.SolidBrush(purple)
                    g.FillEllipse(b, 5, 4, 22, 22)
                End Using
                Using f As New System.Drawing.Font("Segoe UI", 14.0F, FontStyle.Bold)
                    g.DrawString("i", f, System.Drawing.Brushes.White, 12, 3)
                End Using
                Using b As New System.Drawing.SolidBrush(green)
                    g.FillEllipse(b, 21, 20, 12, 12)
                End Using
                Using p As New System.Drawing.Pen(Color.White, 2)
                    g.DrawLine(p, 27, 22, 27, 30)
                    g.DrawLine(p, 23, 26, 31, 26)
                End Using

            ElseIf key.Contains("TÍNH TOÁN") OrElse key.Contains("CALCULATOR") Then
                Using p As New System.Drawing.Pen(navy, 2)
                    g.DrawRectangle(p, 5, 3, 24, 29)
                    g.DrawRectangle(p, 9, 7, 16, 6)
                    g.DrawLine(p, 9, 18, 25, 18)
                    g.DrawLine(p, 9, 24, 25, 24)
                    g.DrawLine(p, 14, 15, 14, 29)
                    g.DrawLine(p, 20, 15, 20, 29)
                End Using

            ElseIf key.Contains("LƯU") Then
                Using b As New System.Drawing.SolidBrush(navy)
                    g.FillRectangle(b, 5, 4, 24, 26)
                End Using
                Using b As New System.Drawing.SolidBrush(Color.White)
                    g.FillRectangle(b, 9, 6, 14, 8)
                    g.FillRectangle(b, 10, 19, 14, 9)
                End Using

            ElseIf key.Contains("COPY") Then
                Using p As New System.Drawing.Pen(navy, 2)
                    g.DrawRectangle(p, 10, 5, 18, 22)
                    g.DrawRectangle(p, 5, 10, 18, 20)
                End Using
            ElseIf key.Contains("PASTE") Then
                Using p As New System.Drawing.Pen(green, 2)
                    g.DrawRectangle(p, 7, 8, 20, 23)
                    g.DrawRectangle(p, 12, 3, 10, 7)
                End Using
            ElseIf key.Contains("FILL") Then
                Using p As New System.Drawing.Pen(navy, 2)
                    g.DrawRectangle(p, 7, 4, 20, 25)
                    g.DrawLine(p, 17, 10, 17, 25)
                    g.DrawLine(p, 12, 20, 17, 25)
                    g.DrawLine(p, 22, 20, 17, 25)
                End Using
            ElseIf key.Contains("XUẤT") Then
                Using b As New System.Drawing.SolidBrush(green)
                    g.FillRectangle(b, 5, 4, 21, 27)
                End Using
                Using f As New System.Drawing.Font("Segoe UI", 13.0F, FontStyle.Bold)
                    g.DrawString("X", f, System.Drawing.Brushes.White, 7, 8)
                End Using
                If key.Contains("LỌC") Then
                    Using b As New System.Drawing.SolidBrush(gray)
                        Dim pts() As System.Drawing.Point = {New System.Drawing.Point(20, 7), New System.Drawing.Point(33, 7), New System.Drawing.Point(28, 15), New System.Drawing.Point(28, 25), New System.Drawing.Point(25, 28), New System.Drawing.Point(25, 15)}
                        g.FillPolygon(b, pts)
                    End Using
                ElseIf key.Contains("CHỌN") Then
                    Using p As New System.Drawing.Pen(navy, 2)
                        g.DrawLine(p, 23, 22, 27, 27)
                        g.DrawLine(p, 27, 27, 33, 17)
                    End Using
                Else
                    Using p As New System.Drawing.Pen(navy, 2)
                        g.DrawLine(p, 26, 23, 31, 28)
                        g.DrawLine(p, 31, 28, 33, 24)
                    End Using
                End If

            ElseIf key.Contains("ASSEMBLY") OrElse key.Contains("HIỂN THỊ") Then
                Using p As New System.Drawing.Pen(cyan, 2)
                    g.DrawRectangle(p, 5, 5, 10, 10)
                    g.DrawRectangle(p, 19, 5, 10, 10)
                    g.DrawRectangle(p, 12, 20, 10, 10)
                    g.DrawLine(p, 10, 15, 17, 20)
                    g.DrawLine(p, 24, 15, 17, 20)
                End Using

            ElseIf key.Contains("THU GỌN") Then
                Using p As New System.Drawing.Pen(navy, 3)
                    g.DrawEllipse(p, 5, 5, 24, 24)
                    g.DrawLine(p, 10, 17, 24, 17)
                End Using

            ElseIf key.Contains("MỞ RỘNG") Then
                Using p As New System.Drawing.Pen(navy, 3)
                    g.DrawEllipse(p, 5, 5, 24, 24)
                    g.DrawLine(p, 10, 17, 24, 17)
                    g.DrawLine(p, 17, 10, 17, 24)
                End Using

            ElseIf key.Contains("CỘT") OrElse key.Contains("BỐ CỤC") Then
                Using p As New System.Drawing.Pen(gray, 2)
                    g.DrawRectangle(p, 4, 5, 26, 24)
                    g.DrawLine(p, 12, 5, 12, 29)
                    g.DrawLine(p, 21, 5, 21, 29)
                    g.DrawLine(p, 4, 13, 30, 13)
                End Using

            ElseIf key.Contains("DRAWING") Then
                Using p As New System.Drawing.Pen(navy, 2)
                    g.DrawRectangle(p, 6, 4, 21, 27)
                    g.DrawLine(p, 10, 11, 23, 11)
                    g.DrawLine(p, 10, 16, 23, 16)
                    g.DrawLine(p, 10, 21, 20, 21)
                End Using

            ElseIf key.Contains("MỞ PART") Then
                Using p As New System.Drawing.Pen(cyan, 2)
                    Dim pts() As System.Drawing.Point = {New System.Drawing.Point(17, 3), New System.Drawing.Point(29, 10), New System.Drawing.Point(29, 24), New System.Drawing.Point(17, 31), New System.Drawing.Point(5, 24), New System.Drawing.Point(5, 10)}
                    g.DrawPolygon(p, pts)
                    g.DrawLine(p, 5, 10, 17, 17)
                    g.DrawLine(p, 29, 10, 17, 17)
                    g.DrawLine(p, 17, 17, 17, 31)
                End Using

            ElseIf key.Contains("HIGHLIGHT") OrElse key.Contains("ĐÁNH DẤU") Then
                Using b As New System.Drawing.SolidBrush(Color.FromArgb(255, 225, 75))
                    g.FillEllipse(b, 6, 6, 22, 22)
                End Using
                Using p As New System.Drawing.Pen(orange, 2)
                    g.DrawEllipse(p, 6, 6, 22, 22)
                End Using

            ElseIf key.Contains("ZOOM") Then
                Using p As New System.Drawing.Pen(navy, 3)
                    g.DrawEllipse(p, 5, 5, 18, 18)
                    g.DrawLine(p, 21, 21, 30, 30)
                End Using

            Else
                Using b As New System.Drawing.SolidBrush(navy)
                    g.FillEllipse(b, 6, 6, 22, 22)
                End Using
                Using f As New System.Drawing.Font("Segoe UI", 11.0F, FontStyle.Bold)
                    g.DrawString("•", f, System.Drawing.Brushes.White, 11, 7)
                End Using
            End If
        End Using
        Return bmp
    End Function


