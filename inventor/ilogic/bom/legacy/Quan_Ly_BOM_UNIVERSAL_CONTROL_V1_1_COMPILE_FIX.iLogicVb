'####################################################################
' SUBSECTION 15.01 - CONSTRUCTOR / FORM INITIALIZATION
'####################################################################

    Public Sub New( _
        ByVal inventorApplication As Inventor.Application, _
        ByVal assemblyPath As String, _
        ByVal assemblyName As String, _
        ByVal items As List(Of PartBomItem), _
        ByVal selectedProperties As List(Of PropertyColumnInfo), _
        ByVal includeFileName As Boolean, _
        ByVal includeFilePath As Boolean, _
        ByVal includeParentAssembly As Boolean, _
        ByVal exportCallback As System.Action(Of List(Of PartBomItem)), _
        ByVal refreshCallback As System.Action(Of List(Of PartBomItem)), _
        ByVal loadBomCallback As System.Action, _
        ByVal scanMode As BomScanMode)

        _inventor = inventorApplication
        _assemblyPath = assemblyPath
        _assemblyName = assemblyName
        _allItems = items
        _selectedProperties = selectedProperties
        _includeFileName = includeFileName
        _includeFilePath = includeFilePath
        _includeParentAssembly = includeParentAssembly
        _exportCallback = exportCallback
        _refreshCallback = refreshCallback
        _loadBomCallback = loadBomCallback
        _scanMode = scanMode
        _performance.LastMode = _scanMode.ToString().ToUpperInvariant()
        _loadedAt = DateTime.Now
        _rootAssemblySignature = BomSignatureEngine.FileSignature(_assemblyPath)
        For Each signatureItem As PartBomItem In _allItems
            If signatureItem IsNot Nothing AndAlso signatureItem.SignatureCapturedAt = DateTime.MinValue Then BomSignatureEngine.CaptureIntoItem(signatureItem)
        Next
        _runtimeIndex.Build(_assemblyName, _allItems)
        RegisterBuiltInFeatures()
        RegisterUiCommands()

        Dim configFolder As String = IOPath.Combine( _
            System.Environment.GetFolderPath(System.Environment.SpecialFolder.MyDocuments), _
            "BOMToolByHieu")
        Try
            If Not System.IO.Directory.Exists(configFolder) Then System.IO.Directory.CreateDirectory(configFolder)
        Catch
        End Try
        _layoutFile = IOPath.Combine(configFolder, "BOM_VIEWER_LAYOUT.txt")
        _drawingMapFile = IOPath.Combine(configFolder, "DRAWING_PATH_MAP.txt")
        _sessionFile = IOPath.Combine(configFolder, "BOM_SESSION_STATE.txt")
        _pendingRecoveryFile = IOPath.Combine(configFolder, "BOM_PENDING_TRANSACTION.txt")
        _safeMode = _config.SafeModeDefault
        _transactionAtomic = _config.AtomicTransactionDefault

        BuildInterface()
        BuildColumns()
        LoadManualDrawingMap()

        If _scanMode <> BomScanMode.Fast Then
            SourceLabel.Text = "Đang xác định vị trí Drawing..."
            WinFormsApplication.DoEvents()
            BuildDrawingIndex()
        Else
            _drawingIndex.Clear()
        End If

        If _scanMode = BomScanMode.Deep Then
            SourceLabel.Text = "DEEP MODE - đang nạp Geometry..."
            WinFormsApplication.DoEvents()
            Dim deepIndex As Integer = 0
            For Each deepItem As PartBomItem In _allItems
                BomGeometryEngine.EnsureLoaded(deepItem)
                deepIndex += 1
                If deepIndex Mod 25 = 0 Then WinFormsApplication.DoEvents()
            Next
        End If

        SourceLabel.Text = "Nguồn: " & _assemblyPath & "  |  MODE: " & _scanMode.ToString().ToUpperInvariant()
        BuildAssemblyFilterItems()
        LoadRows()
        TryLoadLayout(False)
        RestoreSessionState()
        RestorePendingTransactionIfAvailable()
        UpdateSafeModeUI()
    End Sub

    Public Sub ReplaceAssemblyData( _
        ByVal assemblyPath As String, _
        ByVal assemblyName As String, _
        ByVal items As List(Of PartBomItem), _
        ByVal selectedProperties As List(Of PropertyColumnInfo), _
        ByVal includeFileName As Boolean, _
        ByVal includeFilePath As Boolean, _
        ByVal includeParentAssembly As Boolean, _
        ByVal exportCallback As System.Action(Of List(Of PartBomItem)), _
        ByVal refreshCallback As System.Action(Of List(Of PartBomItem)), _
        ByVal loadBomCallback As System.Action, _
        ByVal scanMode As BomScanMode)

        'Atomic UI/data swap: caller only invokes this after successful scan.
        If items Is Nothing Then Throw New ArgumentNullException("items")
        If selectedProperties Is Nothing Then selectedProperties = New List(Of PropertyColumnInfo)()

        Me.SuspendLayout()
        Try
            _assemblyPath = assemblyPath
            _assemblyName = assemblyName
            _allItems = items
            _selectedProperties = selectedProperties
            _includeFileName = includeFileName
            _includeFilePath = includeFilePath
            _includeParentAssembly = includeParentAssembly
            _exportCallback = exportCallback
            _refreshCallback = refreshCallback
            _loadBomCallback = loadBomCallback
            _scanMode = scanMode
            _loadedAt = DateTime.Now
            _rootAssemblySignature = BomSignatureEngine.FileSignature(_assemblyPath)

            _pendingTransaction = New BomTransaction()
            _undoStack.Clear()
            _redoStack.Clear()
            _drawingIndex.Clear()
            _runtimeIndex.Build(_assemblyName, _allItems)

            If _scanMode <> BomScanMode.Fast Then BuildDrawingIndex()

            BuildAssemblyFilterItems()
            BuildColumns()
            LoadRows()

            Me.Text = BomConstants.ToolVersion & " - " & _assemblyName
            If SourceLabel IsNot Nothing Then
                SourceLabel.Text = "Nguồn: " & _assemblyPath & "  |  MODE: " & _scanMode.ToString().ToUpperInvariant()
            End If

            UpdatePendingCaption()
            UpdateSafeModeUI()
            SaveSessionState()
            BomViewerRegistry.UpdateAssembly(_assemblyPath)

            If StatusSelection IsNot Nothing Then
                StatusSelection.Text = "Loaded: " & _assemblyName
            End If
        Finally
            Me.ResumeLayout(True)
        End Try
    End Sub


