    Private Sub ManufacturingPurchasedClicked(ByVal sender As Object, ByVal e As EventArgs)
        ShowManufacturingList(BomManufacturingType.Purchased, "PURCHASED LIST")
    End Sub

    Private Sub ManufacturingFastenerClicked(ByVal sender As Object, ByVal e As EventArgs)
        ShowManufacturingList(BomManufacturingType.Fastener, "FASTENER LIST")
    End Sub

    Private Sub ShowManufacturingList(ByVal mfgType As BomManufacturingType, ByVal title As String)
        Dim records As List(Of BomManufacturingRecord) = BomManufacturingListBuilder.BuildRecords(_allItems)
        records = BomManufacturingListBuilder.Filter(records, mfgType)
        Using f As New BomManufacturingListForm(title, records)
            f.ShowDialog(Me)
        End Using
    End Sub

    Private Sub ToggleSafeModeClicked(ByVal sender As Object, ByVal e As EventArgs)
        _safeMode = Not _safeMode
        UpdateSafeModeUI()
        BomLogger.Info("SAFE_MODE", If(_safeMode, "Safe Mode enabled", "Safe Mode disabled"))
    End Sub

    Private Sub UpdateSafeModeUI()
        If Grid IsNot Nothing Then Grid.ReadOnly = _safeMode
        If ToolBar IsNot Nothing Then
            For Each toolItem As System.Windows.Forms.ToolStripItem In ToolBar.Items
                Dim key As String = If(toolItem.Text, "").ToUpperInvariant()
                Dim isWrite As Boolean =
                    key.Contains("LƯU") OrElse key.Contains("SAVE") OrElse key.Contains("PASTE") OrElse key.Contains("FILL") OrElse
                    key.Contains("XÓA Ô") OrElse key.Contains("SUPPRESS") OrElse key.Contains("UNSUPPRESS") OrElse
                    key.Contains("GROUND") OrElse key.Contains("ẨN / HIỆN") OrElse key.Contains("ISOLATE") OrElse
                    key.Contains("RESTORE") OrElse key = "UPDATE" OrElse key = "REBUILD" OrElse key.Contains("COMMIT")
                If isWrite Then toolItem.Enabled = Not _safeMode
            Next
        End If
        If RibbonQuickBar IsNot Nothing Then
            For Each c As Control In RibbonQuickBar.Controls
                Dim b As Button = TryCast(c, Button)
                If b Is Nothing Then Continue For
                Dim key As String = If(b.Text, "").ToUpperInvariant()
                If key = "COMMIT" OrElse key = "UNDO" OrElse key = "REDO" Then b.Enabled = Not _safeMode
            Next
        End If
        If StatusSafeMode IsNot Nothing Then
            If _safeMode Then
                StatusSafeMode.Text = "SAFE MODE | READ ONLY"
                StatusSafeMode.ForeColor = Color.DarkOrange
            Else
                StatusSafeMode.Text = "EDIT MODE"
                StatusSafeMode.ForeColor = Color.FromArgb(55, 80, 90)
            End If
        End If
        UpdatePendingCaption()
    End Sub

    Private Sub ShowSafeModeNotice(ByVal operationName As String)
        If StatusSelection IsNot Nothing Then StatusSelection.Text = "SAFE MODE | READ ONLY | Blocked: " & operationName
        BomLogger.Warn("SAFE_MODE", "Blocked operation: " & operationName)
    End Sub

    Private Sub SaveSessionState()
        If Not _config.EnableSessionPersistence OrElse String.IsNullOrWhiteSpace(_sessionFile) Then Exit Sub
        Try
            Dim s As New BomSessionState()
            s.AssemblyPath = _assemblyPath
            s.DisplayMode = _bomDisplayMode.ToString()
            s.ScanMode = _scanMode.ToString()
            s.SearchText = If(SearchBox Is Nothing, "", SearchBox.Text)
            s.AssemblyFilter = If(AssemblyFilterBox Is Nothing, "", AssemblyFilterBox.Text)
            s.QuickFilter = _quickFilterMode
            s.ActiveWorkspace = _activeRibbonTab
            s.SafeMode = _safeMode
            s.RibbonCollapsed = _ribbonCollapsed
            s.DetailPanelVisible = (MainSplit IsNot Nothing AndAlso Not MainSplit.Panel2Collapsed)
            If MainSplit IsNot Nothing AndAlso Not MainSplit.Panel2Collapsed Then s.DetailPanelWidth = Math.Max(260, MainSplit.ClientSize.Width - MainSplit.SplitterDistance)
            s.SelectedProfile = _selectedColumnProfile
            If Me.WindowState = System.Windows.Forms.FormWindowState.Normal Then
                s.WindowWidth = Me.Width
                s.WindowHeight = Me.Height
                s.WindowLeft = Me.Left
                s.WindowTop = Me.Top
            End If
            s.Save(_sessionFile)
        Catch ex As Exception
            BomLogger.Warn("SESSION", "Save session failed: " & ex.Message)
        End Try
    End Sub

    Private Sub RestoreSessionState()
        If Not _config.EnableSessionPersistence OrElse String.IsNullOrWhiteSpace(_sessionFile) Then Exit Sub
        Try
            Dim s As BomSessionState = BomSessionState.Load(_sessionFile)
            If Not String.IsNullOrWhiteSpace(s.AssemblyPath) AndAlso
               Not String.Equals(s.AssemblyPath, _assemblyPath, StringComparison.OrdinalIgnoreCase) Then Exit Sub

            _safeMode = s.SafeMode
            _ribbonCollapsed = s.RibbonCollapsed
            _detailPanelVisible = s.DetailPanelVisible
            _detailPanelWidth = Math.Max(260, s.DetailPanelWidth)
            _selectedColumnProfile = s.SelectedProfile
            If MainSplit IsNot Nothing Then
                MainSplit.Panel2Collapsed = Not _detailPanelVisible
                If _detailPanelVisible AndAlso MainSplit.ClientSize.Width > _detailPanelWidth Then SafeSetSplitterDistance(MainSplit, MainSplit.ClientSize.Width - _detailPanelWidth)
            End If
            ApplyRibbonCollapsedState()
            If SearchBox IsNot Nothing Then SearchBox.Text = s.SearchText
            If AssemblyFilterBox IsNot Nothing AndAlso Not String.IsNullOrWhiteSpace(s.AssemblyFilter) Then AssemblyFilterBox.Text = s.AssemblyFilter
            If Not String.IsNullOrWhiteSpace(s.QuickFilter) Then _quickFilterMode = s.QuickFilter
            If Not String.IsNullOrWhiteSpace(s.ActiveWorkspace) AndAlso _ribbonTabButtons.ContainsKey(s.ActiveWorkspace) Then
                _activeRibbonTab = s.ActiveWorkspace
                BuildToolBar()
                UpdateRibbonTabVisuals()
            End If
            If s.WindowWidth >= Me.MinimumSize.Width AndAlso s.WindowHeight >= Me.MinimumSize.Height Then
                Me.Size = New Size(s.WindowWidth, s.WindowHeight)
            End If
        Catch ex As Exception
            BomLogger.Warn("SESSION", "Restore session failed: " & ex.Message)
        End Try
    End Sub

    Private Sub BomViewerFormClosed(ByVal sender As Object, ByVal e As FormClosedEventArgs)
        BomViewerRegistry.Unregister(Me)
        PersistPendingTransaction()
        SaveSessionState()
        Try
            If _inventorSyncTimer IsNot Nothing Then _inventorSyncTimer.Stop()
        Catch
        End Try
        Try
            If _bomHighlightSet IsNot Nothing Then _bomHighlightSet.Clear()
        Catch ex As Exception
            BomLogger.Add(BomLogLevel.Warning, "VIEWER_CLOSE", ex.Message)
        End Try
        _bomHighlightSet = Nothing
        BomLogger.Info("VIEWER", "Viewer closed")
    End Sub

    Private Sub SelectMatchingAssemblyOccurrences(ByVal occurrences As ComponentOccurrences, ByVal targetAssemblyName As String, ByVal selectSet As SelectSet)
        For Each occ As ComponentOccurrence In occurrences
            Try
                If occ.Suppressed Then Continue For
                Dim doc As Inventor.Document = Nothing
                Try
                    doc = occ.ReferencedDocumentDescriptor.ReferencedDocument
                Catch
                    Try
                        doc = occ.Definition.Document
                    Catch
                    End Try
                End Try
                If doc Is Nothing Then Continue For
                If doc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    Dim docName As String = GetDocumentPartNumberOrFileName(doc)
                    Dim fileNameOnly As String = IOPath.GetFileNameWithoutExtension(doc.FullFileName)
                    If String.Equals(docName, targetAssemblyName, StringComparison.OrdinalIgnoreCase) OrElse String.Equals(fileNameOnly, targetAssemblyName, StringComparison.OrdinalIgnoreCase) Then
                        selectSet.Select(occ)
                    Else
                        SelectMatchingAssemblyOccurrences(occ.SubOccurrences, targetAssemblyName, selectSet)
                    End If
                End If
            Catch
            End Try
        Next
    End Sub

    Private Sub SelectMatchingOccurrences(ByVal occurrences As ComponentOccurrences, ByVal targetPath As String, ByVal selectSet As SelectSet)
        For Each occ As ComponentOccurrence In occurrences
            Try
                If occ.Suppressed Then Continue For
                Dim doc As Inventor.Document = Nothing
                Try
                    doc = occ.ReferencedDocumentDescriptor.ReferencedDocument
                Catch
                    Try
                        doc = occ.Definition.Document
                    Catch
                    End Try
                End Try
                If doc IsNot Nothing Then
                    If doc.DocumentType = DocumentTypeEnum.kPartDocumentObject Then
                        If String.Equals(doc.FullFileName, targetPath, StringComparison.OrdinalIgnoreCase) Then selectSet.Select(occ)
                    ElseIf doc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                        SelectMatchingOccurrences(occ.SubOccurrences, targetPath, selectSet)
                    End If
                End If
            Catch
            End Try
        Next
    End Sub


    Private Function BeginBusy(ByVal operationName As String) As Boolean
        If _isBusy Then
            StatusSelection.Text = "Đang xử lý: " & _busyOperation
            Return False
        End If
        _isBusy = True
        _busyOperation = operationName
        Me.UseWaitCursor = True
        If ToolBar IsNot Nothing Then ToolBar.Enabled = False
        If RibbonHost IsNot Nothing Then RibbonHost.Enabled = False
        StatusSelection.Text = "Đang xử lý: " & operationName
        Return True
    End Function

    Private Sub EndBusy(Optional ByVal statusText As String = "Sẵn sàng")
        _isBusy = False
        _busyOperation = ""
        Me.UseWaitCursor = False
        If ToolBar IsNot Nothing Then ToolBar.Enabled = True
        If RibbonHost IsNot Nothing Then RibbonHost.Enabled = True
        StatusSelection.Text = statusText
    End Sub

    Private Sub RefreshViewFromCache()
        Dim sw As Stopwatch = Stopwatch.StartNew()
        _runtimeIndex.Build(_assemblyName, _allItems)
        BuildAssemblyFilterItems()
        LoadRows()
        _lastRefreshDurationMs = sw.ElapsedMilliseconds
        BomLogger.Info("REFRESH_VIEW", "Cache refresh in " & _lastRefreshDurationMs.ToString() & " ms")
    End Sub

'####################################################################
' SUBSECTION 15.23 - LOAD BOM / CACHE INFO / REFRESH
'####################################################################

    Private Sub LoadBomClicked(ByVal sender As Object, ByVal e As EventArgs)
        'The Viewer must never call the External Rule again.
        'Assembly switching is initiated by the user activating the target
        'Assembly in Inventor and running the BOM command/rule once.
        Try
            Dim activeDoc As Inventor.Document = _inventor.ActiveDocument
            If activeDoc Is Nothing OrElse activeDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then
                MessageBox.Show("Hãy Active một Assembly (.iam) cần nạp.", "LOAD BOM", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If

            Dim activeAsm As AssemblyDocument = CType(activeDoc, AssemblyDocument)
            Dim activePath As String = activeAsm.FullFileName

            If String.Equals(BomViewerRegistry.NormalizePath(activePath),
                             BomViewerRegistry.NormalizePath(_assemblyPath),
                             StringComparison.OrdinalIgnoreCase) Then
                StatusSelection.Text = "Assembly này đang được BOM Tool quản lý. Không reload."
                Me.BringToFront()
                Me.Activate()
                Exit Sub
            End If

            MessageBox.Show( _
                "Assembly đang Active khác BOM hiện tại." & vbCrLf & vbCrLf & _
                "Current BOM:" & vbCrLf & _assemblyPath & vbCrLf & vbCrLf & _
                "Active Assembly:" & vbCrLf & activePath & vbCrLf & vbCrLf & _
                "Chạy lại lệnh BOM Tool một lần để mở workflow chuyển Assembly an toàn.", _
                "ASSEMBLY SWITCH", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Information)
        Catch ex As Exception
            BomLogger.Error("ASSEMBLY_SWITCH", "Load BOM command failed: " & ex.Message)
        End Try
    End Sub

    Private Sub ScanModeClicked(ByVal sender As Object, ByVal e As EventArgs)
        Using f As New BomScanModeForm(_scanMode)
            If f.ShowDialog(Me) <> DialogResult.OK Then Exit Sub
            Dim newMode As BomScanMode = f.SelectedMode
            If newMode = _scanMode Then Exit Sub
            _scanMode = newMode
        End Using

        _performance.LastMode = _scanMode.ToString().ToUpperInvariant()
        If _scanMode = BomScanMode.Fast Then
            _drawingIndex.Clear()
        Else
            BuildDrawingIndex()
        End If

        If _scanMode = BomScanMode.Deep Then
            Dim ctx As New BomOperationContext()
            ctx.OperationName = "DEEP SCAN"
            ctx.Total = _allItems.Count
            BeginBusy("DEEP SCAN")
            Try
                Dim i As Integer = 0
                For Each item As PartBomItem In _allItems
                    If ctx.CancelRequested Then Exit For
                    BomGeometryEngine.EnsureLoaded(item)
                    i += 1
                    ctx.Current = i
                    If i Mod 25 = 0 Then
                        StatusSelection.Text = "DEEP SCAN " & i.ToString() & " / " & ctx.Total.ToString()
                        WinFormsApplication.DoEvents()
                    End If
                Next
            Finally
                EndBusy()
            End Try
        End If

        SourceLabel.Text = "Nguồn: " & _assemblyPath & "  |  MODE: " & _scanMode.ToString().ToUpperInvariant()
        LoadRows()
        StatusSelection.Text = "Scan Mode: " & _scanMode.ToString().ToUpperInvariant()
    End Sub

    Private Sub ClearGeometryCacheClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim cleared As Integer = 0
        For Each item As PartBomItem In _allItems
            If item Is Nothing Then Continue For
            If String.Equals(item.GeometryLoadState, "LOADED", StringComparison.OrdinalIgnoreCase) OrElse _
               String.Equals(item.GeometryLoadState, "FAILED", StringComparison.OrdinalIgnoreCase) Then
                BomGeometryEngine.Invalidate(item)
                cleared += 1
            End If
            Dim geoKeys() As String = {"GEOMETRY_TYPE", "THICKNESS", "THICK_SOURCE", "BOUNDING_BOX", "MASS", "VOLUME", "SURFACE_AREA", "DENSITY"}
            For Each k As String In geoKeys
                item.LoadedFeatures.Remove(k)
                If item.FeatureValues.ContainsKey(k) Then item.FeatureValues.Remove(k)
            Next
        Next
        GC.Collect()
        StatusSelection.Text = "Đã xóa Geometry Cache: " & cleared.ToString() & " Part"
        LoadRows()
    End Sub

    Private Sub ClearThumbnailCacheClicked(ByVal sender As Object, ByVal e As EventArgs)
        For Each pair As KeyValuePair(Of String, System.Drawing.Image) In _thumbnailCache
            Try
                If pair.Value IsNot Nothing Then pair.Value.Dispose()
            Catch
            End Try
        Next
        Dim count As Integer = _thumbnailCache.Count
        _thumbnailCache.Clear()
        For Each item As PartBomItem In _allItems
            If item Is Nothing Then Continue For
            item.LoadedFeatures.Remove("THUMBNAIL")
            If item.FeatureValues.ContainsKey("THUMBNAIL") Then item.FeatureValues.Remove("THUMBNAIL")
        Next
        If PreviewImage IsNot Nothing Then PreviewImage.Image = Nothing
        GC.Collect()
        StatusSelection.Text = "Đã xóa Thumbnail Cache: " & count.ToString() & " ảnh"
    End Sub

    Private Sub ResetPerformanceCountersClicked(ByVal sender As Object, ByVal e As EventArgs)
        BomPerformanceCounters.Reset()
        _performance = New BomPerformanceSnapshot()
        _performance.LastMode = _scanMode.ToString().ToUpperInvariant()
        StatusSelection.Text = "Đã reset Performance Counter"
    End Sub

    Private Sub CacheInfoClicked(ByVal sender As Object, ByVal e As EventArgs)
        Try
            Dim assemblyCount As Integer = _runtimeIndex.ItemsByAssembly.Count
            Dim propertyCount As Integer = If(_selectedProperties Is Nothing, 0, _selectedProperties.Count)
            Dim occurrenceCount As Integer = _runtimeIndex.TotalOccurrences
            Dim message As New StringBuilder()
            message.AppendLine("BOM TOOL PRO - CACHE STATUS")
            message.AppendLine()
            message.AppendLine("Assembly index: " & assemblyCount.ToString())
            message.AppendLine("Unique Part: " & _runtimeIndex.ItemByKey.Count.ToString())
            message.AppendLine("Total QTY: " & _runtimeIndex.TotalQuantity.ToString())
            message.AppendLine("Cached Occurrence: " & occurrenceCount.ToString())
            message.AppendLine("Cached iProperty columns: " & propertyCount.ToString())
            message.AppendLine("Loaded at: " & _loadedAt.ToString("dd/MM/yyyy HH:mm:ss"))
            message.AppendLine("Last Refresh: " & _lastRefreshDurationMs.ToString() & " ms")
            message.AppendLine("Scan Mode: " & _scanMode.ToString().ToUpperInvariant())
            message.AppendLine("Signature checks: " & _performance.SignatureChecks.ToString())
            message.AppendLine("Cache hit: " & _performance.CacheHits.ToString() & " | miss: " & _performance.CacheMisses.ToString())
            message.AppendLine("Cache hit rate: " & _performance.HitRate().ToString("0.0") & " %")
            message.AppendLine("Changed documents (last smart refresh): " & _performance.ChangedDocuments.ToString())
            message.AppendLine()
            message.AppendLine("PERFORMANCE PROFILER")
            message.AppendLine("Initial BOM load: " & BomPerformanceCounters.InitialLoadMs.ToString() & " ms")
            message.AppendLine("Occurrence traversal: " & BomPerformanceCounters.OccurrenceTraversal.ToString())
            message.AppendLine("Document access: " & BomPerformanceCounters.DocumentAccess.ToString())
            message.AppendLine("Property read: " & BomPerformanceCounters.PropertyRead.ToString() & " | " & BomPerformanceCounters.PropertyReadMs.ToString() & " ms")
            message.AppendLine("Signature checks: " & BomPerformanceCounters.SignatureChecks.ToString())
            message.AppendLine("Geometry loads: " & BomPerformanceCounters.GeometryLoads.ToString() & " | " & BomPerformanceCounters.GeometryMs.ToString() & " ms")
            message.AppendLine("Drawing searches: " & BomPerformanceCounters.DrawingSearch.ToString() & " | index " & BomPerformanceCounters.DrawingIndexMs.ToString() & " ms")
            message.AppendLine("Grid refresh: " & BomPerformanceCounters.GridRefresh.ToString() & " | " & BomPerformanceCounters.GridBuildMs.ToString() & " ms")
            Dim memory As BomMemorySnapshot = BomMemorySnapshot.Capture(_allItems, occurrenceCount, _thumbnailCache.Count)
            message.AppendLine()
            message.AppendLine("MEMORY MONITOR")
            message.AppendLine("Managed: " & BomMemorySnapshot.FormatMB(memory.ManagedBytes))
            message.AppendLine("Inventor process working set: " & BomMemorySnapshot.FormatMB(memory.WorkingSetBytes))
            message.AppendLine("Cached Items: " & memory.CachedItems.ToString())
            message.AppendLine("Cached Occurrences: " & memory.CachedOccurrences.ToString())
            message.AppendLine("Cached Geometry: " & memory.CachedGeometry.ToString())
            message.AppendLine("Cached Thumbnails: " & memory.CachedThumbnails.ToString())
            Dim dirtyCount As Integer = 0
            For Each cacheItem As PartBomItem In _allItems
                If cacheItem IsNot Nothing AndAlso cacheItem.IsBomDirty Then dirtyCount += 1
            Next
            message.AppendLine("Dirty Part: " & dirtyCount.ToString())
            message.AppendLine(BomLogger.Summary())
            message.AppendLine()
            message.Append("Search, Filter, Dashboard, Project Check và Export đang dùng dữ liệu RAM đã Cache." & vbCrLf & vbCrLf & "Refresh thường = SMART INCREMENTAL | Ctrl+Refresh = đọc lại toàn bộ iProperty | Shift+Refresh = FULL RELOAD")
            MessageBox.Show(message.ToString(), "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
        Catch ex As Exception
            MessageBox.Show("Không thể đọc thông tin Cache." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End Try
    End Sub

    Private Function SmartIncrementalRefresh() As Boolean
        Dim sw As Stopwatch = Stopwatch.StartNew()
        Dim changed As New List(Of PartBomItem)()
        _performance.SignatureChecks = 0
        _performance.CacheHits = 0
        _performance.CacheMisses = 0
        _performance.ChangedDocuments = 0
        _performance.LastMode = _scanMode.ToString().ToUpperInvariant()

        'Nếu Assembly gốc đã thay đổi/Dirty, cấu trúc NEW/REMOVED/QTY có thể đã đổi.
        'Khi đó không đoán: chuyển sang Full Reload để bảo toàn tính đúng của BOM.
        Dim rootChanged As Boolean = False
        Try
            Dim activeAsm As AssemblyDocument = TryCast(_inventor.ActiveDocument, AssemblyDocument)
            If activeAsm IsNot Nothing AndAlso String.Equals(activeAsm.FullFileName, _assemblyPath, StringComparison.OrdinalIgnoreCase) Then
                If activeAsm.Dirty Then rootChanged = True
            End If
        Catch
        End Try
        If Not String.Equals(_rootAssemblySignature, BomSignatureEngine.FileSignature(_assemblyPath), StringComparison.Ordinal) Then rootChanged = True

        If rootChanged Then
            BomLogger.Info("SMART_REFRESH", "Root assembly changed -> FULL RELOAD")
            Return False
        End If

        For Each item As PartBomItem In _allItems
            If item Is Nothing Then Continue For
            _performance.SignatureChecks += 1
            BomPerformanceCounters.SignatureChecks += 1
            If BomSignatureEngine.HasChanged(item) Then
                item.LastCacheState = "CHANGED"
                changed.Add(item)
                _performance.CacheMisses += 1
            Else
                item.LastCacheState = "UNCHANGED"
                _performance.CacheHits += 1
            End If
        Next

        _performance.ChangedDocuments = changed.Count
        If changed.Count > 0 AndAlso _refreshCallback IsNot Nothing Then
            _refreshCallback.Invoke(changed)
            If _scanMode = BomScanMode.Deep Then
                For Each changedItem As PartBomItem In changed
                    BomGeometryEngine.EnsureLoaded(changedItem)
                Next
            End If
        End If
        _loadedAt = DateTime.Now
        RefreshViewFromCache()
        sw.Stop()
        _performance.SmartRefreshMs = sw.ElapsedMilliseconds
        _lastRefreshDurationMs = sw.ElapsedMilliseconds
        BomLogger.Info("SMART_REFRESH", "Checked=" & _performance.SignatureChecks.ToString() & ", changed=" & changed.Count.ToString() & ", hit=" & _performance.HitRate().ToString("0.0") & "%, time=" & sw.ElapsedMilliseconds.ToString() & " ms")
        Return True
    End Function

    Private Sub RefreshClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not BeginBusy("Refresh") Then Exit Sub
        Try
            Dim modifier As Keys = System.Windows.Forms.Control.ModifierKeys
            Dim sw As Stopwatch = Stopwatch.StartNew()

            If (modifier And Keys.Shift) = Keys.Shift Then
                'SHIFT + Refresh = quét lại toàn bộ Assembly bằng luồng LOAD BOM hiện có.
                EndBusy("Đang chuyển sang Full Reload...")
                If _loadBomCallback IsNot Nothing Then _loadBomCallback.Invoke()
                Exit Sub
            ElseIf (modifier And Keys.Control) = Keys.Control Then
                'CTRL + Refresh = đọc lại toàn bộ iProperty đã chọn.
                If _refreshCallback IsNot Nothing Then _refreshCallback.Invoke(_allItems)
                If _scanMode = BomScanMode.Deep Then
                    For Each deepRefreshItem As PartBomItem In _allItems
                        BomGeometryEngine.EnsureLoaded(deepRefreshItem)
                    Next
                End If
                _loadedAt = DateTime.Now
                RefreshViewFromCache()
                _lastRefreshDurationMs = sw.ElapsedMilliseconds
                EndBusy("Đã Refresh iProperty: " & _lastRefreshDurationMs.ToString() & " ms")
            Else
                'V20: SMART REFRESH = signature check; chỉ đọc lại Part thực sự thay đổi.
                Dim smartOk As Boolean = SmartIncrementalRefresh()
                If Not smartOk Then
                    EndBusy("Assembly đã thay đổi - đang Full Reload...")
                    If _loadBomCallback IsNot Nothing Then _loadBomCallback.Invoke()
                    Exit Sub
                End If
                EndBusy("Smart Refresh: " & _performance.ChangedDocuments.ToString() & " changed / " & _performance.SignatureChecks.ToString() & " checked | " & _lastRefreshDurationMs.ToString() & " ms")
            End If
        Catch ex As Exception
            BomLogger.Add(BomLogLevel.[Error], "REFRESH", ex.Message)
            EndBusy("Refresh lỗi")
            MessageBox.Show("Không thể Refresh." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub RefreshSelectedClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _refreshCallback Is Nothing Then Exit Sub
        Dim rows As List(Of PartBomItem) = GetSelectedItems()
        If rows.Count = 0 Then Exit Sub
        If Not BeginBusy("Refresh dòng đã chọn") Then Exit Sub
        Try
            Dim sw As Stopwatch = Stopwatch.StartNew()
            _refreshCallback.Invoke(rows)
            _loadedAt = DateTime.Now
            LoadRows()
            _lastRefreshDurationMs = sw.ElapsedMilliseconds
            EndBusy("Đã Refresh " & rows.Count.ToString() & " dòng: " & _lastRefreshDurationMs.ToString() & " ms")
        Catch ex As Exception
            BomLogger.Add(BomLogLevel.[Error], "REFRESH_SELECTED", ex.Message)
            EndBusy("Refresh lỗi")
            MessageBox.Show("Không thể Refresh dòng đã chọn." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    '================================================================
    ' MÁY TÍNH / THỐNG KÊ
    '================================================================

'####################################################################
' SUBSECTION 15.24 - CALCULATOR / ASSEMBLY OPEN / EXPORT COMMANDS
'####################################################################

    Private Sub CalculatorClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim assemblyRows As New List(Of PartBomItem)()
        If Grid.CurrentRow IsNot Nothing Then
            Dim groupName As String = GetRowGroupName(Grid.CurrentRow)
            If groupName.Length > 0 Then
                Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
                For Each row As DataGridViewRow In Grid.Rows
                    Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                    If item IsNot Nothing AndAlso String.Equals(GetRowGroupName(row), groupName, StringComparison.OrdinalIgnoreCase) AndAlso Not seen.Contains(item.DocumentKey) Then
                        seen.Add(item.DocumentKey)
                        assemblyRows.Add(item)
                    End If
                Next
            End If
        End If
        Dim form As New BomCalculatorForm(New List(Of PartBomItem)(_allItems), GetFilteredItems(), GetSelectedItems(), assemblyRows, _selectedProperties)
        form.ShowDialog(Me)
        form.Dispose()
    End Sub

    Private Function GetCurrentAssemblyPath() As String
        If Grid.CurrentRow Is Nothing OrElse Not IsAssemblyHeaderRow(Grid.CurrentRow) Then Return ""
        Dim groupName As String = GetRowGroupName(Grid.CurrentRow)
        If String.Equals(groupName, _assemblyName, StringComparison.OrdinalIgnoreCase) Then Return _assemblyPath
        Dim sourceAsm As AssemblyDocument = Nothing
        Try
            sourceAsm = CType(_inventor.Documents.ItemByName(_assemblyPath), AssemblyDocument)
        Catch
        End Try
        If sourceAsm Is Nothing Then Return ""
        Return FindAssemblyPath(sourceAsm.ComponentDefinition.Occurrences, groupName)
    End Function

    Private Function FindAssemblyPath(ByVal occurrences As ComponentOccurrences, ByVal targetName As String) As String
        For Each occ As ComponentOccurrence In occurrences
            Try
                If occ.Suppressed Then Continue For
                Dim doc As Inventor.Document = Nothing
                Try : doc = occ.ReferencedDocumentDescriptor.ReferencedDocument : Catch : Try : doc = occ.Definition.Document : Catch : End Try : End Try
                If doc Is Nothing OrElse doc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then Continue For
                Dim pn As String = GetDocumentPartNumberOrFileName(doc)
                Dim fn As String = IOPath.GetFileNameWithoutExtension(doc.FullFileName)
                If String.Equals(pn, targetName, StringComparison.OrdinalIgnoreCase) OrElse String.Equals(fn, targetName, StringComparison.OrdinalIgnoreCase) Then Return doc.FullFileName
                Dim nested As String = FindAssemblyPath(occ.SubOccurrences, targetName)
                If nested.Length > 0 Then Return nested
            Catch
            End Try
        Next
        Return ""
    End Function

    Private Sub OpenAssemblySelected()
        Dim path As String = GetCurrentAssemblyPath()
        If path.Length = 0 Then
            MessageBox.Show("Không tìm thấy file Assembly tương ứng.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Try
            _inventor.Documents.Open(path, True)
        Catch ex As Exception
            MessageBox.Show("Không mở được Assembly." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub ExportAllClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _exportCallback IsNot Nothing Then _exportCallback.Invoke(New List(Of PartBomItem)(_allItems))
    End Sub

    Private Sub ExportSelectedClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _exportCallback IsNot Nothing Then _exportCallback.Invoke(GetSelectedItems())
    End Sub

    Private Sub ExportFilteredClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _exportCallback IsNot Nothing Then _exportCallback.Invoke(GetFilteredItems())
    End Sub
'####################################################################
' SECTION 15A - ON-DEMAND FEATURE ENGINE / THUMBNAIL / PREVIEW
' Chỉ đọc dữ liệu khi người dùng bật Feature. Bỏ chọn chỉ ẩn cột, Cache vẫn giữ.
'####################################################################

    Private Sub RegisterBuiltInFeatures()
        _featureRegistry.Clear()
        RegisterFeature(New BomFeatureDefinition("THUMBNAIL", "PART_IMAGE", "ẢNH PART", "PREVIEW", 92, True, True))
        RegisterFeature(New BomFeatureDefinition("GEOMETRY_TYPE", "GEOMETRY_TYPE", "DẠNG CHI TIẾT", "GEOMETRY", 125, False, False))
        RegisterFeature(New BomFeatureDefinition("THICKNESS", "THICKNESS", "THICK (" & BomUnitManager.LengthUnit & ")", "SHEET METAL", 92, True, False))
        RegisterFeature(New BomFeatureDefinition("THICK_SOURCE", "THICK_SOURCE", "NGUỒN THICK", "SHEET METAL", 110, True, False))
        RegisterFeature(New BomFeatureDefinition("BOUNDING_BOX", "BOUNDING_BOX", "BOUNDING BOX L x W x H (" & BomUnitManager.LengthUnit & ")", "PHYSICAL", 205, False, False))
        RegisterFeature(New BomFeatureDefinition("MASS", "FEATURE_MASS", "MASS (" & BomUnitManager.MassUnit & ")", "PHYSICAL", 100, True, False))
        RegisterFeature(New BomFeatureDefinition("VOLUME", "FEATURE_VOLUME", "VOLUME (" & BomUnitManager.VolumeUnit & ")", "PHYSICAL", 110, True, False))
        RegisterFeature(New BomFeatureDefinition("SURFACE_AREA", "FEATURE_AREA", "SURFACE AREA (" & BomUnitManager.AreaUnit & ")", "PHYSICAL", 125, True, False))
        RegisterFeature(New BomFeatureDefinition("DENSITY", "FEATURE_DENSITY", "DENSITY", "PHYSICAL", 100, True, False))
        RegisterFeature(New BomFeatureDefinition("FILE_SIZE", "FEATURE_FILE_SIZE", "FILE SIZE", "FILE", 100, True, False))
        RegisterFeature(New BomFeatureDefinition("LAST_MODIFIED", "FEATURE_LAST_MODIFIED", "LAST MODIFIED", "FILE", 145, True, False))
        RegisterFeature(New BomFeatureDefinition("READ_ONLY", "FEATURE_READONLY", "READ ONLY", "FILE", 82, True, False))
    End Sub

    Private Sub RegisterFeature(ByVal feature As BomFeatureDefinition)
        If feature Is Nothing OrElse String.IsNullOrWhiteSpace(feature.Key) Then Exit Sub
        _featureRegistry(feature.Key) = feature
    End Sub

    Private Sub FeatureManagerClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim form As New BomFeatureManagerForm(_featureRegistry, _enabledFeatures)
        If form.ShowDialog(Me) <> DialogResult.OK Then
            form.Dispose()
            Exit Sub
        End If
        ApplyFeatureSelection(form.SelectedFeatureKeys)
        form.Dispose()
    End Sub

    Private Sub ToggleThumbnailFeatureClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim nextKeys As New HashSet(Of String)(_enabledFeatures, StringComparer.OrdinalIgnoreCase)
        If nextKeys.Contains("THUMBNAIL") Then
            nextKeys.Remove("THUMBNAIL")
        Else
            nextKeys.Add("THUMBNAIL")
        End If
        ApplyFeatureSelection(nextKeys)
    End Sub

    Private Sub ApplyFeatureSelection(ByVal selectedKeys As IEnumerable(Of String))
        Dim requested As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        If selectedKeys IsNot Nothing Then
            For Each key As String In selectedKeys
                If _featureRegistry.ContainsKey(key) Then requested.Add(key)
            Next
        End If

        Me.Cursor = System.Windows.Forms.Cursors.WaitCursor
        Grid.SuspendLayout()
        Try
            'Chỉ Load những Feature mới được bật.
            For Each key As String In requested
                If Not _enabledFeatures.Contains(key) Then LoadFeatureForAllItems(key)
            Next
            _enabledFeatures = requested
            BuildColumns()
            LoadRows()
            If MainSplit IsNot Nothing Then
                MainSplit.Panel2Collapsed = Not _enabledFeatures.Contains("THUMBNAIL")
                If Not MainSplit.Panel2Collapsed Then
                    'Chờ WinForms bố trí lại Panel2 rồi mới đặt SplitterDistance.
                    Try
                        Me.BeginInvoke(New System.Windows.Forms.MethodInvoker(AddressOf ApplyDefaultSplitterDistance))
                    Catch
                        ApplyDefaultSplitterDistance()
                    End Try
                End If
            End If
            UpdatePreviewFromCurrentRow()
            BeginLoadVisibleThumbnails()
        Finally
            Grid.ResumeLayout()
            Me.Cursor = System.Windows.Forms.Cursors.Default
        End Try
    End Sub

    Private Sub LoadFeatureForAllItems(ByVal featureKey As String)
        If String.Equals(featureKey, "THUMBNAIL", StringComparison.OrdinalIgnoreCase) Then Exit Sub 'Lazy loading
        For Each item As PartBomItem In _allItems
            EnsureFeatureLoaded(item, featureKey)
        Next
    End Sub

    Private Sub EnsureFeatureLoaded(ByVal item As PartBomItem, ByVal featureKey As String)
        If item Is Nothing OrElse item.LoadedFeatures.Contains(featureKey) Then Exit Sub
        Try
            Select Case featureKey.ToUpperInvariant()
                Case "GEOMETRY_TYPE", "THICKNESS", "THICK_SOURCE", "BOUNDING_BOX", "MASS", "VOLUME", "SURFACE_AREA", "DENSITY"
                    BomGeometryEngine.EnsureLoaded(item)
            End Select
            Select Case featureKey.ToUpperInvariant()
                Case "GEOMETRY_TYPE"
                    item.FeatureValues(featureKey) = item.GeometryType
                Case "THICKNESS"
                    item.FeatureValues(featureKey) = item.Thickness
                Case "THICK_SOURCE"
                    item.FeatureValues(featureKey) = item.ThicknessSource
                Case "BOUNDING_BOX"
                    item.FeatureValues(featureKey) = item.BoundingBoxText
                Case "MASS"
                    item.FeatureValues(featureKey) = item.Mass
                Case "VOLUME"
                    item.FeatureValues(featureKey) = item.Volume
                Case "SURFACE_AREA"
                    item.FeatureValues(featureKey) = item.SurfaceArea
                Case "DENSITY"
                    Dim density As Double = 0
                    If item.Volume > 0 Then density = item.Mass / item.Volume
                    item.FeatureValues(featureKey) = density
                Case "FILE_SIZE"
                    If Not String.IsNullOrWhiteSpace(item.FilePath) AndAlso System.IO.File.Exists(item.FilePath) Then
                        item.FeatureValues(featureKey) = New System.IO.FileInfo(item.FilePath).Length
                    Else
                        item.FeatureValues(featureKey) = 0L
                    End If
                Case "LAST_MODIFIED"
                    If Not String.IsNullOrWhiteSpace(item.FilePath) AndAlso System.IO.File.Exists(item.FilePath) Then
                        item.FeatureValues(featureKey) = System.IO.File.GetLastWriteTime(item.FilePath)
                    Else
                        item.FeatureValues(featureKey) = Nothing
                    End If
                Case "READ_ONLY"
                    item.FeatureValues(featureKey) = item.IsReadOnly
            End Select
        Catch ex As Exception
            item.FeatureValues(featureKey) = "ERROR"
        Finally
            item.LoadedFeatures.Add(featureKey)
        End Try
    End Sub

    Private Function GetFeatureDisplayValue(ByVal item As PartBomItem, ByVal featureKey As String) As Object
        If item Is Nothing Then Return ""
        If String.Equals(featureKey, "THUMBNAIL", StringComparison.OrdinalIgnoreCase) Then
            Return GetThumbnailFromCache(item)
        End If
        EnsureFeatureLoaded(item, featureKey)
        If Not item.FeatureValues.ContainsKey(featureKey) Then Return ""
        Dim value As Object = item.FeatureValues(featureKey)
        Select Case featureKey.ToUpperInvariant()
            Case "THICKNESS"
                Return BomUnitManager.FormatLength(item.Thickness)
            Case "BOUNDING_BOX"
                Return BomUnitManager.FormatBoundingBox(item)
            Case "MASS"
                Return BomUnitManager.FormatMass(item.Mass)
            Case "VOLUME"
                Return BomUnitManager.FormatValue(BomUnitManager.ConvertVolumeFromCm3(item.Volume))
            Case "SURFACE_AREA"
                Return BomUnitManager.FormatValue(BomUnitManager.ConvertAreaFromCm2(item.SurfaceArea))
            Case "DENSITY"
                Dim d As Double = 0
                Double.TryParse(Convert.ToString(value), d)
                Return If(d = 0, "", d.ToString("0.####"))
            Case "FILE_SIZE"
                Dim bytes As Long = 0
                Long.TryParse(Convert.ToString(value), bytes)
                If bytes <= 0 Then Return ""
                If bytes >= 1048576 Then Return (bytes / 1048576.0).ToString("0.##") & " MB"
                Return (bytes / 1024.0).ToString("0.##") & " KB"
            Case "LAST_MODIFIED"
                If TypeOf value Is DateTime Then Return CType(value, DateTime).ToString("dd/MM/yyyy HH:mm")
            Case "READ_ONLY"
                Return If(Convert.ToBoolean(value), "YES", "NO")
        End Select
        Return If(value Is Nothing, "", value)
    End Function

    Private Function GetThumbnailFromCache(ByVal item As PartBomItem) As System.Drawing.Image
        If item Is Nothing Then Return Nothing
        If _thumbnailCache.ContainsKey(item.DocumentKey) Then Return _thumbnailCache(item.DocumentKey)
        Return Nothing
    End Function

    Private Sub BeginLoadVisibleThumbnails()
        If Not _enabledFeatures.Contains("THUMBNAIL") OrElse Grid.Rows.Count = 0 Then Exit Sub
        Dim first As Integer = 0
        Try : first = Grid.FirstDisplayedScrollingRowIndex : Catch : first = 0 : End Try
        If first < 0 Then first = 0
        Dim visible As Integer = Math.Max(20, Grid.DisplayedRowCount(True) + 4)
        For i As Integer = first To Math.Min(Grid.Rows.Count - 1, first + visible)
            Dim row As DataGridViewRow = Grid.Rows(i)
            Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
            If item Is Nothing Then Continue For
            Dim image As System.Drawing.Image = LoadThumbnailForItem(item)
            If Grid.Columns.Contains("PART_IMAGE") Then row.Cells("PART_IMAGE").Value = image
        Next
    End Sub

    Private Sub GridScrolledForLazyFeatures(ByVal sender As Object, ByVal e As System.Windows.Forms.ScrollEventArgs)
        BeginLoadVisibleThumbnails()
    End Sub

    Private Function LoadThumbnailForItem(ByVal item As PartBomItem) As System.Drawing.Image
        If item Is Nothing Then Return Nothing
        If _thumbnailCache.ContainsKey(item.DocumentKey) Then Return _thumbnailCache(item.DocumentKey)
        Dim image As System.Drawing.Image = Nothing
        Try
            If item.Document IsNot Nothing Then
                Dim thumbObject As Object = Nothing
                Try
                    thumbObject = item.Document.PropertySets.Item("Inventor Summary Information").Item("Thumbnail").Value
                Catch
                    Try : thumbObject = item.Document.PropertySets.Item("Summary Information").Item("Thumbnail").Value : Catch : End Try
                End Try
                image = PictureDispConverter.ToImage(thumbObject)
            End If
        Catch
            image = Nothing
        End Try
        If image Is Nothing Then image = CreateThumbnailPlaceholder(item.PartNumber)
        _thumbnailCache(item.DocumentKey) = image
        item.ThumbnailImage = image
        item.LoadedFeatures.Add("THUMBNAIL")
        Return image
    End Function

    Private Function CreateThumbnailPlaceholder(ByVal caption As String) As System.Drawing.Image
        Dim bmp As New System.Drawing.Bitmap(160, 120)
        Using g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)
            g.Clear(Color.FromArgb(242, 246, 248))
            Using pen As New System.Drawing.Pen(Color.FromArgb(160, 178, 186))
                g.DrawRectangle(pen, 1, 1, 157, 117)
            End Using
            Using f As New Font("Segoe UI", 8.5F, FontStyle.Bold)
                Dim txt As String = If(String.IsNullOrWhiteSpace(caption), "NO IMAGE", caption)
                g.DrawString(txt, f, System.Drawing.Brushes.DimGray, 8.0F, 46.0F)
            End Using
        End Using
        Return bmp
    End Function

    Private Sub BuildPreviewPanel()
        PreviewPanel = New Panel()
        PreviewPanel.Dock = DockStyle.Fill
        PreviewPanel.BackColor = Color.FromArgb(247, 250, 252)
        PreviewPanel.Padding = New System.Windows.Forms.Padding(10)

        PreviewTitle = New Label()
        PreviewTitle.Dock = DockStyle.Top
        PreviewTitle.Height = 34
        PreviewTitle.Font = New Font("Segoe UI Semibold", 11.0F, FontStyle.Bold)
        PreviewTitle.ForeColor = Color.FromArgb(38, 78, 98)
        PreviewTitle.Text = "SMART DETAIL"
        PreviewPanel.Controls.Add(PreviewTitle)

        PreviewImage = New PictureBox()
        PreviewImage.Dock = DockStyle.Top
        PreviewImage.Height = 170
        PreviewImage.SizeMode = System.Windows.Forms.PictureBoxSizeMode.Zoom
        PreviewImage.BackColor = Color.White
        PreviewImage.BorderStyle = System.Windows.Forms.BorderStyle.FixedSingle
        AddHandler PreviewImage.DoubleClick, AddressOf PreviewImageDoubleClicked
        PreviewPanel.Controls.Add(PreviewImage)

        DetailActions = New FlowLayoutPanel()
        DetailActions.Dock = DockStyle.Top
        DetailActions.Height = 38
        DetailActions.WrapContents = False
        DetailActions.Padding = New Padding(0, 5, 0, 2)
        AddDetailAction("OPEN", AddressOf OpenPartClicked)
        AddDetailAction("DRAWING", AddressOf OpenDrawingClicked)
        AddDetailAction("HIGHLIGHT", AddressOf HighlightClicked)
        AddDetailAction("ZOOM", AddressOf ZoomClicked)
        AddDetailAction("WHERE USED", AddressOf WhereUsedClicked)
        AddDetailAction("IMPACT", AddressOf ImpactAnalysisClicked)
        PreviewPanel.Controls.Add(DetailActions)

        DetailTabs = New TabControl()
        DetailTabs.Dock = DockStyle.Fill
        DetailTabs.Font = New Font("Segoe UI", 8.5F)
        PreviewPanel.Controls.Add(DetailTabs)

        Dim infoPage As New TabPage("DETAIL")
        PreviewInfo = New Label()
        PreviewInfo.Dock = DockStyle.Fill
        PreviewInfo.Padding = New Padding(8)
        PreviewInfo.AutoEllipsis = True
        PreviewInfo.Font = New Font("Segoe UI", 9.0F)
        PreviewInfo.Text = "Select a Part or Assembly."
        infoPage.Controls.Add(PreviewInfo)
        DetailTabs.TabPages.Add(infoPage)

        Dim propertyPage As New TabPage("PROPERTIES")
        DetailPropertyText = New TextBox()
        DetailPropertyText.Dock = DockStyle.Fill
        DetailPropertyText.Multiline = True
        DetailPropertyText.ReadOnly = True
        DetailPropertyText.ScrollBars = ScrollBars.Vertical
        DetailPropertyText.BorderStyle = BorderStyle.None
        propertyPage.Controls.Add(DetailPropertyText)
        DetailTabs.TabPages.Add(propertyPage)

        Dim contextPage As New TabPage("CONTEXT")
        DetailContextText = New TextBox()
        DetailContextText.Dock = DockStyle.Fill
        DetailContextText.Multiline = True
        DetailContextText.ReadOnly = True
        DetailContextText.ScrollBars = ScrollBars.Vertical
        DetailContextText.BorderStyle = BorderStyle.None
        contextPage.Controls.Add(DetailContextText)
        DetailTabs.TabPages.Add(contextPage)

        PreviewImage.BringToFront()
        DetailActions.BringToFront()
        PreviewTitle.BringToFront()
    End Sub

    Private Sub AddDetailAction(ByVal caption As String, ByVal handler As EventHandler)
        Dim b As New Button()
        b.Text = caption
        b.AutoSize = True
        b.Height = 27
        b.FlatStyle = FlatStyle.Flat
        b.FlatAppearance.BorderColor = Color.FromArgb(200, 215, 222)
        b.Font = New Font("Segoe UI", 7.5F, FontStyle.Bold)
        AddHandler b.Click, handler
        DetailActions.Controls.Add(b)
    End Sub

    Private Sub UpdatePreviewFromCurrentRow()
        If PreviewImage Is Nothing OrElse MainSplit Is Nothing OrElse MainSplit.Panel2Collapsed Then Exit Sub
        If Grid.CurrentRow Is Nothing Then Exit Sub
        Dim item As PartBomItem = TryCast(Grid.CurrentRow.Tag, PartBomItem)
        If item Is Nothing Then Exit Sub

        Dim img As System.Drawing.Image = LoadThumbnailForItem(item)
        PreviewImage.Image = img
        PreviewTitle.Text = If(String.IsNullOrWhiteSpace(item.PartNumber), item.FileName, item.PartNumber)

        Dim drawingState As String = GetDrawingStatus(item.FilePath)
        Dim mfg As String = "UNKNOWN"
        If item.IsPurchased Then mfg = "PURCHASED"
        If item.IsSheetMetal Then mfg = "SHEET METAL"

        PreviewInfo.Text =
            "PART INFORMATION" & vbCrLf & vbCrLf &
            "Part Number: " & item.PartNumber & vbCrLf &
            "Description: " & item.Description & vbCrLf &
            "Material: " & item.Material & vbCrLf &
            "Revision: " & item.Revision & vbCrLf &
            "Qty: " & item.Quantity.ToString() & vbCrLf &
            "Drawing: " & drawingState & vbCrLf &
            "Manufacturing: " & mfg & vbCrLf &
            "File: " & item.FileName

        If DetailPropertyText IsNot Nothing Then
            Dim p As New System.Text.StringBuilder()
            For Each pi As PropertyColumnInfo In _selectedProperties
                Dim value As String = ""
                If item.SelectedPropertyValues IsNot Nothing AndAlso item.SelectedPropertyValues.ContainsKey(pi.Key) Then value = item.SelectedPropertyValues(pi.Key)
                p.AppendLine(pi.PropertyName & ": " & value)
            Next
            DetailPropertyText.Text = p.ToString()
        End If

        If DetailContextText IsNot Nothing Then
            Dim contextTitle As String = _activeRibbonTab.ToUpperInvariant()
            Dim body As String = ""
            Select Case contextTitle
                Case "STRUCTURE" : body = "Parent: " & item.GetParentAssemblyText() & vbCrLf & "Where Used / Impact are available from this workspace."
                Case "CHECK" : body = "Validation status: " & If(String.Equals(item.DataStatus, "ERROR", StringComparison.OrdinalIgnoreCase), "ERROR", If(String.Equals(item.DataStatus, "WARNING", StringComparison.OrdinalIgnoreCase), "WARNING", "READY")) & vbCrLf & "Use CHECK PROJECT for full quality control."
                Case "DRAWINGS" : body = "Drawing status: " & drawingState & vbCrLf & "Path: " & FindDrawingPath(item.FilePath)
                Case "CHANGES" : body = "Pending property changes: " & _pendingTransaction.Changes.Count.ToString()
                Case "MANUFACTURING" : body = "Type: " & mfg & vbCrLf & "Material: " & item.Material & vbCrLf & "Thickness: " & BomUnitManager.FormatLength(item.Thickness)
                Case Else : body = "Current workspace: " & contextTitle
            End Select
            DetailContextText.Text = body
        End If
    End Sub

    Private Sub PreviewImageDoubleClicked(ByVal sender As Object, ByVal e As EventArgs)
        OpenPartClicked(sender, e)
    End Sub


End Class

'====================================================================
' FORM CHỌN THÊM IPROPERTY NGAY TRONG BOM VIEWER
'====================================================================


Public Class BomFeatureDefinition
    Public Key As String
    Public ColumnName As String
    Public HeaderText As String
    Public GroupName As String
    Public Width As Integer
    Public Centered As Boolean
    Public IsImage As Boolean
    Public Sub New(ByVal keyValue As String, ByVal columnValue As String, ByVal headerValue As String, ByVal groupValue As String, ByVal widthValue As Integer, ByVal centeredValue As Boolean, ByVal imageValue As Boolean)
        Key = keyValue : ColumnName = columnValue : HeaderText = headerValue : GroupName = groupValue
        Width = widthValue : Centered = centeredValue : IsImage = imageValue
    End Sub
End Class

Public Class BomFeatureManagerForm
    Inherits Form
    Private FeatureList As CheckedListBox
    Private Registry As Dictionary(Of String, BomFeatureDefinition)
    Public SelectedFeatureKeys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)

    Public Sub New(ByVal registryValue As Dictionary(Of String, BomFeatureDefinition), ByVal enabledValue As HashSet(Of String))
        Registry = registryValue
        Me.Text = "FEATURE MANAGER - CHỈ LOAD KHI ĐƯỢC CHỌN"
        Me.StartPosition = FormStartPosition.CenterParent
        Me.Size = New Size(620, 650)
        Me.MinimumSize = New Size(520, 500)
        Me.Font = New Font("Segoe UI", 9.0F)

        Dim info As New Label()
        info.Dock = DockStyle.Top
        info.Height = 58
        info.Padding = New System.Windows.Forms.Padding(12, 10, 12, 4)
        info.Text = "Tick Feature cần dùng. Feature chưa chọn sẽ không hiện và không được đọc từ Inventor. Bỏ tick chỉ ẩn cột; Cache đã đọc vẫn được giữ."
        Me.Controls.Add(info)

        FeatureList = New CheckedListBox()
        FeatureList.Dock = DockStyle.Fill
        FeatureList.CheckOnClick = True
        FeatureList.HorizontalScrollbar = True
        Me.Controls.Add(FeatureList)
        FeatureList.BringToFront()

        Dim entries As New List(Of BomFeatureDefinition)(Registry.Values)
        entries.Sort(Function(a As BomFeatureDefinition, b As BomFeatureDefinition) As Integer
            Dim c As Integer = String.Compare(a.GroupName, b.GroupName, StringComparison.OrdinalIgnoreCase)
            If c <> 0 Then Return c
            Return String.Compare(a.HeaderText, b.HeaderText, StringComparison.OrdinalIgnoreCase)
        End Function)
        For Each f As BomFeatureDefinition In entries
            Dim display As String = "[" & f.GroupName & "]  " & f.HeaderText
            Dim index As Integer = FeatureList.Items.Add(New BomFeatureListItem(f.Key, display))
            If enabledValue IsNot Nothing AndAlso enabledValue.Contains(f.Key) Then FeatureList.SetItemChecked(index, True)
        Next

        Dim buttons As New Panel()
        buttons.Dock = DockStyle.Bottom
        buttons.Height = 52
        Me.Controls.Add(buttons)
        Dim okButton As New Button()
        okButton.Text = "ÁP DỤNG"
        okButton.Size = New Size(120, 32)
        okButton.Location = New Point(350, 10)
        okButton.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        AddHandler okButton.Click, AddressOf ApplyClicked
        buttons.Controls.Add(okButton)
        Dim cancelButton As New Button()
        cancelButton.Text = "HỦY"
        cancelButton.Size = New Size(100, 32)
        cancelButton.Location = New Point(480, 10)
        cancelButton.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        cancelButton.DialogResult = DialogResult.Cancel
        buttons.Controls.Add(cancelButton)
        Me.CancelButton = cancelButton
    End Sub

    Private Sub ApplyClicked(ByVal sender As Object, ByVal e As EventArgs)
        SelectedFeatureKeys.Clear()
        For Each obj As Object In FeatureList.CheckedItems
            Dim entry As BomFeatureListItem = TryCast(obj, BomFeatureListItem)
            If entry IsNot Nothing Then SelectedFeatureKeys.Add(entry.Key)
        Next
        Me.DialogResult = DialogResult.OK
        Me.Close()
    End Sub
End Class

Public Class BomFeatureListItem
    Public Key As String
    Public Text As String
    Public Sub New(ByVal keyValue As String, ByVal textValue As String)
        Key = keyValue : Text = textValue
    End Sub
    Public Overrides Function ToString() As String
        Return Text
    End Function
End Class

Public Class PictureDispConverter
    Inherits System.Windows.Forms.AxHost
    Private Sub New()
        MyBase.New("")
    End Sub
    Public Shared Function ToImage(ByVal pictureObject As Object) As System.Drawing.Image
        If pictureObject Is Nothing Then Return Nothing
        Try
            Dim image As System.Drawing.Image = CType(GetPictureFromIPicture(pictureObject), System.Drawing.Image)
            If image Is Nothing Then Return Nothing
            Return New System.Drawing.Bitmap(image)
        Catch
            Return Nothing
        End Try
    End Function
End Class




Public Enum BomAssemblySwitchDecision
    Cancel = 0
    KeepCurrent = 1
    LoadNew = 2
End Enum

Public Enum BomPendingSwitchDecision
    Cancel = 0
    Review = 1
    Commit = 2
    Discard = 3
End Enum

Public Class BomAssemblySwitchForm
    Inherits BomDialogBase
    Public Decision As BomAssemblySwitchDecision = BomAssemblySwitchDecision.Cancel

    Public Sub New(ByVal currentPath As String, ByVal newPath As String, ByVal pendingCount As Integer)
        Me.Text = "ASSEMBLY SWITCH"
        Me.Size = New Size(720, 390)
        SetHeader("BOM TOOL ĐANG QUẢN LÝ MỘT ASSEMBLY KHÁC",
                  "Tool sẽ không thay BOM hiện tại nếu bạn chưa xác nhận.")

        Dim content As New TableLayoutPanel()
        content.Dock = DockStyle.Fill
        content.ColumnCount = 2
        content.RowCount = 4
        content.ColumnStyles.Add(New ColumnStyle(SizeType.Absolute, 145))
        content.ColumnStyles.Add(New ColumnStyle(SizeType.Percent, 100))
        content.RowStyles.Add(New RowStyle(SizeType.Absolute, 72))
        content.RowStyles.Add(New RowStyle(SizeType.Absolute, 72))
        content.RowStyles.Add(New RowStyle(SizeType.Absolute, 48))
        content.RowStyles.Add(New RowStyle(SizeType.Percent, 100))

        content.Controls.Add(New Label() With {.Text = "CURRENT BOM", .Dock = DockStyle.Fill, .Padding = New Padding(8, 10, 8, 0), .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)}, 0, 0)
        content.Controls.Add(New Label() With {.Text = currentPath, .Dock = DockStyle.Fill, .Padding = New Padding(8, 10, 8, 0), .AutoEllipsis = True}, 1, 0)
        content.Controls.Add(New Label() With {.Text = "ACTIVE ASSEMBLY", .Dock = DockStyle.Fill, .Padding = New Padding(8, 10, 8, 0), .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)}, 0, 1)
        content.Controls.Add(New Label() With {.Text = newPath, .Dock = DockStyle.Fill, .Padding = New Padding(8, 10, 8, 0), .AutoEllipsis = True}, 1, 1)
        content.Controls.Add(New Label() With {.Text = "PENDING", .Dock = DockStyle.Fill, .Padding = New Padding(8, 10, 8, 0), .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)}, 0, 2)
        content.Controls.Add(New Label() With {.Text = pendingCount.ToString() & " changes", .Dock = DockStyle.Fill, .Padding = New Padding(8, 10, 8, 0), .ForeColor = If(pendingCount > 0, Color.DarkOrange, BomUiTheme.TextPrimary)}, 1, 2)

        ContentHost.Controls.Add(content)

        ActionBar.Controls.Add(BomUiFactory.ActionButton("CANCEL", Sub(sender, e) CloseWith(BomAssemblySwitchDecision.Cancel)))
        ActionBar.Controls.Add(BomUiFactory.ActionButton("KEEP CURRENT BOM", Sub(sender, e) CloseWith(BomAssemblySwitchDecision.KeepCurrent)))
        ActionBar.Controls.Add(BomUiFactory.ActionButton("LOAD NEW ASSEMBLY", Sub(sender, e) CloseWith(BomAssemblySwitchDecision.LoadNew), True))
    End Sub

    Private Sub CloseWith(ByVal value As BomAssemblySwitchDecision)
        Decision = value
        Me.DialogResult = DialogResult.OK
        Me.Close()
    End Sub
End Class

Public Class BomPendingSwitchForm
    Inherits BomDialogBase
