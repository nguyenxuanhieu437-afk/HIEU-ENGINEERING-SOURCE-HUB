Public Class BomProgressForm
    Inherits Form

    Private ProgressControl As ProgressBar
    Private StatusLabel As Label
    Private PercentLabel As Label
    Private CancelProcessButton As Button

    Public CancelRequested As Boolean = False

    Public Sub New()
        Me.Text = "BOM TOOL PRO - PROCESSING"
        Me.StartPosition = FormStartPosition.CenterScreen
        Me.Size = New Size(580, 235)
        Me.MinimumSize = New Size(580, 235)
        Me.MaximumSize = New Size(580, 235)
        Me.MaximizeBox = False
        Me.MinimizeBox = False
        Me.ControlBox = False
        Me.TopMost = False
        Me.ShowInTaskbar = False
        Me.Font = New Font("Segoe UI", 9.0F)
        Me.BackColor = Color.FromArgb(245, 247, 250)

        Dim titleLabel As New Label()
        titleLabel.Text = "ĐANG XỬ LÝ BOM"
        titleLabel.Font = New Font("Segoe UI", 13.0F, FontStyle.Bold)
        titleLabel.ForeColor = Color.FromArgb(31, 78, 121)
        titleLabel.AutoSize = True
        titleLabel.Location = New Point(20, 17)
        Me.Controls.Add(titleLabel)

        StatusLabel = New Label()
        StatusLabel.Text = "Đang chuẩn bị..."
        StatusLabel.Location = New Point(22, 52)
        StatusLabel.Size = New Size(530, 63)
        StatusLabel.AutoEllipsis = True
        Me.Controls.Add(StatusLabel)

        ProgressControl = New ProgressBar()
        ProgressControl.Location = New Point(22, 124)
        ProgressControl.Size = New Size(455, 25)
        ProgressControl.Minimum = 0
        ProgressControl.Maximum = 100
        ProgressControl.Value = 0
        ProgressControl.Style = ProgressBarStyle.Continuous
        Me.Controls.Add(ProgressControl)

        PercentLabel = New Label()
        PercentLabel.Text = "0%"
        PercentLabel.Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)
        PercentLabel.TextAlign = ContentAlignment.MiddleCenter
        PercentLabel.Location = New Point(482, 124)
        PercentLabel.Size = New Size(50, 25)
        Me.Controls.Add(PercentLabel)

        CancelProcessButton = New Button()
        CancelProcessButton.Text = "HỦY"
        CancelProcessButton.Location = New Point(457, 163)
        CancelProcessButton.Size = New Size(75, 30)
        AddHandler CancelProcessButton.Click, AddressOf CancelProcessButtonClick
        Me.Controls.Add(CancelProcessButton)
    End Sub

    Public Sub SetProgress( _
        ByVal percent As Integer, _
        ByVal statusText As String)

        If percent < 0 Then percent = 0
        If percent > 100 Then percent = 100

        Try
            ProgressControl.Value = percent
        Catch
            ProgressControl.Value = 0
        End Try

        PercentLabel.Text = percent.ToString() & "%"
        StatusLabel.Text = statusText
        Me.Refresh()
        WinFormsApplication.DoEvents()
    End Sub

    Public Sub SetStatus(ByVal statusText As String)
        StatusLabel.Text = statusText
        Me.Refresh()
        WinFormsApplication.DoEvents()
    End Sub

    Private Sub CancelProcessButtonClick( _
        ByVal sender As Object, _
        ByVal e As EventArgs)

        CancelRequested = True
        CancelProcessButton.Enabled = False
        StatusLabel.Text = "Đang dừng an toàn..."
        Me.Refresh()
        WinFormsApplication.DoEvents()
    End Sub
End Class



'====================================================================
' UNIT ENGINE - GIỮ GIÁ TRỊ GỐC TRONG CACHE, CHỈ QUY ĐỔI KHI HIỂN THỊ
'====================================================================

'####################################################################
' SECTION 13 - UNIT ENGINE
' Quản lý đơn vị hiển thị và chuyển đổi dữ liệu.
'####################################################################

Public Class BomUnitManager
    Public Shared MassUnit As String = "kg"
    Public Shared LengthUnit As String = "mm"
    Public Shared AreaUnit As String = "cm²"
    Public Shared VolumeUnit As String = "cm³"

    Public Shared Function ConvertMass(ByVal valueKg As Double) As Double
        Select Case MassUnit.ToLowerInvariant()
            Case "g" : Return valueKg * 1000.0
            Case "mg" : Return valueKg * 1000000.0
            Case "lb" : Return valueKg * 2.20462262185
            Case "oz" : Return valueKg * 35.2739619496
            Case "ton" : Return valueKg / 1000.0
            Case Else : Return valueKg
        End Select
    End Function

    Public Shared Function ConvertLengthFromMm(ByVal valueMm As Double) As Double
        Select Case LengthUnit.ToLowerInvariant()
            Case "cm" : Return valueMm / 10.0
            Case "m" : Return valueMm / 1000.0
            Case "inch", "in" : Return valueMm / 25.4
            Case "ft" : Return valueMm / 304.8
            Case Else : Return valueMm
        End Select
    End Function

    'Inventor MassProperties.Area sử dụng cm² vì đơn vị cơ sở chiều dài là cm.
    Public Shared Function ConvertAreaFromCm2(ByVal valueCm2 As Double) As Double
        Select Case AreaUnit.ToLowerInvariant()
            Case "mm²", "mm2" : Return valueCm2 * 100.0
            Case "m²", "m2" : Return valueCm2 / 10000.0
            Case "inch²", "in²", "in2" : Return valueCm2 / 6.4516
            Case "ft²", "ft2" : Return valueCm2 / 929.0304
            Case Else : Return valueCm2
        End Select
    End Function

    'Inventor MassProperties.Volume sử dụng cm³.
    Public Shared Function ConvertVolumeFromCm3(ByVal valueCm3 As Double) As Double
        Select Case VolumeUnit.ToLowerInvariant()
            Case "mm³", "mm3" : Return valueCm3 * 1000.0
            Case "l", "liter", "litre" : Return valueCm3 / 1000.0
            Case "m³", "m3" : Return valueCm3 / 1000000.0
            Case "inch³", "in³", "in3" : Return valueCm3 / 16.387064
            Case "ft³", "ft3" : Return valueCm3 / 28316.846592
            Case Else : Return valueCm3
        End Select
    End Function

    Public Shared Function FormatValue(ByVal value As Double) As String
        If Math.Abs(value) >= 1000000 Then Return value.ToString("0.###E+0")
        If Math.Abs(value) >= 1000 Then Return value.ToString("0.###")
        If Math.Abs(value) >= 1 Then Return value.ToString("0.###")
        Return value.ToString("0.######")
    End Function

    Public Shared Function FormatMass(ByVal valueKg As Double) As String
        Return FormatValue(ConvertMass(valueKg))
    End Function

    Public Shared Function FormatLength(ByVal valueMm As Double) As String
        Return FormatValue(ConvertLengthFromMm(valueMm))
    End Function

    Public Shared Function FormatBoundingBox(ByVal item As PartBomItem) As String
        If item Is Nothing OrElse item.BoundingMaxMm <= 0 Then Return ""
        Return FormatLength(item.BoundingMaxMm) & " x " & FormatLength(item.BoundingMidMm) & " x " & FormatLength(item.BoundingMinMm)
    End Function

    Public Shared Function IsMassProperty(ByVal name As String) As Boolean
        Dim n As String = If(name, "").Trim().ToUpperInvariant()
        Return n = "MASS" OrElse n = "WEIGHT" OrElse n.Contains("MASS")
    End Function

    Public Shared Function IsVolumeProperty(ByVal name As String) As Boolean
        Dim n As String = If(name, "").Trim().ToUpperInvariant()
        Return n = "VOLUME" OrElse n.Contains("VOLUME")
    End Function

    Public Shared Function IsAreaProperty(ByVal name As String) As Boolean
        Dim n As String = If(name, "").Trim().ToUpperInvariant()
        Return n = "AREA" OrElse n = "SURFACE AREA" OrElse n.Contains("SURFACE AREA")
    End Function

    Public Shared Function GetPropertyHeader(ByVal propertyName As String) As String
        If IsMassProperty(propertyName) Then Return propertyName.ToUpperInvariant() & " (" & MassUnit & ")"
        If IsVolumeProperty(propertyName) Then Return propertyName.ToUpperInvariant() & " (" & VolumeUnit & ")"
        If IsAreaProperty(propertyName) Then Return propertyName.ToUpperInvariant() & " (" & AreaUnit & ")"
        Return propertyName.ToUpperInvariant()
    End Function

    Public Shared Function GetPropertyDisplayValue(ByVal item As PartBomItem, ByVal propertyInfo As PropertyColumnInfo) As Object
        If item Is Nothing OrElse propertyInfo Is Nothing Then Return ""
        If IsMassProperty(propertyInfo.PropertyName) Then Return ConvertMass(item.Mass)
        If IsVolumeProperty(propertyInfo.PropertyName) Then Return ConvertVolumeFromCm3(item.Volume)
        If IsAreaProperty(propertyInfo.PropertyName) Then Return ConvertAreaFromCm2(item.SurfaceArea)
        If item.SelectedPropertyValues.ContainsKey(propertyInfo.Key) Then Return item.SelectedPropertyValues(propertyInfo.Key)
        Return ""
    End Function
End Class

'====================================================================
' LỊCH SỬ CHỈNH SỬA IPROPERTY - UNDO / REDO
'====================================================================

'####################################################################
' SECTION 14 - EDIT HISTORY / VIEWER REGISTRY
' Undo/Redo action model và registry của Viewer.
'####################################################################

Public Class BomEditAction
    Public DocumentKey As String = ""
    Public PropertyKey As String = ""
    Public OldValue As String = ""
    Public NewValue As String = ""
    Public PropertyInfo As PropertyColumnInfo = Nothing
End Class

'====================================================================
' PHASE 2 - TRANSACTION ENGINE / STAGING MODEL
'====================================================================
Public Class BomPropertyChange
    Public DocumentKey As String = ""
    Public DocumentPath As String = ""
    Public PartNumber As String = ""
    Public FileName As String = ""
    Public PropertyKey As String = ""
    Public PropertyInfo As PropertyColumnInfo = Nothing
    Public OldValue As String = ""
    Public NewValue As String = ""
    'Quan trọng cho Custom iProperty: False nghĩa là trước Commit property chưa tồn tại.
    'Undo/Rollback phải DELETE property vừa tạo thay vì để lại một property rỗng.
    Public PropertyExistedBefore As Boolean = True
    Public Status As String = "PENDING"
    Public ErrorMessage As String = ""
End Class


Public Class BomPendingTransactionStore
    Private Shared Function Enc(ByVal value As String) As String
        Return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(If(value, "")))
    End Function

    Private Shared Function Dec(ByVal value As String) As String
        Try
            Return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(If(value, "")))
        Catch
            Return ""
        End Try
    End Function

    Public Shared Sub Save(ByVal filePath As String, ByVal assemblyPath As String, ByVal tx As BomTransaction)
        If String.IsNullOrWhiteSpace(filePath) Then Exit Sub
        If tx Is Nothing OrElse tx.Changes Is Nothing OrElse tx.Changes.Count = 0 Then
            Try
                If System.IO.File.Exists(filePath) Then System.IO.File.Delete(filePath)
            Catch
            End Try
            Exit Sub
        End If

        Dim lines As New List(Of String)()
        lines.Add("FORMAT=3")
        lines.Add("ASSEMBLY=" & Enc(assemblyPath))
        lines.Add("NAME=" & Enc(tx.Name))
        lines.Add("CREATED=" & tx.CreatedAt.ToString("o"))
        For Each ch As BomPropertyChange In tx.Changes
            Dim propName As String = ""
            Try
                If ch.PropertyInfo IsNot Nothing Then propName = ch.PropertyInfo.PropertyName
            Catch
            End Try
            lines.Add("CHANGE|" &
                      Enc(ch.DocumentPath) & "|" &
                      Enc(ch.DocumentKey) & "|" &
                      Enc(ch.PartNumber) & "|" &
                      Enc(ch.PropertyKey) & "|" &
                      Enc(propName) & "|" &
                      Enc(ch.OldValue) & "|" &
                      Enc(ch.NewValue) & "|" &
                      Enc(ch.Status) & "|" &
                      Enc(If(ch.PropertyExistedBefore, "1", "0")))
        Next
        System.IO.File.WriteAllLines(filePath, lines.ToArray(), System.Text.Encoding.UTF8)
    End Sub

    Public Shared Function Load(ByVal filePath As String,
                                ByRef assemblyPath As String,
                                ByRef transactionName As String,
                                ByRef createdAt As DateTime) As List(Of BomPropertyChange)
        Dim result As New List(Of BomPropertyChange)()
        assemblyPath = ""
        transactionName = "RECOVERED BOM EDIT"
        createdAt = DateTime.MinValue
        If String.IsNullOrWhiteSpace(filePath) OrElse Not System.IO.File.Exists(filePath) Then Return result

        Try
            For Each line As String In System.IO.File.ReadAllLines(filePath, System.Text.Encoding.UTF8)
                If line.StartsWith("ASSEMBLY=", StringComparison.OrdinalIgnoreCase) Then
                    assemblyPath = Dec(line.Substring(9))
                ElseIf line.StartsWith("NAME=", StringComparison.OrdinalIgnoreCase) Then
                    transactionName = Dec(line.Substring(5))
                ElseIf line.StartsWith("CREATED=", StringComparison.OrdinalIgnoreCase) Then
                    DateTime.TryParse(line.Substring(8), createdAt)
                ElseIf line.StartsWith("CHANGE|", StringComparison.OrdinalIgnoreCase) Then
                    Dim p() As String = line.Split("|"c)
                    If p.Length >= 9 Then
                        Dim ch As New BomPropertyChange()
                        ch.DocumentPath = Dec(p(1))
                        ch.DocumentKey = Dec(p(2))
                        ch.PartNumber = Dec(p(3))
                        ch.PropertyKey = Dec(p(4))
                        Dim propertyName As String = Dec(p(5))
                        ch.OldValue = Dec(p(6))
                        ch.NewValue = Dec(p(7))
                        ch.Status = Dec(p(8))
                        'FORMAT 3 lưu thêm trạng thái property có tồn tại trước edit hay không.
                        'File recovery cũ (FORMAT 2) mặc định True để rollback an toàn, không xóa nhầm property cũ.
                        ch.PropertyExistedBefore = True
                        If p.Length >= 10 Then ch.PropertyExistedBefore = String.Equals(Dec(p(9)), "1", StringComparison.OrdinalIgnoreCase)
                        ch.ErrorMessage = propertyName 'temporary carrier until PropertyInfo is resolved
                        result.Add(ch)
                    End If
                End If
            Next
        Catch ex As Exception
            BomLogger.Error("RECOVERY", "Pending transaction read failed: " & ex.Message)
        End Try
        Return result
    End Function

    Public Shared Sub Delete(ByVal filePath As String)
        Try
            If Not String.IsNullOrWhiteSpace(filePath) AndAlso System.IO.File.Exists(filePath) Then System.IO.File.Delete(filePath)
        Catch ex As Exception
            BomLogger.Warn("RECOVERY", "Cannot delete recovery file: " & ex.Message)
        End Try
    End Sub
End Class

Public Class BomTransaction
    Public Name As String = "BOM EDIT"
    Public CreatedAt As DateTime = DateTime.Now
    Public Changes As New List(Of BomPropertyChange)()
    Public Status As String = "PENDING"
    Public Atomic As Boolean = True
    Public AppliedCount As Integer = 0
    Public FailedCount As Integer = 0
    Public NotProcessedCount As Integer = 0
    Public RollbackFailedCount As Integer = 0
End Class

'====================================================================
' GIỮ MỘT BOM VIEWER DUY NHẤT
'====================================================================
Public Enum BomAssemblySwitchResult
    NoViewer = 0
    SameAssembly = 1
    DifferentAssembly = 2
    SwitchConfirmed = 3
    SwitchCancelled = 4
    SwitchFailed = 5
End Enum

Public Class BomViewerRegistry
    Public Shared CurrentViewer As BomViewerForm = Nothing
    Public Shared CurrentAssemblyPath As String = ""

    Public Shared Function NormalizePath(ByVal pathValue As String) As String
        If String.IsNullOrWhiteSpace(pathValue) Then Return ""
        Try
            Return System.IO.Path.GetFullPath(pathValue).Trim()
        Catch
            Return pathValue.Trim()
        End Try
    End Function

    Public Shared Function HasActiveViewer() As Boolean
        Try
            Return CurrentViewer IsNot Nothing AndAlso
                   Not CurrentViewer.IsDisposed AndAlso
                   Not CurrentViewer.Disposing
        Catch
            CurrentViewer = Nothing
            CurrentAssemblyPath = ""
            Return False
        End Try
    End Function

    Public Shared Function IsSameAssembly(ByVal assemblyPath As String) As Boolean
        If Not HasActiveViewer() Then Return False
        Return String.Equals(NormalizePath(CurrentAssemblyPath),
                             NormalizePath(assemblyPath),
                             StringComparison.OrdinalIgnoreCase)
    End Function

    Public Shared Function TryActivateExistingViewer() As Boolean
        If Not HasActiveViewer() Then Return False
        Try
            If CurrentViewer.WindowState = FormWindowState.Minimized Then
                CurrentViewer.WindowState = FormWindowState.Normal
            End If
            CurrentViewer.Show()
            CurrentViewer.BringToFront()
            CurrentViewer.Activate()
            CurrentViewer.Focus()
            Return True
        Catch
            Return False
        End Try
    End Function

    Public Shared Sub Register(ByVal viewer As BomViewerForm, ByVal assemblyPath As String)
        CurrentViewer = viewer
        CurrentAssemblyPath = NormalizePath(assemblyPath)
        BomSingleInstanceManager.Register(viewer)
    End Sub

    Public Shared Sub UpdateAssembly(ByVal assemblyPath As String)
        CurrentAssemblyPath = NormalizePath(assemblyPath)
    End Sub

    Public Shared Sub Unregister(ByVal viewer As BomViewerForm)
        If CurrentViewer Is viewer Then
            CurrentViewer = Nothing
            CurrentAssemblyPath = ""
        End If
        BomSingleInstanceManager.Unregister(viewer)
    End Sub
End Class

