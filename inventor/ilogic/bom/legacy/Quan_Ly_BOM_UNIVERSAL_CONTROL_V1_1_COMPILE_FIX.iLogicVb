'====================================================================
' BOM TOOL PRO BY HIẾU - V9 

'####################################################################
' BOM TOOL PRO - MASTER STRUCTURE MAP
'####################################################################
' 01. PROGRAM ENTRY / MAIN CONTROLLER
' 02. VIEWER CALLBACKS / DATA BRIDGE
' 03. SCAN CONTROL / CANCELLATION
' 04. INVENTOR ASSEMBLY SCAN ENGINE
' 05. IPROPERTY READ ENGINE
' 06. EXCEL EXPORT ENGINE
' 07. ASSEMBLY EXPORT DATA MODELS
' 08. COMMON UTILITIES / FORMAT / COM RELEASE
' 09. CORE DATA CACHE / GEOMETRY
' 10. PRIMARY BOM DATA MODELS
' 11. PROPERTY SELECTION UI
' 12. PROGRESS / CANCEL UI
' 13. UNIT ENGINE
' 14. EDIT HISTORY / VIEWER REGISTRY
' 15. MAIN BOM VIEWER FORM
'     15.01 Constructor & Interface
'     15.02 Ribbon & Quick Access
'     15.03 Status Bar & Context Menu
'     15.04 Grid Columns & Row Rendering
'     15.05 Assembly Filter & Search
'     15.06 Grid Selection & Mouse Events
'     15.07 Cell Editing & Undo/Redo
'     15.08 Group / Mark / Layout
'     15.09 Part & Drawing Interaction
'     15.10 Excel-like Grid Commands
'     15.11 Where Used & Occurrence Helpers
'     15.12 Inventor Commands
'     15.13 Refresh / Calculator / Export
' 16. ADD PROPERTY FORM
' 17. COLUMN MANAGER FORM
' 18. DASHBOARD FORM
' 19. PROJECT CHECK FORM
' 20. CALCULATOR / ANALYTICS FORM
' 21. ON-DEMAND FEATURE ENGINE / THUMBNAIL / PREVIEW
'####################################################################
' MAINTENANCE RULES
' - Không đặt code giao diện vào Scan Engine.
' - Không gọi Inventor từ Search/Filter nếu dữ liệu đã có trong Cache.
' - Không thêm Catch rỗng tại khu vực quan trọng.
' - Mỗi chức năng mới phải được đặt đúng SECTION và SUBSECTION.
' - Giữ Main ngắn, chỉ điều phối và xử lý lỗi cấp cao.
'####################################################################

'
' Chức năng:
'   - Chạy trong Assembly (.iam)
'   - Quét kiểu Parts Only
'   - Bung toàn bộ Sub-Assembly thành Part
'   - Gộp Part theo đường dẫn file và cộng số lượng
'   - Ghi Part nằm trong Assembly nào
'   - Chỉ quét tên iProperty để dựng danh sách chọn
'   - Sau khi chọn chỉ đọc đúng giá trị iProperty đã chọn
'   - Có Progress Bar và nút Hủy
'   - Xuất Excel hoàn chỉnh, không cần căn chỉnh lại
'   - Không dùng ThisApplication.ScreenUpdating nên không làm ảnh hưởng
'     hiển thị các document khác đang mở
'====================================================================


'####################################################################
' SECTION 01 - PROGRAM ENTRY / MAIN CONTROLLER
' Kiểm tra môi trường, khởi tạo, điều phối luồng chính và xử lý lỗi cấp cao.
'####################################################################

Sub Main()

    '==================================================================
    ' SINGLE INSTANCE + ASSEMBLY IDENTITY GUARD
    ' IMPORTANT: this executes BEFORE scan/reset/property/progress.
    '==================================================================
    Dim entryActivePath As String = ""
    Try
        If ThisApplication.ActiveDocument IsNot Nothing AndAlso
           ThisApplication.ActiveDocument.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
            entryActivePath = CType(ThisApplication.ActiveDocument, AssemblyDocument).FullFileName
        End If
    Catch
        entryActivePath = ""
    End Try

    If BomViewerRegistry.HasActiveViewer() Then
        If BomViewerRegistry.IsSameAssembly(entryActivePath) Then
            ' CASE B: SAME ASSEMBLY.
            ' Absolutely no refresh/reload/reset is allowed.
            BomViewerRegistry.TryActivateExistingViewer()
            Exit Sub
        End If

        ' CASE C: VIEWER EXISTS BUT ACTIVE ASSEMBLY IS DIFFERENT.
        ' Ask before touching the current BOM.
        If String.IsNullOrWhiteSpace(entryActivePath) Then
            BomViewerRegistry.TryActivateExistingViewer()
            Exit Sub
        End If

        Dim switchDecision As BomAssemblySwitchDecision = BomAssemblySwitchDecision.Cancel
        Using switchForm As New BomAssemblySwitchForm( _
            BomViewerRegistry.CurrentAssemblyPath, _
            entryActivePath, _
            BomViewerRegistry.CurrentViewer.PendingChangeCount)
            switchForm.ShowDialog(BomViewerRegistry.CurrentViewer)
            switchDecision = switchForm.Decision
        End Using

        If switchDecision = BomAssemblySwitchDecision.KeepCurrent Then
            BomViewerRegistry.TryActivateExistingViewer()
            Exit Sub
        ElseIf switchDecision <> BomAssemblySwitchDecision.LoadNew Then
            Exit Sub
        End If

        ' Second safety layer: pending transaction must be explicitly resolved.
        If BomViewerRegistry.CurrentViewer.PendingChangeCount > 0 Then
            If Not BomViewerRegistry.CurrentViewer.ResolvePendingBeforeAssemblySwitch() Then
                BomViewerRegistry.TryActivateExistingViewer()
                Exit Sub
            End If
        End If

        ' Do NOT close the old viewer here.
        ' Main continues and scans the new Assembly into temporary/local data.
        ' Existing viewer stays intact until scan succeeds completely.
    Else
        ' Clean stale reference, if any.
        BomSingleInstanceManager.TryActivateExisting()
    End If

    BomLogger.Reset()
    BomPerformanceCounters.Reset()
    Dim mainWatch As Stopwatch = Stopwatch.StartNew()
    Dim progressForm As BomProgressForm = Nothing

    Try
        '==============================================================
        ' KIỂM TRA DOCUMENT
        '==============================================================
        If ThisApplication.ActiveDocument Is Nothing Then
            MessageBox.Show( _
                "Không có tài liệu nào đang mở.", _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Warning)
            Exit Sub
        End If

        If ThisApplication.ActiveDocument.DocumentType <> _
           DocumentTypeEnum.kAssemblyDocumentObject Then

            MessageBox.Show( _
                "Rule này chỉ chạy trong môi trường Assembly (.iam).", _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Warning)
            Exit Sub
        End If

        Dim targetAssembly As AssemblyDocument = _
            CType(ThisApplication.ActiveDocument, AssemblyDocument)

        If String.IsNullOrWhiteSpace(targetAssembly.FullFileName) Then
            MessageBox.Show( _
                "Hãy lưu file Assembly trước khi xuất BOM.", _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Warning)
            Exit Sub
        End If

        '==============================================================
        ' HIỂN THỊ PROGRESS FORM
        '==============================================================
        progressForm = New BomProgressForm()
        progressForm.Show()
        progressForm.SetProgress(2, "Đang khởi tạo BOM Tool...")
        WinFormsApplication.DoEvents()

        '==============================================================
        ' QUÉT CÂY ASSEMBLY
        '==============================================================
        Dim partDictionary As New Dictionary( _
            Of String, PartBomItem)(StringComparer.OrdinalIgnoreCase)

        Dim rootAssemblyName As String = _
            GetDocumentPartNumberOrFileName(targetAssembly)

        Dim scannedOccurrenceCount As Integer = 0

        progressForm.SetProgress(8, "Đang quét cấu trúc Assembly...")

        ScanOccurrences( _
            targetAssembly.ComponentDefinition.Occurrences, _
            rootAssemblyName, _
            rootAssemblyName, _
            partDictionary, _
            progressForm, _
            scannedOccurrenceCount)

        CheckCancel(progressForm)

        If partDictionary.Count = 0 Then
            progressForm.Close()
            progressForm.Dispose()
            progressForm = Nothing

            MessageBox.Show( _
                "Không tìm thấy Part hợp lệ trong Assembly." & vbCrLf & _
                "Các component đang Suppress sẽ bị bỏ qua.", _
                "BOM TOOL PRO", _
                MessageBoxButtons.OK, _
                MessageBoxIcon.Information)
            Exit Sub
        End If

        progressForm.SetProgress(30, _
            "Đã quét xong cấu trúc Assembly." & vbCrLf & _
            "Component đã kiểm tra: " & scannedOccurrenceCount.ToString() & vbCrLf & _
            "Loại Part tìm thấy: " & partDictionary.Count.ToString())

        '==============================================================
        ' CHUYỂN DICTIONARY THÀNH LIST
        '==============================================================
        Dim bomItems As New List(Of PartBomItem)

        For Each pair As KeyValuePair(Of String, PartBomItem) In partDictionary
            Dim cachedItem As PartBomItem = pair.Value
            cachedItem.SearchBlob = (cachedItem.FileName & "|" & cachedItem.FilePath & "|" & cachedItem.PartNumber & "|" & cachedItem.Description & "|" & cachedItem.Material & "|" & cachedItem.Vendor & "|" & cachedItem.Revision & "|" & cachedItem.StockNumber & "|" & cachedItem.Project & "|" & cachedItem.Category & "|" & cachedItem.GetParentAssemblyText()).ToUpperInvariant()
            bomItems.Add(cachedItem)
        Next

        bomItems.Sort(AddressOf CompareBomItems)

        '==============================================================
        ' CHỈ QUÉT TÊN IPROPERTY
        ' Không đọc Value ở bước này
        '==============================================================
        Dim propertyDictionary As New Dictionary( _
            Of String, PropertyColumnInfo)(StringComparer.OrdinalIgnoreCase)

        Dim propertyScanIndex As Integer = 0
        Dim totalParts As Integer = bomItems.Count

        progressForm.SetProgress(34, "Đang lập danh sách tên iProperty...")

        For Each item As PartBomItem In bomItems
            CheckCancel(progressForm)
            propertyScanIndex += 1

            If item.Document IsNot Nothing Then
                ScanDocumentPropertyNames(item.Document, propertyDictionary)
            End If

            If propertyScanIndex Mod 20 = 0 OrElse propertyScanIndex = totalParts Then
                Dim propertyProgress As Integer = 34

                If totalParts > 0 Then
                    propertyProgress = 34 + CInt( _
                        (CDbl(propertyScanIndex) / CDbl(totalParts)) * 16)
                End If

                progressForm.SetProgress( _
                    Math.Min(propertyProgress, 50), _
                    "Đang lập danh sách iProperty..." & vbCrLf & _
                    propertyScanIndex.ToString() & " / " & totalParts.ToString() & " Part")
            End If
        Next

        Dim availableProperties As New List(Of PropertyColumnInfo)

        For Each pair As KeyValuePair(Of String, PropertyColumnInfo) In propertyDictionary
            availableProperties.Add(pair.Value)
        Next

        availableProperties.Sort(AddressOf ComparePropertyColumns)

        '==============================================================
        ' HIỆN FORM CHỌN CỘT
        '==============================================================
        progressForm.SetProgress(52, _
            "Đã lập xong danh sách iProperty." & vbCrLf & _
            "Đang mở cửa sổ chọn cột...")
        progressForm.Hide()

        Dim selectionForm As New BomPropertySelectionForm( _
            availableProperties, _
            bomItems.Count)

        Dim formResult As DialogResult = selectionForm.ShowDialog()

        If formResult <> DialogResult.OK Then
            progressForm.Close()
            progressForm.Dispose()
            progressForm = Nothing
            Exit Sub
        End If

        Dim selectedProperties As List(Of PropertyColumnInfo) = _
            selectionForm.SelectedProperties

        Dim includeFileName As Boolean = selectionForm.IncludeFileName
        Dim includeFilePath As Boolean = selectionForm.IncludeFilePath
        Dim includeParentAssembly As Boolean = selectionForm.IncludeParentAssembly
        Dim openExcelAfterExport As Boolean = selectionForm.OpenExcelAfterExport
        Dim selectedScanMode As BomScanMode = selectionForm.SelectedScanMode

        '==============================================================
        ' SAU KHI CHỌN MỚI ĐỌC ĐÚNG PROPERTY ĐƯỢC CHỌN
        '==============================================================
        progressForm.Show()
        progressForm.SetProgress(55, _
            "Đang đọc đúng các iProperty đã chọn..." & vbCrLf & _
            "Số cột iProperty: " & selectedProperties.Count.ToString())

        ReadSelectedPropertiesOnly( _
            bomItems, _
            selectedProperties, _
            progressForm)

        CheckCancel(progressForm)

        '==============================================================
        ' ĐÓNG PROGRESS VÀ MỞ BOM VIEWER KHÔNG KHÓA INVENTOR
        '==============================================================
        progressForm.SetProgress(100, "Đã nạp xong dữ liệu BOM.")
        WinFormsApplication.DoEvents()
        progressForm.Close()
        progressForm.Dispose()
        progressForm = Nothing

        'SAFE SWITCH:
        'At this point the NEW assembly has already scanned successfully.
        'The old Viewer/Data Model has intentionally remained untouched.

        Dim existingViewer As BomViewerForm = Nothing
        If BomViewerRegistry.HasActiveViewer() Then existingViewer = BomViewerRegistry.CurrentViewer

        Dim exportCallback As System.Action(Of List(Of PartBomItem)) = _
            Sub(rowsToExport As List(Of PartBomItem))
                ExportRowsFromViewer( _
                    targetAssembly, _
                    rowsToExport, _
                    selectedProperties, _
                    includeFileName, _
                    includeFilePath, _
                    includeParentAssembly, _
                    openExcelAfterExport)
            End Sub

        Dim refreshCallback As System.Action(Of List(Of PartBomItem)) = _
            Sub(rowsToRefresh As List(Of PartBomItem))
                RefreshRowsFromViewer(rowsToRefresh, selectedProperties)
            End Sub

        'Nạp BOM từ đúng document đang Active trong Inventor.
        'Viewer cũ chỉ bị thay sau khi Assembly mới đã quét thành công.
        Dim loadBomCallback As System.Action = _
            Sub()
                Try
                    If ThisApplication.ActiveDocument Is Nothing Then
                        MessageBox.Show( _
                            "Không có tài liệu nào đang mở.", _
                            "LOAD BOM", _
                            MessageBoxButtons.OK, _
                            MessageBoxIcon.Warning)
                        Exit Sub
                    End If

                    If ThisApplication.ActiveDocument.DocumentType <> _
                       DocumentTypeEnum.kAssemblyDocumentObject Then

                        MessageBox.Show( _
                            "Đây không phải file lắp ráp (.iam)." & vbCrLf & _
                            "Hãy Active một Assembly rồi nhấn LOAD BOM lại.", _
                            "LOAD BOM", _
                            MessageBoxButtons.OK, _
                            MessageBoxIcon.Warning)
                        Exit Sub
                    End If

                    Dim activeAsm As AssemblyDocument = _
                        CType(ThisApplication.ActiveDocument, AssemblyDocument)

                    If String.Equals( _
                        activeAsm.FullFileName, _
                        targetAssembly.FullFileName, _
                        StringComparison.OrdinalIgnoreCase) Then

                        Dim sameResult As DialogResult = MessageBox.Show( _
                            "Assembly đang Active chính là BOM hiện tại:" & vbCrLf & _
                            activeAsm.DisplayName & vbCrLf & vbCrLf & _
                            "Bạn có muốn nạp lại BOM này không?", _
                            "LOAD BOM", _
                            MessageBoxButtons.YesNo, _
                            MessageBoxIcon.Question)

                        If sameResult <> DialogResult.Yes Then Exit Sub
                    Else
                        Dim replaceResult As DialogResult = MessageBox.Show( _
                            "BOM hiện tại:" & vbCrLf & _
                            targetAssembly.DisplayName & vbCrLf & vbCrLf & _
                            "Assembly đang Active:" & vbCrLf & _
                            activeAsm.DisplayName & vbCrLf & vbCrLf & _
                            "Bạn có muốn thay BOM hiện tại bằng Assembly đang Active không?", _
                            "LOAD BOM", _
                            MessageBoxButtons.YesNo, _
                            MessageBoxIcon.Question)

                        If replaceResult <> DialogResult.Yes Then Exit Sub
                    End If

                    MessageBox.Show( _
                        "Không gọi lại External Rule từ bên trong Viewer." & vbCrLf & _
                        "Hãy Active Assembly cần chuyển và chạy BOM Tool; hệ thống sẽ xử lý Safe Assembly Switch.", _
                        "ASSEMBLY SWITCH", _
                        MessageBoxButtons.OK, _
                        MessageBoxIcon.Information)

                Catch ex As Exception
                    MessageBox.Show( _
                        "Không thể Load BOM từ Assembly đang Active." & vbCrLf & _
                        ex.Message, _
                        "LOAD BOM", _
                        MessageBoxButtons.OK, _
                        MessageBoxIcon.Error)
                End Try
            End Sub

        BomPerformanceCounters.InitialLoadMs = mainWatch.ElapsedMilliseconds

        If existingViewer IsNot Nothing AndAlso Not existingViewer.IsDisposed Then
            'REUSE EXISTING VIEWER. No close/dispose/flicker.
            existingViewer.ReplaceAssemblyData( _
                targetAssembly.FullFileName, _
                GetDocumentPartNumberOrFileName(targetAssembly), _
                bomItems, _
                selectedProperties, _
                includeFileName, _
                includeFilePath, _
                includeParentAssembly, _
                exportCallback, _
                refreshCallback, _
                loadBomCallback, _
                selectedScanMode)

            BomViewerRegistry.UpdateAssembly(targetAssembly.FullFileName)
            BomLogger.Info("ASSEMBLY_SWITCH", "Switched Viewer safely to: " & targetAssembly.FullFileName)
            existingViewer.BringToFront()
            existingViewer.Activate()
        Else
            Dim viewer As New BomViewerForm( _
                ThisApplication, _
                targetAssembly.FullFileName, _
                GetDocumentPartNumberOrFileName(targetAssembly), _
                bomItems, _
                selectedProperties, _
                includeFileName, _
                includeFilePath, _
                includeParentAssembly, _
                exportCallback, _
                refreshCallback, _
                loadBomCallback, _
                selectedScanMode)

            BomViewerRegistry.Register(viewer, targetAssembly.FullFileName)

            AddHandler viewer.FormClosed, _
                Sub(sender As Object, e As FormClosedEventArgs)
                    BomViewerRegistry.Unregister(viewer)
                End Sub

            BomLogger.Info("MAIN", "BOM loaded: " & bomItems.Count.ToString() & " unique Part in " & mainWatch.ElapsedMilliseconds.ToString() & " ms")
            viewer.Show()
            viewer.BringToFront()
        End If

    Catch ex As OperationCanceledException

        If progressForm IsNot Nothing Then
            Try
                progressForm.Close()
                progressForm.Dispose()
            Catch
            End Try
        End If

        MessageBox.Show( _
            "Đã hủy quá trình xuất BOM.", _
            "BOM TOOL PRO", _
            MessageBoxButtons.OK, _
            MessageBoxIcon.Information)

    Catch ex As Exception

        If progressForm IsNot Nothing Then
            Try
                progressForm.Close()
                progressForm.Dispose()
            Catch
            End Try
        End If

        MessageBox.Show( _
            "Không thể xuất BOM." & vbCrLf & vbCrLf & _
            "Chi tiết lỗi:" & vbCrLf & ex.Message, _
            "BOM TOOL PRO", _
            MessageBoxButtons.OK, _
            MessageBoxIcon.Error)

    End Try

End Sub


'====================================================================
' XUẤT DỮ LIỆU TỪ BOM VIEWER
'====================================================================

'####################################################################
' SECTION 02 - VIEWER CALLBACKS / DATA BRIDGE
' Các callback giữa Main, Viewer, Refresh và Export.
'####################################################################

Sub ExportRowsFromViewer( _
    ByVal targetAssembly As AssemblyDocument, _
    ByVal rowsToExport As List(Of PartBomItem), _
    ByVal selectedProperties As List(Of PropertyColumnInfo), _
    ByVal includeFileName As Boolean, _
    ByVal includeFilePath As Boolean, _
    ByVal includeParentAssembly As Boolean, _
    ByVal openExcelAfterExport As Boolean)

    If rowsToExport Is Nothing OrElse rowsToExport.Count = 0 Then
        MessageBox.Show("Không có dòng dữ liệu nào để xuất.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
        Exit Sub
    End If

    Dim defaultFileName As String = _
        IOPath.GetFileNameWithoutExtension(targetAssembly.FullFileName) & _
        "_PARTS_ONLY_BOM_" & DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".xlsx"

    Dim saveDialog As New SaveFileDialog()
    saveDialog.Title = "Lưu Parts Only BOM"
    saveDialog.Filter = "Excel Workbook (*.xlsx)|*.xlsx"
    saveDialog.FileName = defaultFileName
    saveDialog.InitialDirectory = IOPath.GetDirectoryName(targetAssembly.FullFileName)
    saveDialog.OverwritePrompt = True
    saveDialog.AddExtension = True
    saveDialog.DefaultExt = "xlsx"

    If saveDialog.ShowDialog() <> DialogResult.OK Then Exit Sub

    Dim progress As New BomProgressForm()
    Try
        progress.Show()
        progress.SetProgress(76, "Đang chuẩn bị dữ liệu xuất Excel...")

        ExportBomToExcel( _
            targetAssembly, _
            rowsToExport, _
            selectedProperties, _
            includeFileName, _
            includeFilePath, _
            includeParentAssembly, _
            saveDialog.FileName, _
            openExcelAfterExport, _
            progress)

        progress.Close()
        progress.Dispose()

        MessageBox.Show( _
            "Đã xuất BOM thành công." & vbCrLf & vbCrLf & _
            "Số dòng: " & rowsToExport.Count.ToString() & vbCrLf & _
            "Đường dẫn:" & vbCrLf & saveDialog.FileName, _
            "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)

    Catch ex As Exception
        Try
            progress.Close()
            progress.Dispose()
        Catch
        End Try
        MessageBox.Show("Không thể xuất Excel." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
    End Try
End Sub

'====================================================================
' LÀM MỚI ĐÚNG CÁC DÒNG VÀ CỘT ĐÃ CHỌN
'====================================================================
Sub RefreshRowsFromViewer( _
    ByVal rowsToRefresh As List(Of PartBomItem), _
    ByVal selectedProperties As List(Of PropertyColumnInfo))

    If rowsToRefresh Is Nothing OrElse rowsToRefresh.Count = 0 Then Exit Sub

    Dim sw As Stopwatch = Stopwatch.StartNew()
    For Each item As PartBomItem In rowsToRefresh
        If item Is Nothing OrElse item.Document Is Nothing Then Continue For
        'Part thay đổi: invalidate geometry cache; Core refresh vẫn giữ nhẹ.
        BomGeometryEngine.Invalidate(item)
        CacheCorePartData(item)
        item.SelectedPropertyValues.Clear()
        ReadSelectedPropertiesForDocument(item, selectedProperties)
        BomSignatureEngine.CaptureIntoItem(item)
    Next
    BomLogger.Info("REFRESH_PROPERTIES", "Refreshed " & rowsToRefresh.Count.ToString() & " Part in " & sw.ElapsedMilliseconds.ToString() & " ms")
End Sub

'====================================================================
' KIỂM TRA YÊU CẦU HỦY
'====================================================================

'####################################################################
' SECTION 03 - SCAN CONTROL / CANCELLATION
' Kiểm soát hủy an toàn và trạng thái tiến trình.
'####################################################################

Sub CheckCancel(ByVal progressForm As BomProgressForm)
    WinFormsApplication.DoEvents()

    If progressForm IsNot Nothing AndAlso progressForm.CancelRequested Then
        Throw New OperationCanceledException()
    End If
End Sub

'====================================================================
' QUÉT ĐỆ QUY ASSEMBLY
'====================================================================

'####################################################################
' SECTION 04 - INVENTOR ASSEMBLY SCAN ENGINE
' Quét occurrence, bung cấu trúc, gộp Part và xây dữ liệu BOM.
'####################################################################

Sub ScanOccurrences( _
    ByVal occurrences As ComponentOccurrences, _
    ByVal immediateParentAssembly As String, _
    ByVal immediateParentPath As String, _
    ByVal partDictionary As Dictionary(Of String, PartBomItem), _
    ByVal progressForm As BomProgressForm, _
    ByRef scannedOccurrenceCount As Integer)

    If occurrences Is Nothing Then Exit Sub

    For Each occurrence As ComponentOccurrence In occurrences

        scannedOccurrenceCount += 1
        BomPerformanceCounters.OccurrenceTraversal += 1

        If scannedOccurrenceCount Mod 25 = 0 Then
            progressForm.SetStatus( _
                "Đang quét cấu trúc Assembly..." & vbCrLf & _
                "Đã kiểm tra: " & scannedOccurrenceCount.ToString() & " component" & vbCrLf & _
                "Đã tìm thấy: " & partDictionary.Count.ToString() & " loại Part")
            CheckCancel(progressForm)
        End If

        Try
            If occurrence.Suppressed Then Continue For

            Dim referencedDocument As Inventor.Document = Nothing

            Try
                referencedDocument = _
                    occurrence.ReferencedDocumentDescriptor.ReferencedDocument
            Catch
                Try
                    referencedDocument = occurrence.Definition.Document
                Catch
                    referencedDocument = Nothing
                End Try
            End Try

            If referencedDocument Is Nothing Then Continue For

            If referencedDocument.DocumentType = _
               DocumentTypeEnum.kPartDocumentObject Then

                AddPartToDictionary( _
                    referencedDocument, _
                    occurrence, _
                    immediateParentAssembly, _
                    immediateParentPath, _
                    partDictionary)

            ElseIf referencedDocument.DocumentType = _
                   DocumentTypeEnum.kAssemblyDocumentObject Then

                Dim subAssemblyName As String = _
                    GetDocumentPartNumberOrFileName(referencedDocument)

                Dim subOccurrences As ComponentOccurrences = Nothing

                Try
                    subOccurrences = occurrence.SubOccurrences
                Catch
                    subOccurrences = Nothing
                End Try

                If subOccurrences IsNot Nothing Then
                    Dim subAssemblyPath As String = immediateParentPath
                    If String.IsNullOrWhiteSpace(subAssemblyPath) Then
                        subAssemblyPath = subAssemblyName
                    Else
                        subAssemblyPath &= "\" & subAssemblyName
                    End If

                    ScanOccurrences( _
                        subOccurrences, _
                        subAssemblyName, _
                        subAssemblyPath, _
                        partDictionary, _
                        progressForm, _
                        scannedOccurrenceCount)
                End If
            End If

        Catch ex As Exception
            BomLogger.Add(BomLogLevel.Warning, "SCAN", "Bỏ qua occurrence lỗi: " & ex.Message)
        End Try
    Next

End Sub

'====================================================================
' THÊM/GỘP PART
'====================================================================
Sub AddPartToDictionary( _
    ByVal partDocument As Inventor.Document, _
    ByVal sourceOccurrence As ComponentOccurrence, _
    ByVal parentAssembly As String, _
    ByVal parentAssemblyPath As String, _
    ByVal partDictionary As Dictionary(Of String, PartBomItem))

    If partDocument Is Nothing Then Exit Sub

    Dim documentKey As String = ""

    Try
        documentKey = partDocument.FullFileName
    Catch
        documentKey = ""
    End Try

    If String.IsNullOrWhiteSpace(documentKey) Then
        Try
            documentKey = partDocument.InternalName
        Catch
            Try
                documentKey = partDocument.DisplayName
            Catch
                documentKey = Guid.NewGuid().ToString()
            End Try
        End Try
    End If

    documentKey = documentKey.Trim()
    If String.IsNullOrWhiteSpace(documentKey) Then Exit Sub

    Dim item As PartBomItem = Nothing

    If partDictionary.TryGetValue(documentKey, item) Then
        item.Quantity += 1
        item.AddParentAssembly(parentAssembly)
        item.AddAssemblyPath(parentAssemblyPath)
        item.AddOccurrence(sourceOccurrence)
    Else
        item = New PartBomItem()
        item.DocumentKey = documentKey
        item.Document = partDocument
        item.Quantity = 1
        item.FileName = GetSafeFileName(partDocument)
        item.FilePath = GetSafeFullFileName(partDocument)
        item.PartNumber = GetDocumentPartNumberOrFileName(partDocument)
        item.AddParentAssembly(parentAssembly)
        item.AddAssemblyPath(parentAssemblyPath)
        item.AddOccurrence(sourceOccurrence)
        CacheCorePartData(item)
        partDictionary.Add(documentKey, item)
    End If

End Sub

'====================================================================
' CHỈ QUÉT TÊN IPROPERTY
'====================================================================
Public Shared Sub ScanDocumentPropertyNames( _
    ByVal oDoc As Inventor.Document, _
    ByVal propertyDictionary As Dictionary(Of String, PropertyColumnInfo))

    If oDoc Is Nothing Then Exit Sub

    Dim propertySets As Inventor.PropertySets = Nothing

    Try
        propertySets = oDoc.PropertySets
    Catch
        Exit Sub
    End Try

    For Each propertySet As Inventor.PropertySet In propertySets

        Dim setDisplayName As String = ""
        Dim setInternalName As String = ""

        Try
            setDisplayName = propertySet.DisplayName
        Catch
        End Try

        Try
            setInternalName = propertySet.InternalName
        Catch
        End Try

        If ShouldSkipPropertySet(setDisplayName, setInternalName) Then
            Continue For
        End If

        For Each inventorProperty As Inventor.Property In propertySet
            Try
                Dim propertyName As String = inventorProperty.Name

                If String.IsNullOrWhiteSpace(propertyName) Then Continue For

                If String.Equals( _
                    propertyName, _
                    "Thumbnail", _
                    StringComparison.OrdinalIgnoreCase) Then
                    Continue For
                End If

                Dim propertyKey As String = _
                    BuildPropertyKey(setInternalName, propertyName)

                If Not propertyDictionary.ContainsKey(propertyKey) Then
                    Dim columnInfo As New PropertyColumnInfo()
                    columnInfo.Key = propertyKey
                    columnInfo.PropertySetDisplayName = setDisplayName
                    columnInfo.PropertySetInternalName = setInternalName
                    columnInfo.PropertyName = propertyName
                    columnInfo.DisplayText = _
                        BuildPropertyDisplayText(setDisplayName, propertyName)
                    columnInfo.DefaultSelected = IsDefaultProperty(propertyName)
                    propertyDictionary.Add(propertyKey, columnInfo)
                End If

                'Không đọc Value tại đây
            Catch ex As Exception
                BomLogger.Add(BomLogLevel.Warning, "PROPERTY_SCAN", ex.Message, Nothing, TryGetDocumentPath(oDoc))
            End Try
        Next
    Next

End Sub

Public Shared Function TryGetDocumentPath(ByVal doc As Inventor.Document) As String
    If doc Is Nothing Then Return ""
    Try
        Return doc.FullFileName
    Catch
        Try
            Return doc.DisplayName
        Catch
            Return ""
        End Try
    End Try
End Function

'====================================================================
' CHỈ ĐỌC GIÁ TRỊ PROPERTY ĐÃ CHỌN
'====================================================================


'====================================================================
' UNIVERSAL PART / SHEET METAL CONTROL
' Các cột synthetic dùng chung transaction engine với iProperty.
'====================================================================
Private Const SystemSettingSetInternalName As String = "__HIEU_SYSTEM_SETTING__"
Private Const SystemSettingSetDisplayName As String = "Inventor / Model Settings"

Private Shared Function MakeSystemSetting(ByVal settingId As String, ByVal caption As String) As PropertyColumnInfo
    Dim p As New PropertyColumnInfo()
    p.IsSystemSetting = True
    p.SettingId = settingId
    p.PropertySetInternalName = SystemSettingSetInternalName
    p.PropertySetDisplayName = SystemSettingSetDisplayName
    p.PropertyName = caption
    p.Key = SystemSettingSetInternalName & "||" & settingId
    p.DisplayText = "[MODEL] " & caption
    p.DefaultSelected = False
    Return p
End Function

Private Shared Sub AddUniversalSystemSettings(ByVal available As List(Of PropertyColumnInfo))
    If available Is Nothing Then Exit Sub
    available.Add(MakeSystemSetting("PART.MATERIAL", "Material"))
    available.Add(MakeSystemSetting("PART.APPEARANCE", "Appearance"))
    available.Add(MakeSystemSetting("SM.RULE", "Sheet Metal Rule"))
    available.Add(MakeSystemSetting("SM.USE_RULE_THICKNESS", "Use Thickness From Rule"))
    available.Add(MakeSystemSetting("SM.THICKNESS", "Sheet Metal Thickness"))
    available.Add(MakeSystemSetting("SM.USE_RULE_MATERIAL", "Use Material From Rule"))
    available.Add(MakeSystemSetting("SM.UNFOLD_RULE", "Unfold Rule"))
    available.Add(MakeSystemSetting("SM.USE_RULE_UNFOLD", "Use Unfold Rule From Sheet Metal Rule"))
End Sub

Private Shared Function IsSheetMetalDocument(ByVal doc As Inventor.Document) As Boolean
    Try
        If Not TypeOf doc Is Inventor.PartDocument Then Return False
        Return TypeOf CType(doc, Inventor.PartDocument).ComponentDefinition Is Inventor.SheetMetalComponentDefinition
    Catch
        Return False
    End Try
End Function

Private Shared Function ParseBomBoolean(ByVal value As String) As Boolean
    Dim s As String = If(value, "").Trim().ToUpperInvariant()
    If s = "1" OrElse s = "TRUE" OrElse s = "YES" OrElse s = "Y" OrElse s = "ON" OrElse s = "CÓ" OrElse s = "CO" OrElse s = "X" Then Return True
    If s = "0" OrElse s = "FALSE" OrElse s = "NO" OrElse s = "N" OrElse s = "OFF" OrElse s = "KHÔNG" OrElse s = "KHONG" OrElse s = "" Then Return False
    Throw New Exception("Giá trị Boolean không hợp lệ: '" & value & "'. Dùng TRUE/FALSE, YES/NO hoặc 1/0.")
End Function

Private Shared Function ReadSystemSettingValue(ByVal doc As Inventor.Document, ByVal info As PropertyColumnInfo) As Object
    If doc Is Nothing OrElse info Is Nothing Then Return ""
    Try
        Dim partDoc As Inventor.PartDocument = TryCast(doc, Inventor.PartDocument)
        Select Case info.SettingId
            Case "PART.MATERIAL"
                If partDoc Is Nothing OrElse partDoc.ActiveMaterial Is Nothing Then Return ""
                Return partDoc.ActiveMaterial.DisplayName
            Case "PART.APPEARANCE"
                If partDoc Is Nothing OrElse partDoc.ActiveAppearance Is Nothing Then Return ""
                Return partDoc.ActiveAppearance.DisplayName
        End Select

        If partDoc Is Nothing OrElse Not TypeOf partDoc.ComponentDefinition Is Inventor.SheetMetalComponentDefinition Then Return ""
        Dim sm As Inventor.SheetMetalComponentDefinition = CType(partDoc.ComponentDefinition, Inventor.SheetMetalComponentDefinition)

        Select Case info.SettingId
            Case "SM.RULE"
                If sm.ActiveSheetMetalStyle Is Nothing Then Return ""
                Return sm.ActiveSheetMetalStyle.Name
            Case "SM.USE_RULE_THICKNESS"
                Return sm.UseSheetMetalStyleThickness
            Case "SM.THICKNESS"
                If sm.Thickness Is Nothing Then Return ""
                Return sm.Thickness.Expression
            Case "SM.USE_RULE_MATERIAL"
                Return sm.UseSheetMetalStyleMaterial
            Case "SM.UNFOLD_RULE"
                If sm.UnfoldMethod Is Nothing Then Return ""
                Return sm.UnfoldMethod.Name
            Case "SM.USE_RULE_UNFOLD"
                Return sm.UseSheetMetalStyleUnfoldMethod
        End Select
    Catch ex As Exception
        BomLogger.Add(BomLogLevel.Warning, "SYSTEM_SETTING_READ", info.SettingId & ": " & ex.Message, Nothing, TryGetDocumentPath(doc))
    End Try
    Return ""
End Function

Private Shared Function FindMaterialAsset(ByVal partDoc As Inventor.PartDocument, ByVal requestedName As String) As Inventor.Asset
    If partDoc Is Nothing OrElse String.IsNullOrWhiteSpace(requestedName) Then Return Nothing
    Dim wanted As String = requestedName.Trim()

    Try
        For Each a As Inventor.Asset In partDoc.MaterialAssets
            If String.Equals(a.DisplayName, wanted, StringComparison.OrdinalIgnoreCase) OrElse
               String.Equals(a.Name, wanted, StringComparison.OrdinalIgnoreCase) Then Return a
        Next
    Catch
    End Try

    Try
        Dim invApp As Inventor.Application = CType(partDoc.Parent, Inventor.Application)
        For Each assetLibrary As Inventor.AssetLibrary In invApp.AssetLibraries
            Try
                For Each a As Inventor.Asset In assetLibrary.MaterialAssets
                    If String.Equals(a.DisplayName, wanted, StringComparison.OrdinalIgnoreCase) OrElse
                       String.Equals(a.Name, wanted, StringComparison.OrdinalIgnoreCase) Then
                        Dim localAsset As Inventor.Asset = a.CopyTo(partDoc)
                        Return localAsset
                    End If
                Next
            Catch
            End Try
        Next
    Catch
    End Try
    Return Nothing
End Function

Private Shared Function FindAppearanceAsset(ByVal partDoc As Inventor.PartDocument, ByVal requestedName As String) As Inventor.Asset
    If partDoc Is Nothing OrElse String.IsNullOrWhiteSpace(requestedName) Then Return Nothing
    Dim wanted As String = requestedName.Trim()

    Try
        For Each a As Inventor.Asset In partDoc.AppearanceAssets
            If String.Equals(a.DisplayName, wanted, StringComparison.OrdinalIgnoreCase) OrElse
               String.Equals(a.Name, wanted, StringComparison.OrdinalIgnoreCase) Then Return a
        Next
    Catch
    End Try

    Try
        Dim invApp As Inventor.Application = CType(partDoc.Parent, Inventor.Application)
        For Each assetLibrary As Inventor.AssetLibrary In invApp.AssetLibraries
            Try
                For Each a As Inventor.Asset In assetLibrary.AppearanceAssets
                    If String.Equals(a.DisplayName, wanted, StringComparison.OrdinalIgnoreCase) OrElse
                       String.Equals(a.Name, wanted, StringComparison.OrdinalIgnoreCase) Then
                        Dim localAsset As Inventor.Asset = a.CopyTo(partDoc)
                        Return localAsset
                    End If
                Next
            Catch
            End Try
        Next
    Catch
    End Try
    Return Nothing
End Function

Private Shared Sub WriteSystemSettingValue(ByVal doc As Inventor.Document, ByVal info As PropertyColumnInfo, ByVal newValue As String)
    If doc Is Nothing OrElse info Is Nothing Then Throw New Exception("System setting không hợp lệ.")
    Dim partDoc As Inventor.PartDocument = TryCast(doc, Inventor.PartDocument)

    Select Case info.SettingId
        Case "PART.MATERIAL"
            If partDoc Is Nothing Then Throw New Exception("Material chỉ áp dụng cho Part.")
            Dim mat As Inventor.Asset = FindMaterialAsset(partDoc, newValue)
            If mat Is Nothing Then Throw New Exception("Không tìm thấy Material: " & newValue)
            partDoc.ActiveMaterial = mat
            Exit Sub

        Case "PART.APPEARANCE"
            If partDoc Is Nothing Then Throw New Exception("Appearance chỉ áp dụng cho Part.")
            Dim app As Inventor.Asset = FindAppearanceAsset(partDoc, newValue)
            If app Is Nothing Then Throw New Exception("Không tìm thấy Appearance: " & newValue)
            partDoc.ActiveAppearance = app
            Exit Sub
    End Select

    If partDoc Is Nothing OrElse Not TypeOf partDoc.ComponentDefinition Is Inventor.SheetMetalComponentDefinition Then
        Throw New Exception("'" & info.PropertyName & "' chỉ áp dụng cho Sheet Metal Part.")
    End If

    Dim sm As Inventor.SheetMetalComponentDefinition = CType(partDoc.ComponentDefinition, Inventor.SheetMetalComponentDefinition)

    Select Case info.SettingId
        Case "SM.RULE"
            Dim target As Inventor.SheetMetalStyle = Nothing
            Try : target = sm.SheetMetalStyles.Item(newValue.Trim()) : Catch : End Try
            If target Is Nothing Then Throw New Exception("Không tìm thấy Sheet Metal Rule: " & newValue)
            target.Activate()

        Case "SM.USE_RULE_THICKNESS"
            sm.UseSheetMetalStyleThickness = ParseBomBoolean(newValue)

        Case "SM.THICKNESS"
            'Khi người dùng sửa Thickness trực tiếp, tự chuyển sang override để giá trị có hiệu lực.
            sm.UseSheetMetalStyleThickness = False
            sm.Thickness.Expression = newValue.Trim()

        Case "SM.USE_RULE_MATERIAL"
            sm.UseSheetMetalStyleMaterial = ParseBomBoolean(newValue)

        Case "SM.UNFOLD_RULE"
            Dim targetUnfold As Inventor.UnfoldMethod = Nothing
            Try : targetUnfold = sm.UnfoldMethods.Item(newValue.Trim()) : Catch : End Try
            If targetUnfold Is Nothing Then Throw New Exception("Không tìm thấy Unfold Rule: " & newValue)
            sm.UseSheetMetalStyleUnfoldMethod = False
            sm.UnfoldMethod = targetUnfold

        Case "SM.USE_RULE_UNFOLD"
            sm.UseSheetMetalStyleUnfoldMethod = ParseBomBoolean(newValue)

        Case Else
            Throw New Exception("Chưa có handler cho setting: " & info.SettingId)
    End Select
End Sub


'####################################################################
' SECTION 05 - IPROPERTY READ ENGINE
' Đọc đúng các iProperty được chọn và giảm COM Call.
'####################################################################

Sub ReadSelectedPropertiesOnly( _
    ByVal bomItems As List(Of PartBomItem), _
    ByVal selectedProperties As List(Of PropertyColumnInfo), _
    ByVal progressForm As BomProgressForm)

    Dim totalParts As Integer = bomItems.Count
    Dim currentPart As Integer = 0
    Dim sw As Stopwatch = Stopwatch.StartNew()

    For Each item As PartBomItem In bomItems
        CheckCancel(progressForm)
        currentPart += 1
        item.SelectedPropertyValues.Clear()

        If item.Document IsNot Nothing Then
            ReadSelectedPropertiesForDocument(item, selectedProperties)
        End If

        If currentPart Mod 10 = 0 OrElse currentPart = totalParts Then
            Dim percent As Integer = 55
            If totalParts > 0 Then
                percent = 55 + CInt((CDbl(currentPart) / CDbl(totalParts)) * 19)
            End If
            progressForm.SetProgress( _
                Math.Min(percent, 74), _
                "Đang đọc thông tin đã chọn..." & vbCrLf & _
                currentPart.ToString() & " / " & totalParts.ToString() & " Part" & vbCrLf & _
                "Số cột đã chọn: " & selectedProperties.Count.ToString())
        End If
    Next

    BomLogger.Info("PROPERTY_READ", "Read " & totalParts.ToString() & " Part x " & selectedProperties.Count.ToString() & " columns in " & sw.ElapsedMilliseconds.ToString() & " ms")
End Sub

Sub ReadSelectedPropertiesForDocument(ByVal item As PartBomItem, ByVal selectedProperties As List(Of PropertyColumnInfo))
    If item Is Nothing OrElse item.Document Is Nothing OrElse selectedProperties Is Nothing Then Exit Sub

    Dim localWatch As Stopwatch = Stopwatch.StartNew()
    BomPerformanceCounters.DocumentAccess += 1
    Dim setCache As New Dictionary(Of String, Inventor.PropertySet)(StringComparer.OrdinalIgnoreCase)
    Try
        For Each info As PropertyColumnInfo In selectedProperties
            BomPerformanceCounters.PropertyRead += 1
            Dim value As Object = ""
            If info IsNot Nothing AndAlso info.IsSystemSetting Then
                value = ReadSystemSettingValue(item.Document, info)
                item.SelectedPropertyValues(info.Key) = value
                Continue For
            End If
            Try
                Dim setObj As Inventor.PropertySet = Nothing
                If Not setCache.TryGetValue(info.PropertySetInternalName, setObj) Then
                    setObj = item.Document.PropertySets.Item(info.PropertySetInternalName)
                    setCache(info.PropertySetInternalName) = setObj
                End If
                Dim prop As Inventor.Property = setObj.Item(info.PropertyName)
                If prop IsNot Nothing AndAlso prop.Value IsNot Nothing Then value = prop.Value
            Catch ex As Exception
                BomLogger.Warn("PROPERTY_READ", info.PropertyName & ": " & ex.Message, item)
                value = ""
            End Try
            item.SelectedPropertyValues(info.Key) = value
        Next
    Finally
        setCache.Clear()
        localWatch.Stop()
        BomPerformanceCounters.PropertyReadMs += localWatch.ElapsedMilliseconds
    End Try
End Sub

'====================================================================
' ĐỌC MỘT PROPERTY ĐÃ CHỌN
'====================================================================
Public Shared Function ReadSingleSelectedProperty( _
    ByVal oDoc As Inventor.Document, _
    ByVal propertyInfo As PropertyColumnInfo) As Object

    If oDoc Is Nothing OrElse propertyInfo Is Nothing Then Return ""
    If propertyInfo.IsSystemSetting Then Return ReadSystemSettingValue(oDoc, propertyInfo)

    Try
        Dim propertySet As Inventor.PropertySet = Nothing

        Try
            propertySet = oDoc.PropertySets.Item( _
                propertyInfo.PropertySetInternalName)
        Catch
            Return ""
        End Try

        Dim inventorProperty As Inventor.Property = Nothing

        Try
            inventorProperty = propertySet.Item(propertyInfo.PropertyName)
        Catch
            Return ""
        End Try

        Return ConvertPropertyValue(inventorProperty.Value)
    Catch
        Return ""
    End Try

End Function

'====================================================================
' XUẤT EXCEL
'====================================================================

'####################################################################
' SECTION 06 - EXCEL EXPORT ENGINE
' Xuất BOM, cấu trúc Assembly, Summary và định dạng Excel.
'####################################################################

Sub ExportBomToExcel( _
    ByVal assemblyDocument As AssemblyDocument, _
    ByVal bomItems As List(Of PartBomItem), _
    ByVal selectedProperties As List(Of PropertyColumnInfo), _
    ByVal includeFileName As Boolean, _
    ByVal includeFilePath As Boolean, _
    ByVal includeParentAssembly As Boolean, _
    ByVal outputPath As String, _
    ByVal openExcelAfterExport As Boolean, _
    ByVal progressForm As BomProgressForm)

    Dim excelApplication As Object = Nothing
    Dim workbook As Object = Nothing
    Dim worksheet As Object = Nothing
    Dim tableRange As Object = Nothing
    Dim listObject As Object = Nothing
    Dim excelWasVisible As Boolean = False

    Try
        CheckCancel(progressForm)

        progressForm.SetProgress(78, "Đang khởi động Microsoft Excel...")

        Try
            excelApplication = CreateObject("Excel.Application")
        Catch
            Throw New Exception( _
                "Không khởi động được Microsoft Excel." & vbCrLf & _
                "Hãy kiểm tra Excel đã được cài trên máy.")
        End Try

        excelApplication.DisplayAlerts = False
        excelApplication.ScreenUpdating = False
        excelApplication.EnableEvents = False
        excelApplication.Visible = False

        workbook = excelApplication.Workbooks.Add()
        worksheet = workbook.Worksheets(1)
        worksheet.Name = "THEO PART"
        'Bảo đảm Workbook chỉ còn Sheet THEO PART trước khi tạo Sheet THEO ASSEMBLY.
        While workbook.Worksheets.Count > 1
            workbook.Worksheets(workbook.Worksheets.Count).Delete()
        End While

        progressForm.SetProgress(82, "Đang tạo cấu trúc bảng Excel...")
        CheckCancel(progressForm)

        Dim totalColumns As Integer = 6
        If includeFileName Then totalColumns += 1
        If includeFilePath Then totalColumns += 1
        If includeParentAssembly Then totalColumns += 1
        totalColumns += selectedProperties.Count

        Dim titleRow As Integer = 1
        Dim infoRow As Integer = 2
        Dim headerRow As Integer = 4
        Dim firstDataRow As Integer = 5
        Dim lastDataRow As Integer = firstDataRow + bomItems.Count - 1
        Dim lastColumnLetter As String = ExcelColumnLetter(totalColumns)

        Dim titleRange As Object = worksheet.Range( _
            "A" & titleRow.ToString(), _
            lastColumnLetter & titleRow.ToString())

        titleRange.Merge()
        titleRange.Value = "BOM THEO PART"
        titleRange.Font.Bold = True
        titleRange.Font.Size = 16
        titleRange.HorizontalAlignment = -4108
        titleRange.VerticalAlignment = -4108
        titleRange.RowHeight = 28

        Dim infoRange As Object = worksheet.Range( _
            "A" & infoRow.ToString(), _
            lastColumnLetter & infoRow.ToString())

        infoRange.Merge()
        infoRange.Value = _
            "Assembly: " & GetDocumentPartNumberOrFileName(assemblyDocument) & _
            "    |    Exported: " & DateTime.Now.ToString("dd/MM/yyyy HH:mm") & _
            "    |    Unique parts: " & bomItems.Count.ToString()

        infoRange.Font.Size = 10
        infoRange.Font.Italic = True
        infoRange.HorizontalAlignment = -4108
        infoRange.VerticalAlignment = -4108
        infoRange.RowHeight = 20

        '==============================================================
        ' TẠO MẢNG DATA .NET - KHÔNG GỌI LẠI INVENTOR API
        '==============================================================
        Dim dataRowCount As Integer = bomItems.Count + 1
        Dim dataArray(dataRowCount - 1, totalColumns - 1) As Object
        Dim currentColumn As Integer = 0

        dataArray(0, currentColumn) = "ITEM"
        currentColumn += 1

        dataArray(0, currentColumn) = "QTY"
        currentColumn += 1
        dataArray(0, currentColumn) = "DẠNG CHI TIẾT"
        currentColumn += 1
        dataArray(0, currentColumn) = "THICK (" & BomUnitManager.LengthUnit & ")"
        currentColumn += 1
        dataArray(0, currentColumn) = "NGUỒN THICK"
        currentColumn += 1
        dataArray(0, currentColumn) = "BOUNDING BOX L x W x H (" & BomUnitManager.LengthUnit & ")"
        currentColumn += 1

        If includeFileName Then
            dataArray(0, currentColumn) = "FILE NAME"
            currentColumn += 1
        End If

        If includeFilePath Then
            dataArray(0, currentColumn) = "FILE PATH"
            currentColumn += 1
        End If

        If includeParentAssembly Then
            dataArray(0, currentColumn) = "NẰM TRONG ASSEMBLY"
            currentColumn += 1
        End If

        For Each propertyInfo As PropertyColumnInfo In selectedProperties
            dataArray(0, currentColumn) = _
                BomUnitManager.GetPropertyHeader(propertyInfo.PropertyName)
            currentColumn += 1
        Next

        progressForm.SetProgress(86, "Đang tạo dữ liệu BOM trong bộ nhớ...")

        For rowIndex As Integer = 0 To bomItems.Count - 1
            CheckCancel(progressForm)

            Dim item As PartBomItem = bomItems(rowIndex)
            'Export profile hiện có chứa Geometry/Thickness/BoundingBox => load đúng lúc export cần.
            BomGeometryEngine.EnsureLoaded(item)
            currentColumn = 0

            dataArray(rowIndex + 1, currentColumn) = rowIndex + 1
            currentColumn += 1

            dataArray(rowIndex + 1, currentColumn) = item.Quantity
            currentColumn += 1
            dataArray(rowIndex + 1, currentColumn) = item.GeometryType
            currentColumn += 1
            dataArray(rowIndex + 1, currentColumn) = BomUnitManager.ConvertLengthFromMm(item.Thickness)
            currentColumn += 1
            dataArray(rowIndex + 1, currentColumn) = item.ThicknessSource
            currentColumn += 1
            dataArray(rowIndex + 1, currentColumn) = BomUnitManager.FormatBoundingBox(item)
            currentColumn += 1

            If includeFileName Then
                dataArray(rowIndex + 1, currentColumn) = item.FileName
                currentColumn += 1
            End If

            If includeFilePath Then
                dataArray(rowIndex + 1, currentColumn) = item.FilePath
                currentColumn += 1
            End If

            If includeParentAssembly Then
                dataArray(rowIndex + 1, currentColumn) = item.GetParentAssemblyText()
                currentColumn += 1
            End If

            For Each propertyInfo As PropertyColumnInfo In selectedProperties
                Dim valueToExport As Object = ""

                valueToExport = BomUnitManager.GetPropertyDisplayValue(item, propertyInfo)

                dataArray(rowIndex + 1, currentColumn) = valueToExport
                currentColumn += 1
            Next

            If rowIndex Mod 100 = 0 Then
                progressForm.SetStatus( _
                    "Đang tạo dữ liệu BOM trong bộ nhớ..." & vbCrLf & _
                    (rowIndex + 1).ToString() & " / " & bomItems.Count.ToString() & " dòng")
            End If
        Next

        progressForm.SetProgress(90, "Đang ghi toàn bộ dữ liệu vào Excel...")
        CheckCancel(progressForm)

        tableRange = worksheet.Range( _
            "A" & headerRow.ToString(), _
            lastColumnLetter & lastDataRow.ToString())

        'QUAN TRỌNG:
        'Định dạng toàn bộ vùng thành Text TRƯỚC KHI ghi dữ liệu.
        'Nhờ vậy các mã như 7-140, 22-7, 29-7... không bị Excel
        'tự động chuyển thành ngày tháng.
        tableRange.NumberFormat = "@"

        tableRange.Value2 = dataArray

        'Giữ nguyên tất cả các cột ở dạng Text.
        'Không chuyển riêng ITEM, QTY hoặc bất kỳ cột nào sang Number/Date.

        progressForm.SetProgress(93, "Đang định dạng bảng Excel...")

        worksheet.Cells.Font.Name = "Arial"
        worksheet.Cells.Font.Size = 10
        worksheet.Cells.VerticalAlignment = -4108

        Dim headerRange As Object = worksheet.Range( _
            "A" & headerRow.ToString(), _
            lastColumnLetter & headerRow.ToString())

        headerRange.Font.Bold = True
        headerRange.Font.Size = 10
        headerRange.HorizontalAlignment = -4108
        headerRange.VerticalAlignment = -4108
        headerRange.WrapText = True
        headerRange.RowHeight = 30
        headerRange.Interior.Color = RGBValue(31, 78, 121)
        headerRange.Font.Color = RGBValue(255, 255, 255)

        tableRange.Borders.LineStyle = 1
        tableRange.Borders.Weight = 2

        'FAST MODE: AutoFilter nhanh hơn ListObject/Table Style đáng kể.
        Try
            headerRange.AutoFilter()
        Catch
        End Try

        worksheet.Columns(1).HorizontalAlignment = -4108
        worksheet.Columns(2).HorizontalAlignment = -4108
        worksheet.Columns(1).ColumnWidth = 8
        worksheet.Columns(2).ColumnWidth = 8
        worksheet.Columns(3).ColumnWidth = 18
        worksheet.Columns(4).ColumnWidth = 12
        worksheet.Columns(5).ColumnWidth = 16
        worksheet.Columns(6).ColumnWidth = 30

        Dim excelColumnIndex As Integer = 7

        If includeFileName Then
            worksheet.Columns(excelColumnIndex).HorizontalAlignment = -4131
            worksheet.Columns(excelColumnIndex).ColumnWidth = 28
            excelColumnIndex += 1
        End If

        If includeFilePath Then
            worksheet.Columns(excelColumnIndex).HorizontalAlignment = -4131
            worksheet.Columns(excelColumnIndex).ColumnWidth = 55
            excelColumnIndex += 1
        End If

        If includeParentAssembly Then
            worksheet.Columns(excelColumnIndex).HorizontalAlignment = -4131
            worksheet.Columns(excelColumnIndex).ColumnWidth = 32
            worksheet.Columns(excelColumnIndex).WrapText = True
            excelColumnIndex += 1
        End If

        For Each propertyInfo As PropertyColumnInfo In selectedProperties
            Dim propertyColumn As Object = worksheet.Columns(excelColumnIndex)
            propertyColumn.HorizontalAlignment = _
                GetPropertyHorizontalAlignment(propertyInfo.PropertyName)
            propertyColumn.ColumnWidth = _
                GetRecommendedColumnWidth(propertyInfo.PropertyName)
            propertyColumn.WrapText = _
                ShouldWrapProperty(propertyInfo.PropertyName)
            excelColumnIndex += 1
        Next

        For columnIndex As Integer = 1 To totalColumns
            Dim currentWidth As Double = 15

            Try
                currentWidth = CDbl(worksheet.Columns(columnIndex).ColumnWidth)
            Catch
            End Try

            If currentWidth < 8 Then
                worksheet.Columns(columnIndex).ColumnWidth = 8
            ElseIf currentWidth > 55 Then
                worksheet.Columns(columnIndex).ColumnWidth = 55
            End If
        Next

        Dim dataRange As Object = worksheet.Range( _
            "A" & firstDataRow.ToString(), _
            lastColumnLetter & lastDataRow.ToString())

        dataRange.VerticalAlignment = -4108

        'Không AutoFit/lặp từng dòng qua COM. Đặt chiều cao cả vùng một lần.
        Try
            dataRange.RowHeight = 20
        Catch
        End Try

        worksheet.Activate()
        excelApplication.ActiveWindow.SplitColumn = 0
        excelApplication.ActiveWindow.SplitRow = 4
        excelApplication.ActiveWindow.FreezePanes = True

        'Bỏ PageSetup/Select trong chế độ nhanh để giảm COM call.
        WriteAssemblyHierarchySheet(workbook, bomItems, selectedProperties, includeFileName, includeFilePath)

        progressForm.SetProgress(97, _
            "Đang lưu file Excel..." & vbCrLf & outputPath)
        CheckCancel(progressForm)

        workbook.SaveAs(outputPath, 51)

        If openExcelAfterExport Then
            excelApplication.ScreenUpdating = True
            excelApplication.EnableEvents = True
            excelApplication.DisplayAlerts = True
            excelApplication.Visible = True
            excelWasVisible = True
        Else
            workbook.Close(False)
            excelApplication.Quit()
        End If

    Catch
        If workbook IsNot Nothing Then
            Try
                workbook.Close(False)
            Catch
            End Try
        End If

        If excelApplication IsNot Nothing Then
            Try
                excelApplication.Quit()
            Catch
            End Try
        End If

        Throw

    Finally
        ReleaseComObject(listObject)
        ReleaseComObject(tableRange)
        ReleaseComObject(worksheet)
        ReleaseComObject(workbook)
        ReleaseComObject(excelApplication)

        'Không cưỡng bức GC nhiều lần vì làm UI khựng.
        GC.Collect(0)
    End Try

End Sub

Sub WriteAssemblyHierarchySheet( _
    ByVal workbook As Object, _
    ByVal bomItems As List(Of PartBomItem), _
    ByVal selectedProperties As List(Of PropertyColumnInfo), _
    ByVal includeFileName As Boolean, _
    ByVal includeFilePath As Boolean)

    Dim sheet As Object = Nothing
    Dim usedRange As Object = Nothing

    Try
        sheet = workbook.Worksheets.Add(Nothing, workbook.Worksheets(workbook.Worksheets.Count))
        sheet.Name = "THEO ASSEMBLY"

        'Dựng cây từ đường dẫn đã Cache trong lần quét Inventor đầu tiên.
        'Không gọi lại Inventor API khi xuất Excel.
        Dim root As New AssemblyExportNode("", "")
        For Each item As PartBomItem In bomItems
            If item Is Nothing Then Continue For
            Dim paths As List(Of String) = item.GetAssemblyPaths()
            If paths.Count = 0 Then
                Dim fallbackParents As List(Of String) = item.GetParentAssemblies()
                For Each parentName As String In fallbackParents
                    If Not String.IsNullOrWhiteSpace(parentName) Then
                        root.AddPartByPath(parentName, item, item.GetQuantityForParent(parentName))
                    End If
                Next
            Else
                For Each assemblyPath As String In paths
                    root.AddPartByPath(assemblyPath, item, item.GetQuantityForAssemblyPath(assemblyPath))
                Next
            End If
        Next

        Dim totalColumns As Integer = 8 + selectedProperties.Count
        If includeFileName Then totalColumns += 1
        If includeFilePath Then totalColumns += 1
        Dim lastColumnLetter As String = ExcelColumnLetter(totalColumns)

        Dim rows As New List(Of Object())()
        Dim rowTypes As New List(Of Integer)() '0 title/info, 1 assembly, 2 header, 3 part
        Dim rowLevels As New List(Of Integer)()

        Dim title(totalColumns - 1) As Object
        title(0) = "BOM THEO ASSEMBLY - CẤU TRÚC MẸ / CON"
        rows.Add(title) : rowTypes.Add(0) : rowLevels.Add(0)

        Dim info(totalColumns - 1) As Object
        info(0) = "Assembly nguồn: " & GetDocumentPartNumberOrFileName(CType(ThisApplication.ActiveDocument, Inventor.Document)) & " | Xuất: " & DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        rows.Add(info) : rowTypes.Add(0) : rowLevels.Add(0)

        Dim blank(totalColumns - 1) As Object
        rows.Add(blank) : rowTypes.Add(0) : rowLevels.Add(0)

        Dim roots As List(Of AssemblyExportNode) = root.GetSortedChildren()
        For Each rootNode As AssemblyExportNode In roots
            AppendAssemblyExportRows(rootNode, 0, rows, rowTypes, rowLevels, totalColumns, selectedProperties, includeFileName, includeFilePath)
        Next

        If rows.Count = 3 Then
            Dim emptyRow(totalColumns - 1) As Object
            emptyRow(0) = "Không có dữ liệu Assembly để xuất."
            rows.Add(emptyRow) : rowTypes.Add(0) : rowLevels.Add(0)
        End If

        Dim values(rows.Count - 1, totalColumns - 1) As Object
        For rowIndex As Integer = 0 To rows.Count - 1
            Dim sourceRow() As Object = rows(rowIndex)
            For colIndex As Integer = 0 To totalColumns - 1
                values(rowIndex, colIndex) = sourceRow(colIndex)
            Next
        Next

        usedRange = sheet.Range("A1", lastColumnLetter & rows.Count.ToString())
        usedRange.NumberFormat = "@"
        usedRange.Value2 = values

        sheet.Cells.Font.Name = "Arial"
        sheet.Cells.Font.Size = 10
        sheet.Cells.VerticalAlignment = -4108
        sheet.Columns(1).ColumnWidth = 8
        sheet.Columns(2).ColumnWidth = 10
        sheet.Columns(3).ColumnWidth = 14
        sheet.Columns(4).ColumnWidth = 24
        sheet.Columns(5).ColumnWidth = 34
        sheet.Columns(6).ColumnWidth = 22
        sheet.Columns(7).ColumnWidth = 12
        sheet.Columns(8).ColumnWidth = 28

        sheet.Range("A1", lastColumnLetter & "1").Merge()
        sheet.Range("A1").Font.Bold = True
        sheet.Range("A1").Font.Size = 16
        sheet.Range("A1").HorizontalAlignment = -4108
        sheet.Range("A2", lastColumnLetter & "2").Merge()
        sheet.Range("A2").Font.Italic = True

        'Định dạng theo metadata đã dựng trong RAM; không lặp quét Part theo Assembly.
        For i As Integer = 3 To rows.Count - 1
            Dim excelRow As Integer = i + 1
            Select Case rowTypes(i)
                Case 1 'Assembly
                    With sheet.Range("A" & excelRow.ToString(), lastColumnLetter & excelRow.ToString())
                        .Font.Bold = True
                        .Interior.Color = RGBValue(65, 120, 145)
                        .Font.Color = RGBValue(255, 255, 255)
                    End With
                    Try
                        sheet.Rows(excelRow).OutlineLevel = Math.Min(8, rowLevels(i) + 1)
                    Catch
                    End Try
                Case 2 'Header
                    With sheet.Range("A" & excelRow.ToString(), lastColumnLetter & excelRow.ToString())
                        .Font.Bold = True
                        .Interior.Color = RGBValue(210, 230, 238)
                    End With
                    Try
                        sheet.Rows(excelRow).OutlineLevel = Math.Min(8, rowLevels(i) + 1)
                    Catch
                    End Try
                Case 3 'Part
                    Try
                        sheet.Rows(excelRow).OutlineLevel = Math.Min(8, rowLevels(i) + 1)
                    Catch
                    End Try
            End Select
        Next

        usedRange.Borders.LineStyle = 1
        usedRange.Borders.Weight = 2
        sheet.Outline.SummaryRow = 0
        sheet.Activate()
        workbook.Application.ActiveWindow.SplitRow = 3
        workbook.Application.ActiveWindow.FreezePanes = True

    Catch
        'Không làm hỏng sheet THEO PART nếu sheet Assembly gặp lỗi định dạng.
    Finally
        ReleaseComObject(usedRange)
        ReleaseComObject(sheet)
    End Try
End Sub

Sub AppendAssemblyExportRows( _
    ByVal node As AssemblyExportNode, _
    ByVal level As Integer, _
    ByVal rows As List(Of Object()), _
    ByVal rowTypes As List(Of Integer), _
    ByVal rowLevels As List(Of Integer), _
    ByVal totalColumns As Integer, _
    ByVal selectedProperties As List(Of PropertyColumnInfo), _
    ByVal includeFileName As Boolean, _
    ByVal includeFilePath As Boolean)

    If node Is Nothing Then Exit Sub

    Dim assemblyRow(totalColumns - 1) As Object
    assemblyRow(0) = New String(" "c, level * 4) & "▼ ASSEMBLY: " & node.Name
    assemblyRow(1) = "LEVEL " & level.ToString()
    assemblyRow(2) = "PART TYPES: " & node.GetRecursiveUniquePartCount().ToString()
    assemblyRow(3) = "TOTAL QTY: " & node.GetRecursiveQuantity().ToString()
    assemblyRow(4) = "PATH: " & node.FullPath
    rows.Add(assemblyRow) : rowTypes.Add(1) : rowLevels.Add(level)

    If node.DirectParts.Count > 0 Then
        Dim header(totalColumns - 1) As Object
        Dim c As Integer = 0
        header(c) = "LEVEL" : c += 1
        header(c) = "ITEM" : c += 1
        header(c) = "QTY" : c += 1
        header(c) = "PART NUMBER" : c += 1
        header(c) = "DESCRIPTION" : c += 1
        header(c) = "MATERIAL" : c += 1
        header(c) = "THICK (" & BomUnitManager.LengthUnit & ")" : c += 1
        header(c) = "BOUNDING BOX (" & BomUnitManager.LengthUnit & ")" : c += 1
        If includeFileName Then header(c) = "FILE NAME" : c += 1
        If includeFilePath Then header(c) = "FILE PATH" : c += 1
        For Each pi As PropertyColumnInfo In selectedProperties
            header(c) = BomUnitManager.GetPropertyHeader(pi.PropertyName) : c += 1
        Next
        rows.Add(header) : rowTypes.Add(2) : rowLevels.Add(level + 1)

        Dim sortedParts As List(Of AssemblyExportPart) = node.GetSortedDirectParts()
        Dim itemNo As Integer = 1
        For Each partEntry As AssemblyExportPart In sortedParts
            Dim item As PartBomItem = partEntry.Item
            Dim partRow(totalColumns - 1) As Object
            c = 0
            partRow(c) = level + 1 : c += 1
            partRow(c) = itemNo : c += 1
            partRow(c) = partEntry.Quantity : c += 1
            partRow(c) = item.PartNumber : c += 1
            partRow(c) = item.Description : c += 1
            partRow(c) = item.Material : c += 1
            partRow(c) = BomUnitManager.ConvertLengthFromMm(item.Thickness) : c += 1
            partRow(c) = BomUnitManager.FormatBoundingBox(item) : c += 1
            If includeFileName Then partRow(c) = item.FileName : c += 1
            If includeFilePath Then partRow(c) = item.FilePath : c += 1
            For Each pi As PropertyColumnInfo In selectedProperties
                partRow(c) = BomUnitManager.GetPropertyDisplayValue(item, pi) : c += 1
            Next
            rows.Add(partRow) : rowTypes.Add(3) : rowLevels.Add(level + 1)
            itemNo += 1
        Next
    End If

    For Each child As AssemblyExportNode In node.GetSortedChildren()
        AppendAssemblyExportRows(child, level + 1, rows, rowTypes, rowLevels, totalColumns, selectedProperties, includeFileName, includeFilePath)
    Next
End Sub


'####################################################################
' SECTION 07 - ASSEMBLY EXPORT DATA MODELS
' Mô hình cây Assembly và Part dùng riêng cho xuất Excel cha-con.
'####################################################################

Public Class AssemblyExportPart
    Public Item As PartBomItem
    Public Quantity As Integer
End Class

Public Class AssemblyExportNode
    Public Name As String
    Public FullPath As String
    Public Children As New Dictionary(Of String, AssemblyExportNode)(StringComparer.OrdinalIgnoreCase)
    Public DirectParts As New Dictionary(Of String, AssemblyExportPart)(StringComparer.OrdinalIgnoreCase)

    Public Sub New(ByVal nodeName As String, ByVal nodePath As String)
        Name = If(nodeName, "")
        FullPath = If(nodePath, "")
    End Sub

    Public Sub AddPartByPath(ByVal assemblyPath As String, ByVal item As PartBomItem, ByVal quantity As Integer)
        If item Is Nothing OrElse String.IsNullOrWhiteSpace(assemblyPath) Then Exit Sub
        Dim parts() As String = assemblyPath.Trim().Trim("\"c).Split("\"c)
        Dim current As AssemblyExportNode = Me
        Dim pathBuilder As String = ""
        For Each rawName As String In parts
            Dim cleanName As String = rawName.Trim()
            If cleanName.Length = 0 Then Continue For
            If pathBuilder.Length = 0 Then pathBuilder = cleanName Else pathBuilder &= "\" & cleanName
            Dim child As AssemblyExportNode = Nothing
            If Not current.Children.TryGetValue(cleanName, child) Then
                child = New AssemblyExportNode(cleanName, pathBuilder)
                current.Children.Add(cleanName, child)
            End If
            current = child
        Next
        current.AddDirectPart(item, quantity)
    End Sub

    Private Sub AddDirectPart(ByVal item As PartBomItem, ByVal quantity As Integer)
        Dim key As String = item.DocumentKey
        If String.IsNullOrWhiteSpace(key) Then key = item.PartNumber & "|" & item.FileName
        Dim entry As AssemblyExportPart = Nothing
        If DirectParts.TryGetValue(key, entry) Then
            entry.Quantity += Math.Max(0, quantity)
        Else
            entry = New AssemblyExportPart()
            entry.Item = item
            entry.Quantity = Math.Max(0, quantity)
            DirectParts.Add(key, entry)
        End If
    End Sub

    Public Function GetSortedChildren() As List(Of AssemblyExportNode)
        Dim result As New List(Of AssemblyExportNode)(Children.Values)
        result.Sort(Function(a As AssemblyExportNode, b As AssemblyExportNode) StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name))
        Return result
    End Function

    Public Function GetSortedDirectParts() As List(Of AssemblyExportPart)
        Dim result As New List(Of AssemblyExportPart)(DirectParts.Values)
        result.Sort(Function(a As AssemblyExportPart, b As AssemblyExportPart) StringComparer.OrdinalIgnoreCase.Compare(a.Item.PartNumber, b.Item.PartNumber))
        Return result
    End Function

    Public Function GetRecursiveQuantity() As Integer
        Dim total As Integer = 0
        For Each entry As AssemblyExportPart In DirectParts.Values
            total += Math.Max(0, entry.Quantity)
        Next
        For Each child As AssemblyExportNode In Children.Values
            total += child.GetRecursiveQuantity()
        Next
        Return total
    End Function

    Public Function GetRecursiveUniquePartCount() As Integer
        Dim keys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        CollectPartKeys(keys)
        Return keys.Count
    End Function

    Private Sub CollectPartKeys(ByVal keys As HashSet(Of String))
        For Each key As String In DirectParts.Keys
            keys.Add(key)
        Next
        For Each child As AssemblyExportNode In Children.Values
            child.CollectPartKeys(keys)
        Next
    End Sub
End Class

'====================================================================
' HỖ TRỢ PROPERTY
'====================================================================
Public Shared Function ConvertPropertyValue(ByVal rawValue As Object) As Object
    If rawValue Is Nothing Then Return ""

    Try
        If TypeOf rawValue Is DateTime Then
            Return CType(rawValue, DateTime).ToString("dd/MM/yyyy")
        ElseIf TypeOf rawValue Is Boolean Then
            If CBool(rawValue) Then Return "Yes" Else Return "No"
        ElseIf TypeOf rawValue Is Byte() Then
            Return ""
        ElseIf Marshal.IsComObject(rawValue) Then
            Return ""
        Else
            Return Convert.ToString(rawValue)
        End If
    Catch
        Return ""
    End Try
End Function

Public Shared Function GetDocumentPartNumberOrFileName( _
    ByVal oDoc As Inventor.Document) As String

    If oDoc Is Nothing Then Return ""

    Dim partNumber As String = ""

    Try
        Dim designTrackingSet As PropertySet = _
            oDoc.PropertySets.Item( _
                "{32853F0F-3444-11D1-9E93-0060B03C1CA6}")

        Dim partNumberProperty As Inventor.Property = _
            designTrackingSet.Item("Part Number")

        partNumber = Convert.ToString(partNumberProperty.Value).Trim()
    Catch
        partNumber = ""
    End Try

    If Not String.IsNullOrWhiteSpace(partNumber) Then Return partNumber

    Dim safeName As String = GetSafeFileName(oDoc)

    Try
        Return IOPath.GetFileNameWithoutExtension(safeName)
    Catch
        Return safeName
    End Try
End Function

Public Shared Function GetSafeFileName(ByVal oDoc As Inventor.Document) As String
    If oDoc Is Nothing Then Return ""

    Try
        If Not String.IsNullOrWhiteSpace(oDoc.FullFileName) Then
            Return IOPath.GetFileName(oDoc.FullFileName)
        End If
    Catch
    End Try

    Try
        Return oDoc.DisplayName
    Catch
        Return ""
    End Try
End Function


'####################################################################
' SECTION 08 - COMMON UTILITIES / FORMAT / COM RELEASE
' Hàm dùng chung: đường dẫn, căn lề, màu, định dạng và giải phóng COM.
'####################################################################

Function GetSafeFullFileName(ByVal oDoc As Inventor.Document) As String
    If oDoc Is Nothing Then Return ""

    Try
        Return oDoc.FullFileName
    Catch
        Return ""
    End Try
End Function

Public Shared Function BuildPropertyKey( _
    ByVal setInternalName As String, _
    ByVal propertyName As String) As String

    Return If(setInternalName, "").Trim() & "||" & _
           If(propertyName, "").Trim()
End Function

Public Shared Function BuildPropertyDisplayText( _
    ByVal setDisplayName As String, _
    ByVal propertyName As String) As String

    If String.IsNullOrWhiteSpace(setDisplayName) Then Return propertyName
    Return propertyName & "    [" & setDisplayName & "]"
End Function

Public Shared Function ShouldSkipPropertySet( _
    ByVal setDisplayName As String, _
    ByVal setInternalName As String) As Boolean

    Dim displayUpper As String = _
        If(setDisplayName, "").Trim().ToUpperInvariant()

    If displayUpper.Contains("PRIVATE") Then Return True
    If displayUpper.Contains("THUMBNAIL") Then Return True
    Return False
End Function

Public Shared Function IsDefaultProperty(ByVal propertyName As String) As Boolean
    Select Case If(propertyName, "").Trim().ToUpperInvariant()
        Case "PART NUMBER", _
             "DESCRIPTION", _
             "MATERIAL", _
             "STOCK NUMBER", _
             "REVISION NUMBER"
            Return True
    End Select

    Return False
End Function

Public Shared Function CompareBomItems( _
    ByVal firstItem As PartBomItem, _
    ByVal secondItem As PartBomItem) As Integer

    Dim firstText As String = ""
    Dim secondText As String = ""

    If firstItem IsNot Nothing Then firstText = firstItem.PartNumber
    If secondItem IsNot Nothing Then secondText = secondItem.PartNumber

    Return String.Compare( _
        firstText, _
        secondText, _
        StringComparison.OrdinalIgnoreCase)
End Function

Public Shared Function ComparePropertyColumns( _
    ByVal firstProperty As PropertyColumnInfo, _
    ByVal secondProperty As PropertyColumnInfo) As Integer

    If firstProperty Is Nothing AndAlso secondProperty Is Nothing Then Return 0
    If firstProperty Is Nothing Then Return 1
    If secondProperty Is Nothing Then Return -1

    Dim firstPriority As Integer = _
        GetPropertyPriority(firstProperty.PropertyName)

    Dim secondPriority As Integer = _
        GetPropertyPriority(secondProperty.PropertyName)

    If firstPriority <> secondPriority Then
        Return firstPriority.CompareTo(secondPriority)
    End If

    Return String.Compare( _
        firstProperty.DisplayText, _
        secondProperty.DisplayText, _
        StringComparison.OrdinalIgnoreCase)
End Function

Public Shared Function GetPropertyPriority(ByVal propertyName As String) As Integer
    Select Case If(propertyName, "").Trim().ToUpperInvariant()
        Case "PART NUMBER" : Return 1
        Case "DESCRIPTION" : Return 2
        Case "MATERIAL" : Return 3
        Case "STOCK NUMBER" : Return 4
        Case "REVISION NUMBER" : Return 5
        Case Else : Return 100
    End Select
End Function

Public Shared Function GetRecommendedColumnWidth(ByVal propertyName As String) As Double
    Dim upperName As String = _
        If(propertyName, "").Trim().ToUpperInvariant()

    If upperName.Contains("DESCRIPTION") Then Return 38
    If upperName.Contains("PART NUMBER") Then Return 22
    If upperName.Contains("MATERIAL") Then Return 20

    If upperName.Contains("COMMENT") OrElse _
       upperName.Contains("NOTE") OrElse _
       upperName.Contains("GHI CHÚ") Then
        Return 32
    End If

    If upperName.Contains("DATE") Then Return 16
    If upperName.Contains("REVISION") Then Return 12

    If upperName.Contains("NUMBER") OrElse _
       upperName.Contains("CODE") Then
        Return 18
    End If

    Return 20
End Function

Function GetPropertyHorizontalAlignment(ByVal propertyName As String) As Integer
    Dim upperName As String = _
        If(propertyName, "").Trim().ToUpperInvariant()

    If upperName.Contains("DESCRIPTION") OrElse _
       upperName.Contains("COMMENT") OrElse _
       upperName.Contains("NOTE") OrElse _
       upperName.Contains("TITLE") OrElse _
       upperName.Contains("SUBJECT") Then
        Return -4131
    End If

    If upperName.Contains("PART NUMBER") OrElse _
       upperName.Contains("STOCK NUMBER") OrElse _
       upperName.Contains("MATERIAL") OrElse _
       upperName.Contains("REVISION") OrElse _
       upperName.Contains("CODE") Then
        Return -4108
    End If

    Return -4131
End Function

Function ShouldWrapProperty(ByVal propertyName As String) As Boolean
    Dim upperName As String = _
        If(propertyName, "").Trim().ToUpperInvariant()

    Return upperName.Contains("DESCRIPTION") OrElse _
           upperName.Contains("COMMENT") OrElse _
           upperName.Contains("NOTE") OrElse _
           upperName.Contains("TITLE") OrElse _
           upperName.Contains("SUBJECT")
End Function


Sub WriteFastSummarySheet(ByVal workbook As Object, ByVal bomItems As List(Of PartBomItem))
    If workbook Is Nothing OrElse bomItems Is Nothing Then Exit Sub
    Try
        Dim materialMap As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
        Dim vendorMap As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
        Dim revisionMap As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
        Dim totalQty As Integer = 0
        Dim totalMass As Double = 0
        For Each item As PartBomItem In bomItems
            If item Is Nothing Then Continue For
            totalQty += item.Quantity
            totalMass += item.Mass * item.Quantity
            IncrementSummary(materialMap, If(String.IsNullOrWhiteSpace(item.Material), "(EMPTY)", item.Material), item.Quantity)
            IncrementSummary(vendorMap, If(String.IsNullOrWhiteSpace(item.Vendor), "(EMPTY)", item.Vendor), item.Quantity)
            IncrementSummary(revisionMap, If(String.IsNullOrWhiteSpace(item.Revision), "(EMPTY)", item.Revision), item.Quantity)
        Next
        Dim rows As Integer = 5 + materialMap.Count + vendorMap.Count + revisionMap.Count
        Dim data(rows - 1, 2) As Object
        Dim r As Integer = 0
        data(r, 0) = "BOM SUMMARY" : r += 1
        data(r, 0) = "Unique Parts" : data(r, 1) = bomItems.Count : r += 1
        data(r, 0) = "Total Quantity" : data(r, 1) = totalQty : r += 1
        data(r, 0) = "Total Mass (" & BomUnitManager.MassUnit & ")" : data(r, 1) = BomUnitManager.ConvertMass(totalMass) : r += 1
        data(r, 0) = "MATERIAL" : data(r, 1) = "QTY" : r += 1
        For Each pair As KeyValuePair(Of String, Integer) In materialMap
            data(r, 0) = pair.Key : data(r, 1) = pair.Value : r += 1
        Next
        data(r, 0) = "VENDOR" : data(r, 1) = "QTY" : r += 1
        For Each pair As KeyValuePair(Of String, Integer) In vendorMap
            data(r, 0) = pair.Key : data(r, 1) = pair.Value : r += 1
        Next
        data(r, 0) = "REVISION" : data(r, 1) = "QTY" : r += 1
        For Each pair As KeyValuePair(Of String, Integer) In revisionMap
            data(r, 0) = pair.Key : data(r, 1) = pair.Value : r += 1
        Next
        Dim ws As Object = workbook.Worksheets.Add()
        ws.Name = "SUMMARY"
        ws.Range("A1", "C" & rows.ToString()).NumberFormat = "@"
        ws.Range("A1", "C" & rows.ToString()).Value2 = data
        ws.Columns("A:C").ColumnWidth = 24
        ws.Rows(1).Font.Bold = True
    Catch
        'Summary không được phép làm hỏng quá trình xuất BOM chính.
    End Try
End Sub

Sub IncrementSummary(ByVal map As Dictionary(Of String, Integer), ByVal key As String, ByVal quantity As Integer)
    If map.ContainsKey(key) Then map(key) += quantity Else map(key) = quantity
End Sub

Function ExcelColumnLetter(ByVal columnNumber As Integer) As String
    Dim dividend As Integer = columnNumber
    Dim columnName As String = ""

    While dividend > 0
        Dim modulo As Integer = (dividend - 1) Mod 26
        columnName = Chr(65 + modulo) & columnName
        dividend = CInt(Math.Floor(CDbl(dividend - modulo) / 26))
    End While

    Return columnName
End Function

Function RGBValue( _
    ByVal red As Integer, _
    ByVal green As Integer, _
    ByVal blue As Integer) As Integer

    Return red + (green * 256) + (blue * 65536)
End Function

Sub ReleaseComObject(ByVal comObject As Object)
    If comObject Is Nothing Then Exit Sub

    Try
        If Marshal.IsComObject(comObject) Then
            Marshal.FinalReleaseComObject(comObject)
        End If
    Catch
    End Try
End Sub

'====================================================================
' CORE CACHE - CHỈ ĐỌC INVENTOR MỘT LẦN CHO MỖI UNIQUE PART
'====================================================================

'####################################################################
' SECTION 09 - CORE DATA CACHE / GEOMETRY
' Cache dữ liệu cốt lõi, khối lượng, hình học, thickness và bounding box.
'####################################################################

Sub CacheCorePartData(ByVal item As PartBomItem)
    If item Is Nothing OrElse item.Document Is Nothing Then Exit Sub
    BomPerformanceCounters.CoreCacheCalls += 1
    BomPerformanceCounters.DocumentAccess += 1
    Dim doc As Inventor.Document = item.Document

    'PHASE 1 / PERFORMANCE CORE 2.0:
    'Core scan chỉ đọc dữ liệu BOM nhẹ. Geometry/Mass/RangeBox được tách sang BomGeometryEngine.
    item.Description = ReadPropertyByNames(doc, New String() {"Description"})
    item.Material = ReadPropertyByNames(doc, New String() {"Material"})
    item.Vendor = ReadPropertyByNames(doc, New String() {"Vendor", "Supplier"})
    item.Revision = ReadPropertyByNames(doc, New String() {"Revision Number", "Revision"})
    item.StockNumber = ReadPropertyByNames(doc, New String() {"Stock Number"})
    item.Project = ReadPropertyByNames(doc, New String() {"Project"})
    item.Category = ReadPropertyByNames(doc, New String() {"Category"})

    Try
        item.IsReadOnly = doc.FileSaveCounter < 0
    Catch
        item.IsReadOnly = False
    End Try
    Try
        item.IsUnsaved = String.IsNullOrWhiteSpace(doc.FullFileName)
    Catch
        item.IsUnsaved = True
    End Try

    'Chỉ nhận dạng Sheet Metal bằng type; không gọi MassProperties/RangeBox ở Core Scan.
    Try
        Dim pDoc As PartDocument = TryCast(doc, PartDocument)
        If pDoc IsNot Nothing AndAlso pDoc.ComponentDefinition IsNot Nothing Then
            item.IsSheetMetal = TypeOf pDoc.ComponentDefinition Is SheetMetalComponentDefinition
        End If
    Catch
        item.IsSheetMetal = False
    End Try

    Dim classificationText As String = (item.FileName & " " & item.PartNumber & " " & item.Description & " " & item.Category).ToUpperInvariant()
    item.IsPurchased = classificationText.Contains("PURCHASE") OrElse classificationText.Contains("MUA NGOÀI") OrElse classificationText.Contains("BEARING") OrElse classificationText.Contains("MOTOR")
    item.SearchBlob = (item.FileName & "|" & item.FilePath & "|" & item.PartNumber & "|" & item.Description & "|" & item.Material & "|" & item.Vendor & "|" & item.Revision & "|" & item.StockNumber & "|" & item.Project & "|" & item.Category & "|" & item.GetParentAssemblyText()).ToUpperInvariant()
    BomSignatureEngine.CaptureIntoItem(item)
End Sub

Public Class BomGeometryEngine
    Public Shared Sub EnsureLoaded(ByVal item As PartBomItem)
        If item Is Nothing Then Exit Sub
        If String.Equals(item.GeometryLoadState, "LOADED", StringComparison.OrdinalIgnoreCase) Then Exit Sub
        If String.Equals(item.GeometryLoadState, "LOADING", StringComparison.OrdinalIgnoreCase) Then Exit Sub
        item.GeometryLoadState = "LOADING"
        item.GeometryLoadError = ""
        Dim sw As Stopwatch = Stopwatch.StartNew()
        Try
            Dim pDoc As PartDocument = TryCast(item.Document, PartDocument)
            If pDoc Is Nothing OrElse pDoc.ComponentDefinition Is Nothing Then
                item.GeometryLoadState = "FAILED"
                item.GeometryLoadError = "Part document/component definition unavailable."
                Exit Sub
            End If
            Dim pDef As PartComponentDefinition = pDoc.ComponentDefinition
            item.IsSheetMetal = TypeOf pDef Is SheetMetalComponentDefinition
            Try
                Dim mp As MassProperties = pDef.MassProperties
                item.Mass = mp.Mass
                item.Volume = mp.Volume
                item.SurfaceArea = mp.Area
            Catch ex As Exception
                BomLogger.Warn("GEOMETRY_MASS", ex.Message, item)
            End Try
            Try
                Dim box As Box = pDef.RangeBox
                Dim dx As Double = Math.Abs(box.MaxPoint.X - box.MinPoint.X) * 10.0
                Dim dy As Double = Math.Abs(box.MaxPoint.Y - box.MinPoint.Y) * 10.0
                Dim dz As Double = Math.Abs(box.MaxPoint.Z - box.MinPoint.Z) * 10.0
                Dim dims As New List(Of Double)(New Double() {dx, dy, dz})
                dims.Sort()
                item.BoundingMinMm = dims(0) : item.BoundingMidMm = dims(1) : item.BoundingMaxMm = dims(2)
                item.BoundingBoxText = Math.Round(item.BoundingMaxMm, 2).ToString("0.##") & " x " & Math.Round(item.BoundingMidMm, 2).ToString("0.##") & " x " & Math.Round(item.BoundingMinMm, 2).ToString("0.##")
            Catch ex As Exception
                BomLogger.Warn("GEOMETRY_RANGEBOX", ex.Message, item)
            End Try
            If item.IsSheetMetal Then
                Try
                    Dim smDef As SheetMetalComponentDefinition = CType(pDef, SheetMetalComponentDefinition)
                    item.Thickness = smDef.Thickness.Value * 10.0
                    item.ThicknessSource = "SHEET METAL"
                    item.GeometryType = "SHEET METAL / PLATE"
                Catch ex As Exception
                    BomLogger.Warn("GEOMETRY_THICKNESS", ex.Message, item)
                End Try
            Else
                If item.BoundingMinMm > 0 AndAlso item.BoundingMidMm > 0 Then
                    Dim text As String = (item.FileName & " " & item.PartNumber & " " & item.Description & " " & item.Category).ToUpperInvariant()
                    Dim keywordPlate As Boolean = text.Contains("PLATE") OrElse text.Contains("TAM") OrElse text.Contains("TẤM") OrElse text.Contains("BASE") OrElse text.Contains("GUSSET") OrElse text.Contains("BRACKET") OrElse text.Contains("LEG") OrElse text.Contains("CHAN") OrElse text.Contains("CHÂN")
                    Dim thinRatio As Double = item.BoundingMinMm / Math.Max(item.BoundingMidMm, 0.0001)
                    If thinRatio <= 0.25 OrElse (keywordPlate AndAlso thinRatio <= 0.5) Then
                        item.Thickness = item.BoundingMinMm
                        item.ThicknessSource = "BOUNDING BOX"
                        item.GeometryType = If(keywordPlate, "PLATE / LEG", "THIN PART")
                    Else
                        item.Thickness = 0 : item.ThicknessSource = "" : item.GeometryType = "GENERAL PART"
                    End If
                Else
                    item.GeometryType = "UNKNOWN"
                End If
            End If
            item.GeometryLoadState = "LOADED"
            item.GeometryLoadedAt = DateTime.Now
        Catch ex As Exception
            item.GeometryLoadState = "FAILED"
            item.GeometryLoadError = ex.Message
            BomLogger.Warn("GEOMETRY", ex.Message, item)
        Finally
            sw.Stop()
            BomPerformanceCounters.AddGeometryLoad(sw.ElapsedMilliseconds)
        End Try
    End Sub

    Public Shared Sub Invalidate(ByVal item As PartBomItem)
        If item Is Nothing Then Exit Sub
        item.GeometryLoadState = "NOT LOADED"
        item.GeometryLoadError = ""
        item.GeometryLoadedAt = DateTime.MinValue
        item.Mass = 0 : item.Volume = 0 : item.SurfaceArea = 0
        item.Thickness = 0 : item.ThicknessSource = "" : item.GeometryType = ""
        item.BoundingMinMm = 0 : item.BoundingMidMm = 0 : item.BoundingMaxMm = 0 : item.BoundingBoxText = ""
    End Sub
End Class

Public Class BomPerformanceCounters
    Public Shared GeometryLoads As Integer = 0
    Public Shared GeometryMs As Long = 0
    Public Shared DocumentAccess As Long = 0
    Public Shared PropertyRead As Long = 0
    Public Shared OccurrenceTraversal As Long = 0
    Public Shared SignatureChecks As Long = 0
    Public Shared DrawingSearch As Long = 0
    Public Shared GridRefresh As Long = 0
    Public Shared CoreCacheCalls As Long = 0
    Public Shared PropertyReadMs As Long = 0
    Public Shared DrawingIndexMs As Long = 0
    Public Shared GridBuildMs As Long = 0
    Public Shared InitialLoadMs As Long = 0

    Public Shared Sub AddGeometryLoad(ByVal elapsedMs As Long)
        GeometryLoads += 1
        GeometryMs += Math.Max(0, elapsedMs)
    End Sub

    Public Shared Sub Reset()
        GeometryLoads = 0 : GeometryMs = 0
        DocumentAccess = 0 : PropertyRead = 0 : OccurrenceTraversal = 0
        SignatureChecks = 0 : DrawingSearch = 0 : GridRefresh = 0
        CoreCacheCalls = 0 : PropertyReadMs = 0 : DrawingIndexMs = 0 : GridBuildMs = 0
        InitialLoadMs = 0
    End Sub
End Class

Public Class BomMemorySnapshot
    Public ManagedBytes As Long
    Public WorkingSetBytes As Long
    Public CachedItems As Integer
    Public CachedOccurrences As Integer
    Public CachedGeometry As Integer
    Public CachedThumbnails As Integer

    Public Shared Function Capture(ByVal items As List(Of PartBomItem), ByVal occurrenceCount As Integer, ByVal thumbnailCount As Integer) As BomMemorySnapshot
        Dim s As New BomMemorySnapshot()
        Try : s.ManagedBytes = GC.GetTotalMemory(False) : Catch : End Try
        Try : s.WorkingSetBytes = Process.GetCurrentProcess().WorkingSet64 : Catch : End Try
        s.CachedItems = If(items Is Nothing, 0, items.Count)
        s.CachedOccurrences = Math.Max(0, occurrenceCount)
        s.CachedThumbnails = Math.Max(0, thumbnailCount)
        If items IsNot Nothing Then
            For Each item As PartBomItem In items
                If item IsNot Nothing AndAlso String.Equals(item.GeometryLoadState, "LOADED", StringComparison.OrdinalIgnoreCase) Then s.CachedGeometry += 1
            Next
        End If
        Return s
    End Function

    Public Shared Function FormatMB(ByVal bytes As Long) As String
        If bytes <= 0 Then Return "0 MB"
        Return (CDbl(bytes) / 1024.0 / 1024.0).ToString("0.0") & " MB"
    End Function
End Class

Function FormatGeometryNumber(ByVal valueMm As Double) As String
    If valueMm <= 0 Then Return ""
    Return Math.Round(valueMm, 2).ToString("0.##")
End Function

Sub DetectPlateThicknessFromBoundingBox(ByVal item As PartBomItem)
    If item Is Nothing Then Exit Sub
    If item.BoundingMinMm <= 0 OrElse item.BoundingMidMm <= 0 Then
        item.GeometryType = "UNKNOWN"
        Exit Sub
    End If

    Dim text As String = (item.FileName & " " & item.PartNumber & " " & item.Description & " " & item.Category).ToUpperInvariant()
    Dim keywordPlate As Boolean = text.Contains("PLATE") OrElse text.Contains("TAM") OrElse text.Contains("TẤM") OrElse text.Contains("BASE") OrElse text.Contains("GUSSET") OrElse text.Contains("BRACKET") OrElse text.Contains("LEG") OrElse text.Contains("CHAN") OrElse text.Contains("CHÂN")
    Dim thinRatio As Double = item.BoundingMinMm / Math.Max(item.BoundingMidMm, 0.0001)

    'Chi tiết mỏng rõ ràng hoặc có từ khóa plate/chân: lấy cạnh nhỏ nhất làm thickness ước lượng.
    If thinRatio <= 0.25 OrElse (keywordPlate AndAlso thinRatio <= 0.5) Then
        item.Thickness = item.BoundingMinMm
        item.ThicknessSource = "BOUNDING BOX"
        item.GeometryType = If(keywordPlate, "PLATE / LEG", "THIN PART")
    Else
        item.Thickness = 0
        item.ThicknessSource = ""
        item.GeometryType = "GENERAL PART"
    End If
End Sub

Function ReadPropertyByNames(ByVal doc As Inventor.Document, ByVal names As String()) As String
    If doc Is Nothing OrElse names Is Nothing Then Return ""
    BomPerformanceCounters.DocumentAccess += 1
    For Each propertySet As Inventor.PropertySet In doc.PropertySets
        For Each propertyName As String In names
            BomPerformanceCounters.PropertyRead += 1
            Try
                Dim p As Inventor.Property = propertySet.Item(propertyName)
                If p IsNot Nothing AndAlso p.Value IsNot Nothing Then Return Convert.ToString(p.Value).Trim()
            Catch
            End Try
        Next
    Next
    Return ""
End Function



'####################################################################
' PRO MAX 2.0 - COMMAND SECURITY / WRITE GUARD / OPERATION CONTEXT
'####################################################################
Public Enum BomCommandType
    ReadOnlyCommand = 0
    WriteCommand = 1
    DestructiveCommand = 2
End Enum

Public Class BomOperationContext
    Public OperationName As String = ""
    Public Progress As Integer = 0
    Public Total As Integer = 0
    Public Current As Integer = 0
    Public CancelRequested As Boolean = False
    Public StartedAt As DateTime = DateTime.Now

    Public ReadOnly Property Percent As Integer
        Get
            If Total <= 0 Then Return 0
            Return Math.Max(0, Math.Min(100, CInt((CDbl(Current) / CDbl(Total)) * 100.0R)))
        End Get
    End Property
End Class

Public Class BomWriteGuard
    Public Shared Function CanExecute(ByVal safeMode As Boolean, ByVal commandType As BomCommandType) As Boolean
        If Not safeMode Then Return True
        Return commandType = BomCommandType.ReadOnlyCommand
    End Function

    Public Shared Function EnsureWriteAllowed(ByVal safeMode As Boolean,
                                              ByVal operationName As String,
                                              Optional ByVal commandType As BomCommandType = BomCommandType.WriteCommand) As Boolean
        If CanExecute(safeMode, commandType) Then Return True
        BomLogger.Warn("WRITE_GUARD", "Blocked in SAFE MODE: " & operationName)
        Return False
    End Function
End Class

Public Class BomCommandDefinition
    Public Id As String = ""
    Public Caption As String = ""
    Public ShortCaption As String = ""
    Public Workspace As String = ""
    Public GroupName As String = ""
    Public IconKey As String = ""
    Public Tooltip As String = ""
    Public Description As String = ""
    Public Shortcut As String = ""
    Public Keywords As String = ""
    Public CommandType As BomCommandType = BomCommandType.ReadOnlyCommand
    Public IsWriteOperation As Boolean = False
    Public IsDestructive As Boolean = False
    Public RequiresSelection As Boolean = False
    Public RequiresDocument As Boolean = False
    Public RequiresDrawing As Boolean = False
    Public RequiresPendingChanges As Boolean = False
    Public RequiresSnapshot As Boolean = False
    Public IsQuickAccess As Boolean = False
    Public ContextTarget As String = ""
    Public ContextGroup As String = ""
    Public Order As Integer = 0
    Public IsPrimary As Boolean = False
    Public Handler As EventHandler = Nothing
End Class

Public Class BomCommandRegistry
    Private Shared ReadOnly _commands As New Dictionary(Of String, BomCommandDefinition)(StringComparer.OrdinalIgnoreCase)

    Public Shared Sub Register(ByVal command As BomCommandDefinition)
        If command Is Nothing OrElse String.IsNullOrWhiteSpace(command.Id) Then Exit Sub
        _commands(command.Id) = command
    End Sub

    Public Shared Function GetCommand(ByVal id As String) As BomCommandDefinition
        If String.IsNullOrWhiteSpace(id) Then Return Nothing
        Dim result As BomCommandDefinition = Nothing
        If _commands.TryGetValue(id, result) Then Return result
        Return Nothing
    End Function

    Public Shared Function AllCommands() As List(Of BomCommandDefinition)
        Return New List(Of BomCommandDefinition)(_commands.Values)
    End Function

    Public Shared Function ForWorkspace(ByVal workspace As String) As List(Of BomCommandDefinition)
        Dim result As New List(Of BomCommandDefinition)()
        For Each cmd As BomCommandDefinition In _commands.Values
            If String.Equals(cmd.Workspace, workspace, StringComparison.OrdinalIgnoreCase) Then result.Add(cmd)
        Next
        result.Sort(Function(a As BomCommandDefinition, b As BomCommandDefinition) As Integer
                        Dim g As Integer = String.Compare(a.GroupName, b.GroupName, StringComparison.OrdinalIgnoreCase)
                        If g <> 0 Then Return g
                        Return a.Order.CompareTo(b.Order)
                    End Function)
        Return result
    End Function

    Public Shared Sub Clear()
        _commands.Clear()
    End Sub
End Class

Public Class BomIconCache
    Private Shared ReadOnly _cache As New Dictionary(Of String, System.Drawing.Image)(StringComparer.OrdinalIgnoreCase)

    Public Shared Function GetOrCreate(ByVal key As String, ByVal factory As Func(Of System.Drawing.Image)) As System.Drawing.Image
        Dim normalized As String = If(key, "").Trim().ToUpperInvariant()
        If normalized = "" Then normalized = "DEFAULT"
        Dim img As System.Drawing.Image = Nothing
        If _cache.TryGetValue(normalized, img) AndAlso img IsNot Nothing Then
            Return CType(img.Clone(), System.Drawing.Image)
        End If
        img = factory()
        If img IsNot Nothing Then
            _cache(normalized) = CType(img.Clone(), System.Drawing.Image)
            Return img
        End If
        Return Nothing
    End Function

    Public Shared Sub Clear()
        For Each img As System.Drawing.Image In _cache.Values
            Try
                If img IsNot Nothing Then img.Dispose()
            Catch
            End Try
        Next
        _cache.Clear()
    End Sub
End Class


'####################################################################
' PRO MAX FOUNDATION - CENTRAL POLICY / CONFIG / CONSTANTS / SESSION
'####################################################################
Public Enum BomErrorSeverity
    IgnoreSafe = 0
    LogOnly = 1
    Warning = 2
    [Error] = 3
    Fatal = 4
End Enum

Public Class BomOperationResult
    Public Success As Boolean = True
    Public Severity As BomErrorSeverity = BomErrorSeverity.LogOnly
    Public Engine As String = ""
    Public Operation As String = ""
    Public Message As String = ""
    Public ExceptionText As String = ""

    Public Shared Function Ok(ByVal engineName As String, ByVal operationName As String) As BomOperationResult
        Dim r As New BomOperationResult()
        r.Engine = If(engineName, "")
        r.Operation = If(operationName, "")
        Return r
    End Function

    Public Shared Function Fail(ByVal engineName As String,
                                ByVal operationName As String,
                                ByVal messageText As String,
                                ByVal severityValue As BomErrorSeverity,
                                Optional ByVal ex As Exception = Nothing) As BomOperationResult
        Dim r As New BomOperationResult()
        r.Success = False
        r.Engine = If(engineName, "")
        r.Operation = If(operationName, "")
        r.Message = If(messageText, "")
        r.Severity = severityValue
        If ex IsNot Nothing Then r.ExceptionText = ex.ToString()
        Return r
    End Function
End Class

Public Class BomErrorPolicy
    Public Shared Function CanContinue(ByVal severity As BomErrorSeverity) As Boolean
        Return severity <> BomErrorSeverity.Fatal
    End Function

    Public Shared Sub Report(ByVal result As BomOperationResult, Optional ByVal item As PartBomItem = Nothing)
        If result Is Nothing OrElse result.Success Then Exit Sub
        Select Case result.Severity
            Case BomErrorSeverity.IgnoreSafe
                'Optional failure: intentionally silent.
            Case BomErrorSeverity.LogOnly
                BomLogger.Info(result.Engine & "/" & result.Operation, result.Message)
            Case BomErrorSeverity.Warning
                BomLogger.Warn(result.Engine & "/" & result.Operation, result.Message, item)
            Case Else
                BomLogger.Error(result.Engine & "/" & result.Operation,
                                result.Message & If(String.IsNullOrWhiteSpace(result.ExceptionText), "", " | " & result.ExceptionText),
                                item)
        End Select
    End Sub
End Class

Public Class BomConstants
    Public Const ToolVersion As String = "BOM TOOL PRO MAX 10.3 SAFE ASSEMBLY SWITCH"
    Public Const StatusOk As String = "OK"
    Public Const StatusWarning As String = "WARNING"
    Public Const StatusError As String = "ERROR"
    Public Const StatusPending As String = "PENDING"
    Public Const DefaultScanMode As String = "NORMAL"
End Class

Public Class BomConfig
    Public SafeModeDefault As Boolean = False
    Public AtomicTransactionDefault As Boolean = True
    Public EnableSessionPersistence As Boolean = True
    Public EnablePerformanceMonitoring As Boolean = True
    Public EnableMemoryMonitoring As Boolean = True
    Public SearchDebounceMs As Integer = 220
End Class

Public Class BomSessionState
    Public AssemblyPath As String = ""
    Public DisplayMode As String = "HYBRID"
    Public ScanMode As String = "NORMAL"
    Public SearchText As String = ""
    Public AssemblyFilter As String = ""
    Public QuickFilter As String = "ALL"
    Public ActiveWorkspace As String = "HOME"
    Public SafeMode As Boolean = False
    Public WindowWidth As Integer = 1440
    Public WindowHeight As Integer = 860
    Public WindowLeft As Integer = -1
    Public WindowTop As Integer = -1
    Public RibbonCollapsed As Boolean = False
    Public DetailPanelVisible As Boolean = True
    Public DetailPanelWidth As Integer = 340
    Public SelectedProfile As String = "ENGINEERING"

    Private Shared Function E(ByVal value As String) As String
        Return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(If(value, "")))
    End Function

    Private Shared Function D(ByVal value As String) As String
        Try
            Return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(If(value, "")))
        Catch
            Return ""
        End Try
    End Function

    Public Sub Save(ByVal filePath As String)
        If String.IsNullOrWhiteSpace(filePath) Then Exit Sub
        Dim lines As New List(Of String)()
        lines.Add("ASSEMBLY=" & E(AssemblyPath))
        lines.Add("DISPLAY=" & E(DisplayMode))
        lines.Add("SCAN=" & E(ScanMode))
        lines.Add("SEARCH=" & E(SearchText))
        lines.Add("FILTER=" & E(AssemblyFilter))
        lines.Add("QUICK=" & E(QuickFilter))
        lines.Add("WORKSPACE=" & E(ActiveWorkspace))
        lines.Add("SAFE=" & SafeMode.ToString())
        lines.Add("WIDTH=" & WindowWidth.ToString())
        lines.Add("HEIGHT=" & WindowHeight.ToString())
        lines.Add("LEFT=" & WindowLeft.ToString())
        lines.Add("TOP=" & WindowTop.ToString())
        lines.Add("RIBBONCOLLAPSED=" & RibbonCollapsed.ToString())
        lines.Add("DETAILVISIBLE=" & DetailPanelVisible.ToString())
        lines.Add("DETAILWIDTH=" & DetailPanelWidth.ToString())
        lines.Add("PROFILE=" & E(SelectedProfile))
        System.IO.File.WriteAllLines(filePath, lines.ToArray(), System.Text.Encoding.UTF8)
    End Sub

    Public Shared Function Load(ByVal filePath As String) As BomSessionState
        Dim s As New BomSessionState()
        If String.IsNullOrWhiteSpace(filePath) OrElse Not System.IO.File.Exists(filePath) Then Return s
        Try
            For Each line As String In System.IO.File.ReadAllLines(filePath, System.Text.Encoding.UTF8)
                Dim p As Integer = line.IndexOf("="c)
                If p <= 0 Then Continue For
                Dim key As String = line.Substring(0, p).Trim().ToUpperInvariant()
                Dim value As String = line.Substring(p + 1)
                Select Case key
                    Case "ASSEMBLY", "STRUCTURE" : s.AssemblyPath = D(value)
                    Case "DISPLAY" : s.DisplayMode = D(value)
                    Case "SCAN" : s.ScanMode = D(value)
                    Case "SEARCH" : s.SearchText = D(value)
                    Case "FILTER" : s.AssemblyFilter = D(value)
                    Case "QUICK" : s.QuickFilter = D(value)
                    Case "WORKSPACE" : s.ActiveWorkspace = D(value)
                    Case "SAFE" : Boolean.TryParse(value, s.SafeMode)
                    Case "WIDTH" : Integer.TryParse(value, s.WindowWidth)
                    Case "HEIGHT" : Integer.TryParse(value, s.WindowHeight)
                    Case "LEFT" : Integer.TryParse(value, s.WindowLeft)
                    Case "TOP" : Integer.TryParse(value, s.WindowTop)
                    Case "RIBBONCOLLAPSED" : Boolean.TryParse(value, s.RibbonCollapsed)
                    Case "DETAILVISIBLE" : Boolean.TryParse(value, s.DetailPanelVisible)
                    Case "DETAILWIDTH" : Integer.TryParse(value, s.DetailPanelWidth)
                    Case "PROFILE" : s.SelectedProfile = D(value)
                End Select
            Next
        Catch ex As Exception
            BomLogger.Warn("SESSION", "Không đọc được session: " & ex.Message)
        End Try
        Return s
    End Function
End Class



'####################################################################
' SINGLE INSTANCE MANAGER
' Prevents multiple BOM Tool windows/runtimes in the same Inventor process.
' Second launch activates the existing window instead of rebuilding engines.
'####################################################################
Public Class BomSingleInstanceManager
    Private Shared _activeForm As System.Windows.Forms.Form = Nothing
    Private Shared ReadOnly _syncRoot As New Object()

    Public Shared Function TryActivateExisting() As Boolean
        SyncLock _syncRoot
            Try
                If _activeForm Is Nothing Then Return False
                If _activeForm.IsDisposed OrElse _activeForm.Disposing Then
                    _activeForm = Nothing
                    Return False
                End If

                If Not _activeForm.IsHandleCreated Then
                    Return False
                End If

                Try
                    If _activeForm.WindowState = System.Windows.Forms.FormWindowState.Minimized Then
                        _activeForm.WindowState = System.Windows.Forms.FormWindowState.Normal
                    End If
                Catch
                End Try

                Try
                    _activeForm.Show()
                Catch
                End Try

                Try
                    _activeForm.BringToFront()
                    _activeForm.Activate()
                    _activeForm.Focus()
                Catch
                End Try

                Return True
            Catch
                _activeForm = Nothing
                Return False
            End Try
        End SyncLock
    End Function

    Public Shared Sub Register(ByVal form As System.Windows.Forms.Form)
        If form Is Nothing Then Exit Sub
        SyncLock _syncRoot
            _activeForm = form
        End SyncLock
    End Sub

    Public Shared Sub Unregister(ByVal form As System.Windows.Forms.Form)
        SyncLock _syncRoot
            If _activeForm Is form Then _activeForm = Nothing
        End SyncLock
    End Sub

    Public Shared Function HasActiveInstance() As Boolean
        SyncLock _syncRoot
            If _activeForm Is Nothing Then Return False
            Return Not _activeForm.IsDisposed AndAlso Not _activeForm.Disposing
        End SyncLock
    End Function
End Class


'====================================================================
' DATA CLASSES
'====================================================================

'####################################################################
' SECTION 10 - PRIMARY BOM DATA MODELS
' PartBomItem, RuntimeIndex, PropertyColumnInfo và dữ liệu trạng thái.
'####################################################################

Public Enum BomLogLevel
    Info = 0
    Warning = 1
    [Error] = 2
End Enum

Public Class BomLogEntry
    Public Time As DateTime = DateTime.Now
    Public Level As BomLogLevel = BomLogLevel.Info
    Public ModuleName As String = ""
    Public Operation As String = ""
    Public ExceptionText As String = ""
    Public FilePath As String = ""
    Public PartNumber As String = ""
    Public Message As String = ""

    Public Overrides Function ToString() As String
        Return Time.ToString("HH:mm:ss") & " | " & Level.ToString().ToUpperInvariant() & " | " & _
               ModuleName & If(String.IsNullOrWhiteSpace(Operation), "", "/" & Operation) & " | " & PartNumber & " | " & FilePath & " | " & Message & If(String.IsNullOrWhiteSpace(ExceptionText), "", " | EX: " & ExceptionText)
    End Function
End Class

Public Class BomLogger
    Private Shared _entries As New List(Of BomLogEntry)()
    Private Shared _sessionStarted As DateTime = DateTime.Now

    Public Shared Sub Reset()
        _entries.Clear()
        _sessionStarted = DateTime.Now
    End Sub

    Public Shared Sub Add(ByVal level As BomLogLevel, ByVal moduleName As String, ByVal message As String, Optional ByVal item As PartBomItem = Nothing, Optional ByVal filePath As String = "")
        Try
            Dim e As New BomLogEntry()
            e.Time = DateTime.Now
            e.Level = level
            e.ModuleName = If(moduleName, "")
            e.Message = If(message, "")
            If item IsNot Nothing Then
                e.FilePath = If(item.FilePath, "")
                e.PartNumber = If(item.PartNumber, "")
            Else
                e.FilePath = If(filePath, "")
            End If
            _entries.Add(e)
        Catch
            'Logger tuyệt đối không được làm dừng Rule.
        End Try
    End Sub

    Public Shared Sub Info(ByVal moduleName As String, ByVal message As String)
        Add(BomLogLevel.Info, moduleName, message)
    End Sub

    Public Shared Sub Warn(ByVal moduleName As String, ByVal message As String, Optional ByVal item As PartBomItem = Nothing)
        Add(BomLogLevel.Warning, moduleName, message, item)
    End Sub

    Public Shared Sub [Error](ByVal moduleName As String, ByVal message As String, Optional ByVal item As PartBomItem = Nothing)
        Add(BomLogLevel.[Error], moduleName, message, item)
    End Sub

    Public Shared Sub Log(ByVal moduleName As String,
                          ByVal filePath As String,
                          ByVal operationName As String,
                          ByVal severity As String,
                          ByVal message As String)
        Dim level As BomLogLevel = BomLogLevel.Info
        Dim s As String = If(severity, "").Trim().ToUpperInvariant()
        If s = "ERROR" OrElse s = "CRITICAL" Then
            level = BomLogLevel.[Error]
        ElseIf s = "WARNING" OrElse s = "WARN" Then
            level = BomLogLevel.Warning
        End If
        Add(level, If(moduleName, "") & If(String.IsNullOrWhiteSpace(operationName), "", "/" & operationName),
            If(message, ""), Nothing, If(filePath, ""))
    End Sub

    Public Shared Function Count(ByVal level As BomLogLevel) As Integer
        Dim n As Integer = 0
        For Each e As BomLogEntry In _entries
            If e.Level = level Then n += 1
        Next
        Return n
    End Function

    Public Shared Function Summary() As String
        Return "Log: " & _entries.Count.ToString() & _
               " | Warning: " & Count(BomLogLevel.Warning).ToString() & _
               " | Error: " & Count(BomLogLevel.[Error]).ToString()
    End Function

    Public Shared Function BuildText() As String
        Dim sb As New StringBuilder()
        sb.AppendLine("BOM TOOL PRO - SESSION LOG")
        sb.AppendLine("Started: " & _sessionStarted.ToString("dd/MM/yyyy HH:mm:ss"))
        sb.AppendLine(Summary())
        sb.AppendLine(New String("-"c, 90))
        For Each e As BomLogEntry In _entries
            sb.AppendLine(e.ToString())
        Next
        Return sb.ToString()
    End Function
End Class

Public Enum BomScanMode
    Fast = 0
    Normal = 1
    Deep = 2
End Enum

Public Class BomPerformanceSnapshot
    Public StartedAt As DateTime = DateTime.Now
    Public SmartRefreshMs As Long = 0
    Public SignatureChecks As Integer = 0
    Public CacheHits As Integer = 0
    Public CacheMisses As Integer = 0
    Public ChangedDocuments As Integer = 0
    Public LastMode As String = "NORMAL"

    Public Function HitRate() As Double
        Dim total As Integer = CacheHits + CacheMisses
        If total <= 0 Then Return 0
        Return (CDbl(CacheHits) / CDbl(total)) * 100.0
    End Function
End Class

Public Class BomSignatureEngine
    Public Shared Sub CaptureIntoItem(ByVal item As PartBomItem)
        If item Is Nothing Then Exit Sub
        item.SignaturePath = If(item.FilePath, "")
        item.SignaturePartNumber = If(item.PartNumber, "")
        item.SignatureRevision = If(item.Revision, "")
        item.SignatureBomStructure = If(item.BomStructureText, "")
        item.SignatureWriteTicks = 0
        item.SignatureFileSize = 0
        Try
            If Not String.IsNullOrWhiteSpace(item.FilePath) AndAlso System.IO.File.Exists(item.FilePath) Then
                Dim fi As New System.IO.FileInfo(item.FilePath)
                item.SignatureWriteTicks = fi.LastWriteTimeUtc.Ticks
                item.SignatureFileSize = fi.Length
            End If
        Catch ex As Exception
            BomLogger.Warn("SIGNATURE", ex.Message, item)
        End Try
        item.SignatureCapturedAt = DateTime.Now
        item.LastCacheState = "UNCHANGED"
    End Sub

    Public Shared Function HasChanged(ByVal item As PartBomItem) As Boolean
        If item Is Nothing Then Return True
        Try
            If String.IsNullOrWhiteSpace(item.FilePath) Then Return True
            If Not System.IO.File.Exists(item.FilePath) Then Return True
            Dim fi As New System.IO.FileInfo(item.FilePath)
            If item.SignatureCapturedAt = DateTime.MinValue Then Return True
            If fi.LastWriteTimeUtc.Ticks <> item.SignatureWriteTicks Then Return True
            If fi.Length <> item.SignatureFileSize Then Return True
            If item.Document IsNot Nothing AndAlso item.Document.Dirty Then Return True
            Return False
        Catch
            Return True
        End Try
    End Function

    Public Shared Function FileSignature(ByVal filePath As String) As String
        Try
            If String.IsNullOrWhiteSpace(filePath) OrElse Not System.IO.File.Exists(filePath) Then Return "MISSING"
            Dim fi As New System.IO.FileInfo(filePath)
            Return fi.FullName.ToUpperInvariant() & "|" & fi.LastWriteTimeUtc.Ticks.ToString() & "|" & fi.Length.ToString()
        Catch
            Return "ERROR"
        End Try
    End Function
End Class

Public Class PartBomItem
    Public DocumentKey As String
    Public Document As Inventor.Document
    Public Quantity As Integer
    Public FileName As String
    Public FilePath As String
    Public PartNumber As String

    'Core cache: đọc đúng một lần cho mỗi file Part.
    Public Description As String = ""
    Public Material As String = ""
    Public Vendor As String = ""
    Public Revision As String = ""
    Public StockNumber As String = ""
    Public Project As String = ""
    Public Category As String = ""
    Public Mass As Double = 0
    Public Volume As Double = 0
    Public SurfaceArea As Double = 0
    Public Thickness As Double = 0
    Public ThicknessSource As String = ""
    Public GeometryType As String = ""
    Public BoundingMinMm As Double = 0
    Public BoundingMidMm As Double = 0
    Public BoundingMaxMm As Double = 0
    Public BoundingBoxText As String = ""
    Public GeometryLoadState As String = "NOT LOADED"
    Public GeometryLoadError As String = ""
    Public GeometryLoadedAt As DateTime = DateTime.MinValue
    Public BomStructureText As String = ""

    'Compatibility properties used by the later engines.
    Public Property BomStructure As String
        Get
            Return If(BomStructureText, "")
        End Get
        Set(ByVal value As String)
            BomStructureText = If(value, "")
        End Set
    End Property

    Public SuppressedCount As Integer = 0
    Public DataStatus As String = ""

    Public IsReadOnly As Boolean = False
    Public IsUnsaved As Boolean = False
    Public IsAdaptive As Boolean = False
    Public IsVirtual As Boolean = False
    Public IsReference As Boolean = False
    Public IsSheetMetal As Boolean = False
    Public IsPurchased As Boolean = False
    Public SearchBlob As String = ""
    Public IsBomDirty As Boolean = False
    Public DirtyPropertyKeys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)

    'V20 - CHANGE SIGNATURE / INCREMENTAL CACHE
    Public SignaturePath As String = ""
    Public SignatureWriteTicks As Long = 0
    Public SignatureFileSize As Long = 0
    Public SignaturePartNumber As String = ""
    Public SignatureRevision As String = ""
    Public SignatureBomStructure As String = ""
    Public SignatureCapturedAt As DateTime = DateTime.MinValue
    Public LastCacheState As String = "NEW"

    'On-demand feature cache. Chỉ Feature được gọi mới đọc Inventor.
    Public FeatureValues As New Dictionary(Of String, Object)(StringComparer.OrdinalIgnoreCase)
    Public LoadedFeatures As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
    Public ThumbnailImage As System.Drawing.Image = Nothing

    'Occurrence cache giúp Highlight Part O(k), không quét lại toàn bộ cây Assembly.
    Public Occurrences As New List(Of ComponentOccurrence)()

    Public Sub AddOccurrence(ByVal occurrence As ComponentOccurrence)
        If occurrence Is Nothing Then Exit Sub
        Occurrences.Add(occurrence)
    End Sub

    Public SelectedPropertyValues As New Dictionary( _
        Of String, Object)(StringComparer.OrdinalIgnoreCase)

    Private ParentAssemblies As New SortedSet( _
        Of String)(StringComparer.OrdinalIgnoreCase)

    Private ParentAssemblyQuantities As New Dictionary( _
        Of String, Integer)(StringComparer.OrdinalIgnoreCase)

    'Đường dẫn Assembly đầy đủ, ví dụ ROOT\FRAME\WELDMENT.
    'Dùng để xuất Excel đúng cấu trúc mẹ-con mà không đọc lại Inventor.
    Private AssemblyPathQuantities As New Dictionary( _
        Of String, Integer)(StringComparer.OrdinalIgnoreCase)

    Public Sub AddParentAssembly(ByVal assemblyName As String)
        If String.IsNullOrWhiteSpace(assemblyName) Then Exit Sub
        Dim cleanName As String = assemblyName.Trim()
        ParentAssemblies.Add(cleanName)
        If ParentAssemblyQuantities.ContainsKey(cleanName) Then
            ParentAssemblyQuantities(cleanName) += 1
        Else
            ParentAssemblyQuantities(cleanName) = 1
        End If
    End Sub

    Public Sub AddAssemblyPath(ByVal assemblyPath As String)
        If String.IsNullOrWhiteSpace(assemblyPath) Then Exit Sub
        Dim cleanPath As String = assemblyPath.Trim().Trim("\"c)
        If cleanPath.Length = 0 Then Exit Sub
        If AssemblyPathQuantities.ContainsKey(cleanPath) Then
            AssemblyPathQuantities(cleanPath) += 1
        Else
            AssemblyPathQuantities(cleanPath) = 1
        End If
    End Sub

    Public Function GetAssemblyPaths() As List(Of String)
        Return New List(Of String)(AssemblyPathQuantities.Keys)
    End Function

    Public Function GetQuantityForAssemblyPath(ByVal assemblyPath As String) As Integer
        If String.IsNullOrWhiteSpace(assemblyPath) Then Return 0
        Dim cleanPath As String = assemblyPath.Trim().Trim("\"c)
        If AssemblyPathQuantities.ContainsKey(cleanPath) Then Return AssemblyPathQuantities(cleanPath)
        Return 0
    End Function

    Public Function GetParentAssemblyText() As String
        If ParentAssemblies.Count = 0 Then Return ""
        Return String.Join("; ", New List(Of String)(ParentAssemblies).ToArray())
    End Function

    Public Function GetParentAssemblies() As List(Of String)
        Return New List(Of String)(ParentAssemblies)
    End Function

    Public Function GetQuantityForParent(ByVal assemblyName As String) As Integer
        If String.IsNullOrWhiteSpace(assemblyName) Then Return 0
        If ParentAssemblyQuantities.ContainsKey(assemblyName) Then Return ParentAssemblyQuantities(assemblyName)
        Return 0
    End Function
End Class

Public Class BomRuntimeIndex
    Public ItemByKey As New Dictionary(Of String, PartBomItem)(StringComparer.OrdinalIgnoreCase)
    Public ItemsByAssembly As New SortedDictionary(Of String, List(Of PartBomItem))(StringComparer.OrdinalIgnoreCase)
    Public AssemblyQuantity As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
    Public TotalQuantity As Integer = 0
    Public TotalOccurrences As Integer = 0

    Public Sub Build(ByVal rootAssemblyName As String, ByVal items As List(Of PartBomItem))
        ItemByKey.Clear()
        ItemsByAssembly.Clear()
        AssemblyQuantity.Clear()
        TotalQuantity = 0
        TotalOccurrences = 0
        If items Is Nothing Then Exit Sub

        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            If Not String.IsNullOrWhiteSpace(item.DocumentKey) AndAlso Not ItemByKey.ContainsKey(item.DocumentKey) Then
                ItemByKey.Add(item.DocumentKey, item)
            End If
            TotalQuantity += Math.Max(0, item.Quantity)
            If item.Occurrences IsNot Nothing Then TotalOccurrences += item.Occurrences.Count

            Dim parents As List(Of String) = item.GetParentAssemblies()
            If parents.Count = 0 AndAlso Not String.IsNullOrWhiteSpace(rootAssemblyName) Then parents.Add(rootAssemblyName)
            For Each parentName As String In parents
                If String.IsNullOrWhiteSpace(parentName) Then Continue For
                If Not ItemsByAssembly.ContainsKey(parentName) Then ItemsByAssembly(parentName) = New List(Of PartBomItem)()
                ItemsByAssembly(parentName).Add(item)
                Dim q As Integer = item.GetQuantityForParent(parentName)
                If q <= 0 AndAlso String.Equals(parentName, rootAssemblyName, StringComparison.OrdinalIgnoreCase) Then q = item.Quantity
                If AssemblyQuantity.ContainsKey(parentName) Then
                    AssemblyQuantity(parentName) += Math.Max(0, q)
                Else
                    AssemblyQuantity(parentName) = Math.Max(0, q)
                End If
            Next
        Next

        If Not String.IsNullOrWhiteSpace(rootAssemblyName) AndAlso Not ItemsByAssembly.ContainsKey(rootAssemblyName) Then
            ItemsByAssembly(rootAssemblyName) = New List(Of PartBomItem)(items)
            AssemblyQuantity(rootAssemblyName) = TotalQuantity
        End If
    End Sub

    Public Function BelongsToAssembly(ByVal item As PartBomItem, ByVal assemblyName As String, ByVal rootAssemblyName As String) As Boolean
        If item Is Nothing OrElse String.IsNullOrWhiteSpace(assemblyName) Then Return True
        If String.Equals(assemblyName, rootAssemblyName, StringComparison.OrdinalIgnoreCase) Then Return True
        Return item.GetQuantityForParent(assemblyName) > 0
    End Function
End Class


'####################################################################
' PHASE 4 - STRUCTURED BOM ENGINE
' PARTS ONLY / STRUCTURED / HYBRID + Quantity/BOM Structure foundation
'####################################################################
Public Enum BomDisplayMode
    PartsOnly = 0
    Structured = 1
    Hybrid = 2
End Enum

Public Class BomAssemblyPartEntry
    Public Item As PartBomItem
    Public LocalQuantity As Integer
End Class

Public Class BomAssemblyNode
    Public Name As String = ""
    Public FullPath As String = ""
    Public Level As Integer = 0
    Public Parent As BomAssemblyNode = Nothing
    Public Children As New Dictionary(Of String, BomAssemblyNode)(StringComparer.OrdinalIgnoreCase)
    Public DirectParts As New Dictionary(Of String, BomAssemblyPartEntry)(StringComparer.OrdinalIgnoreCase)

    Public Sub New(ByVal nodeName As String, ByVal nodePath As String, ByVal nodeLevel As Integer, ByVal parentNode As BomAssemblyNode)
        Name = If(nodeName, "")
        FullPath = If(nodePath, "")
        Level = Math.Max(0, nodeLevel)
        Parent = parentNode
    End Sub

    Public Function GetOrCreateChild(ByVal childName As String, ByVal childPath As String) As BomAssemblyNode
        Dim child As BomAssemblyNode = Nothing
        If Not Children.TryGetValue(childName, child) Then
            child = New BomAssemblyNode(childName, childPath, Level + 1, Me)
            Children.Add(childName, child)
        End If
        Return child
    End Function

    Public Sub AddDirectPart(ByVal item As PartBomItem, ByVal qty As Integer)
        If item Is Nothing Then Exit Sub
        Dim key As String = If(String.IsNullOrWhiteSpace(item.DocumentKey), item.FilePath, item.DocumentKey)
        If String.IsNullOrWhiteSpace(key) Then key = item.PartNumber & "|" & item.FileName
        Dim entry As BomAssemblyPartEntry = Nothing
        If DirectParts.TryGetValue(key, entry) Then
            entry.LocalQuantity += Math.Max(0, qty)
        Else
            entry = New BomAssemblyPartEntry()
            entry.Item = item
            entry.LocalQuantity = Math.Max(0, qty)
            DirectParts.Add(key, entry)
        End If
    End Sub

    Public Function GetSortedChildren() As List(Of BomAssemblyNode)
        Dim result As New List(Of BomAssemblyNode)(Children.Values)
        result.Sort(Function(a As BomAssemblyNode, b As BomAssemblyNode) StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name))
        Return result
    End Function

    Public Function GetDirectEntries() As List(Of BomAssemblyPartEntry)
        Return New List(Of BomAssemblyPartEntry)(DirectParts.Values)
    End Function

    Public Function GetRecursiveQuantity() As Integer
        Dim total As Integer = 0
        For Each e As BomAssemblyPartEntry In DirectParts.Values
            If e Is Nothing OrElse e.Item Is Nothing Then Continue For
            If Not BomStructurePolicy.IsReference(e.Item) Then total += Math.Max(0, e.LocalQuantity)
        Next
        For Each child As BomAssemblyNode In Children.Values
            total += child.GetRecursiveQuantity()
        Next
        Return total
    End Function

    Public Function GetRecursiveUniquePartCount() As Integer
        Dim keys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        CollectKeys(keys)
        Return keys.Count
    End Function

    Private Sub CollectKeys(ByVal keys As HashSet(Of String))
        For Each key As String In DirectParts.Keys
            keys.Add(key)
        Next
        For Each child As BomAssemblyNode In Children.Values
            child.CollectKeys(keys)
        Next
    End Sub
End Class


Public Class BomQuantityInfo
    Public LocalQty As Integer = 0
    Public ParentQty As Integer = 1
    Public EffectiveQty As Integer = 0
    Public TotalQty As Integer = 0
    Public VisibleQty As Integer = 0
    Public SuppressedQty As Integer = 0
End Class

Public Class BomQuantityEngine
    Public Shared Function ForItemInNode(ByVal item As PartBomItem, ByVal node As BomAssemblyNode) As BomQuantityInfo
        Dim q As New BomQuantityInfo()
        If item Is Nothing Then Return q
        q.TotalQty = Math.Max(0, item.Quantity)
        If node IsNot Nothing Then
            q.LocalQty = item.GetQuantityForAssemblyPath(node.FullPath)
            If q.LocalQty <= 0 Then q.LocalQty = item.GetQuantityForParent(node.Name)
            q.ParentQty = GetParentMultiplier(node)
        End If
        If q.LocalQty <= 0 Then q.LocalQty = q.TotalQty
        q.EffectiveQty = Math.Max(0, q.LocalQty * Math.Max(1, q.ParentQty))
        q.SuppressedQty = Math.Max(0, item.SuppressedCount)
        q.VisibleQty = Math.Max(0, q.TotalQty - q.SuppressedQty)
        Return q
    End Function

    Private Shared Function GetParentMultiplier(ByVal node As BomAssemblyNode) As Integer
        'AssemblyPath cache currently represents occurrence paths, therefore each concrete path
        'already contributes one parent occurrence. Keep multiplier explicit for future BOM-row qty.
        If node Is Nothing Then Return 1
        Return 1
    End Function
End Class

Public Class BomStructurePolicy
    Public Shared Function Normalize(ByVal value As String) As String
        Dim s As String = If(value, "").Trim().ToUpperInvariant()
        If s.Contains("PHANTOM") Then Return "PHANTOM"
        If s.Contains("REFERENCE") Then Return "REFERENCE"
        If s.Contains("PURCHASED") Then Return "PURCHASED"
        If s.Contains("INSEPARABLE") Then Return "INSEPARABLE"
        If s.Contains("NORMAL") Then Return "NORMAL"
        Return If(s.Length = 0, "NORMAL", s)
    End Function

    Public Shared Function IncludeInPartsOnly(ByVal item As PartBomItem) As Boolean
        If item Is Nothing Then Return False
        'Reference is excluded from normal Parts Only quantity rollup.
        Return Normalize(item.BomStructure) <> "REFERENCE"
    End Function

    Public Shared Function IsReference(ByVal item As PartBomItem) As Boolean
        Return item IsNot Nothing AndAlso Normalize(item.BomStructure) = "REFERENCE"
    End Function

    Public Shared Function IsPhantom(ByVal item As PartBomItem) As Boolean
        Return item IsNot Nothing AndAlso Normalize(item.BomStructure) = "PHANTOM"
    End Function

    Public Shared Function IsPurchased(ByVal item As PartBomItem) As Boolean
        Return item IsNot Nothing AndAlso Normalize(item.BomStructure) = "PURCHASED"
    End Function

    Public Shared Function IsInseparable(ByVal item As PartBomItem) As Boolean
        Return item IsNot Nothing AndAlso Normalize(item.BomStructure) = "INSEPARABLE"
    End Function

    Public Shared Function IsEffectiveBomLeaf(ByVal item As PartBomItem) As Boolean
        If item Is Nothing Then Return False
        Dim s As String = Normalize(item.BomStructure)
        Return s = "NORMAL" OrElse s = "PURCHASED" OrElse s = "INSEPARABLE"
    End Function

    Public Shared Function StatusText(ByVal item As PartBomItem) As String
        If item Is Nothing Then Return ""
        Return Normalize(item.BomStructure)
    End Function
End Class


Public Class BomStructureAuditResult
    Public Errors As New List(Of String)()
    Public Warnings As New List(Of String)()
    Public Function IsValid() As Boolean
        Return Errors.Count = 0
    End Function
End Class

Public Class BomStructureAuditEngine
    Public Shared Function Audit(ByVal root As BomAssemblyNode) As BomStructureAuditResult
        Dim result As New BomStructureAuditResult()
        If root Is Nothing Then
            result.Errors.Add("Structure root is Nothing.")
            Return result
        End If
        Dim visited As New HashSet(Of BomAssemblyNode)()
        AuditNode(root, visited, result)
        Return result
    End Function

    Private Shared Sub AuditNode(ByVal node As BomAssemblyNode,
                                 ByVal visited As HashSet(Of BomAssemblyNode),
                                 ByVal result As BomStructureAuditResult)
        If node Is Nothing Then Return
        If visited.Contains(node) Then
            result.Errors.Add("Cycle detected at: " & node.FullPath)
            Return
        End If
        visited.Add(node)

        For Each entry As BomAssemblyPartEntry In node.DirectParts.Values
            If entry Is Nothing OrElse entry.Item Is Nothing Then
                result.Warnings.Add("Empty BOM entry at: " & node.FullPath)
                Continue For
            End If
            If entry.LocalQuantity < 0 Then
                result.Errors.Add("Negative Local Qty: " & entry.Item.FileName)
            End If
            Dim structureName As String = BomStructurePolicy.Normalize(entry.Item.BomStructure)
            If structureName <> "NORMAL" AndAlso structureName <> "PURCHASED" AndAlso
               structureName <> "PHANTOM" AndAlso structureName <> "REFERENCE" AndAlso
               structureName <> "INSEPARABLE" Then
                result.Warnings.Add("Unknown BOM Structure [" & structureName & "]: " & entry.Item.FileName)
            End If
        Next

        For Each child As BomAssemblyNode In node.Children.Values
            If child Is Nothing Then Continue For
            If child.Parent IsNot node Then
                result.Errors.Add("Invalid Parent link: " & child.FullPath)
            End If
            AuditNode(child, visited, result)
        Next
        visited.Remove(node)
    End Sub
End Class

Public Class BomStructureEngine
    Public Shared Function Build(ByVal rootAssemblyName As String, ByVal items As List(Of PartBomItem)) As BomAssemblyNode
        Dim rootName As String = If(String.IsNullOrWhiteSpace(rootAssemblyName), "ROOT", rootAssemblyName)
        Dim root As New BomAssemblyNode(rootName, rootName, 0, Nothing)
        If items Is Nothing Then Return root

        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            Dim paths As List(Of String) = item.GetAssemblyPaths()
            If paths.Count = 0 Then
                root.AddDirectPart(item, item.Quantity)
                Continue For
            End If

            For Each rawPath As String In paths
                If String.IsNullOrWhiteSpace(rawPath) Then Continue For
                Dim names() As String = rawPath.Trim().Trim("\"c).Split("\"c)
                Dim current As BomAssemblyNode = root
                Dim builtPath As String = ""
                Dim startIndex As Integer = 0
                If names.Length > 0 AndAlso String.Equals(names(0).Trim(), rootName, StringComparison.OrdinalIgnoreCase) Then startIndex = 1

                For i As Integer = startIndex To names.Length - 1
                    Dim n As String = names(i).Trim()
                    If n.Length = 0 Then Continue For
                    builtPath = If(builtPath.Length = 0, rootName & "\" & n, builtPath & "\" & n)
                    current = current.GetOrCreateChild(n, builtPath)
                Next

                Dim q As Integer = item.GetQuantityForAssemblyPath(rawPath)
                If q <= 0 Then q = item.GetQuantityForParent(current.Name)
                If q <= 0 Then q = item.Quantity
                current.AddDirectPart(item, q)
            Next
        Next
        Return root
    End Function
End Class


'####################################################################
' PHASE 5 - PROJECT INTELLIGENCE
' WHERE USED 2.0 / DEPENDENCY TREE / IMPACT ANALYSIS
'####################################################################
Public Class BomWhereUsedNode
    Public Name As String = ""
    Public FullPath As String = ""
    Public Level As Integer = 0
    Public LocalQty As Integer = 0
    Public TotalQty As Integer = 0
    Public OccurrenceCount As Integer = 0
    Public SuppressedCount As Integer = 0
    Public VisibleCount As Integer = 0
    Public Children As New List(Of BomWhereUsedNode)()
End Class

Public Class BomImpactResult
    Public Part As PartBomItem = Nothing
    Public Assemblies As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
    Public AssemblyPaths As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
    Public Drawings As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
    Public OccurrenceCount As Integer = 0
    Public SuppressedCount As Integer = 0
    Public VisibleCount As Integer = 0
End Class

Public Class BomWhereUsedEngine
    Public Shared Function BuildTree(ByVal item As PartBomItem, ByVal rootAssembly As String) As BomWhereUsedNode
        Dim root As New BomWhereUsedNode()
        root.Name = If(String.IsNullOrWhiteSpace(item.PartNumber), item.FileName, item.PartNumber)
        root.FullPath = root.Name
        root.Level = 0
        If item Is Nothing Then Return root

        Dim paths As List(Of String) = item.GetAssemblyPaths()
        For Each rawPath As String In paths
            If String.IsNullOrWhiteSpace(rawPath) Then Continue For
            Dim names() As String = rawPath.Trim().Trim("\"c).Split("\"c)
            Dim current As BomWhereUsedNode = root
            Dim built As String = ""
            For i As Integer = names.Length - 1 To 0 Step -1
                Dim n As String = names(i).Trim()
                If n.Length = 0 Then Continue For
                built = If(built.Length = 0, n, n & "\" & built)
                Dim child As BomWhereUsedNode = Nothing
                For Each c As BomWhereUsedNode In current.Children
                    If String.Equals(c.Name, n, StringComparison.OrdinalIgnoreCase) Then
                        child = c
                        Exit For
                    End If
                Next
                If child Is Nothing Then
                    child = New BomWhereUsedNode()
                    child.Name = n
                    child.FullPath = built
                    child.Level = current.Level + 1
                    current.Children.Add(child)
                End If
                child.LocalQty += Math.Max(1, item.GetQuantityForAssemblyPath(rawPath))
                child.OccurrenceCount += 1
                current = child
            Next
        Next

        root.TotalQty = Math.Max(0, item.Quantity)
        root.SuppressedCount = Math.Max(0, item.SuppressedCount)
        root.VisibleCount = Math.Max(0, root.TotalQty - root.SuppressedCount)
        Return root
    End Function

    Public Shared Function AnalyzeImpact(ByVal item As PartBomItem,
                                         ByVal drawingIndex As Dictionary(Of String, String)) As BomImpactResult
        Dim result As New BomImpactResult()
        result.Part = item
        If item Is Nothing Then Return result

        result.OccurrenceCount = Math.Max(0, item.Quantity)
        result.SuppressedCount = Math.Max(0, item.SuppressedCount)
        result.VisibleCount = Math.Max(0, result.OccurrenceCount - result.SuppressedCount)

        For Each p As String In item.GetAssemblyPaths()
            If String.IsNullOrWhiteSpace(p) Then Continue For
            result.AssemblyPaths.Add(p)
            Dim names() As String = p.Trim().Trim("\"c).Split("\"c)
            For Each n As String In names
                If Not String.IsNullOrWhiteSpace(n) Then result.Assemblies.Add(n.Trim())
            Next
        Next

        If drawingIndex IsNot Nothing Then
            Dim keys As New List(Of String)()
            If Not String.IsNullOrWhiteSpace(item.FileName) Then keys.Add(System.IO.Path.GetFileNameWithoutExtension(item.FileName))
            If Not String.IsNullOrWhiteSpace(item.PartNumber) Then keys.Add(item.PartNumber)
            For Each k As String In keys
                Dim drawingPath As String = ""
                If drawingIndex.TryGetValue(k, drawingPath) Then
                    If Not String.IsNullOrWhiteSpace(drawingPath) Then result.Drawings.Add(drawingPath)
                End If
            Next
        End If
        Return result
    End Function
End Class



Public Class BomDependencyCacheEntry
    Public Signature As String = ""
    Public Root As BomWhereUsedNode = Nothing
    Public Impact As BomImpactResult = Nothing
End Class

Public Class BomDependencyCache
    Private Shared ReadOnly _entries As New Dictionary(Of String, BomDependencyCacheEntry)(StringComparer.OrdinalIgnoreCase)

    Public Shared Function MakeKey(ByVal item As PartBomItem) As String
        If item Is Nothing Then Return ""
        If Not String.IsNullOrWhiteSpace(item.DocumentKey) Then Return item.DocumentKey
        If Not String.IsNullOrWhiteSpace(item.FilePath) Then Return item.FilePath
        Return item.PartNumber & "|" & item.FileName
    End Function

    Public Shared Function MakeSignature(ByVal item As PartBomItem) As String
        If item Is Nothing Then Return ""
        Dim sb As New System.Text.StringBuilder()
        sb.Append(item.Quantity.ToString()).Append("|")
        sb.Append(item.SuppressedCount.ToString()).Append("|")
        For Each p As String In item.GetAssemblyPaths()
            sb.Append(p).Append(";")
        Next
        Return sb.ToString()
    End Function

    Public Shared Function TryGet(ByVal item As PartBomItem, ByRef root As BomWhereUsedNode, ByRef impact As BomImpactResult) As Boolean
        Dim key As String = MakeKey(item)
        If key.Length = 0 Then Return False
        Dim entry As BomDependencyCacheEntry = Nothing
        If Not _entries.TryGetValue(key, entry) OrElse entry Is Nothing Then Return False
        If Not String.Equals(entry.Signature, MakeSignature(item), StringComparison.Ordinal) Then
            _entries.Remove(key)
            Return False
        End If
        root = entry.Root
        impact = entry.Impact
        Return root IsNot Nothing AndAlso impact IsNot Nothing
    End Function

    Public Shared Sub Put(ByVal item As PartBomItem, ByVal root As BomWhereUsedNode, ByVal impact As BomImpactResult)
        Dim key As String = MakeKey(item)
        If key.Length = 0 Then Exit Sub
        Dim entry As New BomDependencyCacheEntry()
        entry.Signature = MakeSignature(item)
        entry.Root = root
        entry.Impact = impact
        _entries(key) = entry
    End Sub

    Public Shared Sub Invalidate(ByVal item As PartBomItem)
        Dim key As String = MakeKey(item)
        If key.Length > 0 Then _entries.Remove(key)
    End Sub

    Public Shared Sub Clear()
        _entries.Clear()
    End Sub
End Class

Public Class BomDependencyForm
    Inherits Form

    Private _tree As TreeView
    Private _grid As DataGridView
    Private _closeButton As Button
    Private _item As PartBomItem
    Private _impact As BomImpactResult
    Private _root As BomWhereUsedNode
    Private _openDrawing As Action(Of String)
    Private _locateAssembly As Action(Of String)
    Private _filterImpact As Action(Of BomImpactResult)

    Public Sub New(ByVal item As PartBomItem,
                   ByVal root As BomWhereUsedNode,
                   ByVal impact As BomImpactResult,
                   ByVal openDrawing As Action(Of String),
                   ByVal locateAssembly As Action(Of String),
                   ByVal filterImpact As Action(Of BomImpactResult))
        _item = item
        _root = root
        _impact = impact
        _openDrawing = openDrawing
        _locateAssembly = locateAssembly
        _filterImpact = filterImpact

        Text = "PROJECT INTELLIGENCE - WHERE USED / IMPACT"
        StartPosition = FormStartPosition.CenterParent
        Width = 980
        Height = 680
        MinimizeBox = False

        Dim split As New SplitContainer()
        split.Dock = DockStyle.Fill
        split.Orientation = Orientation.Vertical
        split.SplitterDistance = 430

        _tree = New TreeView()
        _tree.Dock = DockStyle.Fill
        _tree.HideSelection = False
        AddHandler _tree.NodeMouseDoubleClick, AddressOf TreeDoubleClick

        _grid = New DataGridView()
        _grid.Dock = DockStyle.Fill
        _grid.ReadOnly = True
        _grid.AllowUserToAddRows = False
        _grid.AllowUserToDeleteRows = False
        _grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        _grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
        _grid.Columns.Add("TYPE", "TYPE")
        _grid.Columns.Add("NAME", "NAME / PATH")
        _grid.Columns.Add("DETAIL", "DETAIL")
        AddHandler _grid.CellDoubleClick, AddressOf GridDoubleClick

        split.Panel1.Controls.Add(_tree)
        split.Panel2.Controls.Add(_grid)

        Dim bottom As New Panel()
        bottom.Dock = DockStyle.Bottom
        bottom.Height = 44
        Dim filterButton As New Button()
        filterButton.Text = "FILTER IMPACT"
        filterButton.Width = 125
        filterButton.Height = 28
        filterButton.Left = 705
        filterButton.Top = 8
        filterButton.Anchor = AnchorStyles.Right Or AnchorStyles.Top
        AddHandler filterButton.Click, Sub()
                                           If _filterImpact IsNot Nothing Then _filterImpact(_impact)
                                       End Sub
        bottom.Controls.Add(filterButton)

        _closeButton = New Button()
        _closeButton.Text = "CLOSE"
        _closeButton.Width = 100
        _closeButton.Height = 28
        _closeButton.Left = 840
        _closeButton.Top = 8
        _closeButton.Anchor = AnchorStyles.Right Or AnchorStyles.Top
        AddHandler _closeButton.Click, Sub() Me.Close()
        bottom.Controls.Add(_closeButton)

        Controls.Add(split)
        Controls.Add(bottom)
        BuildContent()
    End Sub

    Private Sub BuildContent()
        _tree.Nodes.Clear()
        _grid.Rows.Clear()

        Dim partName As String = If(_item Is Nothing, "", If(String.IsNullOrWhiteSpace(_item.PartNumber), _item.FileName, _item.PartNumber))
        Dim rootNode As New TreeNode(partName & "   [PART]")
        rootNode.Tag = "PART|" & partName
        _tree.Nodes.Add(rootNode)
        AddWhereUsedChildren(rootNode, _root)

        Dim drawingRoot As New TreeNode("DRAWINGS (" & If(_impact Is Nothing, 0, _impact.Drawings.Count).ToString() & ")")
        drawingRoot.Tag = "GROUP|DRAWINGS"
        rootNode.Nodes.Add(drawingRoot)
        If _impact IsNot Nothing Then
            Dim drawings As New List(Of String)(_impact.Drawings)
            drawings.Sort(StringComparer.OrdinalIgnoreCase)
            For Each d As String In drawings
                Dim dn As New TreeNode(System.IO.Path.GetFileName(d))
                dn.ToolTipText = d
                dn.Tag = "DRAWING|" & d
                drawingRoot.Nodes.Add(dn)
                _grid.Rows.Add("DRAWING", d, "Double-click để mở")
            Next

            Dim paths As New List(Of String)(_impact.AssemblyPaths)
            paths.Sort(StringComparer.OrdinalIgnoreCase)
            For Each p As String In paths
                _grid.Rows.Add("ASSEMBLY PATH", p, "Dependency")
            Next
        End If

        If _item IsNot Nothing Then
            _grid.Rows.Insert(0, "SUMMARY", partName,
                              "Qty=" & _item.Quantity.ToString() &
                              " | Visible=" & Math.Max(0, _item.Quantity - _item.SuppressedCount).ToString() &
                              " | Suppressed=" & Math.Max(0, _item.SuppressedCount).ToString())
        End If

        rootNode.Expand()
        drawingRoot.Expand()
    End Sub

    Private Sub AddWhereUsedChildren(ByVal parentTree As TreeNode, ByVal source As BomWhereUsedNode)
        If source Is Nothing Then Exit Sub
        Dim children As New List(Of BomWhereUsedNode)(source.Children)
        children.Sort(Function(a As BomWhereUsedNode, b As BomWhereUsedNode) StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name))
        For Each child As BomWhereUsedNode In children
            Dim relation As String = If(parentTree.Parent Is Nothing, "DIRECT", "INDIRECT")
            Dim label As String = child.Name & "   [" & relation & " | Local " & child.LocalQty.ToString() & " | Occ " & child.OccurrenceCount.ToString() & "]"
            Dim tn As New TreeNode(label)
            tn.Tag = "ASSEMBLY|" & child.Name
            tn.ToolTipText = child.FullPath
            parentTree.Nodes.Add(tn)
            AddWhereUsedChildren(tn, child)
        Next
    End Sub

    Private Sub TreeDoubleClick(ByVal sender As Object, ByVal e As TreeNodeMouseClickEventArgs)
        If e Is Nothing OrElse e.Node Is Nothing OrElse e.Node.Tag Is Nothing Then Exit Sub
        Dim tagText As String = CStr(e.Node.Tag)
        If tagText.StartsWith("DRAWING|", StringComparison.OrdinalIgnoreCase) Then
            Dim p As String = tagText.Substring(8)
            If _openDrawing IsNot Nothing Then _openDrawing(p)
        ElseIf tagText.StartsWith("ASSEMBLY|", StringComparison.OrdinalIgnoreCase) Then
            Dim a As String = tagText.Substring(9)
            If _locateAssembly IsNot Nothing Then _locateAssembly(a)
        End If
    End Sub

    Private Sub GridDoubleClick(ByVal sender As Object, ByVal e As DataGridViewCellEventArgs)
        If e.RowIndex < 0 OrElse e.RowIndex >= _grid.Rows.Count Then Exit Sub
        Dim row As DataGridViewRow = _grid.Rows(e.RowIndex)
        Dim kind As String = Convert.ToString(row.Cells("TYPE").Value)
        Dim value As String = Convert.ToString(row.Cells("NAME").Value)
        If String.Equals(kind, "DRAWING", StringComparison.OrdinalIgnoreCase) Then
            If _openDrawing IsNot Nothing Then _openDrawing(value)
        ElseIf String.Equals(kind, "ASSEMBLY PATH", StringComparison.OrdinalIgnoreCase) Then
            Dim names() As String = value.Trim().Trim("\"c).Split("\"c)
            If names.Length > 0 AndAlso _locateAssembly IsNot Nothing Then _locateAssembly(names(names.Length - 1))
        End If
    End Sub
End Class


'####################################################################
' PHASE 6 - CHANGE MANAGEMENT
' SNAPSHOT / BOM COMPARE / CHANGE SET / CHANGE REPORT
'####################################################################
Public Class BomSnapshotItem
    Public Key As String = ""
    Public FileName As String = ""
    Public FilePath As String = ""
    Public PartNumber As String = ""
    Public Description As String = ""
    Public Material As String = ""
    Public Revision As String = ""
    Public BomStructure As String = ""
    Public Quantity As Integer = 0
End Class

Public Class BomSnapshot
    Public Name As String = ""
    Public CreatedUtc As DateTime = DateTime.UtcNow
    Public AssemblyName As String = ""
    Public Items As New Dictionary(Of String, BomSnapshotItem)(StringComparer.OrdinalIgnoreCase)
End Class

Public Enum BomChangeKind
    Added = 0
    Removed = 1
    QuantityChanged = 2
    PropertyChanged = 3
End Enum

Public Class BomChangeRecord
    Public Kind As BomChangeKind
    Public Key As String = ""
    Public PartNumber As String = ""
    Public FileName As String = ""
    Public FieldName As String = ""
    Public OldValue As String = ""
    Public NewValue As String = ""
End Class

Public Class BomChangeSet
    Public SnapshotName As String = ""
    Public ComparedUtc As DateTime = DateTime.UtcNow
    Public Changes As New List(Of BomChangeRecord)()

    Public Function CountKind(ByVal kind As BomChangeKind) As Integer
        Dim n As Integer = 0
        For Each c As BomChangeRecord In Changes
            If c IsNot Nothing AndAlso c.Kind = kind Then n += 1
        Next
        Return n
    End Function
End Class

Public Class BomChangeManagementEngine
    Public Shared Function Capture(ByVal snapshotName As String,
                                   ByVal assemblyName As String,
                                   ByVal items As List(Of PartBomItem)) As BomSnapshot
        Dim snap As New BomSnapshot()
        snap.Name = snapshotName
        snap.AssemblyName = assemblyName
        snap.CreatedUtc = DateTime.UtcNow
        If items Is Nothing Then Return snap

        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            Dim s As New BomSnapshotItem()
            s.Key = MakeKey(item)
            s.FileName = If(item.FileName, "")
            s.FilePath = If(item.FilePath, "")
            s.PartNumber = If(item.PartNumber, "")
            s.Description = If(item.Description, "")
            s.Material = If(item.Material, "")
            s.Revision = If(item.Revision, "")
            s.BomStructure = If(item.BomStructure, "")
            s.Quantity = Math.Max(0, item.Quantity)
            If s.Key.Length > 0 Then snap.Items(s.Key) = s
        Next
        Return snap
    End Function

    Public Shared Function Compare(ByVal snap As BomSnapshot,
                                   ByVal currentItems As List(Of PartBomItem)) As BomChangeSet
        Dim result As New BomChangeSet()
        If snap Is Nothing Then Return result
        result.SnapshotName = snap.Name

        Dim current As New Dictionary(Of String, PartBomItem)(StringComparer.OrdinalIgnoreCase)
        If currentItems IsNot Nothing Then
            For Each item As PartBomItem In currentItems
                If item Is Nothing Then Continue For
                Dim key As String = MakeKey(item)
                If key.Length > 0 Then current(key) = item
            Next
        End If

        For Each pair As KeyValuePair(Of String, BomSnapshotItem) In snap.Items
            Dim oldItem As BomSnapshotItem = pair.Value
            Dim nowItem As PartBomItem = Nothing
            If Not current.TryGetValue(pair.Key, nowItem) Then
                AddChange(result, BomChangeKind.Removed, oldItem, Nothing, "ITEM", oldItem.PartNumber, "")
                Continue For
            End If

            If oldItem.Quantity <> nowItem.Quantity Then
                AddChange(result, BomChangeKind.QuantityChanged, oldItem, nowItem, "QTY",
                          oldItem.Quantity.ToString(), nowItem.Quantity.ToString())
            End If
            CompareField(result, oldItem, nowItem, "PART NUMBER", oldItem.PartNumber, nowItem.PartNumber)
            CompareField(result, oldItem, nowItem, "DESCRIPTION", oldItem.Description, nowItem.Description)
            CompareField(result, oldItem, nowItem, "MATERIAL", oldItem.Material, nowItem.Material)
            CompareField(result, oldItem, nowItem, "REVISION", oldItem.Revision, nowItem.Revision)
            CompareField(result, oldItem, nowItem, "BOM STRUCTURE", oldItem.BomStructure, nowItem.BomStructure)
            current.Remove(pair.Key)
        Next

        For Each pair As KeyValuePair(Of String, PartBomItem) In current
            AddChange(result, BomChangeKind.Added, Nothing, pair.Value, "ITEM", "", pair.Value.PartNumber)
        Next
        Return result
    End Function

    Private Shared Sub CompareField(ByVal result As BomChangeSet,
                                    ByVal oldItem As BomSnapshotItem,
                                    ByVal nowItem As PartBomItem,
                                    ByVal fieldName As String,
                                    ByVal oldValue As String,
                                    ByVal newValue As String)
        If Not String.Equals(If(oldValue, ""), If(newValue, ""), StringComparison.Ordinal) Then
            AddChange(result, BomChangeKind.PropertyChanged, oldItem, nowItem, fieldName, oldValue, newValue)
        End If
    End Sub

    Private Shared Sub AddChange(ByVal result As BomChangeSet,
                                 ByVal kind As BomChangeKind,
                                 ByVal oldItem As BomSnapshotItem,
                                 ByVal nowItem As PartBomItem,
                                 ByVal fieldName As String,
                                 ByVal oldValue As String,
                                 ByVal newValue As String)
        Dim c As New BomChangeRecord()
        c.Kind = kind
        c.Key = If(nowItem IsNot Nothing, MakeKey(nowItem), If(oldItem IsNot Nothing, oldItem.Key, ""))
        c.PartNumber = If(nowItem IsNot Nothing, nowItem.PartNumber, If(oldItem IsNot Nothing, oldItem.PartNumber, ""))
        c.FileName = If(nowItem IsNot Nothing, nowItem.FileName, If(oldItem IsNot Nothing, oldItem.FileName, ""))
        c.FieldName = fieldName
        c.OldValue = If(oldValue, "")
        c.NewValue = If(newValue, "")
        result.Changes.Add(c)
    End Sub

    Public Shared Function MakeKey(ByVal item As PartBomItem) As String
        If item Is Nothing Then Return ""
        If Not String.IsNullOrWhiteSpace(item.DocumentKey) Then Return item.DocumentKey
        If Not String.IsNullOrWhiteSpace(item.FilePath) Then Return item.FilePath
        Return item.PartNumber & "|" & item.FileName
    End Function
End Class

Public Class BomChangeSetForm
    Inherits Form
    Private _grid As DataGridView

    Public Sub New(ByVal changeSet As BomChangeSet)
        Text = "BOM CHANGE SET  | V23 FINAL"
        StartPosition = FormStartPosition.CenterParent
        Width = 1050
        Height = 650

        Dim summary As New Label()
        summary.Dock = DockStyle.Top
        summary.Height = 42
        summary.TextAlign = ContentAlignment.MiddleLeft
        summary.Font = New Font("Segoe UI Semibold", 9.5F)
        summary.Text = "Snapshot: " & changeSet.SnapshotName &
                       "    | ADDED " & changeSet.CountKind(BomChangeKind.Added).ToString() &
                       " | REMOVED " & changeSet.CountKind(BomChangeKind.Removed).ToString() &
                       " | QTY " & changeSet.CountKind(BomChangeKind.QuantityChanged).ToString() &
                       " | PROPERTY " & changeSet.CountKind(BomChangeKind.PropertyChanged).ToString()

        _grid = New DataGridView()
        _grid.Dock = DockStyle.Fill
        _grid.ReadOnly = True
        _grid.AllowUserToAddRows = False
        _grid.AllowUserToDeleteRows = False
        _grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        _grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
        _grid.Columns.Add("KIND", "CHANGE")
        _grid.Columns.Add("PN", "PART NUMBER")
        _grid.Columns.Add("FILE", "FILE")
        _grid.Columns.Add("FIELD", "FIELD")
        _grid.Columns.Add("OLD", "OLD VALUE")
        _grid.Columns.Add("NEW", "NEW VALUE")

        For Each c As BomChangeRecord In changeSet.Changes
            _grid.Rows.Add(c.Kind.ToString().ToUpperInvariant(), c.PartNumber, c.FileName, c.FieldName, c.OldValue, c.NewValue)
        Next

        Controls.Add(_grid)
        Controls.Add(summary)
    End Sub
End Class


'####################################################################
' PHASE 7 - MANUFACTURING INTELLIGENCE
' MATERIAL / THICKNESS / PROCESS / PROCUREMENT SUMMARY
'####################################################################
Public Class BomManufacturingGroup
    Public Key As String = ""
    Public Material As String = ""
    Public Thickness As String = ""
    Public ProcessName As String = ""
    Public PartCount As Integer = 0
    Public TotalQty As Integer = 0
    Public PurchasedCount As Integer = 0
    Public ManufacturedCount As Integer = 0
End Class

Public Class BomManufacturingSummary
    Public Groups As New List(Of BomManufacturingGroup)()
    Public TotalUniqueParts As Integer = 0
    Public TotalQty As Integer = 0
    Public PurchasedParts As Integer = 0
    Public ManufacturedParts As Integer = 0
    Public ReferenceParts As Integer = 0
End Class


Public Enum BomManufacturingType
    Unknown = 0
    Plate = 1
    Profile = 2
    Tube = 3
    SheetMetal = 4
    Purchased = 5
    Fastener = 6
End Enum

Public Enum BomClassificationConfidence
    Low = 0
    Medium = 1
    High = 2
    Manual = 3
End Enum

Public Class BomManufacturingRecord
    Public PartNumber As String = ""
    Public Description As String = ""
    Public Material As String = ""
    Public ManufacturingType As BomManufacturingType = BomManufacturingType.Unknown
    Public Confidence As BomClassificationConfidence = BomClassificationConfidence.Low
    Public Thickness As Double = 0
    Public Width As Double = 0
    Public Length As Double = 0
    Public Quantity As Integer = 0
    Public UnitMass As Double = 0
    Public TotalMass As Double = 0
    Public Profile As String = ""
    Public Section As String = ""
    Public Standard As String = ""
    Public Vendor As String = ""
    Public StockNumber As String = ""
    Public ManualOverride As Boolean = False
End Class


Public Class BomManufacturingListBuilder
    Public Shared Function BuildRecords(ByVal items As List(Of PartBomItem)) As List(Of BomManufacturingRecord)
        Dim result As New List(Of BomManufacturingRecord)()
        If items Is Nothing Then Return result
        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            Dim r As New BomManufacturingRecord()
            r.PartNumber = item.PartNumber
            r.Description = item.Description
            r.Material = item.Material
            r.Quantity = Math.Max(1, item.Quantity)
            r.UnitMass = item.Mass
            r.TotalMass = r.UnitMass * r.Quantity
            r.Thickness = item.Thickness
            r.Length = item.BoundingMaxMm
            r.Width = item.BoundingMidMm

            Dim pn As String = (If(item.PartNumber, "") & " " & If(item.Description, "")).ToUpperInvariant()
            If item.IsPurchased Then
                r.ManufacturingType = BomManufacturingType.Purchased
                r.Confidence = BomClassificationConfidence.High
            ElseIf pn.Contains("BOLT") OrElse pn.Contains("SCREW") OrElse pn.Contains("NUT") OrElse pn.Contains("WASHER") Then
                r.ManufacturingType = BomManufacturingType.Fastener
                r.Confidence = BomClassificationConfidence.Medium
            ElseIf item.IsSheetMetal Then
                r.ManufacturingType = BomManufacturingType.SheetMetal
                r.Confidence = BomClassificationConfidence.High
            ElseIf r.Thickness > 0 AndAlso item.BoundingMaxMm > 0 AndAlso item.BoundingMinMm > 0 AndAlso
                   r.Thickness <= Math.Max(0.01R, item.BoundingMinMm * 1.25R) Then
                r.ManufacturingType = BomManufacturingType.Plate
                r.Confidence = BomClassificationConfidence.Medium
            ElseIf pn.Contains("PIPE") OrElse pn.Contains("TUBE") OrElse pn.Contains("ỐNG") Then
                r.ManufacturingType = BomManufacturingType.Tube
                r.Confidence = BomClassificationConfidence.Medium
            ElseIf pn.Contains("ANGLE") OrElse pn.Contains("CHANNEL") OrElse pn.Contains("PROFILE") OrElse pn.Contains("I-BEAM") OrElse pn.Contains("H-BEAM") OrElse pn.Contains("C-SECTION") Then
                r.ManufacturingType = BomManufacturingType.Profile
                r.Confidence = BomClassificationConfidence.Low
            Else
                r.ManufacturingType = BomManufacturingType.Unknown
                r.Confidence = BomClassificationConfidence.Low
            End If
            result.Add(r)
        Next
        Return result
    End Function

    Public Shared Function Filter(ByVal records As List(Of BomManufacturingRecord), ByVal manufacturingType As BomManufacturingType) As List(Of BomManufacturingRecord)
        Dim result As New List(Of BomManufacturingRecord)()
        If records Is Nothing Then Return result
        For Each r As BomManufacturingRecord In records
            If r IsNot Nothing AndAlso r.ManufacturingType = manufacturingType Then result.Add(r)
        Next
        Return result
    End Function
End Class

Public Class BomManufacturingEngine
    Public Shared Function Analyze(ByVal items As List(Of PartBomItem)) As BomManufacturingSummary
        Dim result As New BomManufacturingSummary()
        Dim groups As New Dictionary(Of String, BomManufacturingGroup)(StringComparer.OrdinalIgnoreCase)
        If items Is Nothing Then Return result

        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            result.TotalUniqueParts += 1
            result.TotalQty += Math.Max(0, item.Quantity)

            Dim structureName As String = BomStructurePolicy.Normalize(item.BomStructure)
            If structureName = "REFERENCE" Then
                result.ReferenceParts += 1
                Continue For
            End If

            Dim purchased As Boolean = (structureName = "PURCHASED")
            If purchased Then
                result.PurchasedParts += 1
            Else
                result.ManufacturedParts += 1
            End If

            Dim material As String = If(String.IsNullOrWhiteSpace(item.Material), "(NO MATERIAL)", item.Material.Trim())
            Dim thickness As String = GetThicknessText(item)
            Dim processName As String = InferProcess(item, purchased)
            Dim key As String = material & "|" & thickness & "|" & processName

            Dim g As BomManufacturingGroup = Nothing
            If Not groups.TryGetValue(key, g) Then
                g = New BomManufacturingGroup()
                g.Key = key
                g.Material = material
                g.Thickness = thickness
                g.ProcessName = processName
                groups.Add(key, g)
            End If
            g.PartCount += 1
            g.TotalQty += Math.Max(0, item.Quantity)
            If purchased Then g.PurchasedCount += 1 Else g.ManufacturedCount += 1
        Next

        result.Groups = New List(Of BomManufacturingGroup)(groups.Values)
        result.Groups.Sort(Function(a As BomManufacturingGroup, b As BomManufacturingGroup)
                               Dim c As Integer = StringComparer.OrdinalIgnoreCase.Compare(a.Material, b.Material)
                               If c <> 0 Then Return c
                               c = StringComparer.OrdinalIgnoreCase.Compare(a.Thickness, b.Thickness)
                               If c <> 0 Then Return c
                               Return StringComparer.OrdinalIgnoreCase.Compare(a.ProcessName, b.ProcessName)
                           End Function)
        Return result
    End Function

    Private Shared Function GetThicknessText(ByVal item As PartBomItem) As String
        If item Is Nothing Then Return ""
        Try
            If String.Equals(item.GeometryLoadState, "LOADED", StringComparison.OrdinalIgnoreCase) AndAlso item.Thickness > 0 Then
                Return item.Thickness.ToString("0.###")
            End If
        Catch
        End Try
        Return "(LAZY)"
    End Function

    Private Shared Function InferProcess(ByVal item As PartBomItem, ByVal purchased As Boolean) As String
        If purchased Then Return "PURCHASE"
        If item Is Nothing Then Return "UNKNOWN"
        Dim g As String = If(item.GeometryType, "").Trim().ToUpperInvariant()
        If g.Contains("SHEET") OrElse g.Contains("PLATE") Then Return "CUT / BEND"
        If g.Contains("TUBE") OrElse g.Contains("PIPE") OrElse g.Contains("PROFILE") Then Return "CUT / FABRICATION"
        If g.Contains("CYL") OrElse g.Contains("ROUND") Then Return "MACHINING"
        If g.Length > 0 Then Return g
        Return "MANUFACTURE"
    End Function
End Class

Public Class BomManufacturingDashboard
    Inherits Form

    Public Sub New(ByVal summary As BomManufacturingSummary)
        Text = "MANUFACTURING INTELLIGENCE"
        StartPosition = FormStartPosition.CenterParent
        Width = 1050
        Height = 680

        Dim top As New Label()
        top.Dock = DockStyle.Top
        top.Height = 46
        top.TextAlign = ContentAlignment.MiddleLeft
        top.Font = New Font("Segoe UI Semibold", 9.5F)
        top.Text = "UNIQUE PARTS " & summary.TotalUniqueParts.ToString() &
                   "   | TOTAL QTY " & summary.TotalQty.ToString() &
                   "   | MANUFACTURE " & summary.ManufacturedParts.ToString() &
                   "   | PURCHASE " & summary.PurchasedParts.ToString() &
                   "   | REFERENCE " & summary.ReferenceParts.ToString()

        Dim grid As New DataGridView()
        grid.Dock = DockStyle.Fill
        grid.ReadOnly = True
        grid.AllowUserToAddRows = False
        grid.AllowUserToDeleteRows = False
        grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
        grid.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
        grid.Columns.Add("MATERIAL", "MATERIAL")
        grid.Columns.Add("THICKNESS", "THICKNESS")
        grid.Columns.Add("PROCESS", "PROCESS")
        grid.Columns.Add("PARTS", "UNIQUE PARTS")
        grid.Columns.Add("QTY", "TOTAL QTY")
        grid.Columns.Add("MFG", "MANUFACTURE")
        grid.Columns.Add("BUY", "PURCHASE")

        For Each g As BomManufacturingGroup In summary.Groups
            grid.Rows.Add(g.Material, g.Thickness, g.ProcessName,
                          g.PartCount.ToString(), g.TotalQty.ToString(),
                          g.ManufacturedCount.ToString(), g.PurchasedCount.ToString())
        Next

        Controls.Add(grid)
        Controls.Add(top)
    End Sub
End Class


'####################################################################
' PHASE 8 - EXPORT / REPORTING CENTER
' UNIFIED REPORT MODEL + CSV/HTML REPORTS
'####################################################################
Public Class BomReportRow
    Public Values As New List(Of String)()
End Class

Public Class BomReportTable
    Public Title As String = ""
    Public Headers As New List(Of String)()
    Public Rows As New List(Of BomReportRow)()
End Class

Public Class BomReportingEngine
    Public Shared Function BuildBomReport(ByVal assemblyName As String,
                                          ByVal items As List(Of PartBomItem)) As BomReportTable
        Dim t As New BomReportTable()
        t.Title = "BOM REPORT - " & assemblyName
        t.Headers.AddRange(New String() {"PART NUMBER","DESCRIPTION","FILE","QTY","MATERIAL","REVISION","BOM STRUCTURE","STATUS"})
        If items Is Nothing Then Return t
        For Each item As PartBomItem In items
            If item Is Nothing Then Continue For
            Dim r As New BomReportRow()
            r.Values.Add(If(item.PartNumber, ""))
            r.Values.Add(If(item.Description, ""))
            r.Values.Add(If(item.FileName, ""))
            r.Values.Add(item.Quantity.ToString())
            r.Values.Add(If(item.Material, ""))
            r.Values.Add(If(item.Revision, ""))
            r.Values.Add(BomStructurePolicy.Normalize(item.BomStructure))
            r.Values.Add(If(item.DataStatus, ""))
            t.Rows.Add(r)
        Next
        Return t
    End Function

    Public Shared Sub ExportCsv(ByVal table As BomReportTable, ByVal fileName As String)
        Using sw As New System.IO.StreamWriter(fileName, False, System.Text.Encoding.UTF8)
            sw.WriteLine(String.Join(",", table.Headers.ConvertAll(Function(x As String) Csv(x)).ToArray()))
            For Each row As BomReportRow In table.Rows
                sw.WriteLine(String.Join(",", row.Values.ConvertAll(Function(x As String) Csv(x)).ToArray()))
            Next
        End Using
    End Sub

    Public Shared Sub ExportHtml(ByVal table As BomReportTable, ByVal fileName As String)
        Dim sb As New System.Text.StringBuilder()
        sb.AppendLine("<!DOCTYPE html><html><head><meta charset=""utf-8""><title>" & H(table.Title) & "</title>")
        sb.AppendLine("<style>body{font-family:Segoe UI,Arial;margin:24px;color:#222}h1{font-size:22px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid #ccc;padding:6px 8px;text-align:left}th{background:#eee;position:sticky;top:0}.summary{margin-bottom:14px}</style></head><body>")
        sb.AppendLine("<h1>" & H(table.Title) & "</h1>")
        sb.AppendLine("<div class=""summary"">Rows: " & table.Rows.Count.ToString() & " | Generated: " & DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") & "</div>")
        sb.AppendLine("<table><thead><tr>")
        For Each hText As String In table.Headers
            sb.Append("<th>").Append(H(hText)).AppendLine("</th>")
        Next
        sb.AppendLine("</tr></thead><tbody>")
        For Each row As BomReportRow In table.Rows
            sb.AppendLine("<tr>")
            For Each v As String In row.Values
                sb.Append("<td>").Append(H(v)).AppendLine("</td>")
            Next
            sb.AppendLine("</tr>")
        Next
        sb.AppendLine("</tbody></table></body></html>")
        System.IO.File.WriteAllText(fileName, sb.ToString(), System.Text.Encoding.UTF8)
    End Sub

    Private Shared Function Csv(ByVal value As String) As String
        Dim s As String = If(value, "")
        Return """" & s.Replace("""", """""") & """"
    End Function

    Private Shared Function H(ByVal value As String) As String
        Dim s As String = If(value, "")
        Return s.Replace("&","&amp;").Replace("<","&lt;").Replace(">","&gt;").Replace("""","&quot;")
    End Function
End Class

Public Class BomReportCenterForm
    Inherits Form
    Private _grid As DataGridView
    Private _table As BomReportTable

    Public Sub New(ByVal table As BomReportTable)
        _table = table
