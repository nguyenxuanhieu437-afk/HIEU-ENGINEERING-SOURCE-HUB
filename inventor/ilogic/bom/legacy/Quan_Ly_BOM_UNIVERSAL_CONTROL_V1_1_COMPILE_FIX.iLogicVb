' SUBSECTION 15.05 - UNIT DISPLAY / GRID COLUMNS
'####################################################################

    Private Sub UnitManagerClicked(ByVal sender As Object, ByVal e As EventArgs)
        Try
            Using unitForm As New Form()
                unitForm.Text = "BOM TOOL PRO - UNIT MANAGER"
                unitForm.StartPosition = FormStartPosition.CenterParent
                unitForm.FormBorderStyle = FormBorderStyle.FixedDialog
                unitForm.MaximizeBox = False
                unitForm.MinimizeBox = False
                unitForm.ClientSize = New Size(430, 270)
                unitForm.Font = New Font("Segoe UI", 9.0F)

                Dim labels() As String = {"Khối lượng", "Chiều dài / Thickness / Bounding Box", "Diện tích", "Thể tích"}
                Dim options As String()() = { _
                    New String() {"kg", "g", "mg", "lb", "oz", "ton"}, _
                    New String() {"mm", "cm", "m", "inch", "ft"}, _
                    New String() {"mm²", "cm²", "m²", "inch²", "ft²"}, _
                    New String() {"mm³", "cm³", "L", "m³", "inch³", "ft³"} _
                }
                Dim current() As String = {BomUnitManager.MassUnit, BomUnitManager.LengthUnit, BomUnitManager.AreaUnit, BomUnitManager.VolumeUnit}
                Dim combos As New List(Of ComboBox)()

                For i As Integer = 0 To 3
                    Dim lbl As New Label()
                    lbl.Text = labels(i)
                    lbl.Left = 22
                    lbl.Top = 24 + i * 48
                    lbl.Width = 235
                    lbl.Height = 26
                    lbl.TextAlign = ContentAlignment.MiddleLeft
                    unitForm.Controls.Add(lbl)

                    Dim cbo As New ComboBox()
                    cbo.DropDownStyle = ComboBoxStyle.DropDownList
                    cbo.Left = 270
                    cbo.Top = 23 + i * 48
                    cbo.Width = 125
                    cbo.Items.AddRange(options(i))
                    cbo.SelectedItem = current(i)
                    If cbo.SelectedIndex < 0 Then cbo.SelectedIndex = 0
                    unitForm.Controls.Add(cbo)
                    combos.Add(cbo)
                Next

                Dim okButton As New Button()
                okButton.Text = "ÁP DỤNG"
                okButton.DialogResult = DialogResult.OK
                okButton.Left = 220
                okButton.Top = 218
                okButton.Width = 95
                unitForm.Controls.Add(okButton)

                Dim cancelButton As New Button()
                cancelButton.Text = "HỦY"
                cancelButton.DialogResult = DialogResult.Cancel
                cancelButton.Left = 322
                cancelButton.Top = 218
                cancelButton.Width = 72
                unitForm.Controls.Add(cancelButton)
                unitForm.AcceptButton = okButton
                unitForm.CancelButton = cancelButton

                If unitForm.ShowDialog(Me) = DialogResult.OK Then
                    BomUnitManager.MassUnit = Convert.ToString(combos(0).SelectedItem)
                    BomUnitManager.LengthUnit = Convert.ToString(combos(1).SelectedItem)
                    BomUnitManager.AreaUnit = Convert.ToString(combos(2).SelectedItem)
                    BomUnitManager.VolumeUnit = Convert.ToString(combos(3).SelectedItem)
                    RefreshUnitDisplay()
                End If
            End Using
        Catch ex As Exception
            MessageBox.Show("Không thể đổi đơn vị:" & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End Try
    End Sub

    Private Sub RefreshUnitDisplay()
        Grid.SuspendLayout()
        Try
            If Grid.Columns.Contains("THICKNESS") Then Grid.Columns("THICKNESS").HeaderText = "THICK (" & BomUnitManager.LengthUnit & ")"
            If Grid.Columns.Contains("BOUNDING_BOX") Then Grid.Columns("BOUNDING_BOX").HeaderText = "BOUNDING BOX L x W x H (" & BomUnitManager.LengthUnit & ")"
            For Each p As PropertyColumnInfo In _selectedProperties
                If Grid.Columns.Contains(p.Key) Then Grid.Columns(p.Key).HeaderText = BomUnitManager.GetPropertyHeader(p.PropertyName)
            Next

            For Each row As DataGridViewRow In Grid.Rows
                Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                If item Is Nothing Then Continue For
                If Grid.Columns.Contains("THICKNESS") Then row.Cells("THICKNESS").Value = BomUnitManager.FormatLength(item.Thickness)
                If Grid.Columns.Contains("BOUNDING_BOX") Then row.Cells("BOUNDING_BOX").Value = BomUnitManager.FormatBoundingBox(item)
                For Each p As PropertyColumnInfo In _selectedProperties
                    If Grid.Columns.Contains(p.Key) Then row.Cells(p.Key).Value = BomUnitManager.GetPropertyDisplayValue(item, p)
                Next
            Next
            StatusLoadTime.Text = "Đơn vị: " & BomUnitManager.MassUnit & " | " & BomUnitManager.LengthUnit & " | " & BomUnitManager.AreaUnit & " | " & BomUnitManager.VolumeUnit
        Finally
            Grid.ResumeLayout()
        End Try
    End Sub

    Private Sub BuildColumns()
        Grid.Columns.Clear()
        _excelHeaderTitles.Clear()
        AddColumn("ITEM", "ITEM", 62, True, False)
        AddColumn("QTY", "QTY", 62, True, False)
        If _includeFileName Then AddColumn("FILE_NAME", "FILE NAME", 150, False, False)
        If _includeFilePath Then AddColumn("FILE_PATH", "FILE PATH", 330, False, False)
        If _includeParentAssembly Then AddColumn("PARENT_ASSEMBLY", "NẰM TRONG ASSEMBLY", 190, False, False)
        AddColumn("DRAWING_STATUS", "DRAWING", 92, True, False)
        AddColumn("DATA_STATUS", "DATA STATUS", 170, False, False)

        'Không tự động hiện Feature chưa chọn.
        For Each featureKey As String In _enabledFeatures
            AddFeatureColumn(featureKey)
        Next

        For Each p As PropertyColumnInfo In _selectedProperties
            AddPropertyColumn(p)
        Next
    End Sub

    Private Sub AddPropertyColumn(ByVal p As PropertyColumnInfo)
        If Grid.Columns.Contains(p.Key) Then Exit Sub
        Dim isEditable As Boolean = IsEditableProperty(p.PropertyName)
        AddColumn(p.Key, BomUnitManager.GetPropertyHeader(p.PropertyName), CInt(GetRecommendedColumnWidth(p.PropertyName) * 7), False, isEditable)
        Dim col As DataGridViewColumn = Grid.Columns(p.Key)
        col.Tag = p
        col.ToolTipText = If(isEditable, "Có thể chỉnh sửa trực tiếp. Nhấn F2 hoặc nhập dữ liệu.", "Thuộc tính chỉ đọc hoặc không nên sửa trực tiếp.")
    End Sub

    Private Sub AddColumn(ByVal name As String, ByVal header As String, ByVal width As Integer, ByVal centered As Boolean, ByVal editable As Boolean)
        Dim col As New System.Windows.Forms.DataGridViewTextBoxColumn()
        col.Name = name
        _excelHeaderTitles(name) = header
        col.HeaderText = ColumnIndexToExcelName(Grid.Columns.Count) & vbCrLf & header
        col.Width = Math.Max(55, width)
        col.MinimumWidth = 48
        col.ReadOnly = Not editable
        'V13.2: bắt buộc Programmatic. Automatic sẽ trộn Assembly Header với Part rows.
        col.SortMode = System.Windows.Forms.DataGridViewColumnSortMode.Programmatic
        col.AutoSizeMode = System.Windows.Forms.DataGridViewAutoSizeColumnMode.None
        If centered Then col.DefaultCellStyle.Alignment = System.Windows.Forms.DataGridViewContentAlignment.MiddleCenter
        Grid.Columns.Add(col)
    End Sub

    Private Sub AddImageColumn(ByVal name As String, ByVal header As String, ByVal width As Integer)
        If Grid.Columns.Contains(name) Then Exit Sub
        Dim col As New System.Windows.Forms.DataGridViewImageColumn()
        col.Name = name
        _excelHeaderTitles(name) = header
        col.HeaderText = ColumnIndexToExcelName(Grid.Columns.Count) & vbCrLf & header
        col.Width = Math.Max(72, width)
        col.MinimumWidth = 64
        col.ReadOnly = True
        col.SortMode = System.Windows.Forms.DataGridViewColumnSortMode.NotSortable
        col.ImageLayout = System.Windows.Forms.DataGridViewImageCellLayout.Zoom
        Grid.Columns.Add(col)
        col.DisplayIndex = Math.Min(1, Grid.Columns.Count - 1)
    End Sub

    Private Sub AddFeatureColumn(ByVal featureKey As String)
        If String.IsNullOrWhiteSpace(featureKey) OrElse Not _featureRegistry.ContainsKey(featureKey) Then Exit Sub
        Dim f As BomFeatureDefinition = _featureRegistry(featureKey)
        If f.IsImage Then
            AddImageColumn(f.ColumnName, f.HeaderText, f.Width)
        Else
            AddColumn(f.ColumnName, f.HeaderText, f.Width, f.Centered, False)
        End If
    End Sub

    Private Function IsEditableProperty(ByVal propertyName As String) As Boolean
        Dim n As String = If(propertyName, "").Trim().ToUpperInvariant()
        If n = "MASS" OrElse n = "VOLUME" OrElse n = "AREA" OrElse n = "DENSITY" OrElse n = "THUMBNAIL" Then Return False
        If n.Contains("DATE CREATED") OrElse n.Contains("LAST UPDATED") Then Return False
        Return True
    End Function


'####################################################################
' SUBSECTION 15.06 - GRID ROW RENDERING / DATA STATUS
'####################################################################

    Private Sub LoadRows()
        Dim gridWatch As Stopwatch = Stopwatch.StartNew()
        BomPerformanceCounters.GridRefresh += 1
        _suppressCellWrite = True
        Grid.SuspendLayout()
        Grid.Rows.Clear()

        Dim itemNumber As Integer = 0

        If _bomDisplayMode = BomDisplayMode.PartsOnly Then
            _groupedView = False
            Dim flatItems As New List(Of PartBomItem)()
            For Each candidate As PartBomItem In _allItems
                If BomStructurePolicy.IncludeInPartsOnly(candidate) Then flatItems.Add(candidate)
            Next
            SortItemsForCurrentView(flatItems, "")
            For Each item As PartBomItem In flatItems
                itemNumber += 1
                AddPartRow(item, itemNumber, item.Quantity, "")
            Next
        Else
            _groupedView = True
            _structureRoot = BomStructureEngine.Build(_assemblyName, _allItems)
            Dim structureAudit As BomStructureAuditResult = BomStructureAuditEngine.Audit(_structureRoot)
            If structureAudit.Errors.Count > 0 Then
                BomLogger.Log("STRUCTURE", _assemblyName, "Audit", "ERROR",
                              String.Join(" | ", structureAudit.Errors.ToArray()))
            End If
            If structureAudit.Warnings.Count > 0 Then
                BomLogger.Log("STRUCTURE", _assemblyName, "Audit", "WARNING",
                              String.Join(" | ", structureAudit.Warnings.ToArray()))
            End If

            If _bomDisplayMode = BomDisplayMode.Structured Then
                'STRUCTURED: cây Assembly cha-con thật. Part chỉ nằm dưới đúng node trực tiếp.
                AddStructuredNodeRows(_structureRoot, itemNumber, False, True)
            Else
                'HYBRID: cây cha-con + Local Qty ở Part + Total Qty/Unique Part trên Assembly header.
                AddStructuredNodeRows(_structureRoot, itemNumber, True, True)
            End If
        End If

        UpdateSortGlyph()
        Grid.ResumeLayout()
        _suppressCellWrite = False
        ApplySearchFilter()
        gridWatch.Stop()
        BomPerformanceCounters.GridBuildMs += gridWatch.ElapsedMilliseconds
    End Sub

    Private Sub AddStructuredNodeRows(ByVal node As BomAssemblyNode, ByRef itemNumber As Integer, ByVal hybridMode As Boolean, ByVal includeRoot As Boolean)
        If node Is Nothing Then Exit Sub

        If includeRoot Then AddStructuredAssemblyHeaderRow(node, hybridMode)

        Dim entries As List(Of BomAssemblyPartEntry) = node.GetDirectEntries()
        If entries.Count > 0 Then
            Dim items As New List(Of PartBomItem)()
            Dim qtyByKey As New Dictionary(Of String, Integer)(StringComparer.OrdinalIgnoreCase)
            For Each entry As BomAssemblyPartEntry In entries
                If entry Is Nothing OrElse entry.Item Is Nothing Then Continue For
                items.Add(entry.Item)
                Dim key As String = If(String.IsNullOrWhiteSpace(entry.Item.DocumentKey), entry.Item.FilePath, entry.Item.DocumentKey)
                qtyByKey(key) = entry.LocalQuantity
            Next
            SortItemsForCurrentView(items, node.Name)
            For Each item As PartBomItem In items
                itemNumber += 1
                Dim key As String = If(String.IsNullOrWhiteSpace(item.DocumentKey), item.FilePath, item.DocumentKey)
                Dim qInfo As BomQuantityInfo = BomQuantityEngine.ForItemInNode(item, node)
                Dim localQty As Integer = If(qtyByKey.ContainsKey(key), qtyByKey(key), qInfo.LocalQty)
                If localQty <= 0 Then localQty = qInfo.LocalQty
                AddPartRow(item, itemNumber, localQty, node.Name)
                Dim row As DataGridViewRow = Grid.Rows(Grid.Rows.Count - 1)
                row.HeaderCell.Tag = node.FullPath
                row.Cells("ITEM").Style.Padding = New Padding(Math.Min(48, (node.Level + 1) * 12), 0, 0, 0)
                If Grid.Columns.Contains("DATA_STATUS") Then
                    Dim qInfo2 As BomQuantityInfo = BomQuantityEngine.ForItemInNode(item, node)
                    Dim structureText As String = BomStructurePolicy.StatusText(item)
                    row.Cells("DATA_STATUS").ToolTipText = "BOM: " & structureText &
                        " | LOCAL QTY: " & localQty.ToString() &
                        " | PARENT QTY: " & qInfo2.ParentQty.ToString() &
                        " | EFFECTIVE QTY: " & qInfo2.EffectiveQty.ToString() &
                        " | TOTAL QTY: " & qInfo2.TotalQty.ToString() &
                        " | VISIBLE: " & qInfo2.VisibleQty.ToString() &
                        " | SUPPRESSED: " & qInfo2.SuppressedQty.ToString()
                    If BomStructurePolicy.IsReference(item) Then
                        row.DefaultCellStyle.Font = New Font(row.DefaultCellStyle.Font, FontStyle.Italic)
                        row.Cells("DATA_STATUS").Value = "REFERENCE"
                    ElseIf BomStructurePolicy.IsPurchased(item) Then
                        row.Cells("DATA_STATUS").Value = "PURCHASED"
                    ElseIf BomStructurePolicy.IsInseparable(item) Then
                        row.Cells("DATA_STATUS").Value = "INSEPARABLE"
                    ElseIf BomStructurePolicy.IsPhantom(item) Then
                        row.Cells("DATA_STATUS").Value = "PHANTOM"
                    End If
                End If
            Next
        End If

        For Each child As BomAssemblyNode In node.GetSortedChildren()
            AddStructuredNodeRows(child, itemNumber, hybridMode, True)
        Next
    End Sub

    Private Sub AddStructuredAssemblyHeaderRow(ByVal node As BomAssemblyNode, ByVal hybridMode As Boolean)
        If node Is Nothing Then Exit Sub
        Dim rowIndex As Integer = Grid.Rows.Add()
        Dim row As DataGridViewRow = Grid.Rows(rowIndex)
        row.Tag = Nothing
        row.HeaderCell.Tag = node.FullPath
        row.Height = 31
        row.ReadOnly = True
        row.DefaultCellStyle.BackColor = Color.FromArgb(45, 165, 180)
        row.DefaultCellStyle.ForeColor = Color.White
        row.DefaultCellStyle.SelectionBackColor = Color.FromArgb(34, 140, 154)
        row.DefaultCellStyle.SelectionForeColor = Color.White
        row.DefaultCellStyle.Font = New Font("Segoe UI Semibold", 9.5F, FontStyle.Bold)

        Dim collapsed As Boolean = _collapsedGroups.Contains(node.FullPath)
        row.Cells("ITEM").Value = If(collapsed, "▸", "▾")
        row.Cells("ITEM").Style.Padding = New Padding(Math.Min(48, node.Level * 12), 0, 0, 0)

        Dim recursiveQty As Integer = node.GetRecursiveQuantity()
        row.Cells("QTY").Value = recursiveQty.ToString()
        Dim titleColumn As String = If(Grid.Columns.Contains("FILE_NAME"), "FILE_NAME", If(Grid.Columns.Contains("PARENT_ASSEMBLY"), "PARENT_ASSEMBLY", "DATA_STATUS"))
        Dim title As String = "📁  " & node.Name
        If hybridMode Then
            title &= "   | UNIQUE " & node.GetRecursiveUniquePartCount().ToString() & " | TOTAL QTY " & recursiveQty.ToString()
        Else
            title &= "   (" & node.DirectParts.Count.ToString() & " direct Part)"
        End If
        row.Cells(titleColumn).Value = title
        row.Cells("DATA_STATUS").Value = If(hybridMode, "HYBRID", "STRUCTURED")
        Dim normalCount As Integer = 0, purchasedCount As Integer = 0, phantomCount As Integer = 0, referenceCount As Integer = 0, inseparableCount As Integer = 0
        CountStructureTypes(node, normalCount, purchasedCount, phantomCount, referenceCount, inseparableCount)
        row.Cells("DATA_STATUS").ToolTipText = "PATH: " & node.FullPath &
            " | NORMAL " & normalCount.ToString() &
            " | PURCHASED " & purchasedCount.ToString() &
            " | PHANTOM " & phantomCount.ToString() &
            " | REFERENCE " & referenceCount.ToString() &
            " | INSEPARABLE " & inseparableCount.ToString() &
            " | PHANTOM POLICY: roll-up/flatten in effective BOM; REFERENCE excluded from effective quantity." 
    End Sub

    Private Sub CountStructureTypes(ByVal node As BomAssemblyNode,
                                        ByRef normalCount As Integer,
                                        ByRef purchasedCount As Integer,
                                        ByRef phantomCount As Integer,
                                        ByRef referenceCount As Integer,
                                        ByRef inseparableCount As Integer)
        If node Is Nothing Then Exit Sub
        For Each entry As BomAssemblyPartEntry In node.DirectParts.Values
            If entry Is Nothing OrElse entry.Item Is Nothing Then Continue For
            Select Case BomStructurePolicy.Normalize(entry.Item.BomStructure)
                Case "PURCHASED" : purchasedCount += 1
                Case "PHANTOM" : phantomCount += 1
                Case "REFERENCE" : referenceCount += 1
                Case "INSEPARABLE" : inseparableCount += 1
                Case Else : normalCount += 1
            End Select
        Next
        For Each child As BomAssemblyNode In node.Children.Values
            CountStructureTypes(child, normalCount, purchasedCount, phantomCount, referenceCount, inseparableCount)
        Next
    End Sub

    Private Sub AddAssemblyHeaderRow(ByVal assemblyName As String, ByVal items As List(Of PartBomItem))
        Dim totalQty As Integer = 0
        For Each item As PartBomItem In items
            totalQty += Math.Max(1, item.GetQuantityForParent(assemblyName))
        Next
        Dim rowIndex As Integer = Grid.Rows.Add()
        Dim row As DataGridViewRow = Grid.Rows(rowIndex)
        row.Tag = Nothing
        row.HeaderCell.Tag = assemblyName
        row.Height = 31
        row.ReadOnly = True
        Dim cyanHeader As Color = Color.FromArgb(45, 165, 180)
        Dim cyanSelected As Color = Color.FromArgb(34, 140, 154)
        row.DefaultCellStyle.BackColor = cyanHeader
        row.DefaultCellStyle.ForeColor = Color.White
        row.DefaultCellStyle.SelectionBackColor = cyanSelected
        row.DefaultCellStyle.SelectionForeColor = Color.White
        row.DefaultCellStyle.Font = New Font("Segoe UI Semibold", 9.5F, FontStyle.Bold)
        row.Cells("ITEM").Value = If(_collapsedGroups.Contains(assemblyName), "▸", "▾")
        row.Cells("QTY").Value = totalQty.ToString()
        Dim titleColumn As String = If(Grid.Columns.Contains("FILE_NAME"), "FILE_NAME", If(Grid.Columns.Contains("PARENT_ASSEMBLY"), "PARENT_ASSEMBLY", "DATA_STATUS"))
        row.Cells(titleColumn).Value = "📁  " & assemblyName & "   (" & items.Count.ToString() & " loại Part)"
        row.Cells("DATA_STATUS").Value = "ASSEMBLY GROUP"
    End Sub

    Private Sub AddPartRow(ByVal item As PartBomItem, ByVal itemNumber As Integer, ByVal groupQty As Integer, ByVal groupName As String)
        Dim drawingStatus As String = GetDrawingStatus(item.FilePath)
        Dim dataStatus As String = GetDataStatus(item)
        item.DataStatus = dataStatus
        Dim values As New Dictionary(Of String, Object)(StringComparer.OrdinalIgnoreCase)
        values("ITEM") = itemNumber.ToString()
        values("QTY") = If(groupQty > 0, groupQty, item.Quantity).ToString()
        If _includeFileName Then values("FILE_NAME") = item.FileName
        If _includeFilePath Then values("FILE_PATH") = item.FilePath
        If _includeParentAssembly Then values("PARENT_ASSEMBLY") = If(groupName.Length > 0, groupName, item.GetParentAssemblyText())
        values("DRAWING_STATUS") = drawingStatus
        For Each featureKey As String In _enabledFeatures
            If _featureRegistry.ContainsKey(featureKey) Then
                Dim f As BomFeatureDefinition = _featureRegistry(featureKey)
                values(f.ColumnName) = GetFeatureDisplayValue(item, featureKey)
            End If
        Next
        values("DATA_STATUS") = dataStatus
        For Each p As PropertyColumnInfo In _selectedProperties
            Dim value As Object = BomUnitManager.GetPropertyDisplayValue(item, p)
            values(p.Key) = If(value Is Nothing, "", value)
        Next

        Dim rowIndex As Integer = Grid.Rows.Add()
        Dim row As DataGridViewRow = Grid.Rows(rowIndex)
        row.Tag = item
        row.HeaderCell.Tag = groupName
        For Each pair As KeyValuePair(Of String, Object) In values
            If Grid.Columns.Contains(pair.Key) Then row.Cells(pair.Key).Value = pair.Value
        Next
        row.DefaultCellStyle.BackColor = If(_markedPartKeys.Contains(item.DocumentKey), Color.FromArgb(255, 245, 170), Color.White)
        If _groupedView AndAlso groupName.Length > 0 AndAlso IsPathCollapsed(groupName) Then row.Visible = False
        If drawingStatus = "MISSING" Then
            row.Cells("DRAWING_STATUS").Style.BackColor = Color.White
            row.Cells("DRAWING_STATUS").Style.ForeColor = Color.FromArgb(205, 45, 45)
        End If
        If dataStatus <> "OK" Then
            row.Cells("DATA_STATUS").Style.BackColor = Color.White
            row.Cells("DATA_STATUS").Style.ForeColor = Color.FromArgb(185, 95, 20)
        End If
    End Sub

    Private Function GetDrawingStatus(ByVal partPath As String) As String
        If _scanMode = BomScanMode.Fast Then Return "SKIPPED"
        If String.IsNullOrWhiteSpace(partPath) Then Return "MISSING"
        Dim drawingPath As String = FindDrawingPath(partPath)
        If String.IsNullOrWhiteSpace(drawingPath) Then Return "MISSING"
        Return IOPath.GetExtension(drawingPath).TrimStart("."c).ToUpperInvariant()
    End Function

    Private Function GetDataStatus(ByVal item As PartBomItem) As String
        Dim missing As New List(Of String)()
        For Each p As PropertyColumnInfo In _selectedProperties
            Dim n As String = p.PropertyName.Trim().ToUpperInvariant()
            If n = "PART NUMBER" OrElse n = "DESCRIPTION" OrElse n = "MATERIAL" Then
                Dim value As String = ""
                If item.SelectedPropertyValues.ContainsKey(p.Key) Then value = Convert.ToString(item.SelectedPropertyValues(p.Key)).Trim()
                If value.Length = 0 Then missing.Add(p.PropertyName)
            End If
        Next
        If item IsNot Nothing AndAlso String.Equals(item.GeometryLoadState, "LOADED", StringComparison.OrdinalIgnoreCase) Then
            If item.IsSheetMetal AndAlso item.Thickness <= 0 Then missing.Add("THICK")
            If (item.GeometryType = "PLATE / LEG" OrElse item.GeometryType = "THIN PART") AndAlso item.Thickness <= 0 Then missing.Add("THICK")
            If item.GeometryType = "GENERAL PART" AndAlso String.IsNullOrWhiteSpace(item.BoundingBoxText) Then missing.Add("BOUNDING BOX")
        End If
        If missing.Count = 0 Then Return "OK"
        Return "MISSING: " & String.Join(", ", missing.ToArray())
    End Function


'####################################################################
' SUBSECTION 15.07 - ASSEMBLY FILTER / SEARCH ENGINE
'####################################################################

    Private Sub BuildAssemblyFilterItems()
        If AssemblyFilterBox Is Nothing Then Exit Sub
        Dim currentText As String = AssemblyFilterBox.Text
        Dim names As New SortedSet(Of String)(StringComparer.OrdinalIgnoreCase)
        names.Add(_assemblyName)
        For Each parentName As String In _runtimeIndex.ItemsByAssembly.Keys
            If Not String.IsNullOrWhiteSpace(parentName) Then names.Add(parentName)
        Next
        AssemblyFilterBox.BeginUpdate()
        AssemblyFilterBox.Items.Clear()
        AssemblyFilterBox.Items.Add("<TẤT CẢ ASSEMBLY>")
        For Each name As String In names
            AssemblyFilterBox.Items.Add(name)
        Next
        AssemblyFilterBox.EndUpdate()
        If currentText.Length > 0 AndAlso AssemblyFilterBox.Items.Contains(currentText) Then
            AssemblyFilterBox.SelectedItem = currentText
        Else
            AssemblyFilterBox.SelectedIndex = 0
        End If
    End Sub

    Private Sub AssemblyFilterChanged(ByVal sender As Object, ByVal e As EventArgs)
        If _searchTimer Is Nothing Then Exit Sub
        _searchTimer.Stop()
        _searchTimer.Start()
    End Sub

    Private Function GetSelectedAssemblyFilter() As String
        If AssemblyFilterBox Is Nothing Then Return ""
        Dim value As String = AssemblyFilterBox.Text.Trim()
        If value.Length = 0 OrElse value = "<TẤT CẢ ASSEMBLY>" Then Return ""
        Return value
    End Function

    Private Function ItemBelongsToAssembly(ByVal item As PartBomItem, ByVal assemblyName As String) As Boolean
        Return _runtimeIndex.BelongsToAssembly(item, assemblyName, _assemblyName)
    End Function

    Private Sub UpdateAssemblyFilterInfo(ByVal assemblyName As String, ByVal uniqueCount As Integer, ByVal totalQty As Integer)
        If AssemblyFilterInfo Is Nothing Then Exit Sub
        If String.IsNullOrWhiteSpace(assemblyName) Then
            AssemblyFilterInfo.Text = "Tất cả Assembly | " & uniqueCount.ToString() & " loại Part | QTY " & totalQty.ToString()
        Else
            AssemblyFilterInfo.Text = assemblyName & " | " & uniqueCount.ToString() & " loại Part | QTY " & totalQty.ToString()
        End If
    End Sub

    Private Sub SearchChanged(ByVal sender As Object, ByVal e As EventArgs)
        If _searchTimer Is Nothing Then
            ApplySearchFilter()
            Exit Sub
        End If
        _searchTimer.Stop()
        _searchTimer.Start()
    End Sub

    Private Sub SearchTimerTick(ByVal sender As Object, ByVal e As EventArgs)
        _searchTimer.Stop()
        ApplySearchFilter()
    End Sub

    Private Sub ApplySearchFilter()
        Dim term As String = SearchBox.Text.Trim()
        Dim selectedAssembly As String = GetSelectedAssemblyFilter()
        Dim visibleCount As Integer = 0
        Dim totalQty As Integer = 0
        Dim missingDrawing As Integer = 0
        Dim currentHeader As DataGridViewRow = Nothing
        Dim currentGroupName As String = ""
        Dim headerHasVisibleChild As Boolean = False

        For Each row As DataGridViewRow In Grid.Rows
            If IsAssemblyHeaderRow(row) Then
                If currentHeader IsNot Nothing Then currentHeader.Visible = headerHasVisibleChild OrElse (term.Length = 0 AndAlso selectedAssembly.Length = 0)
                currentHeader = row
                currentGroupName = GetRowGroupName(row)
                headerHasVisibleChild = False
                row.Visible = _groupedView
            Else
                Dim cachedItem As PartBomItem = TryCast(row.Tag, PartBomItem)
                Dim rowGroup As String = GetRowGroupName(row)
                Dim assemblyMatch As Boolean = ItemBelongsToAssembly(cachedItem, selectedAssembly)
                If _groupedView AndAlso selectedAssembly.Length > 0 AndAlso Not String.Equals(selectedAssembly, _assemblyName, StringComparison.OrdinalIgnoreCase) Then
                    assemblyMatch = assemblyMatch AndAlso String.Equals(rowGroup, selectedAssembly, StringComparison.OrdinalIgnoreCase)
                End If
                Dim visible As Boolean = assemblyMatch AndAlso term.Length = 0
                If assemblyMatch AndAlso Not visible AndAlso cachedItem IsNot Nothing Then
                    visible = CachedSearchMatch(cachedItem, term)
                End If
                If assemblyMatch AndAlso Not visible Then
                    For Each cell As System.Windows.Forms.DataGridViewCell In row.Cells
                        If cell.Value IsNot Nothing AndAlso Convert.ToString(cell.Value).IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0 Then
                            visible = True
                            Exit For
                        End If
                    Next
                End If

                If _groupedView AndAlso rowGroup.Length > 0 AndAlso _collapsedGroups.Contains(rowGroup) Then visible = False

                row.Visible = visible
                If visible Then
                    headerHasVisibleChild = True
                    visibleCount += 1
                    Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                    If item IsNot Nothing Then
                        If selectedAssembly.Length > 0 AndAlso Not String.Equals(selectedAssembly, _assemblyName, StringComparison.OrdinalIgnoreCase) Then
                            totalQty += Math.Max(0, item.GetQuantityForParent(selectedAssembly))
                        Else
                            Dim shownQty As Integer = 0
                            Integer.TryParse(Convert.ToString(row.Cells("QTY").Value), shownQty)
                            totalQty += Math.Max(0, shownQty)
                        End If
                    End If
                    If Convert.ToString(row.Cells("DRAWING_STATUS").Value) = "MISSING" Then missingDrawing += 1
                End If
            End If
        Next
        If currentHeader IsNot Nothing Then currentHeader.Visible = headerHasVisibleChild OrElse (term.Length = 0 AndAlso selectedAssembly.Length = 0)
        UpdateAssemblyFilterInfo(selectedAssembly, visibleCount, totalQty)
        UpdateStatusBar(visibleCount, totalQty, missingDrawing)
    End Sub

    Private Function CachedSearchMatch(ByVal item As PartBomItem, ByVal expression As String) As Boolean
        If item Is Nothing OrElse String.IsNullOrWhiteSpace(expression) Then Return True
        Dim blob As String = If(item.SearchBlob, "")
        Dim query As String = expression.Trim()
        Try
            If query.StartsWith("regex:", StringComparison.OrdinalIgnoreCase) Then
                Return Regex.IsMatch(blob, query.Substring(6), RegexOptions.IgnoreCase)
            End If
        Catch
            Return False
        End Try
        Dim orGroups() As String = query.Split(New String() {" OR ", "|"}, StringSplitOptions.RemoveEmptyEntries)
        For Each groupText As String In orGroups
            Dim groupMatched As Boolean = True
            Dim tokens() As String = groupText.Trim().Split(New Char() {" "c, "+"c}, StringSplitOptions.RemoveEmptyEntries)
            For Each tokenRaw As String In tokens
                Dim token As String = tokenRaw.Trim()
                Dim isNegativeToken As Boolean = token.StartsWith("-") OrElse token.StartsWith("!")
                If isNegativeToken Then token = token.Substring(1)
                token = token.Replace("*", "")
                If token.Length = 0 Then Continue For
                Dim containsToken As Boolean = blob.IndexOf(token, StringComparison.OrdinalIgnoreCase) >= 0
                If (Not isNegativeToken AndAlso Not containsToken) OrElse (isNegativeToken AndAlso containsToken) Then
                    groupMatched = False
                    Exit For
                End If
            Next
            If groupMatched Then Return True
        Next
        Return False
    End Function

    Private Function IsAssemblyHeaderRow(ByVal row As DataGridViewRow) As Boolean
        Return row IsNot Nothing AndAlso row.Tag Is Nothing AndAlso Convert.ToString(row.HeaderCell.Tag).Length > 0
    End Function

    Private Function GetRowGroupName(ByVal row As DataGridViewRow) As String
        If row Is Nothing Then Return ""
        Return Convert.ToString(row.HeaderCell.Tag)
    End Function


'####################################################################
' SUBSECTION 15.08 - STATUS / CURRENT ITEM / SELECTION COLLECTION
'####################################################################

    Private Sub UpdateStatusBar(ByVal visibleCount As Integer, ByVal totalQty As Integer, ByVal missingDrawing As Integer)
        StatusAssembly.Text = "Assembly: " & _assemblyName
        StatusParts.Text = "Loại Part: " & _allItems.Count.ToString()
        StatusVisible.Text = "Đang hiện: " & visibleCount.ToString()
        StatusQty.Text = "Tổng QTY: " & totalQty.ToString()
        StatusDrawing.Text = "Thiếu Drawing: " & missingDrawing.ToString()
        StatusLoadTime.Text = "Load: " & _loadedAt.ToString("HH:mm:ss")
    End Sub

    Private Function GetCurrentItem() As PartBomItem
        If Grid.CurrentRow Is Nothing Then Return Nothing
        Return TryCast(Grid.CurrentRow.Tag, PartBomItem)
    End Function

    Private Function GetSelectedItems() As List(Of PartBomItem)
        Dim result As New List(Of PartBomItem)()
        Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        For Each row As DataGridViewRow In Grid.SelectedRows
            Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
            If item IsNot Nothing AndAlso Not seen.Contains(item.DocumentKey) Then
                seen.Add(item.DocumentKey)
                result.Add(item)
            End If
        Next
        For Each cell As System.Windows.Forms.DataGridViewCell In Grid.SelectedCells
            Dim item As PartBomItem = TryCast(cell.OwningRow.Tag, PartBomItem)
            If item IsNot Nothing AndAlso Not seen.Contains(item.DocumentKey) Then
                seen.Add(item.DocumentKey)
                result.Add(item)
            End If
        Next
        If result.Count = 0 Then
            Dim current As PartBomItem = GetCurrentItem()
            If current IsNot Nothing Then result.Add(current)
        End If
        Return result
    End Function

    Private Function GetFilteredItems() As List(Of PartBomItem)
        Dim result As New List(Of PartBomItem)()
        Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        For Each row As DataGridViewRow In Grid.Rows
            If row.Visible Then
                Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
                If item IsNot Nothing AndAlso Not seen.Contains(item.DocumentKey) Then
                    seen.Add(item.DocumentKey)
                    result.Add(item)
                End If
            End If
        Next
        Return result
    End Function


'####################################################################
' SUBSECTION 15.09 - GRID MOUSE / DOUBLE CLICK / SELECTION EVENTS
'####################################################################

    Private Sub GridCellMouseDown(ByVal sender As Object, ByVal e As DataGridViewCellMouseEventArgs)
        _contextColumnIndex = e.ColumnIndex
        _contextRowIndex = e.RowIndex

        'HYBRID SELECTION MODE:
        ' - Click row header => true FullRowSelect so legacy SelectedRows features keep working.
        ' - Click data cell => Excel CellSelect, unless user explicitly locked row mode from menu.
        If e.Button = MouseButtons.Left Then
            If e.ColumnIndex = -1 AndAlso e.RowIndex >= 0 Then
                If Grid.SelectionMode <> DataGridViewSelectionMode.FullRowSelect Then
                    Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
                    Grid.MultiSelect = True
                End If
            ElseIf e.ColumnIndex >= 0 AndAlso e.RowIndex >= 0 AndAlso Not _forceFullRowSelection Then
                If Grid.SelectionMode <> DataGridViewSelectionMode.CellSelect Then
                    Grid.SelectionMode = DataGridViewSelectionMode.CellSelect
                    Grid.MultiSelect = True
                End If
            End If
        End If

        'Bắt fill handle trước các xử lý chọn ô/dòng thông thường.
        If e.Button = MouseButtons.Left AndAlso e.RowIndex >= 0 AndAlso e.ColumnIndex >= 0 AndAlso Grid.CurrentCell IsNot Nothing Then
            If Grid.CurrentCell.RowIndex = e.RowIndex AndAlso Grid.CurrentCell.ColumnIndex = e.ColumnIndex Then
                Dim col As DataGridViewColumn = Grid.Columns(e.ColumnIndex)
                Dim item As PartBomItem = TryCast(Grid.Rows(e.RowIndex).Tag, PartBomItem)
                Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                Dim cellRect As Rectangle = Grid.GetCellDisplayRectangle(e.ColumnIndex, e.RowIndex, False)
                Dim mousePoint As Point = Grid.PointToClient(Control.MousePosition)
                Dim handleRect As New Rectangle(cellRect.Right - FillHandleSize - 1, cellRect.Bottom - FillHandleSize - 1, FillHandleSize + 2, FillHandleSize + 2)
                If item IsNot Nothing AndAlso pi IsNot Nothing AndAlso Not col.ReadOnly AndAlso handleRect.Contains(mousePoint) Then
                    _fillDragging = True
                    _fillSourceRow = e.RowIndex
                    _fillSourceColumn = e.ColumnIndex
                    _fillTargetRow = e.RowIndex
                    Grid.Capture = True
                    Exit Sub
                End If
            End If
        End If

        'Ô góc trái trên cùng: chọn toàn bộ bảng giống Excel.
        If e.RowIndex = -1 AndAlso e.ColumnIndex = -1 Then
            If e.Button = MouseButtons.Left Then
                SelectAllCellsClicked(sender, EventArgs.Empty)
            End If
            Exit Sub
        End If

        'Chuột phải trên tiêu đề cột: chọn cột trước khi mở menu.
        If e.RowIndex = -1 AndAlso e.ColumnIndex >= 0 Then
            If e.Button = MouseButtons.Right Then
                SelectColumnRange(e.ColumnIndex, e.ColumnIndex, False)
                Grid.CurrentCell = FirstVisibleCellInColumn(e.ColumnIndex)
            End If
            Exit Sub
        End If

        'Chuột phải trên số hàng: chọn hàng trước khi mở menu.
        If e.ColumnIndex = -1 AndAlso e.RowIndex >= 0 Then
            If e.Button = MouseButtons.Right Then
                If Grid.SelectionMode <> DataGridViewSelectionMode.FullRowSelect Then
                    Grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect
                    Grid.MultiSelect = True
                End If
                Grid.ClearSelection()
                Grid.Rows(e.RowIndex).Selected = True
                Grid.CurrentCell = FirstVisibleCellInRow(e.RowIndex)
            End If
            Exit Sub
        End If

        If e.RowIndex < 0 Then Exit Sub

        Dim row As DataGridViewRow = Grid.Rows(e.RowIndex)
        If e.ColumnIndex >= 0 Then Grid.CurrentCell = row.Cells(e.ColumnIndex)

        'Chuột phải một lần: chọn dòng để Context Menu hiển thị đúng Part.
        If e.Button = System.Windows.Forms.MouseButtons.Right Then
            If e.Clicks = 1 Then
                'Nếu dòng chưa thuộc vùng chọn thì chọn riêng dòng đó.
                'Nếu đã chọn nhiều dòng thì giữ nguyên vùng chọn để Context Menu tác động hàng loạt.
                If Not row.Selected Then
                    Grid.ClearSelection()
                    row.Selected = True
                End If
                If e.ColumnIndex >= 0 Then Grid.CurrentCell = row.Cells(e.ColumnIndex)
            End If
            Exit Sub
        End If

        If e.Button <> System.Windows.Forms.MouseButtons.Left Then Exit Sub

        'Không xử lý Double Click tại MouseDown để tránh chạy trùng sự kiện.
        'GridCellDoubleClick chịu trách nhiệm mở Part/Assembly/Drawing.
        'CellSelect cho phép chọn vùng như Excel; click Row Header tự chuyển sang FullRowSelect thật sự.
    End Sub

    'Chuột phải hai lần: bật/tắt chữ đậm cho toàn bộ dòng.
    Private Sub GridCellMouseDoubleClick(ByVal sender As Object, ByVal e As DataGridViewCellMouseEventArgs)
        If e.RowIndex < 0 Then Exit Sub
        If e.Button <> System.Windows.Forms.MouseButtons.Right Then Exit Sub

        Dim row As DataGridViewRow = Grid.Rows(e.RowIndex)
        If row.Tag Is Nothing Then Exit Sub

        Try
            If ContextMenu IsNot Nothing Then ContextMenu.Hide()
        Catch
        End Try

        Dim currentFont As Font = row.DefaultCellStyle.Font
        If currentFont Is Nothing Then currentFont = Grid.DefaultCellStyle.Font

        Dim isBold As Boolean = False
        If currentFont IsNot Nothing Then isBold = currentFont.Bold

        Dim baseFont As Font = Grid.DefaultCellStyle.Font
        If baseFont Is Nothing Then baseFont = New Font("Segoe UI", 9.0F, FontStyle.Regular)

        If isBold Then
            row.DefaultCellStyle.Font = New Font(baseFont.FontFamily, baseFont.Size, FontStyle.Regular)
        Else
            row.DefaultCellStyle.Font = New Font(baseFont.FontFamily, baseFont.Size, FontStyle.Bold)
        End If

        Grid.ClearSelection()
        row.Selected = True
        If e.ColumnIndex >= 0 Then Grid.CurrentCell = row.Cells(e.ColumnIndex)
    End Sub

    'Chuột trái một lần: chỉ chọn dòng.
    'Chọn dòng chỉ chọn dữ liệu; KHÔNG Highlight Part trong Assembly.
    Private Sub GridCellClick(ByVal sender As Object, ByVal e As DataGridViewCellEventArgs)
        If e.RowIndex < 0 OrElse e.ColumnIndex < 0 Then Exit Sub
        Dim row As DataGridViewRow = Grid.Rows(e.RowIndex)

        'CellSelect tự xử lý chọn ô/vùng, Ctrl và Shift.
        'Không ClearSelection ở đây vì sẽ phá chọn nhiều dòng.
        If Grid.CurrentCell Is Nothing OrElse Grid.CurrentCell.RowIndex <> e.RowIndex OrElse Grid.CurrentCell.ColumnIndex <> e.ColumnIndex Then
            Grid.CurrentCell = row.Cells(e.ColumnIndex)
        End If

        If IsAssemblyHeaderRow(row) Then
            If Grid.Columns.Contains("ITEM") AndAlso e.ColumnIndex = Grid.Columns("ITEM").Index Then
                ToggleGroup(GetRowGroupName(row))
            End If
            Exit Sub
        End If

        'Click đơn: CHỈ chọn dòng/cập nhật UI.
        'Không gọi Inventor Highlight ở đây để tránh lag.
    End Sub

    'Chuột trái hai lần:
    ' - Cột DRAWING: mở Drawing.
    ' - Ô iProperty có thể sửa: vào chế độ chỉnh sửa.
    ' - Các ô Part còn lại: mở Part.
    Private Sub GridCellDoubleClick(ByVal sender As Object, ByVal e As DataGridViewCellEventArgs)
        If e.RowIndex < 0 OrElse e.ColumnIndex < 0 Then Exit Sub
        Dim row As DataGridViewRow = Grid.Rows(e.RowIndex)
        Grid.CurrentCell = row.Cells(e.ColumnIndex)
        If Not row.Selected Then row.Selected = True

        If IsAssemblyHeaderRow(row) Then
            OpenAssemblySelected()
            Exit Sub
        End If

        Dim columnName As String = Grid.Columns(e.ColumnIndex).Name
        If String.Equals(columnName, "DRAWING_STATUS", StringComparison.OrdinalIgnoreCase) OrElse _
           String.Equals(columnName, "DRAWING", StringComparison.OrdinalIgnoreCase) Then
            OpenDrawing(TryCast(row.Tag, PartBomItem))
            Exit Sub
        End If

        'Double Click trái trên bất kỳ ô Part nào, kể cả ảnh Thumbnail: mở Part.
        OpenPart(TryCast(row.Tag, PartBomItem))
    End Sub

    Private Function IsPartNumberColumn(ByVal col As DataGridViewColumn) As Boolean
        If col Is Nothing Then Return False
        Dim propertyInfo As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
        If propertyInfo Is Nothing Then Return False
        Return String.Equals(propertyInfo.PropertyName.Trim(), "Part Number", StringComparison.OrdinalIgnoreCase)
    End Function

    Private Sub GridSelectionChanged(ByVal sender As Object, ByVal e As EventArgs)
        UpdatePreviewFromCurrentRow()
        ApplyCommandAvailability()
        UpdateExcelFormulaBar()
        UpdateExcelSelectionStatus()
        'MANUAL HIGHLIGHT ONLY: chọn dòng không truy cập Inventor API.
    End Sub

    Private Sub SelectionTimerTick(ByVal sender As Object, ByVal e As EventArgs)
        If _selectionTimer IsNot Nothing Then _selectionTimer.Stop()
        'MANUAL HIGHLIGHT ONLY: tuyệt đối không Highlight từ SelectionChanged/CellClick.
    End Sub


'####################################################################
' SUBSECTION 15.10 - CELL EDIT / UNDO / REDO / PROPERTY WRITE
'####################################################################

    Private Sub GridCellBeginEdit(ByVal sender As Object, ByVal e As DataGridViewCellCancelEventArgs)
        If _safeMode Then
            e.Cancel = True
            ShowSafeModeNotice("Edit Property")
            Exit Sub
        End If
        _editOriginalValue = ""
        _editDocumentKey = ""
        _editPropertyKey = ""
        If e.RowIndex < 0 OrElse e.ColumnIndex < 0 Then Exit Sub
        Dim row As DataGridViewRow = Grid.Rows(e.RowIndex)
        Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
        Dim propertyInfo As PropertyColumnInfo = TryCast(Grid.Columns(e.ColumnIndex).Tag, PropertyColumnInfo)
        If item Is Nothing OrElse propertyInfo Is Nothing Then Exit Sub
        _editOriginalValue = Convert.ToString(row.Cells(e.ColumnIndex).Value)
        _editDocumentKey = item.DocumentKey
        _editPropertyKey = propertyInfo.Key
    End Sub

    Private Sub UndoClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Undo") Then Exit Sub
        If _transactionUndo.Count > 0 Then
            Dim tx As BomTransaction = _transactionUndo.Pop()
            If ApplyCommittedTransaction(tx, True) Then _transactionRedo.Push(tx) Else _transactionUndo.Push(tx)
            Exit Sub
        End If
        If _undoStack.Count = 0 Then MessageBox.Show("Không có thay đổi nào để Undo.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information) : Exit Sub
        Dim action As BomEditAction = _undoStack.Pop()
        If ApplyHistoryAction(action, action.OldValue) Then _redoStack.Push(action)
    End Sub

    Private Sub RedoClicked(ByVal sender As Object, ByVal e As EventArgs)
        If Not EnsureWriteAllowed("Redo") Then Exit Sub
        If _transactionRedo.Count > 0 Then
            Dim tx As BomTransaction = _transactionRedo.Pop()
            If ApplyCommittedTransaction(tx, False) Then _transactionUndo.Push(tx) Else _transactionRedo.Push(tx)
            Exit Sub
        End If
        If _redoStack.Count = 0 Then MessageBox.Show("Không có thay đổi nào để Redo.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information) : Exit Sub
        Dim action As BomEditAction = _redoStack.Pop()
        If ApplyHistoryAction(action, action.NewValue) Then _undoStack.Push(action)
    End Sub

    Private Function ApplyCommittedTransaction(ByVal tx As BomTransaction, ByVal undoMode As Boolean) As Boolean
        If tx Is Nothing OrElse tx.Changes.Count = 0 Then Return False
        Dim done As New List(Of BomPropertyChange)()
        Try
            Dim ordered As New List(Of BomPropertyChange)(tx.Changes)
            If undoMode Then ordered.Reverse()
            For Each ch As BomPropertyChange In ordered
                If ch.Status <> "COMMITTED" AndAlso ch.Status <> "UNDONE" Then Continue For
                Dim item As PartBomItem = FindItemByDocumentKey(ch.DocumentKey)
                If item Is Nothing OrElse item.Document Is Nothing Then Throw New Exception("Không tìm thấy Document: " & ch.FileName)
                Dim value As String = If(undoMode, ch.OldValue, ch.NewValue)
                If undoMode AndAlso Not ch.PropertyExistedBefore Then
                    DeletePropertyIfExists(item.Document, ch.PropertyInfo)
                Else
                    WritePropertyValue(item.Document, ch.PropertyInfo, value)
                End If
                item.SelectedPropertyValues(ch.PropertyKey) = value : item.IsBomDirty = True : item.DirtyPropertyKeys.Add(ch.PropertyKey)
                If String.Equals(ch.PropertyInfo.PropertyName, "Part Number", StringComparison.OrdinalIgnoreCase) Then item.PartNumber = value
                RebuildItemSearchBlob(item) : _committedDocumentKeys.Add(ch.DocumentKey) : done.Add(ch)
            Next
            For Each ch As BomPropertyChange In tx.Changes : ch.Status = If(undoMode, "UNDONE", "COMMITTED") : Next
            RefreshGridAfterTransaction()
            MessageBox.Show(If(undoMode, "UNDO", "REDO") & " TRANSACTION: " & tx.Name & vbCrLf & done.Count.ToString() & " thay đổi.", "BOM TRANSACTION", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Return True
        Catch ex As Exception
            MessageBox.Show("Không thể " & If(undoMode, "Undo", "Redo") & " transaction." & vbCrLf & ex.Message, "BOM TRANSACTION", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        End Try
    End Function

    Private Function ApplyHistoryAction(ByVal action As BomEditAction, ByVal targetValue As String) As Boolean
        If action Is Nothing OrElse action.PropertyInfo Is Nothing Then Return False
        Dim item As PartBomItem = Nothing
        For Each candidate As PartBomItem In _allItems
            If String.Equals(candidate.DocumentKey, action.DocumentKey, StringComparison.OrdinalIgnoreCase) Then
                item = candidate
                Exit For
            End If
        Next
        If item Is Nothing Then Return False
        Try
            _suppressCellWrite = True
            WritePropertyValue(item.Document, action.PropertyInfo, targetValue)
            item.SelectedPropertyValues(action.PropertyKey) = targetValue
            If String.Equals(action.PropertyInfo.PropertyName, "Part Number", StringComparison.OrdinalIgnoreCase) Then item.PartNumber = targetValue
            For Each row As DataGridViewRow In Grid.Rows
                Dim rowItem As PartBomItem = TryCast(row.Tag, PartBomItem)
                If rowItem IsNot Nothing AndAlso String.Equals(rowItem.DocumentKey, item.DocumentKey, StringComparison.OrdinalIgnoreCase) Then
                    For Each col As DataGridViewColumn In Grid.Columns
                        Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                        If pi IsNot Nothing AndAlso String.Equals(pi.Key, action.PropertyKey, StringComparison.OrdinalIgnoreCase) Then
                            row.Cells(col.Index).Value = targetValue
                            Exit For
                        End If
                    Next
                    If Grid.Columns.Contains("DATA_STATUS") Then row.Cells("DATA_STATUS").Value = GetDataStatus(item)
                End If
            Next
            _suppressCellWrite = False
            Return True
        Catch ex As Exception
            _suppressCellWrite = False
            MessageBox.Show("Không thể áp dụng Undo/Redo." & vbCrLf & ex.Message, "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        End Try
    End Function

    Private Sub GridCellEndEdit(ByVal sender As Object, ByVal e As DataGridViewCellEventArgs)
        If _suppressCellWrite OrElse e.RowIndex < 0 OrElse e.ColumnIndex < 0 Then Exit Sub
        Dim row As DataGridViewRow = Grid.Rows(e.RowIndex)
        Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
        If item Is Nothing Then Exit Sub
        Dim col As DataGridViewColumn = Grid.Columns(e.ColumnIndex)
        Dim propertyInfo As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
        If propertyInfo Is Nothing OrElse col.ReadOnly Then Exit Sub
        Dim newValue As String = Convert.ToString(row.Cells(e.ColumnIndex).Value)
        If String.Equals(_editOriginalValue, newValue, StringComparison.Ordinal) Then Exit Sub
        StagePropertyChange(item, propertyInfo, _editOriginalValue, newValue, row, e.ColumnIndex)
    End Sub

    Private Sub StagePropertyChange(ByVal item As PartBomItem, ByVal propertyInfo As PropertyColumnInfo, ByVal oldValue As String, ByVal newValue As String, ByVal row As DataGridViewRow, ByVal columnIndex As Integer)
        If item Is Nothing OrElse propertyInfo Is Nothing Then Exit Sub
        Dim existing As BomPropertyChange = Nothing
        For Each ch As BomPropertyChange In _pendingTransaction.Changes
            If String.Equals(ch.DocumentKey, item.DocumentKey, StringComparison.OrdinalIgnoreCase) AndAlso String.Equals(ch.PropertyKey, propertyInfo.Key, StringComparison.OrdinalIgnoreCase) Then existing = ch : Exit For
        Next
        If existing Is Nothing Then
            existing = New BomPropertyChange()
            existing.DocumentKey = item.DocumentKey
            existing.DocumentPath = item.FilePath
            existing.PartNumber = item.PartNumber
            existing.FileName = item.FileName
            existing.PropertyKey = propertyInfo.Key
            existing.PropertyInfo = propertyInfo
            existing.OldValue = oldValue
            existing.PropertyExistedBefore = PropertyExistsInDocument(item.Document, propertyInfo)
            _pendingTransaction.Changes.Add(existing)
        End If
        existing.NewValue = newValue
        existing.Status = "PENDING"
        existing.ErrorMessage = ""
        If String.Equals(existing.OldValue, existing.NewValue, StringComparison.Ordinal) Then _pendingTransaction.Changes.Remove(existing)
        _pendingTransaction.Status = If(_pendingTransaction.Changes.Count > 0, "PENDING", "EMPTY")
        If row IsNot Nothing AndAlso columnIndex >= 0 Then
            row.Cells(columnIndex).Style.BackColor = Color.FromArgb(255, 248, 200)
            row.Cells(columnIndex).ToolTipText = "PENDING - chưa ghi vào Inventor. REVIEW / COMMIT / DISCARD."
            If Grid.Columns.Contains("DATA_STATUS") Then row.Cells("DATA_STATUS").Value = "PENDING CHANGES"
        End If
        PersistPendingTransaction()
        UpdatePendingCaption()
    End Sub

    Private Sub UpdatePendingCaption()
        Dim n As Integer = _pendingTransaction.Changes.Count
        Me.Text = BomConstants.ToolVersion & " - " & _assemblyName & If(n > 0, "  |  " & n.ToString() & " PENDING", "")
        If StatusPending IsNot Nothing Then
            StatusPending.Text = n.ToString() & " Pending"
            StatusPending.ForeColor = If(n > 0, Color.DarkOrange, Color.FromArgb(55, 80, 90))
        End If
        If _quickButtons.ContainsKey("REVIEW") Then
            Dim rb As Button = _quickButtons("REVIEW")
            rb.Text = "REVIEW [" & n.ToString() & "]"
            rb.ForeColor = If(n > 0, Color.DarkOrange, Color.FromArgb(40, 70, 85))
        End If
    End Sub

    Private Sub ReviewPendingClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _pendingTransaction.Changes.Count = 0 Then
            MessageBox.Show("Không có Pending Changes.", "BOM TOOL PRO", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        Using f As New BomPendingChangesForm(_pendingTransaction.Changes)
            If f.ShowDialog(Me) = DialogResult.OK Then
                If f.ActionName = "COMMIT_SELECTED" Then
                    CommitChanges(f.SelectedChanges, False, _transactionAtomic, "COMMIT SELECTED")
                ElseIf f.ActionName = "COMMIT_ALL" Then
                    CommitChanges(New List(Of BomPropertyChange)(_pendingTransaction.Changes), False, _transactionAtomic, "COMMIT ALL")
                ElseIf f.ActionName = "DISCARD_SELECTED" Then
                    DiscardSpecificPendingChanges(f.SelectedChanges)
                ElseIf f.ActionName = "DISCARD_ALL" Then
                    DiscardPendingClicked(Nothing, EventArgs.Empty)
                End If
            End If
        End Using
    End Sub

    Private Sub CommitPendingClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _safeMode Then ShowSafeModeNotice("CommitPendingClicked") : Exit Sub
        CommitChanges(New List(Of BomPropertyChange)(_pendingTransaction.Changes), False, _transactionAtomic, "COMMIT ALL")
    End Sub

    Private Sub CommitSelectedClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _safeMode Then ShowSafeModeNotice("CommitSelectedClicked") : Exit Sub
        Dim selected As List(Of BomPropertyChange) = GetSelectedPendingChanges()
        If selected.Count = 0 Then
            MessageBox.Show("Không có Pending Change nào trong vùng đang chọn.", "BOM TRANSACTION", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Exit Sub
        End If
        CommitChanges(selected, False, _transactionAtomic, "COMMIT SELECTED")
    End Sub

    Private Function GetSelectedPendingChanges() As List(Of BomPropertyChange)
        Dim result As New List(Of BomPropertyChange)()
        Dim keys As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        For Each cell As System.Windows.Forms.DataGridViewCell In Grid.SelectedCells
            If cell.RowIndex < 0 OrElse cell.ColumnIndex < 0 Then Continue For
            Dim item As PartBomItem = TryCast(Grid.Rows(cell.RowIndex).Tag, PartBomItem)
            Dim pi As PropertyColumnInfo = TryCast(Grid.Columns(cell.ColumnIndex).Tag, PropertyColumnInfo)
            If item Is Nothing OrElse pi Is Nothing Then Continue For
            keys.Add(item.DocumentKey & "|" & pi.Key)
        Next
        If keys.Count = 0 AndAlso Grid.CurrentCell IsNot Nothing Then
            Dim item As PartBomItem = TryCast(Grid.Rows(Grid.CurrentCell.RowIndex).Tag, PartBomItem)
            Dim pi As PropertyColumnInfo = TryCast(Grid.Columns(Grid.CurrentCell.ColumnIndex).Tag, PropertyColumnInfo)
            If item IsNot Nothing AndAlso pi IsNot Nothing Then keys.Add(item.DocumentKey & "|" & pi.Key)
        End If
        For Each ch As BomPropertyChange In _pendingTransaction.Changes
            If keys.Contains(ch.DocumentKey & "|" & ch.PropertyKey) Then result.Add(ch)
        Next
        Return result
    End Function

    Private Function CloneTransaction(ByVal changes As List(Of BomPropertyChange), ByVal name As String) As BomTransaction
        Dim tx As New BomTransaction()
        tx.Name = name
        tx.Atomic = _transactionAtomic
        For Each source As BomPropertyChange In changes
            Dim ch As New BomPropertyChange()
            ch.DocumentKey = source.DocumentKey : ch.FileName = source.FileName : ch.PropertyKey = source.PropertyKey
            ch.PropertyInfo = source.PropertyInfo : ch.OldValue = source.OldValue : ch.NewValue = source.NewValue
            ch.PropertyExistedBefore = source.PropertyExistedBefore
            ch.Status = source.Status : ch.ErrorMessage = source.ErrorMessage
            tx.Changes.Add(ch)
        Next
        Return tx
    End Function

    Private Function CommitChanges(ByVal requested As List(Of BomPropertyChange), ByVal saveAfterCommit As Boolean, ByVal atomic As Boolean, ByVal transactionName As String) As Boolean
        If Not EnsureWriteAllowed(transactionName) Then Return False
        If requested Is Nothing OrElse requested.Count = 0 Then Return True
        Dim answer As DialogResult = MessageBox.Show(transactionName & ": " & requested.Count.ToString() & " thay đổi?" & vbCrLf & "Atomic = " & If(atomic, "ON (lỗi sẽ rollback)", "OFF (cho phép Partial Commit)"), "BOM TRANSACTION", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
        If answer <> DialogResult.Yes Then Return False
        Dim tx As BomTransaction = CloneTransaction(requested, transactionName)
        tx.Atomic = atomic
        Dim applied As New List(Of BomPropertyChange)()
        Dim failure As Exception = Nothing
        For i As Integer = 0 To tx.Changes.Count - 1
            Dim ch As BomPropertyChange = tx.Changes(i)
            Try
                Dim item As PartBomItem = FindItemByDocumentKey(ch.DocumentKey)
                If item Is Nothing OrElse item.Document Is Nothing Then Throw New Exception("Không tìm thấy Document: " & ch.FileName)
                'Nếu property được một thao tác khác tạo sau lúc Stage nhưng trước Commit, coi nó là property có sẵn để Undo không xóa nhầm.
                If Not ch.PropertyExistedBefore AndAlso PropertyExistsInDocument(item.Document, ch.PropertyInfo) Then ch.PropertyExistedBefore = True
                WritePropertyValue(item.Document, ch.PropertyInfo, ch.NewValue)
                ch.Status = "COMMITTED" : applied.Add(ch) : tx.AppliedCount += 1
                _committedDocumentKeys.Add(ch.DocumentKey)
            Catch ex As Exception
                ch.Status = "FAILED" : ch.ErrorMessage = ex.Message : tx.FailedCount += 1
                tx.NotProcessedCount = tx.Changes.Count - i - 1
                failure = ex
                If atomic Then Exit For
            End Try
        Next
        If failure IsNot Nothing AndAlso atomic Then
            For i As Integer = applied.Count - 1 To 0 Step -1
                Dim ch As BomPropertyChange = applied(i)
                Try
                    Dim item As PartBomItem = FindItemByDocumentKey(ch.DocumentKey)
                    If item Is Nothing OrElse item.Document Is Nothing Then Throw New Exception("Document unavailable")
                    If ch.PropertyExistedBefore Then
                        WritePropertyValue(item.Document, ch.PropertyInfo, ch.OldValue)
                    Else
                        DeletePropertyIfExists(item.Document, ch.PropertyInfo)
                    End If
                    ch.Status = "ROLLED BACK"
                    _committedDocumentKeys.Remove(ch.DocumentKey)
                Catch rbEx As Exception
                    ch.Status = "ROLLBACK FAILED" : ch.ErrorMessage = rbEx.Message : tx.RollbackFailedCount += 1
                End Try
            Next
            tx.Status = If(tx.RollbackFailedCount = 0, "ROLLED BACK", "PARTIAL COMMIT")
            MessageBox.Show("TRANSACTION FAILED" & vbCrLf & "Successful before error: " & tx.AppliedCount.ToString() & vbCrLf & "Failed: " & tx.FailedCount.ToString() & vbCrLf & "Not processed: " & tx.NotProcessedCount.ToString() & vbCrLf & "Rollback failed: " & tx.RollbackFailedCount.ToString() & vbCrLf & vbCrLf & failure.Message, "BOM TRANSACTION", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return False
        End If
        For Each ch As BomPropertyChange In tx.Changes
            If ch.Status <> "COMMITTED" Then Continue For
            Dim item As PartBomItem = FindItemByDocumentKey(ch.DocumentKey)
            If item Is Nothing Then Continue For
            item.SelectedPropertyValues(ch.PropertyKey) = ch.NewValue : item.IsBomDirty = True : item.DirtyPropertyKeys.Add(ch.PropertyKey)
            If String.Equals(ch.PropertyInfo.PropertyName, "Part Number", StringComparison.OrdinalIgnoreCase) Then item.PartNumber = ch.NewValue
            RebuildItemSearchBlob(item)
            For i As Integer = _pendingTransaction.Changes.Count - 1 To 0 Step -1
                Dim p As BomPropertyChange = _pendingTransaction.Changes(i)
                If String.Equals(p.DocumentKey, ch.DocumentKey, StringComparison.OrdinalIgnoreCase) AndAlso String.Equals(p.PropertyKey, ch.PropertyKey, StringComparison.OrdinalIgnoreCase) Then _pendingTransaction.Changes.RemoveAt(i)
            Next
        Next
        tx.Status = If(tx.FailedCount = 0, "COMMITTED", "PARTIAL COMMIT")
        If tx.AppliedCount > 0 Then _transactionUndo.Push(tx) : _transactionRedo.Clear()
        RefreshGridAfterTransaction() : UpdatePendingCaption()
        If saveAfterCommit Then SaveChangedDocumentsCore()
        MessageBox.Show(tx.Status & vbCrLf & "Committed: " & tx.AppliedCount.ToString() & vbCrLf & "Failed: " & tx.FailedCount.ToString() & vbCrLf & "Remaining Pending: " & _pendingTransaction.Changes.Count.ToString(), "BOM TRANSACTION", MessageBoxButtons.OK, If(tx.FailedCount = 0, MessageBoxIcon.Information, MessageBoxIcon.Warning))
        Return tx.FailedCount = 0
    End Function

    Public Function ResolvePendingBeforeAssemblySwitch() As Boolean
        If _pendingTransaction Is Nothing OrElse _pendingTransaction.Changes Is Nothing OrElse _pendingTransaction.Changes.Count = 0 Then Return True

        Do While _pendingTransaction IsNot Nothing AndAlso _pendingTransaction.Changes IsNot Nothing AndAlso _pendingTransaction.Changes.Count > 0
            Using f As New BomPendingSwitchForm(_pendingTransaction.Changes.Count, _assemblyName)
                f.ShowDialog(Me)
                Select Case f.Decision
                    Case BomPendingSwitchDecision.Cancel
                        Return False

                    Case BomPendingSwitchDecision.Review
                        ReviewPendingClicked(Nothing, EventArgs.Empty)
                        'Review may commit/discard some or all changes. If some remain, ask again.

                    Case BomPendingSwitchDecision.Commit
                        If Not CommitPendingChanges(False) Then Return False

                    Case BomPendingSwitchDecision.Discard
                        For Each ch As BomPropertyChange In New List(Of BomPropertyChange)(_pendingTransaction.Changes)
                            RestoreGridPendingValue(ch, ch.OldValue)
                        Next
                        _pendingTransaction = New BomTransaction()
                        UpdatePendingCaption()
                        SaveSessionState()

                    Case Else
                        Return False
                End Select
            End Using
        Loop

        Return True
    End Function

    Private Function CommitPendingChanges(ByVal saveAfterCommit As Boolean) As Boolean
        Return CommitChanges(New List(Of BomPropertyChange)(_pendingTransaction.Changes), saveAfterCommit, _transactionAtomic, "COMMIT ALL")
    End Function

    Private Function FindItemByDocumentKey(ByVal key As String) As PartBomItem
        For Each item As PartBomItem In _allItems
            If String.Equals(item.DocumentKey, key, StringComparison.OrdinalIgnoreCase) Then Return item
        Next
        Return Nothing
    End Function

    Private Sub DiscardPendingClicked(ByVal sender As Object, ByVal e As EventArgs)
        If _pendingTransaction.Changes.Count = 0 Then Exit Sub
        If MessageBox.Show("Hủy " & _pendingTransaction.Changes.Count.ToString() & " Pending Changes? Inventor chưa bị thay đổi.", "DISCARD", MessageBoxButtons.YesNo, MessageBoxIcon.Question) <> DialogResult.Yes Then Exit Sub
        For Each ch As BomPropertyChange In _pendingTransaction.Changes
            RestoreGridPendingValue(ch, ch.OldValue)
        Next
        _pendingTransaction = New BomTransaction()
        UpdatePendingCaption()
    End Sub

    Private Sub RestoreGridPendingValue(ByVal ch As BomPropertyChange, ByVal value As String)
        _suppressCellWrite = True
        For Each row As DataGridViewRow In Grid.Rows
            Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
            If item Is Nothing OrElse Not String.Equals(item.DocumentKey, ch.DocumentKey, StringComparison.OrdinalIgnoreCase) Then Continue For
            For Each col As DataGridViewColumn In Grid.Columns
                Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                If pi IsNot Nothing AndAlso String.Equals(pi.Key, ch.PropertyKey, StringComparison.OrdinalIgnoreCase) Then
                    row.Cells(col.Index).Value = value
                    row.Cells(col.Index).Style.BackColor = Color.White
                    row.Cells(col.Index).ToolTipText = ""
                End If
            Next
            If Grid.Columns.Contains("DATA_STATUS") Then row.Cells("DATA_STATUS").Value = GetDataStatus(item)
        Next
        _suppressCellWrite = False
    End Sub

    Private Sub RefreshGridAfterTransaction()
        _suppressCellWrite = True
        For Each row As DataGridViewRow In Grid.Rows
            Dim item As PartBomItem = TryCast(row.Tag, PartBomItem)
            If item Is Nothing Then Continue For
            For Each col As DataGridViewColumn In Grid.Columns
                Dim pi As PropertyColumnInfo = TryCast(col.Tag, PropertyColumnInfo)
                If pi IsNot Nothing AndAlso item.SelectedPropertyValues.ContainsKey(pi.Key) Then
                    row.Cells(col.Index).Value = item.SelectedPropertyValues(pi.Key)
                    row.Cells(col.Index).Style.BackColor = Color.White
                    row.Cells(col.Index).ToolTipText = ""
                End If
            Next
            If Grid.Columns.Contains("DATA_STATUS") Then row.Cells("DATA_STATUS").Value = GetDataStatus(item)
        Next
        _suppressCellWrite = False
    End Sub

    Private Const UserDefinedPropertySetInternalName As String = "{D5CDD505-2E9C-101B-9397-08002B2CF9AE}"
    Private Const UserDefinedPropertySetName As String = "Inventor User Defined Properties"

    Private Function IsUserDefinedProperty(ByVal propertyInfo As PropertyColumnInfo) As Boolean
        If propertyInfo Is Nothing Then Return False
        If String.Equals(propertyInfo.PropertySetInternalName, UserDefinedPropertySetInternalName, StringComparison.OrdinalIgnoreCase) Then Return True
        If String.Equals(propertyInfo.PropertySetDisplayName, "User Defined Properties", StringComparison.OrdinalIgnoreCase) Then Return True
        If String.Equals(propertyInfo.PropertySetDisplayName, UserDefinedPropertySetName, StringComparison.OrdinalIgnoreCase) Then Return True
        Return False
    End Function

    Private Function GetPropertySetSafe(ByVal doc As Inventor.Document, ByVal propertyInfo As PropertyColumnInfo) As Inventor.PropertySet
        If doc Is Nothing OrElse propertyInfo Is Nothing Then Return Nothing
        Try
            Return doc.PropertySets.Item(propertyInfo.PropertySetInternalName)
        Catch
            If IsUserDefinedProperty(propertyInfo) Then
                Try
                    Return doc.PropertySets.Item(UserDefinedPropertySetName)
                Catch
                End Try
            End If
        End Try
        Return Nothing
    End Function

    Private Function PropertyExistsInDocument(ByVal doc As Inventor.Document, ByVal propertyInfo As PropertyColumnInfo) As Boolean
        If doc Is Nothing OrElse propertyInfo Is Nothing Then Return False
        If propertyInfo.IsSystemSetting Then Return True
        Dim setObj As Inventor.PropertySet = GetPropertySetSafe(doc, propertyInfo)
        If setObj Is Nothing Then Return False
        Try
            Dim prop As Inventor.Property = setObj.Item(propertyInfo.PropertyName)
            Return prop IsNot Nothing
        Catch
            Return False
        End Try
    End Function

    Private Sub DeletePropertyIfExists(ByVal doc As Inventor.Document, ByVal propertyInfo As PropertyColumnInfo)
        If doc Is Nothing OrElse propertyInfo Is Nothing Then Exit Sub
        If Not IsUserDefinedProperty(propertyInfo) Then Throw New InvalidOperationException("Chỉ Custom iProperty mới được phép xóa khi Undo/Rollback.")
        Dim setObj As Inventor.PropertySet = GetPropertySetSafe(doc, propertyInfo)
        If setObj Is Nothing Then Exit Sub
        Try
            Dim prop As Inventor.Property = setObj.Item(propertyInfo.PropertyName)
            If prop IsNot Nothing Then prop.Delete()
        Catch
            'Không tồn tại = trạng thái rollback mong muốn.
        End Try
    End Sub

    Private Sub WritePropertyValue(ByVal doc As Inventor.Document, ByVal propertyInfo As PropertyColumnInfo, ByVal newValue As String)
        If Not EnsureWriteAllowed("Write iProperty") Then Throw New InvalidOperationException("SAFE MODE: Write blocked.")
        If doc Is Nothing Then Throw New Exception("Không còn kết nối tới tài liệu Part.")
        If propertyInfo Is Nothing OrElse String.IsNullOrWhiteSpace(propertyInfo.PropertyName) Then Throw New Exception("Thông tin iProperty không hợp lệ.")

        If propertyInfo.IsSystemSetting Then
            WriteSystemSettingValue(doc, propertyInfo, newValue)
            Exit Sub
        End If

        Dim setObj As Inventor.PropertySet = GetPropertySetSafe(doc, propertyInfo)
        If setObj Is Nothing Then Throw New Exception("Không tìm thấy PropertySet: " & propertyInfo.PropertySetDisplayName)

        Dim prop As Inventor.Property = Nothing
        Try
            prop = setObj.Item(propertyInfo.PropertyName)
        Catch
            prop = Nothing
        End Try

        If prop Is Nothing Then
            If Not IsUserDefinedProperty(propertyInfo) Then
                Throw New Exception("iProperty '" & propertyInfo.PropertyName & "' chưa tồn tại và không phải Custom iProperty nên không thể tự tạo.")
            End If
            'Autodesk Inventor API: Custom iProperty được tạo bằng PropertySet.Add(value, name).
            setObj.Add(CObj(If(newValue, "")), propertyInfo.PropertyName)
        Else
            prop.Value = newValue
        End If
        'Không Update2 sau từng ô: đây là một COM/API operation rất đắt.
        'Document đã tự chuyển sang Dirty; Update/Save được gom theo lệnh người dùng.
    End Sub

    Private Sub RebuildItemSearchBlob(ByVal item As PartBomItem)
        If item Is Nothing Then Exit Sub
        item.SearchBlob = (item.FileName & "|" & item.FilePath & "|" & item.PartNumber & "|" & item.Description & "|" & item.Material & "|" & item.Vendor & "|" & item.Revision & "|" & item.StockNumber & "|" & item.Project & "|" & item.Category & "|" & item.GetParentAssemblyText()).ToUpperInvariant()
        For Each kv As KeyValuePair(Of String, Object) In item.SelectedPropertyValues
            item.SearchBlob &= "|" & Convert.ToString(kv.Value).ToUpperInvariant()
        Next
    End Sub

    Private Sub GridDataError(ByVal sender As Object, ByVal e As System.Windows.Forms.DataGridViewDataErrorEventArgs)
        e.ThrowException = False
    End Sub


