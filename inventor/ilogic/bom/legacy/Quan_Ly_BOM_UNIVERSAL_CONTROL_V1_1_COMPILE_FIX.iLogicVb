    Private Sub ManufacturingExportClicked(ByVal sender As Object, ByVal e As EventArgs)
        Dim summary As BomManufacturingSummary = BomManufacturingEngine.Analyze(_allItems)
        Using dlg As New SaveFileDialog()
            dlg.Title = "EXPORT MANUFACTURING SUMMARY"
            dlg.Filter = "CSV (*.csv)|*.csv"
            dlg.FileName = "MANUFACTURING_SUMMARY_" & DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".csv"
            If dlg.ShowDialog(Me) <> DialogResult.OK Then Exit Sub
            Try
                Using sw As New System.IO.StreamWriter(dlg.FileName, False, System.Text.Encoding.UTF8)
                    sw.WriteLine("MATERIAL,THICKNESS,PROCESS,UNIQUE PARTS,TOTAL QTY,MANUFACTURE,PURCHASE")
                    For Each g As BomManufacturingGroup In summary.Groups
                        sw.WriteLine(CsvChangeValue(g.Material) & "," &
                                     CsvChangeValue(g.Thickness) & "," &
                                     CsvChangeValue(g.ProcessName) & "," &
                                     g.PartCount.ToString() & "," &
                                     g.TotalQty.ToString() & "," &
                                     g.ManufacturedCount.ToString() & "," &
                                     g.PurchasedCount.ToString())
                    Next
                End Using
                MessageBox.Show("Đã xuất Manufacturing Summary:" & System.Environment.NewLine & dlg.FileName,
                                "MANUFACTURING", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Catch ex As Exception
                BomLogger.Log("MANUFACTURING", dlg.FileName, "Export", "ERROR", ex.Message)
                MessageBox.Show(ex.Message, "MANUFACTURING", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
