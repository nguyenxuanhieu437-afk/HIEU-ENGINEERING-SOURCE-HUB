    Private Sub AddMenuItem(ByVal caption As String, ByVal handler As EventHandler)
        Dim item As New ToolStripMenuItem(caption)
        AddHandler item.Click, handler
        ContextMenu.Items.Add(item)
    End Sub


    Private Function AddCheckMenuItem(ByVal caption As String, ByVal checkedValue As Boolean, ByVal handler As EventHandler) As ToolStripMenuItem
        Dim item As New ToolStripMenuItem(caption)
        item.CheckOnClick = True
        item.Checked = checkedValue
        AddHandler item.CheckedChanged, handler
        ContextMenu.Items.Add(item)
        Return item
    End Function

    Private Sub AutoHighlightOptionChanged(ByVal sender As Object, ByVal e As EventArgs)
        'Giữ method để tương thích code cũ nhưng Auto Highlight đã bị vô hiệu hóa.
        _autoHighlightOnClick = False
        If _menuAutoHighlight IsNot Nothing Then _menuAutoHighlight.Checked = False
    End Sub

    Private Sub AutoZoomOptionChanged(ByVal sender As Object, ByVal e As EventArgs)
        _autoZoomOnClick = (_menuAutoZoom IsNot Nothing AndAlso _menuAutoZoom.Checked)
    End Sub

    Private Sub HighlightAllOptionChanged(ByVal sender As Object, ByVal e As EventArgs)
        _highlightAllOccurrences = (_menuHighlightAll Is Nothing OrElse _menuHighlightAll.Checked)
        'Không Highlight ngay; chỉ áp dụng ở lần nhấn HIGHLIGHT/ZOOM tiếp theo.
    End Sub

    Private Sub TwoWaySyncOptionChanged(ByVal sender As Object, ByVal e As EventArgs)
        _syncInventorToBom = (_menuTwoWaySync Is Nothing OrElse _menuTwoWaySync.Checked)
    End Sub



