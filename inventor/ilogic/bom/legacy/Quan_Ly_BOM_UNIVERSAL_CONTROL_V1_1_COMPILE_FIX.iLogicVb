    Private Sub AppendWhereUsedNodeText(ByVal node As BomWhereUsedNode, ByVal sb As System.Text.StringBuilder, ByVal depth As Integer)
        If node Is Nothing Then Exit Sub
        If depth > 0 Then
            sb.Append(New String(" "c, Math.Min(40, (depth - 1) * 3)))
            sb.Append("└─ ")
            sb.Append(node.Name)
            sb.Append("   Local Qty: ")
            sb.Append(node.LocalQty.ToString())
            sb.Append("   Occ: ")
            sb.Append(node.OccurrenceCount.ToString())
            sb.AppendLine()
        End If
        node.Children.Sort(Function(a As BomWhereUsedNode, b As BomWhereUsedNode) StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name))
        For Each child As BomWhereUsedNode In node.Children
            AppendWhereUsedNodeText(child, sb, depth + 1)
        Next
    End Sub

    Private Sub ImpactAnalysisClicked(ByVal sender As Object, ByVal e As EventArgs)
        ShowDependencyImpact(True)
    End Sub

    Private Sub FinalRegressionClicked(ByVal sender As Object, ByVal e As EventArgs)
        BomSafeExecution.Run("FINAL REGRESSION CHECK",
            Sub()
                Dim checks As List(Of BomRegressionCheck) =
                    BomRegressionEngine.Run(_allItems, _structureRoot, _activeSnapshot)

                Dim passed As Integer = 0
                Dim failed As Integer = 0
                Dim sb As New System.Text.StringBuilder()
                sb.AppendLine(BomReleaseInfo.Version & " - " & BomReleaseInfo.ReleaseName)
                sb.AppendLine(BomReleaseInfo.Architecture)
                sb.AppendLine(New String("-"c, 72))

                For Each c As BomRegressionCheck In checks
                    If c.Passed Then passed += 1 Else failed += 1
                    sb.Append(If(c.Passed, "[PASS] ", "[FAIL] "))
                    sb.Append(c.Name)
                    sb.Append("  -  ")
                    sb.AppendLine(c.Detail)
                Next

                sb.AppendLine(New String("-"c, 72))
                sb.AppendLine("PASS: " & passed.ToString() & "   FAIL: " & failed.ToString())
                sb.AppendLine("RUNTIME ERRORS: " & BomProductionDiagnostics.ErrorCount.ToString())
                sb.AppendLine("RECOVERIES: " & BomProductionDiagnostics.RecoveryCount.ToString())
                sb.AppendLine()
                If failed = 0 Then
                    sb.AppendLine("RELEASE STATUS: READY FOR PRODUCTION")
                Else
                    sb.AppendLine("RELEASE STATUS: REVIEW FAILED CHECKS BEFORE PRODUCTION")
                End If

                ShowProjectIntelligenceText("V23 FINAL REGRESSION", sb.ToString())
            End Sub)
    End Sub

    Private Sub HealthCheckClicked(ByVal sender As Object, ByVal e As EventArgs)
        BomSafeExecution.Run("HEALTH CHECK",
            Sub()
                Dim result As BomIntegrityResult = BomIntegrityEngine.Check(_allItems, _structureRoot)
                Dim sb As New System.Text.StringBuilder()
                sb.AppendLine(If(result.IsHealthy(), "STATUS: HEALTHY", "STATUS: ERROR"))
                sb.AppendLine("ITEMS: " & If(_allItems Is Nothing, 0, _allItems.Count).ToString())
                sb.AppendLine("ERRORS: " & result.Errors.Count.ToString())
                sb.AppendLine("WARNINGS: " & result.Warnings.Count.ToString())
                sb.AppendLine("RECOVERIES: " & BomProductionDiagnostics.RecoveryCount.ToString())
                sb.AppendLine("RUNTIME ERRORS: " & BomProductionDiagnostics.ErrorCount.ToString())
                If result.Errors.Count > 0 Then
                    sb.AppendLine().AppendLine("ERROR DETAIL:")
                    For Each s As String In result.Errors
                        sb.AppendLine(" • " & s)
                    Next
                End If
                If result.Warnings.Count > 0 Then
                    sb.AppendLine().AppendLine("WARNING DETAIL:")
                    For Each s As String In result.Warnings
                        sb.AppendLine(" • " & s)
                    Next
                End If
                ShowProjectIntelligenceText("PRODUCTION HEALTH CHECK", sb.ToString())
            End Sub)
    End Sub

    Private Sub RecoverUiClicked(ByVal sender As Object, ByVal e As EventArgs)
        BomSafeExecution.Run("RECOVER UI",
            Sub()
                _suppressCellWrite = True
                Try
                    Grid.EndEdit()
                Catch
                End Try
                Try
                    Grid.ClearSelection()
                Catch
                End Try
                _quickFilterMode = "ALL"
                _collapsedGroups.Clear()
                BomDependencyCache.Clear()
                LoadRows()
                BomProductionDiagnostics.RecoveryCount += 1
            End Sub)
        _suppressCellWrite = False
    End Sub

