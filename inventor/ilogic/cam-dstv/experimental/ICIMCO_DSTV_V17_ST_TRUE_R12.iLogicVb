' ICIMCO DSTV V10 AK CUT DIAGNOSTIC / Autodesk Inventor iLogic VB.NET
' Units in DSTV: mm. Units Inventor API geometry: cm.
' Supported import: U / PFC prismatic section, circular BO holes on v/o/u.
' Rounded contours and arbitrary E/B planes are DETECTED, NOT silently approximated.
' IK straight-sided contours are now cut from the correct datum face.
' Export: reversible source of imported part ONLY IF Inventor feature count is unchanged.
' This is a PROTOTYPE, NOT a certified manufacturing NC post-processor.

AddReference "System.Windows.Forms"
Imports System
Imports System.IO
Imports System.Text
Imports System.Text.RegularExpressions
Imports System.Globalization
Imports System.Collections.Generic
Imports System.Windows.Forms
Imports Inventor

Sub Main()
    Try
        Dim opt As String = InputBox("1 = DỰNG ĐẦY ĐỦ (ST + BO + AK; B0 theo khả năng bản hiện tại)" & vbCrLf & _
                                     "2 = Xuất lại DSTV từ Part đã nhập (chưa chỉnh sửa)" & vbCrLf & _
                                     "3 = CHỈ KIỂM TRA ST (không có BO/AK)" & vbCrLf & _
                                     "0 = Thoát", "ICIMCO DSTV AK V10", "1")
        Select Case opt.Trim()
            Case "1" : ImportNc(False)
            Case "3" : ImportNc(True)
            Case "2" : ExportNc()
            Case Else : Return
        End Select
    Catch ex As Exception
        MessageBox.Show(ex.ToString(), "ICIMCO DSTV - ERROR")
    End Try
End Sub

Private Sub AttachEndpoint(ByVal sketch As PlanarSketch, ByVal endA As SketchPoint, ByVal startB As SketchPoint)
    ' Spatial coincidence is insufficient for a reliably joined Inventor profile.
    ' Explicitly connect the real topology of the line endpoint and arc startpoint.
    Try
        sketch.GeometricConstraints.AddCoincident(endA, startB)
    Catch ex As Exception
        Dim dx As Double = endA.Geometry.X - startB.Geometry.X
        Dim dy As Double = endA.Geometry.Y - startB.Geometry.Y
        If Math.Sqrt(dx * dx + dy * dy) > 0.000001 Then
            Throw New Exception("ST line-arc join failed: " & ex.Message)
        End If
        ' Already joined or auto-constrained by Inventor.
    End Try
End Sub

Private Function Num(ByVal s As String) As Double
    Return Double.Parse(s, CultureInfo.InvariantCulture)
End Function

Private Function Tokens(ByVal line As String) As String()
    Return Regex.Split(line.Trim(), "\s+")
End Function

Private Function IsNumericToken(ByVal s As String) As Boolean
    Return Regex.IsMatch(s, "^[+-]?\d+(?:\.\d+)?[uUvV]?$", RegexOptions.CultureInvariant)
End Function

Private Function ValToken(ByVal s As String) As Double
    Return Num(Regex.Replace(s, "[uUvV]$", ""))
End Function

Private Function SafeName(ByVal s As String) As String
    Return Regex.Replace(s, "[^A-Za-z0-9_\-]", "_")
End Function

Private Sub ImportNc(Optional ByVal stockOnly As Boolean = False)
    Dim sourcePath As String = ""
    Using dlg As New OpenFileDialog()
        dlg.Filter = "DSTV NC (*.nc;*.nc1)|*.nc;*.nc1|All files (*.*)|*.*"
        dlg.Title = "Chọn DSTV NC/NC1"
        If dlg.ShowDialog() <> DialogResult.OK Then Return
        sourcePath = dlg.FileName
    End Using

    Dim content As String = System.IO.File.ReadAllText(sourcePath)
    Dim lines As String() = Regex.Split(content, "\r\n|\n|\r")
    Dim blockName As String = ""
    Dim header As New List(Of String)()
    Dim holeData As New List(Of String)()
    Dim unhandled As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
    Dim contourCount As Integer = 0
    Dim contourData As New List(Of List(Of String))()
    Dim contourSides As New List(Of String)()
    Dim activeContour As List(Of String) = Nothing
    Dim siData As New List(Of String)()
    Dim planeData As New Dictionary(Of String, List(Of String))(StringComparer.OrdinalIgnoreCase)
    Dim sawEnd As Boolean = False

    For Each raw As String In lines
        Dim ln As String = raw.Trim()
        If ln.Length = 0 OrElse ln.StartsWith("**") Then Continue For
        Select Case ln.ToUpperInvariant()
            Case "ST", "BO", "AK", "IK", "SI", "PU", "KO", "EN", "SC"
                blockName = ln.ToUpperInvariant()
                If blockName = "AK" OrElse blockName = "IK" Then
                    contourCount += 1
                    activeContour = New List(Of String)()
                    contourData.Add(activeContour)
                    contourSides.Add(blockName)
                End If
                If blockName = "EN" Then sawEnd = True
                Continue For
        End Select
        If Regex.IsMatch(ln, "^[EB]\d+$", RegexOptions.IgnoreCase) Then
            blockName = ln.ToUpperInvariant()
            unhandled.Add(blockName)
            planeData(blockName) = New List(Of String)()
            Continue For
        End If
        If blockName = "ST" Then
            header.Add(ln)
        ElseIf blockName = "BO" Then
            holeData.Add(ln)
        ElseIf blockName = "AK" OrElse blockName = "IK" Then
            activeContour.Add(ln)
        ElseIf blockName = "SI" Then
            siData.Add(ln)
        ElseIf planeData.ContainsKey(blockName) Then
            planeData(blockName).Add(ln)
        ElseIf blockName <> "EN" Then
            unhandled.Add(blockName)
        End If
    Next

    If Not sawEnd Then Throw New Exception("Thiếu EN: không đủ điều kiện đọc file.")
    If header.Count < 15 Then Throw New Exception("Header ST không đủ trường. Không dựng để tránh sai kích thước.")

    ' DSTV ST normal header indices (0 based): order, drawing, phase, piece, grade,
    ' qty, profile, section type, length, height, width, radius, web, flange, weight.
    Dim partMark As String = header(3)
    Dim grade As String = header(4)
    Dim section As String = header(7).ToUpperInvariant()
    If section <> "U" Then Throw New Exception("MVP01 chỉ dựng tiết diện U/PFC. File này có loại: " & section)
    Dim lengthMm As Double = Num(header(8))
    Dim heightMm As Double = Num(header(9))
    Dim widthMm As Double = Num(header(10))
    Dim flangeMm As Double = Num(header(11))
    Dim webMm As Double = Num(header(12))
    Dim radiusMm As Double = Num(header(13))
    If lengthMm <= 0 OrElse heightMm <= 0 OrElse widthMm <= 0 OrElse webMm <= 0 OrElse flangeMm <= 0 Then
        Throw New Exception("Kích thước phôi không hợp lệ.")
    End If
    If webMm >= widthMm OrElse (2 * flangeMm) >= heightMm OrElse radiusMm < 0 OrElse webMm + radiusMm >= widthMm OrElse 2.0 * (flangeMm + radiusMm) >= heightMm Then
        Throw New Exception("Thông số tiết diện U không hợp lệ.")
    End If

    Dim pd As PartDocument = CType(ThisApplication.Documents.Add(DocumentTypeEnum.kPartDocumentObject, _
                                     ThisApplication.FileManager.GetTemplateFile(DocumentTypeEnum.kPartDocumentObject), True), PartDocument)
    Dim cd As PartComponentDefinition = pd.ComponentDefinition
    Dim tg As TransientGeometry = ThisApplication.TransientGeometry
    Dim sk As PlanarSketch = cd.Sketches.Add(cd.WorkPlanes.Item(3)) ' XY

    ' V17: PFC ST profile with two TRUE tangent quarter-circle R12 arcs.
    ' Coordinates mm; Inventor sketch coordinates cm. Never add final-stage fillet.
    Dim nominalAreaMm2 As Double = 2.0 * widthMm * flangeMm + _
        webMm * (heightMm - 2.0 * flangeMm) + _
        2.0 * radiusMm * radiusMm * (1.0 - Math.PI / 4.0)
    Dim lowerY As Double = flangeMm + radiusMm
    Dim upperY As Double = heightMm - flangeMm - radiusMm
    Dim tangentX As Double = webMm + radiusMm
    Dim k As Double = radiusMm / Math.Sqrt(2.0)
    Dim lowerArc As SketchArc = Nothing
    Dim upperArc As SketchArc = Nothing
    If radiusMm > 0.000001 Then
        lowerArc = sk.SketchArcs.AddByThreePoints( _
            tg.CreatePoint2d(tangentX / 10.0, flangeMm / 10.0), _
            tg.CreatePoint2d((tangentX - k) / 10.0, (lowerY - k) / 10.0), _
            tg.CreatePoint2d(webMm / 10.0, lowerY / 10.0))
        upperArc = sk.SketchArcs.AddByThreePoints( _
            tg.CreatePoint2d(webMm / 10.0, upperY / 10.0), _
            tg.CreatePoint2d((tangentX - k) / 10.0, (upperY + k) / 10.0), _
            tg.CreatePoint2d(tangentX / 10.0, (heightMm - flangeMm) / 10.0))
    End If
    ' Connect with the REAL SketchPoint endpoints, not free floating equal-coordinate lines.
    Dim outer0 As SketchLine = sk.SketchLines.AddByTwoPoints( _
        tg.CreatePoint2d(0, 0), tg.CreatePoint2d(widthMm / 10.0, 0))
    Dim outer1 As SketchLine = sk.SketchLines.AddByTwoPoints(outer0.EndSketchPoint, _
        tg.CreatePoint2d(widthMm / 10.0, flangeMm / 10.0))
    Dim lastEdge As SketchLine = Nothing
    If radiusMm > 0.000001 Then
        sk.SketchLines.AddByTwoPoints(outer1.EndSketchPoint, lowerArc.StartSketchPoint)
        sk.SketchLines.AddByTwoPoints(lowerArc.EndSketchPoint, upperArc.StartSketchPoint)
        lastEdge = sk.SketchLines.AddByTwoPoints(upperArc.EndSketchPoint, _
            tg.CreatePoint2d(widthMm / 10.0, (heightMm - flangeMm) / 10.0))
    Else
        Dim webStart As SketchLine = sk.SketchLines.AddByTwoPoints(outer1.EndSketchPoint, _
            tg.CreatePoint2d(webMm / 10.0, flangeMm / 10.0))
        Dim webEnd As SketchLine = sk.SketchLines.AddByTwoPoints(webStart.EndSketchPoint, _
            tg.CreatePoint2d(webMm / 10.0, (heightMm - flangeMm) / 10.0))
        lastEdge = sk.SketchLines.AddByTwoPoints(webEnd.EndSketchPoint, _
            tg.CreatePoint2d(widthMm / 10.0, (heightMm - flangeMm) / 10.0))
    End If
    lastEdge = sk.SketchLines.AddByTwoPoints(lastEdge.EndSketchPoint, _
        tg.CreatePoint2d(widthMm / 10.0, heightMm / 10.0))
    lastEdge = sk.SketchLines.AddByTwoPoints(lastEdge.EndSketchPoint, _
        tg.CreatePoint2d(0, heightMm / 10.0))
    sk.SketchLines.AddByTwoPoints(lastEdge.EndSketchPoint, outer0.StartSketchPoint)
    If sk.SketchLines.Count <> 8 Then Throw New Exception("ST: expected 8 lines")
    If radiusMm > 0.000001 AndAlso sk.SketchArcs.Count <> 2 Then Throw New Exception("ST: expected exactly 2 true arcs")
    Dim pro As Profile = sk.Profiles.AddForSolid()
    Dim extr As ExtrudeDefinition = cd.Features.ExtrudeFeatures.CreateExtrudeDefinition(pro, PartFeatureOperationEnum.kJoinOperation)
    extr.SetDistanceExtent(lengthMm / 10.0, PartFeatureExtentDirectionEnum.kPositiveExtentDirection)
    Dim stockExtrude As ExtrudeFeature = cd.Features.ExtrudeFeatures.Add(extr)
    stockExtrude.Name = "ICIMCO_ST_PFC_TRUE_R" & radiusMm.ToString("0.###", CultureInfo.InvariantCulture)
    cd.Document.Update()
    Dim measuredAreaMm2 As Double = cd.SurfaceBodies.Item(1).Volume(0.01) * 1000.0 / lengthMm
    If Math.Abs(measuredAreaMm2 - nominalAreaMm2) > Math.Max(2.0, nominalAreaMm2 * 0.001) Then
        Throw New Exception("ST area mismatch: expected " & nominalAreaMm2.ToString("F3", CultureInfo.InvariantCulture) & _
                            " mm2, actual " & measuredAreaMm2.ToString("F3", CultureInfo.InvariantCulture) & " mm2")
    End If
    Dim deferredFilletReport As String = "R12 already part of original ST Sketch (no Fillet Feature)"

    If stockOnly Then
        pd.Update()
        Dim stockPath As String = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(sourcePath), _
                  SafeName(System.IO.Path.GetFileNameWithoutExtension(sourcePath)) & "_ST_TRUE_R12_ONLY.ipt")
        If System.IO.File.Exists(stockPath) Then
            stockPath = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(sourcePath), _
                        SafeName(System.IO.Path.GetFileNameWithoutExtension(sourcePath)) & "_ST_TRUE_R12_ONLY_" & DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".ipt")
        End If
        pd.SaveAs(stockPath, False)
        MessageBox.Show("ST ONLY TRUE R12: flange=" & flangeMm & "mm; web=" & webMm & _
            "mm; R12 in ST Sketch; arcs=" & sk.SketchArcs.Count.ToString() & _
            "; measured section area=" & measuredAreaMm2.ToString("F3", CultureInfo.InvariantCulture) & " mm2" & vbCrLf & _
            "Only base extrusion. No BO/AK/B0. File: " & stockPath, "ICIMCO ST VALIDATION")
        Return
    End If

    Dim parsedHoles As Integer = 0
    Dim invalidHoles As Integer = 0
    Dim todo As New Dictionary(Of String, List(Of Double()))(StringComparer.OrdinalIgnoreCase)
    For Each h As String In holeData
        Dim t As String() = Tokens(h)
        If t.Length < 4 Then
            invalidHoles += 1 : Continue For
        End If
        Dim side As String = t(0).ToLowerInvariant()
        If side <> "v" AndAlso side <> "o" AndAlso side <> "u" Then
            invalidHoles += 1 : Continue For
        End If
        Try
            Dim xx As Double = ValToken(t(1))
            Dim yy As Double = ValToken(t(2))
            Dim dia As Double = ValToken(t(3))
            If dia <= 0 OrElse xx < 0 OrElse xx > lengthMm OrElse yy < 0 Then
                invalidHoles += 1 : Continue For
            End If
            If Not todo.ContainsKey(side) Then todo.Add(side, New List(Of Double())())
            todo(side).Add(New Double() {xx, yy, dia})
        Catch
            invalidHoles += 1
        End Try
    Next

    ' Reconstruct BO circular through-holes on their referenced faces.
    ' Datum assumption: v = web (Y maps across 250 depth),
    ' o = near flange (Y maps across 90 width), u = opposite flange.
    For Each side As String In todo.Keys
        Try
            Dim face As Face = FindFace(cd, side, heightMm)
            If face Is Nothing Then
                invalidHoles += todo(side).Count
                Continue For
            End If
            Dim hs As PlanarSketch = cd.Sketches.Add(face)
            For Each h As Double() In todo(side)
                Dim holeCenter3D As Inventor.Point
                If side = "v" Then
                    holeCenter3D = tg.CreatePoint(0, h(1) / 10.0, h(0) / 10.0)
                ElseIf side = "o" Then
                    holeCenter3D = tg.CreatePoint(h(1) / 10.0, 0, h(0) / 10.0)
                Else
                    holeCenter3D = tg.CreatePoint(h(1) / 10.0, heightMm / 10.0, h(0) / 10.0)
                End If
                Dim center As Point2d = hs.ModelToSketchSpace(holeCenter3D)
                hs.SketchCircles.AddByCenterRadius(center, h(2) / 20.0)
                parsedHoles += 1
            Next
            Dim cp As Profile = hs.Profiles.AddForSolid()
            Dim cdef As ExtrudeDefinition = cd.Features.ExtrudeFeatures.CreateExtrudeDefinition(cp, PartFeatureOperationEnum.kCutOperation)
            cdef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
            cd.Features.ExtrudeFeatures.Add(cdef)
        Catch ex As Exception
            invalidHoles += todo(side).Count
            parsedHoles -= todo(side).Count
            unhandled.Add("BO-" & side & " (" & ex.Message & ")")
        End Try
    Next

    ' AK contour -> genuine material removal outside the declared outline.
    ' Polygon corner radii are not yet solved: flagged explicitly rather than silently certified.
    Dim builtAk As Integer = 0
    Dim failedAk As New List(Of String)()
    Dim rounded As Integer = 0
    Dim builtIk As Integer = 0
    Dim deniedRounded As Integer = 0
    For ci As Integer = 0 To contourData.Count - 1
        Dim linesAk As List(Of String) = contourData(ci)
        Try
            Dim sideAk As String = ""
            Dim coords As New List(Of Double())()
            Dim hasArc As Boolean = False
            For Each a As String In linesAk
                Dim t As String() = Tokens(a)
                If t.Length < 4 Then Throw New Exception("Missing contour coordinate")
                Dim sideNow As String = t(0).ToLowerInvariant()
                If sideNow <> "v" AndAlso sideNow <> "o" AndAlso sideNow <> "u" Then Throw New Exception("Unknown face " & sideNow)
                If sideAk = "" Then sideAk = sideNow
                If sideAk <> sideNow Then Throw New Exception("Mixed-face contour")
                Dim z As Double = ValToken(t(3))
                If Math.Abs(z) > 0.00001 Then
                    rounded += 1
                    hasArc = True
                End If
                coords.Add(New Double() {ValToken(t(1)), ValToken(t(2))})
            Next
            If coords.Count < 4 Then Throw New Exception("Contour needs >=3 vertices and closure")
            If Not Same2(coords(0), coords(coords.Count - 1)) Then Throw New Exception("Contour is not closed")
            coords.RemoveAt(coords.Count - 1)
            If Math.Abs(PolygonArea(coords)) < 1.0 Then Throw New Exception("Degenerate contour")
            ' Do not turn an actual rounded contour into an incorrect sharp cut.
            ' V06: approximate nonzero signed DSTV arc entries with tessellated fillets.
            ' Exact signed-radius semantics require verification against a known DSTV reference.
            ' V14: preserve raw AK vertices. Signed R belongs to the NEXT segment,
            ' not an interpolated fillet at the current vertex.
            If hasArc AndAlso sideAk <> "v" Then Throw New Exception("Curved AK only implemented on face v")
            If contourSides(ci) = "IK" Then
                CutInsideIk(cd, tg, sideAk, coords, heightMm)
                builtIk += 1
            Else
                CutOutsideAk(cd, tg, sideAk, coords, lengthMm, heightMm, widthMm, webMm, flangeMm, radiusMm, linesAk)
                builtAk += 1
            End If
        Catch ex As Exception
            failedAk.Add("AK #" & (ci + 1).ToString() & ": " & ex.Message)
        End Try
    Next

    ' No end-stage ST Fillet: root radius is already part of the original section.
    ' AK R11 remains a straight-chord pre-finish stage in V16; flagged unfinished.
    If rounded > 0 Then failedAk.Add("AK R11 deferred: " & rounded.ToString() & " signed-arc records require final arc finishing")

    ' SI is a marking instruction, not removal of structural material.
    ' Preserve it as metadata for follow-up engraving/marking machine routing.
    Dim markText As String = String.Join(" | ", siData)
    Dim auxiliaryCount As Integer = 0
    For Each k As String In planeData.Keys
        auxiliaryCount += planeData(k).Count
    Next

    pd.Update()
    ' Store an exact source round-trip snapshot, not a claimed CAD-to-NC converter.
    Dim props As PropertySet = pd.PropertySets.Item("Inventor User Defined Properties")
    SaveProp(props, "ICIMCO_NC_SOURCE", Convert.ToBase64String(Encoding.UTF8.GetBytes(content)))
    SaveProp(props, "ICIMCO_NC_FEATURES", cd.Features.ExtrudeFeatures.Count.ToString(CultureInfo.InvariantCulture))
    SaveProp(props, "ICIMCO_NC_IMPORT_COMPLETE", "NO")
    SaveProp(props, "ICIMCO_ST_PFC_AREA_MM2", nominalAreaMm2.ToString("F3", CultureInfo.InvariantCulture))
    SaveProp(props, "ICIMCO_ST_ROOT_RADIUS_MM", radiusMm.ToString("R", CultureInfo.InvariantCulture))
    SaveProp(props, "ICIMCO_NC_LENGTH_MM", lengthMm.ToString(CultureInfo.InvariantCulture))
    SaveProp(props, "ICIMCO_NC_PART_MARK", partMark)
    SaveProp(props, "ICIMCO_NC_UNSUPPORTED", "Contour errors=" & String.Join(" | ", failedAk) & "; radius-points=" & rounded.ToString() & "; E/B lines=" & auxiliaryCount.ToString())
    SaveProp(props, "ICIMCO_SI_MARK", markText)

    Dim savePath As String = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(sourcePath), _
                                SafeName(System.IO.Path.GetFileNameWithoutExtension(sourcePath)) & "_ICIMCO_PREVIEW.ipt")
    If System.IO.File.Exists(savePath) Then
        savePath = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(sourcePath), _
                      SafeName(System.IO.Path.GetFileNameWithoutExtension(sourcePath)) & "_ICIMCO_PREVIEW_" & _
                      DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".ipt")
    End If
    pd.SaveAs(savePath, False)
    Dim report As New StringBuilder()
    report.AppendLine("DSTV V17 / ST TRUE R12 BEFORE BO AND AK - CHUA PHE DUYET GIA CONG")
    report.AppendLine("Part: " & partMark & " | " & header(6) & " | " & grade)
    report.AppendLine("Kích thước (mm): " & lengthMm & " x " & heightMm & " x " & widthMm)
    report.AppendLine("ST: flange thickness=" & flangeMm & " | web thickness=" & webMm & " | root radius=" & radiusMm & " mm")
    report.AppendLine("ST: true rounded-section reference area=" & nominalAreaMm2.ToString("F2", CultureInfo.InvariantCulture) & " mm2")
    report.AppendLine("Lỗ BO thử dựng: " & parsedHoles & "; chưa dựng/không hợp lệ: " & invalidHoles)
    report.AppendLine("AK V12 uses ORIGINAL datum planes, not dynamic BRep faces")
    report.AppendLine("AK outer cuts: " & builtAk)
    report.AppendLine("IK inner cuts: " & builtIk)
    report.AppendLine("Rounded contours attempted (polygonal approximation): " & rounded)
    report.AppendLine("Contour failures: " & String.Join(" | ", failedAk))
    report.AppendLine("Nonzero AK arc parameters read (true arcs on v): " & rounded.ToString())
    report.AppendLine("R12 state: " & deferredFilletReport)
    report.AppendLine("SI marking stored in iProperties: " & siData.Count.ToString())
    report.AppendLine("E/B auxiliary-plane raw data lines (NOT CUT): " & auxiliaryCount.ToString())
    report.AppendLine("Bán kính tiết diện R" & radiusMm & " mm: 2 cung thật trong Sketch ST")
    report.AppendLine("Khối khác: " & String.Join(", ", unhandled))
    report.AppendLine("Chưa bảo đảm model đúng sản xuất, KHÔNG xuất gia công từ preview.")
    report.AppendLine("Đã lưu: " & savePath)
    MessageBox.Show(report.ToString(), "ICIMCO DSTV IMPORT")
End Sub


Private Function Same2(ByVal a As Double(), ByVal b As Double()) As Boolean
    Return Math.Abs(a(0) - b(0)) < 0.001 AndAlso Math.Abs(a(1) - b(1)) < 0.001
End Function

Private Function PolygonArea(ByVal p As List(Of Double())) As Double
    Dim a As Double = 0
    For i As Integer = 0 To p.Count - 1
        Dim j As Integer = (i + 1) Mod p.Count
        a += p(i)(0) * p(j)(1) - p(j)(0) * p(i)(1)
    Next
    Return 0.5 * a
End Function

Private Function AkPoint(ByVal tg As TransientGeometry, ByVal side As String, ByVal a As Double(), Optional ByVal heightMm As Double = 0) As Inventor.Point
    If side = "v" Then Return tg.CreatePoint(0, a(1) / 10.0, a(0) / 10.0)
    If side = "o" Then Return tg.CreatePoint(a(1) / 10.0, 0, a(0) / 10.0)
    Return tg.CreatePoint(a(1) / 10.0, heightMm / 10.0, a(0) / 10.0)
End Function

Private Sub ClosedLoop(ByVal sk As PlanarSketch, ByVal tg As TransientGeometry, ByVal coords As List(Of Inventor.Point))
    If coords.Count < 3 Then Throw New Exception("Too few loop vertices")
    Dim a As Inventor.Point2d = sk.ModelToSketchSpace(coords(0))
    Dim b As Inventor.Point2d = sk.ModelToSketchSpace(coords(1))
    Dim first As SketchLine = sk.SketchLines.AddByTwoPoints(a, b)
    Dim last As SketchLine = first
    For i As Integer = 2 To coords.Count - 1
        last = sk.SketchLines.AddByTwoPoints(last.EndSketchPoint, sk.ModelToSketchSpace(coords(i)))
    Next
    sk.SketchLines.AddByTwoPoints(last.EndSketchPoint, first.StartSketchPoint)
End Sub

Private Sub CutInsideIk(ByVal cd As PartComponentDefinition, ByVal tg As TransientGeometry, _
                        ByVal side As String, ByVal pts As List(Of Double()), ByVal heightMm As Double)
    Dim target As Face = FindFace(cd, side, heightMm)
    If target Is Nothing Then Throw New Exception("Không tìm thấy mặt gia công IK " & side)
    Dim sk As PlanarSketch = cd.Sketches.Add(target)
    Dim inner As New List(Of Inventor.Point)()
    For Each a As Double() In pts
        inner.Add(AkPoint(tg, side, a, heightMm))
    Next
    ClosedLoop(sk, tg, inner)
    Dim pro As Inventor.Profile = sk.Profiles.AddForSolid()
    Dim cut As ExtrudeDefinition = cd.Features.ExtrudeFeatures.CreateExtrudeDefinition(pro, PartFeatureOperationEnum.kCutOperation)
    cut.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
    cd.Features.ExtrudeFeatures.Add(cut)
End Sub

Private Sub CutOutsideAk(ByVal cd As PartComponentDefinition, ByVal tg As TransientGeometry, _
                         ByVal side As String, ByVal pts As List(Of Double()), _
                         ByVal lengthMm As Double, ByVal heightMm As Double, ByVal widthMm As Double, _
                         ByVal webMm As Double, ByVal flangeMm As Double, ByVal rootRadiusMm As Double, _
                         ByVal originalAk As List(Of String))
    ' V11: remove material in small independent areas near stock ENDS.
    ' Never use a full-length outer island sketch. Preserve the filleted ST web/corners.
    ' V13: AK-v needs access through the full depth of the PFC flanges.
    ' The web coping must reach x = section width; otherwise a
    ' longitudinal residual corner may remain on the coped end.
    ' Only applies to local v-face end cuts. BO/B0, ST and u/o untouched.
    Dim thicknessMm As Double = If(side = "v", widthMm, flangeMm)
    ' V13 AK-v: reach full channel width (90 mm), not only web+root (20 mm).
    ' The removed XY/YZ area remains restricted to each end-local AK polygon.
    ' o/u faces use existing 15 mm limited-depth logic unchanged.
    Dim faceDepth As Double = If(side = "v", heightMm, widthMm)
    Dim xmin As Double = Double.PositiveInfinity
    Dim xmax As Double = Double.NegativeInfinity
    For Each p As Double() In pts
        xmin = Math.Min(xmin, p(0)) : xmax = Math.Max(xmax, p(0))
    Next
    Dim leftLimit As Double = Math.Min(lengthMm / 2.0, 120.0)
    Dim rightLimit As Double = Math.Max(lengthMm / 2.0, lengthMm - 120.0)
    Dim applied As Integer = 0
    Dim errors As New List(Of String)()

    If side = "o" OrElse side = "u" Then
        ' Full-width flange AK in sample M45: declared rectangle x=82.45..4252.31.
        ' Only trim material on the LEFT and RIGHT of its start/end, never across the middle.
        Dim ymin As Double = Double.PositiveInfinity, ymax As Double = Double.NegativeInfinity
        For Each p As Double() In pts
            ymin = Math.Min(ymin, p(1)) : ymax = Math.Max(ymax, p(1))
        Next
        If ymin > 0.01 OrElse ymax < faceDepth - 0.01 Then
            Throw New Exception("AK flange shape is not full width; automatic end trim refused")
        End If
        If xmin > 0.01 Then
            Dim polyL As New List(Of Double())()
            polyL.Add(New Double() {-1.0, -1.0}) : polyL.Add(New Double() {xmin, -1.0})
            polyL.Add(New Double() {xmin, faceDepth + 1.0}) : polyL.Add(New Double() {-1.0, faceDepth + 1.0})
            If FaceCutPolygon(cd, tg, side, polyL, heightMm, thicknessMm, "LEFT", errors) Then applied += 1
        End If
        If xmax < lengthMm - 0.01 Then
            Dim polyR As New List(Of Double())()
            polyR.Add(New Double() {xmax, -1.0}) : polyR.Add(New Double() {lengthMm + 1.0, -1.0})
            polyR.Add(New Double() {lengthMm + 1.0, faceDepth + 1.0}) : polyR.Add(New Double() {xmax, faceDepth + 1.0})
            If FaceCutPolygon(cd, tg, side, polyR, heightMm, thicknessMm, "RIGHT", errors) Then applied += 1
        End If
    ElseIf side = "v" Then
        ' V15: FOUR CONNECTED END POCKETS, not one cut per segment.
        ' The M45 contour has 17 unique vertices in the exact order below.
        ' Refuse any other contour until a generalized topology solver is implemented.
        If pts.Count <> 17 Then Throw New Exception("AK-v V15 expected 17 unique vertices; actual=" & pts.Count.ToString())
        Dim arcStarts As Integer() = {2, 6, 10, 14}
        For Each idx As Integer In arcStarts
            If Math.Abs(ValToken(Tokens(originalAk(idx))(3)) + 11.0) > 0.001 Then
                Throw New Exception("AK-v V15 expected R-11 arc at vertex " & idx.ToString())
            End If
        Next
        ' Each corner path contains four consecutive ORIGINAL AK vertices:
        ' straight, circular R11, straight, then three stock-envelope vertices.
        ' Arc is always edge at position 1->2; no overlapping SEG polygons.
        Dim chains As Integer()() = { _
            New Integer() {1, 2, 3, 4}, _
            New Integer() {5, 6, 7, 8}, _
            New Integer() {9, 10, 11, 12}, _
            New Integer() {13, 14, 15, 16}}
        Dim labels As String() = {"RIGHT_TOP", "LEFT_TOP", "LEFT_BOTTOM", "RIGHT_BOTTOM"}
        For ci As Integer = 0 To 3
            Dim ix As Integer() = chains(ci)
            Dim poly As New List(Of Double())()
            For Each id As Integer In ix
                poly.Add(New Double() {pts(id)(0), pts(id)(1)})
            Next
            Dim xa As Double = poly(0)(0)
            Dim xb As Double = poly(3)(0)
            Dim margin As Double = 1.0
            If ci = 0 Then
                poly.Add(New Double() {pts(4)(0), heightMm + margin})
                poly.Add(New Double() {lengthMm + margin, heightMm + margin})
                poly.Add(New Double() {lengthMm + margin, pts(1)(1)})
            ElseIf ci = 1 Then
                poly.Add(New Double() {-margin, pts(8)(1)})
                poly.Add(New Double() {-margin, heightMm + margin})
                poly.Add(New Double() {pts(5)(0), heightMm + margin})
            ElseIf ci = 2 Then
                poly.Add(New Double() {pts(12)(0), -margin})
                poly.Add(New Double() {-margin, -margin})
                poly.Add(New Double() {-margin, pts(9)(1)})
            Else
                poly.Add(New Double() {lengthMm + margin, pts(16)(1)})
                poly.Add(New Double() {lengthMm + margin, -margin})
                poly.Add(New Double() {pts(13)(0), -margin})
            End If
            Dim m As Double() = AkSegmentMidpoint(poly(0), poly(1), poly(2), poly(3), _
                                      ValToken(Tokens(originalAk(ix(1)))(3)))
            If FaceCutCornerV15(cd, tg, poly, heightMm, thicknessMm, labels(ci), errors, m) Then applied += 1
        Next
    Else
        Throw New Exception("Unknown AK side " & side)
    End If
    If errors.Count > 0 Then Throw New Exception("AK " & side & " local cutter errors: " & String.Join(" | ", errors.ToArray()))
    If applied = 0 Then Throw New Exception("AK " & side & " did not remove measurable stock")
End Sub

Private Function FaceCutCornerV15(ByVal cd As PartComponentDefinition, ByVal tg As TransientGeometry, _
                                      ByVal poly As List(Of Double()), ByVal heightMm As Double, _
                                      ByVal thicknessMm As Double, ByVal label As String, _
                                      ByVal errors As List(Of String), ByVal arcMiddle As Double()) As Boolean
    ' One connected seven-vertex boundary per corner, including a TRUE SketchArc.
    ' Same original YZ datum plane and transactional validity checks as V14.
    Dim sk As PlanarSketch = cd.Sketches.Add(cd.WorkPlanes.Item(1))
    sk.Name = "ICIMCO_AK_V15_" & label
    Dim a As SketchLine = sk.SketchLines.AddByTwoPoints( _
        sk.ModelToSketchSpace(AkPoint(tg, "v", poly(0), heightMm)), _
        sk.ModelToSketchSpace(AkPoint(tg, "v", poly(1), heightMm)))
    ' V16 stage 1: use the straight chord between original AK arc endpoints.
    ' True R11 treatment is deferred to a finishing stage; do NOT claim final NC geometry.
    Dim arcChord As SketchLine = sk.SketchLines.AddByTwoPoints( _
        a.EndSketchPoint, sk.ModelToSketchSpace(AkPoint(tg, "v", poly(2), heightMm)))
    Dim prev As SketchLine = sk.SketchLines.AddByTwoPoints(arcChord.EndSketchPoint, _
        sk.ModelToSketchSpace(AkPoint(tg, "v", poly(3), heightMm)))
    For j As Integer = 4 To poly.Count - 1
        prev = sk.SketchLines.AddByTwoPoints(prev.EndSketchPoint, _
            sk.ModelToSketchSpace(AkPoint(tg, "v", poly(j), heightMm)))
    Next
    sk.SketchLines.AddByTwoPoints(prev.EndSketchPoint, a.StartSketchPoint)
    Dim prior As Double = SolidVolumeCm3(cd)
    Dim attempts As New List(Of String)()
    For directionNo As Integer = 0 To 1
        Dim tx As Inventor.Transaction = Nothing
        Try
            tx = ThisApplication.TransactionManager.StartTransaction(cd.Document, "ICIMCO V15 " & label)
            Dim prof As Inventor.Profile = sk.Profiles.AddForSolid()
            Dim definition As ExtrudeDefinition = cd.Features.ExtrudeFeatures.CreateExtrudeDefinition( _
                prof, PartFeatureOperationEnum.kCutOperation)
            Dim cutDirection As PartFeatureExtentDirectionEnum = If(directionNo = 0, _
                PartFeatureExtentDirectionEnum.kNegativeExtentDirection, _
                PartFeatureExtentDirectionEnum.kPositiveExtentDirection)
            definition.SetDistanceExtent((thicknessMm + 0.2) / 10.0, cutDirection)
            Dim feat As ExtrudeFeature = cd.Features.ExtrudeFeatures.Add(definition)
            cd.Document.Update()
            If feat.HealthStatus.ToString() <> "kUpToDateHealth" Then Throw New Exception(feat.HealthStatus.ToString())
            Dim delta As Double = prior - SolidVolumeCm3(cd)
            If delta <= Math.Max(0.00001, prior * 0.00000001) Then Throw New Exception("No volume removed")
            ' Reject catastrophic cuts; a dedicated 120mm end corner cannot remove large volumes.
            If delta > 1000.0 Then Throw New Exception("Excessive volume delta " & delta.ToString("F3", CultureInfo.InvariantCulture))
            feat.Name = "ICIMCO_AK_V15_" & label
            tx.End()
            Return True
        Catch ex As Exception
            attempts.Add(directionNo.ToString() & ": " & ex.Message)
            If tx IsNot Nothing Then
                Try
                    tx.Abort()
                Catch
                End Try
            End If
        End Try
    Next
    errors.Add(label & ": " & String.Join(" | ", attempts.ToArray()))
    Return False
End Function

Private Function AkSegmentMidpoint(ByVal prevP As Double(), ByVal a As Double(), _
                                   ByVal b As Double(), ByVal nextP As Double(), _
                                   ByVal signedR As Double) As Double()
    ' A and B are literal DSTV NC endpoints. Select one of the two circular centers
    ' by matching endpoint tangents to the preceding/following straight segments.
    Dim r As Double = Math.Abs(signedR)
    Dim dx As Double = b(0) - a(0), dy As Double = b(1) - a(1)
    Dim chord As Double = Math.Sqrt(dx * dx + dy * dy)
    If chord < 0.000001 OrElse chord > 2.0 * r + 0.00001 Then Throw New Exception("Invalid signed AK arc chord")
    Dim mx As Double = (a(0) + b(0)) / 2.0, my As Double = (a(1) + b(1)) / 2.0
    Dim off As Double = Math.Sqrt(Math.Max(0.0, r * r - chord * chord / 4.0))
    Dim inX As Double = a(0) - prevP(0), inY As Double = a(1) - prevP(1)
    Dim outX As Double = nextP(0) - b(0), outY As Double = nextP(1) - b(1)
    Dim lin As Double = Math.Sqrt(inX * inX + inY * inY), lout As Double = Math.Sqrt(outX * outX + outY * outY)
    If lin < 0.000001 OrElse lout < 0.000001 Then Throw New Exception("No tangent reference at arc endpoints")
    Dim bestScore As Double = Double.NegativeInfinity
    Dim bestMid As Double() = Nothing
    For signC As Integer = -1 To 1 Step 2
        Dim cx As Double = mx + signC * (-dy / chord) * off
        Dim cy As Double = my + signC * (dx / chord) * off
        Dim th0 As Double = Math.Atan2(a(1) - cy, a(0) - cx)
        Dim th1 As Double = Math.Atan2(b(1) - cy, b(0) - cx)
        For turn As Integer = -1 To 1 Step 2
            Dim sweep As Double = th1 - th0
            If turn > 0 Then
                While sweep < 0.0 : sweep += 2.0 * Math.PI : End While
            Else
                While sweep > 0.0 : sweep -= 2.0 * Math.PI : End While
            End If
            If Math.Abs(sweep) > Math.PI + 0.000001 Then Continue For
            Dim taX As Double = turn * (-(a(1) - cy) / r)
            Dim taY As Double = turn * ((a(0) - cx) / r)
            Dim tbX As Double = turn * (-(b(1) - cy) / r)
            Dim tbY As Double = turn * ((b(0) - cx) / r)
            Dim score As Double = (taX * inX + taY * inY) / lin + (tbX * outX + tbY * outY) / lout
            If score > bestScore Then
                bestScore = score
                bestMid = New Double() {cx + r * Math.Cos(th0 + sweep / 2.0), cy + r * Math.Sin(th0 + sweep / 2.0)}
            End If
        Next
    Next
    If bestMid Is Nothing OrElse bestScore < 1.8 Then Throw New Exception("Arc tangent mismatch; refused non-tangent cutter")
    Return bestMid
End Function

Private Function FaceCutPolygon(ByVal cd As PartComponentDefinition, ByVal tg As TransientGeometry, _
                                ByVal side As String, ByVal poly As List(Of Double()), _
                                ByVal heightMm As Double, ByVal thicknessMm As Double, _
                                ByVal label As String, ByVal errors As List(Of String), _
                                Optional ByVal arcMid As Double() = Nothing) As Boolean
    ' V11: Do not bind AK sketch to a changing face of the filleted / already cut BRep.
    ' Datum workplanes refer to the ORIGINAL base axes and remain stable after every cut.
    Dim akPlane As WorkPlane = Nothing
    If side = "v" Then
        akPlane = cd.WorkPlanes.Item(1)  ' YZ, x=0 : web outside
    ElseIf side = "o" Then
        akPlane = cd.WorkPlanes.Item(2)  ' XZ, y=0 : near flange
    ElseIf side = "u" Then
        Dim basePlane As WorkPlane = cd.WorkPlanes.Item(2)
        akPlane = cd.WorkPlanes.AddByPlaneAndOffset(basePlane, heightMm / 10.0)
        If Math.Abs(akPlane.Plane.RootPoint.Y - heightMm / 10.0) > 0.0001 Then
            akPlane.Delete()
            akPlane = cd.WorkPlanes.AddByPlaneAndOffset(basePlane, -heightMm / 10.0)
        End If
        akPlane.Visible = False
    Else
        errors.Add(label & ": invalid AK side " & side) : Return False
    End If
    Dim sk As PlanarSketch = cd.Sketches.Add(akPlane)
    sk.Name = "ICIMCO_AK_LOCAL_" & side & "_" & label
    Dim points3D As New List(Of Inventor.Point)()
    For Each a As Double() In poly
        points3D.Add(AkPoint(tg, side, a, heightMm))
    Next
    If arcMid Is Nothing Then
        ClosedLoop(sk, tg, points3D)
    Else
        ' For SEG cutting polygons: edge 0->1, 1->2, arc 2->3, edge 3->0.
        ' A true SketchArc, not 12 line segments. Share SketchPoints to close loop.
        If points3D.Count <> 4 Then Throw New Exception("Arc strip needs exactly four vertices")
        Dim ln0 As SketchLine = sk.SketchLines.AddByTwoPoints(sk.ModelToSketchSpace(points3D(0)), sk.ModelToSketchSpace(points3D(1)))
        Dim ln1 As SketchLine = sk.SketchLines.AddByTwoPoints(ln0.EndSketchPoint, sk.ModelToSketchSpace(points3D(2)))
        Dim mid3 As Inventor.Point = AkPoint(tg, side, arcMid, heightMm)
        Dim akArc As SketchArc = sk.SketchArcs.AddByThreePoints(ln1.EndSketchPoint, sk.ModelToSketchSpace(mid3), sk.ModelToSketchSpace(points3D(3)))
        sk.SketchLines.AddByTwoPoints(akArc.EndSketchPoint, ln0.StartSketchPoint)
    End If
    Dim beforeVol As Double = SolidVolumeCm3(cd)
    Dim failures As New List(Of String)()
    Dim depthCm As Double = (thicknessMm + 0.2) / 10.0
    ' On filleted stock the face normal can be opposite to the side naming.
    ' Test 2 single-sided directions and one symmetric, finite-depth fallback.
    ' Every attempt is transactional: only a feature that removes solid volume is retained.
    For attempt As Integer = 0 To 2
        Dim tx As Inventor.Transaction = Nothing
        Try
            tx = ThisApplication.TransactionManager.StartTransaction(cd.Document, "ICIMCO AK verify " & side & " " & label)
            Dim profile As Inventor.Profile = sk.Profiles.AddForSolid()
            Dim exDef As ExtrudeDefinition = cd.Features.ExtrudeFeatures.CreateExtrudeDefinition(profile, PartFeatureOperationEnum.kCutOperation)
            Dim directionName As String = ""
            If attempt = 0 Then
                directionName = "NEG"
                exDef.SetDistanceExtent(depthCm, PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
            ElseIf attempt = 1 Then
                directionName = "POS"
                exDef.SetDistanceExtent(depthCm, PartFeatureExtentDirectionEnum.kPositiveExtentDirection)
            Else
                directionName = "SYMMETRIC"
                exDef.SetDistanceExtent(depthCm * 2.0, PartFeatureExtentDirectionEnum.kSymmetricExtentDirection)
            End If
            Dim feat As ExtrudeFeature = cd.Features.ExtrudeFeatures.Add(exDef)
            cd.Document.Update()
            Dim health As String = feat.HealthStatus.ToString()
            If health <> "kUpToDateHealth" Then Throw New Exception("Extrude unhealthy: " & health)
            Dim afterVol As Double = SolidVolumeCm3(cd)
            Dim delta As Double = beforeVol - afterVol
            If delta > Math.Max(0.00001, beforeVol * 0.00000001) Then
                ' Upper bound based on local planar cutter area and allowed depth prevents blind overcut.
                Dim expectedUpper As Double = Math.Abs(PolygonArea(poly)) * thicknessMm / 1000.0 * 1.3
                If delta > expectedUpper + 0.01 Then
                    Throw New Exception("cut exceeds local stock limit: " & delta.ToString("F5", CultureInfo.InvariantCulture) & " cm3")
                End If
                feat.Name = "ICIMCO_AK_" & side.ToUpperInvariant() & "_" & label
                tx.End()
                Return True
            End If
            failures.Add(directionName & ": before=" & beforeVol.ToString("F5", CultureInfo.InvariantCulture) & ", after=" & afterVol.ToString("F5", CultureInfo.InvariantCulture) & ", feature=" & feat.HealthStatus.ToString())
            tx.Abort()
            tx = Nothing
        Catch ex As Exception
            failures.Add("attempt " & attempt.ToString() & ": " & ex.Message)
            If tx IsNot Nothing Then
                Try
                    tx.Abort()
                Catch
                End Try
            End If
        End Try
    Next
    errors.Add(label & " face=" & side & " depth=" & (depthCm * 10.0).ToString("F2", CultureInfo.InvariantCulture) & "mm : " & String.Join(" / ", failures.ToArray()))
    Return False
End Function

Private Function SolidVolumeCm3(ByVal cd As PartComponentDefinition) As Double
    Dim total As Double = 0.0
    For Each solid As SurfaceBody In cd.SurfaceBodies
        If solid.IsSolid Then total += solid.Volume(0.01)
    Next
    Return total
End Function

' Rounded polygon corners: vertex signed R is converted to tangent arc samples.
' This is a geometric approximation for preview and NOT certified DSTV interpolation.
Private Function RoundAkVertices(ByVal raw As List(Of Double()), _
                                  ByVal sourceLines As List(Of String), _
                                  ByVal subdivisions As Integer) As List(Of Double())
    Dim n As Integer = raw.Count
    Dim output As New List(Of Double())()
    If n < 3 Then Return raw
    For i As Integer = 0 To n - 1
        Dim fields As String() = Tokens(sourceLines(i))
        Dim r As Double = Math.Abs(ValToken(fields(3)))
        Dim v As Double() = raw(i)
        If r < 0.00001 Then
            output.Add(New Double() {v(0), v(1)})
            Continue For
        End If
        Dim p As Double() = raw((i + n - 1) Mod n)
        Dim q As Double() = raw((i + 1) Mod n)
        Dim dx0 As Double = p(0) - v(0), dy0 As Double = p(1) - v(1)
        Dim dx1 As Double = q(0) - v(0), dy1 As Double = q(1) - v(1)
        Dim l0 As Double = Math.Sqrt(dx0 * dx0 + dy0 * dy0)
        Dim l1 As Double = Math.Sqrt(dx1 * dx1 + dy1 * dy1)
        If l0 < 0.001 OrElse l1 < 0.001 Then Throw New Exception("AK fillet has zero-length neighbor")
        Dim ux0 As Double = dx0 / l0, uy0 As Double = dy0 / l0
        Dim ux1 As Double = dx1 / l1, uy1 As Double = dy1 / l1
        Dim angle As Double = Math.Acos(Math.Max(-1.0, Math.Min(1.0, ux0 * ux1 + uy0 * uy1)))
        If angle < 0.03 OrElse Math.Abs(Math.PI - angle) < 0.03 Then Throw New Exception("AK fillet corner angle is degenerate")
        Dim d As Double = r / Math.Tan(angle / 2.0)
        If d > Math.Min(l0, l1) * 0.48 Then Throw New Exception("AK fillet overlaps adjacent segments")
        Dim bx As Double = ux0 + ux1, by As Double = uy0 + uy1
        Dim bl As Double = Math.Sqrt(bx * bx + by * by)
        Dim cx As Double = v(0) + bx / bl * r / Math.Sin(angle / 2.0)
        Dim cy As Double = v(1) + by / bl * r / Math.Sin(angle / 2.0)
        Dim a0x As Double = v(0) + ux0 * d, a0y As Double = v(1) + uy0 * d
        Dim a1x As Double = v(0) + ux1 * d, a1y As Double = v(1) + uy1 * d
        Dim th0 As Double = Math.Atan2(a0y - cy, a0x - cx)
        Dim th1 As Double = Math.Atan2(a1y - cy, a1x - cx)
        Dim cross As Double = ux0 * uy1 - uy0 * ux1
        Dim sweep As Double = th1 - th0
        If cross < 0 Then
            While sweep < 0 : sweep += 2.0 * Math.PI : End While
        Else
            While sweep > 0 : sweep -= 2.0 * Math.PI : End While
        End If
        If Math.Abs(sweep) > Math.PI Then Throw New Exception("AK fillet major arc is invalid")
        For j As Integer = 0 To subdivisions
            Dim th As Double = th0 + sweep * CDbl(j) / CDbl(subdivisions)
            output.Add(New Double() {cx + r * Math.Cos(th), cy + r * Math.Sin(th)})
        Next
    Next
    Return output
End Function

Private Function FindFace(ByVal cd As PartComponentDefinition, ByVal side As String, ByVal hMm As Double) As Face
    For Each fc As Face In cd.SurfaceBodies.Item(1).Faces
        If fc.SurfaceType <> SurfaceTypeEnum.kPlaneSurface Then Continue For
        Dim p As Point = fc.PointOnFace
        Dim n As UnitVector = CType(fc.Geometry, Plane).Normal
        If side = "v" AndAlso Math.Abs(p.X) < 0.0001 AndAlso n.X < -0.9 Then Return fc
        If side = "o" AndAlso Math.Abs(p.Y) < 0.0001 AndAlso n.Y < -0.9 Then Return fc
        If side = "u" AndAlso Math.Abs(p.Y - hMm / 10.0) < 0.0001 AndAlso n.Y > 0.9 Then Return fc
    Next
    Return Nothing
End Function

Private Sub SaveProp(ByVal ps As PropertySet, ByVal key As String, ByVal value As String)
    Try
        ps.Item(key).Value = value
    Catch
        ps.Add(value, key)
    End Try
End Sub

Private Function ReadProp(ByVal ps As PropertySet, ByVal key As String) As String
    Return CStr(ps.Item(key).Value)
End Function

Private Sub ExportNc()
    If ThisApplication.ActiveDocumentType <> DocumentTypeEnum.kPartDocumentObject Then
        Throw New Exception("Hãy kích hoạt file Part (.ipt) đã nhập bằng tool trước khi xuất.")
    End If
    Dim pd As PartDocument = CType(ThisApplication.ActiveDocument, PartDocument)
    Dim ps As PropertySet = pd.PropertySets.Item("Inventor User Defined Properties")
    Dim src As String
    Dim savedCount As Integer
    Try
        src = Encoding.UTF8.GetString(Convert.FromBase64String(ReadProp(ps, "ICIMCO_NC_SOURCE")))
        savedCount = Integer.Parse(ReadProp(ps, "ICIMCO_NC_FEATURES"), CultureInfo.InvariantCulture)
    Catch
        Throw New Exception("Part này không có nguồn DSTV gốc. MVP01 không giả lập NC cho chi tiết CAD tùy ý.")
    End Try
    If pd.ComponentDefinition.Features.ExtrudeFeatures.Count <> savedCount OrElse pd.Dirty Then
        Throw New Exception("Part đã thay đổi hoặc chưa lưu; không thể xuất nguyên file NC cũ như bản gia công cập nhật.")
    End If
    Dim pathOut As String = ""
    Using dlg As New SaveFileDialog()
        dlg.Filter = "DSTV NC1 (*.nc1)|*.nc1|DSTV NC (*.nc)|*.nc"
        dlg.FileName = SafeName(ReadProp(ps, "ICIMCO_NC_PART_MARK")) & ".nc1"
        If dlg.ShowDialog() <> DialogResult.OK Then Return
        pathOut = dlg.FileName
    End Using
    System.IO.File.WriteAllText(pathOut, src, Encoding.UTF8)
    MessageBox.Show("Đã khôi phục bản NC NGUYÊN GỐC: " & pathOut & vbCrLf & _
                    "Không phải dữ liệu NC sinh mới từ hình học đã sửa.", "ICIMCO DSTV EXPORT")
End Sub